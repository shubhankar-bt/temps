    public String buildQuery(
            List<HeadCodeGroup> groups,
            String date,
            String searchKey
    ) {

        StringBuilder caseClause = new StringBuilder();
        StringBuilder whereClause = new StringBuilder();

        caseClause.append("CASE\n");

        for (HeadCodeGroup group : groups) {

            String array = buildArray(group.headCodes());

            // CASE part
            caseClause
                    .append("    WHEN ARRAY_OVERLAP(\"").append(searchKey).append("\", ")
                    .append(array)
                    .append(") THEN '")
                    .append(escapeSql(group.name()))
                    .append("'\n");

            // WHERE part
            if (!whereClause.isEmpty()) {
                whereClause.append("\n        OR ");
            }

            whereClause
                    .append("ARRAY_OVERLAP(\"").append(searchKey).append("\", ")
                    .append(array)
                    .append(")");
        }

        caseClause.append("END");

        return """
                SELECT
                    %s AS "GROUP_NAME",
                    SUM("BALANCE") AS "TOTAL_BALANCE"
                
                FROM "PRODUCT_WISE"
                
                WHERE "DATE" = '%s'
                
                AND (
                    %s
                )
                
                GROUP BY 1
                """.formatted(
                caseClause,
                escapeSql(date),
                whereClause
        );
    }

    private String buildArray(List<String> headCodes) {

        String codes = headCodes.stream()
                .map(this::escapeSql)
                .map(code -> "'" + code + "'")
                .collect(Collectors.joining(","));

        return "ARRAY[" + codes + "]";
    }

    private String escapeSql(String value) {
        return value.replace("'", "''");
    }

    public Map<String, ChartDTO> buildAllCharts(Map<String, Object> responseTree, Double casaRatio) {

        List<DashboardChartsHeaders> headers = dashboardChartsHeadersRepository.findAll();
        Map<String, ChartDTO> charts = new LinkedHashMap<>();

        for (DashboardChartsHeaders header : headers) {
            ChartDTO dto = new ChartDTO();
            dto.setKey(toKey(header.getTitle()));
            dto.setTitle(header.getTitle());
            dto.setSubtitle(header.getSubtitle());
            dto.setActiveFilter(header.getActiveFilter());

            if (header.getFilterOptions() != null && !header.getFilterOptions().isBlank()) {
                dto.setFilterOptions(Arrays.asList(header.getFilterOptions().split(",")));
            }

            if ("DASHBOARD_HEADS".equalsIgnoreCase(header.getDataTableName())) {
                dto.setData(resolveData(header, responseTree));
                dto.setValue(null);
            } else if ("CASA_DATA".equalsIgnoreCase(header.getDataTableName())) {

                dto.setValue(casaRatio);
                dto.setData(getCasaChartData());
            }

            charts.put(dto.getKey(), dto);
        }

        return charts;
    }

    @SuppressWarnings("unchecked")
    private List<ChartDataItem> resolveData(DashboardChartsHeaders header,
                                            Map<String, Object> responseTree) {

        String typeKey = header.getDataTypeKey();       // e.g. "Deposit"
        String subTypeKey = header.getDataSubTypeKey(); // e.g. "Demand Deposit" or "Deposit"

        if (typeKey == null || typeKey.isBlank()) {
            return null; // no data source configured
        }

        Map<String, Object> parentMap = (Map<String, Object>) responseTree.get(typeKey);
        if (parentMap == null) {
            return null;
        }

        // Case 1: subTypeKey == typeKey → COMPOSITION (combine all children with type tag)
        if (subTypeKey == null || subTypeKey.isBlank() || subTypeKey.equalsIgnoreCase(typeKey)) {
            List<ChartDataItem> allItems = new ArrayList<>();
            for (Map.Entry<String, Object> entry : parentMap.entrySet()) {
                if (entry.getKey().startsWith("Total")) continue;
                Map<String, Object> childMap = (Map<String, Object>) entry.getValue();
                if (childMap == null) continue;
                allItems.addAll(buildItems(childMap, entry.getKey())); // type = child key
            }
            return allItems;
        }

        // Case 2: subTypeKey is specific → single sub-map, no type tag
        Map<String, Object> subMap = (Map<String, Object>) parentMap.get(subTypeKey);
        if (subMap == null) {
            return null;
        }
        return buildItems(subMap, subTypeKey);
    }

    private List<ChartDataItem> buildItems(Map<String, Object> sourceMap, String type) {
        return sourceMap.entrySet().stream()
                .filter(e -> !e.getKey().startsWith("Total"))
                .filter(e -> e.getValue() instanceof Number)
                .map(e -> new ChartDataItem(e.getKey(), type, ((Number) e.getValue()).doubleValue()))
                .collect(Collectors.toList());
    }

    private List<ChartDataItem> buildCasaItems(Map<String, Object> sourceMap, String type) {
        return sourceMap.entrySet().stream()
                .filter(e -> !e.getKey().startsWith("Total"))
                .filter(e -> e.getValue() instanceof Number)
                .map(e -> new ChartDataItem(e.getKey(), type, ((Number) e.getValue()).doubleValue()))
                .collect(Collectors.toList());
    }

    private String toKey(String title) {
        return title.toLowerCase().replaceAll("\\s+", "");
    }

    public List<ChartDataItem> getCasaChartData() {
        return casaDataRepository.findAllByOrderByIdAsc().stream()
                .map(cd -> new ChartDataItem(cd.getName(), cd.getValue()))
                .toList();
    }

    private void printTree(Map<String, ?> map, int depth) {
        String indent = "  ".repeat(depth);
        map.forEach((key, value) -> {
            if (value instanceof Map) {
                System.out.println(indent + key);
                printTree((Map<String, ?>) value, depth + 1);
            } else {
                System.out.println(indent + key + " -> " + value);
            }
        });
    }


