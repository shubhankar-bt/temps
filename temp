    /**
     * Initializes the token-visible user data embedded/returned alongside the JWT.
     * Fetches branch and circle mapping dynamically.
     *
     * @param user     the user entity
     * @param userRole the role mapping for the user
     * @return user token DTO with non-sensitive fields
     */
    private UserTokenDataDto initializeTokenData(User user, UserRoles userRole) {
        UserTokenDataDto tokenData = new UserTokenDataDto();
        tokenData.setFirstName(user.getFirstName());
        tokenData.setLastName(user.getLastName());
        tokenData.setPhoneNumber(user.getPhoneNumber());
        tokenData.setUserId(user.getUserId());
        tokenData.setBranch(user.getBranch());
        tokenData.setEmail(user.getEmail());
        tokenData.setRole(userRole.getRole());
        tokenData.setRoleName(userRole.getRoleName());

        // ========== New code changes as per requirement for role access ========== added by v1015698
        tokenData.setRoleDescription(userRole.getRoleDescription());
        tokenData.setRoleAccess(userRole.getRoleAccess());
        tokenData.setAccessName(userRole.getAccessName());
        tokenData.setAccessDescription(userRole.getAccessDescription());

        // FORMAT the branch integer to a 5-digit string (e.g., 8080 -> "08080")
        String branchCodeStr = String.format("%05d", user.getBranch());

        // Fetch specific details from the database
        BranchCircleProjection bcInfo = branchRepository.findBranchAndCircleDetails(branchCodeStr);

        if (bcInfo != null) {
            tokenData.setBranchName(bcInfo.getBranchName());
            tokenData.setCity(bcInfo.getCity());
            tokenData.setAddress(bcInfo.getAddress());
            tokenData.setPincode(bcInfo.getPincode());
            tokenData.setNmrCode(bcInfo.getNmrCode());
            tokenData.setBranchStatus(bcInfo.getBranchStatus());
            tokenData.setBranchType(bcInfo.getBranchType());
            tokenData.setCircleCode(bcInfo.getCircleCode());
            tokenData.setCircleName(bcInfo.getCircleName());
            tokenData.setZoneCode(bcInfo.getZoneCode());
            tokenData.setZoneName(bcInfo.getZoneName());
            tokenData.setCircleBranch(bcInfo.getCircleBranch());
            tokenData.setStateName(bcInfo.getStateName());
            tokenData.setStateCode(bcInfo.getStateCode());


            // Check if user's branch matches the Circle's designated branch code
            boolean isCircle = branchCodeStr.equals(bcInfo.getCircleBranch());
            tokenData.setIsCircle(isCircle);
        } else {
            // Fallback if branch is somehow missing in the master table
            tokenData.setIsCircle(false);
            log.warn("Branch details not found in BRANCH_MASTER for branch code: {}", branchCodeStr);
        }

        return tokenData;
    }


    /**
     * Retrieves the full user profile for Token Refresh.
     * Uses the exact same structure as verifyUserCredentials to ensure token claims are identical.
     */
    @Override
    @Transactional(readOnly = true)
    public UserDto getUserProfile(String userId) {
        User user = userRepository.findByUserId(userId);
        UserRoles userRole = userRepository.getUserRole(userId);

        // Return null if user doesn't exist, caller handles the error
        if (user == null) {
            return null;
        }
        UserDto userDto = new UserDto();
        userDto.setUserId(user.getUserId());
        userDto.setUserStatus(user.getPasswordLogin());
        userDto.setPasswordLoginStatus(user.getPasswordLogin());
        userDto.setUser(initializeTokenData(user, userRole));
        return userDto;
    }


    private String determineMethodString(char mode) {
        if (mode == Constants.LDAP) return "LDAP";
        if (mode == Constants.PWD_MODE) return Constants.PASSWORD_BASED_LOGIN;
        return Constants.SSO_BASED_LOGIN;
    }

    private void handleAccountLocked(LoginAttempt attempt, UserDto result, User user) {
        result.setValidCredentials(false);
        result.setPasswordLoginStatus(user.getPasswordLogin());
        result.setMessage("Your account is locked due to multiple failed attempts.");

        if (Constants.INACTIVE.equalsIgnoreCase(user.getPasswordLogin())) {
            result.setAttemptsLeft(0);
            attempt.setFailureReason("Account Locked (Pre-check)");
        } else {
            result.setMessage("Password login is disabled.");
            attempt.setFailureReason("Password login disabled");
        }
    }

    private void handleSuccess(LoginAttempt attempt, UserDto result, User user, UserRoles userRole) {
        attempt.setSuccess("Y");
        attempt.setFailureReason("Success");
        result.setValidCredentials(true);
        result.setMessage("Login Successful");

        // Reset wrong password count on successful login
        if (user.getUserWrongPasswordCount() > 0) {
            user.setUserWrongPasswordCount(0);
            userRepository.save(user);
        }

        log.info("Credentials validated. Issuing token for userId={}", LoginUtility.sanitizeLog(user.getUserId()));

        // Fetch contextual user data (including branch and circle)
        UserTokenDataDto tokenData = initializeTokenData(user, userRole);

        @SuppressWarnings("unchecked")
        String accessToken = HmacJwtUtil.generate(
                hmacSecret,
                user.getUserId(),
                ttlSeconds,
                mapper.convertValue(tokenData, Map.class) // Embed all tokenData properties into the JWT claims
        );

        result.setAccessToken(accessToken);
        result.setUser(tokenData);
    }

    private void handleFailure(LoginAttempt attempt, UserDto userInfo, User user, LoginParam loginParam, String reason) {
        log.warn("Login failed for user {}: {}", LoginUtility.sanitizeLog(user.getUserId()), reason);
        attempt.setSuccess("N");

        int currentFailedCount = user.getUserWrongPasswordCount();
        int maxAllowed = loginParam.getWrongPasswordAttempts();
        int newFailedCount = currentFailedCount + 1;

        user.setUserWrongPasswordCount(newFailedCount);
        userInfo.setValidCredentials(false);

        if (newFailedCount >= maxAllowed) {
            user.setPasswordLogin(Constants.INACTIVE);
            // user.setAccountStatus(Constants.LOCKED); // Optional: Depending on business rule
            attempt.setFailureReason(reason + " -> Account Locked");
            userInfo.setMessage("Your account has been locked due to multiple unsuccessful login attempts.");
            userInfo.setPasswordLoginStatus(Constants.INACTIVE);
            userInfo.setAttemptsLeft(0);
        } else {
            int remaining = maxAllowed - newFailedCount;
            attempt.setFailureReason(reason);
            if (remaining > 1) {
                userInfo.setMessage("Invalid User ID or Password. Please check and try again.");
            } else {
                userInfo.setMessage("Invalid User ID or Password. Final attempt before lock.");
            }
            userInfo.setAttemptsLeft(remaining);
        }
        userRepository.save(user);
    }


    // ================== OTP Format Utilities ====================

    private String generateSecureOtp() {
        SecureRandom random = new SecureRandom();
        int otp = 100000 + random.nextInt(900000);
        return String.valueOf(otp);
    }

    private String maskEmail(String email) {
        if (email == null || !email.contains("@")) return email;
        String[] parts = email.split("@");
        return (parts[0].length() <= 2 ? "**" : parts[0].charAt(0) + "***" + parts[0].charAt(parts[0].length() - 1)) + "@" + parts[1];
    }

    private String maskMobile(String mobile) {
        if (mobile == null || mobile.length() < 4) return mobile;
        return "******" + mobile.substring(mobile.length() - 4);
    }
}











package com.fincore.gateway.Service;

import com.fincore.gateway.dto.ChildMenu;
import com.fincore.gateway.dto.MenuResponse;
import com.fincore.gateway.dto.PermissionRow;
import com.fincore.gateway.dto.RootMenu;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.util.*;
import java.util.stream.Collectors;

/**
 * Builds navigational menu structures from permission entities or projections.
 *
 * <p>Responsibilities:</p>
 * <ul>
 *   <li>Group permissions by root menu title</li>
 *   <li>Create root and child menu DTOs</li>
 *   <li>Ensure deterministic ordering (by {@code orderId} / {@code permissionOrder})</li>
 *   <li>Be tolerant to missing/nullable sorting fields</li>
 * </ul>
 *
 * <p><strong>Ordering</strong>: Root menus and child menus are sorted in ascending order using their respective
 * order fields. Null order values are placed last to keep ordering stable.</p>
 *
 * <strong>UPDATED:</strong> Merges 'menuAction' for Root Menus with the same Title.
 */
@Slf4j
@Service
public class MenuService {

    /**
     * Returns a non-null order for {@link PermissionRow} (nulls go to the end).
     */
    private static int safePermissionOrder(PermissionRow r) {
        Integer v = r.getPermissionOrder();
        return v != null ? v : Integer.MAX_VALUE;
    }

    // --------------------------------------------------------------------------------------------
    // Builders
    // --------------------------------------------------------------------------------------------

    /**
     * Comparator key extractor for root menus.
     */
    private static int safeOrderIdRoot(RootMenu r) {
        Integer v = r.getOrderId();
        return v != null ? v : Integer.MAX_VALUE;
    }

    /**
     * Comparator key extractor for child menus.
     */
    private static int safeOrderIdChild(ChildMenu c) {
        Integer v = c.getOrderId();
        return v != null ? v : Integer.MAX_VALUE;
    }

    // --------------------------------------------------------------------------------------------
    // Null-safe order helpers
    // --------------------------------------------------------------------------------------------

    /**
     * Transforms a list of {@link PermissionRow} projections into a {@link MenuResponse}.
     * <p>Groups by {@code menuTitle}, creates root items, and child items from rows having a non-null {@code subMenu}.</p>
     *
     * @param rows permission projection rows (typically from a custom query join)
     * @return menu response with ordered root and child menus
     */
    public MenuResponse transformFromProjection(List<PermissionRow> rows) {
        MenuResponse response = new MenuResponse();

        if (rows == null || rows.isEmpty()) {
            response.setRoot_menus(Collections.emptyList());
            return response;
        }

        // Group by root menu title
        Map<String, List<PermissionRow>> grouped = rows.stream().collect(Collectors.groupingBy(PermissionRow::getMenuTitle));

        List<RootMenu> rootMenus = new ArrayList<>();

        for (Map.Entry<String, List<PermissionRow>> entry : grouped.entrySet()) {
            List<PermissionRow> group = entry.getValue();

            //1. Representative root row: choose the smallest non-null permissionOrder
            PermissionRow root = group.stream().min(Comparator.comparing(MenuService::safePermissionOrder)).orElse(group.get(0));

            RootMenu rootMenu = buildRootFromProjection(root);

            // 2. MERGE ROOT ACTIONS
            String mergedAction = group.stream().map(PermissionRow::getMenuAction)       // Get action from each row
                    .filter(Objects::nonNull)                // Ignore nulls
                    .flatMap(action -> Arrays.stream(action.split("\\|"))) // Split "create|modify"
                    .map(String::trim)                       // Clean spaces
                    .filter(s -> !s.isEmpty())               // Remove empty strings
                    .distinct()                              // Remove duplicates
                    .collect(Collectors.joining("|"));       // Join back to "create|modify|block"
            // Overwrite the single-row action with the merged action
            rootMenu.setMenuAction(mergedAction);

            // 3.  Children (only rows that actually represent a sub-menu), ordered by permissionOrder asc
            List<ChildMenu> children = group.stream().filter(r ->
                    r.getSubMenu() != null)
                    .map(this::buildChildFromProjection)
                    .sorted(Comparator.comparing(MenuService::safeOrderIdChild))
                    .collect(Collectors.toList());

            boolean multiChildren = children.size() > 1;
            rootMenu.setHasChildren(multiChildren);
            if (!multiChildren) {
                // children size is 0 or 1
                if (children.size() == 1) {
                    // promote the only child
                    rootMenu.setTitle(children.get(0).getTitle());
                }
            } else {
                // children > 1 → set children normally
                rootMenu.setChildren(children);
            }
            // add root menu
            rootMenus.add(rootMenu);
        }

        // Order root menus as well
        rootMenus.sort(Comparator.comparing(MenuService::safeOrderIdRoot));

        response.setRoot_menus(rootMenus);
        return response;
    }

    private RootMenu buildRootFromProjection(PermissionRow r) {
        RootMenu root = new RootMenu();
        root.setId(r.getMenuId());
        root.setTitle(r.getMenuTitle());
        root.setIcon(r.getMenuIcon());
        root.setRoute(r.getMenuUrl());
        root.setMenuAction(r.getMenuAction());
        root.setComponentPath(r.getComponentPath());
        root.setScreenDescription(r.getMenuDescription());
        root.setOrderId(safePermissionOrder(r));
        root.setRequestType(r.getRequestType());
        return root;
    }

    private ChildMenu buildChildFromProjection(PermissionRow r) {
        ChildMenu c = new ChildMenu();
        c.setId(r.getMenuId());
        c.setTitle(r.getSubMenu());
        c.setIcon(r.getMenuIcon());
        c.setRoute(r.getMenuUrl());
        c.setComponentPath(r.getComponentPath());
        c.setScreenDescription(r.getMenuDescription());
        c.setMenuAction(r.getMenuAction());
        c.setRequestType(r.getRequestType());
        c.setOrderId(safePermissionOrder(r));
        return c;
    }
}




















package com.fincore.gateway.Service;

import com.fincore.gateway.utility.LoginUtility;
import tools.jackson.databind.ObjectMapper;
import com.fincore.commonutilities.util.AesEncryptionUtil;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.kafka.core.KafkaTemplate;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

import java.time.Instant;
import java.util.List;
import java.util.Map;
import java.util.UUID;

/**
 * Publishes encrypted PII payloads to Kafka.
 * * INTERNAL AES KEY INSTRUCTION:
 * The `security.internal.kafka-aes-key` property is a static, shared secret between
 * the Fincore Gateway and the Communication Service.
 * Generate this once using `AesEncryptionUtil.generateBase64SessionKey()` and store
 * it in your application-dev/uat/prod.properties.
 * Example: security.internal.kafka-aes-key=bWV0a...
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class OtpKafkaProducer {

    private final KafkaTemplate<String, String> kafkaTemplate;
    private final ObjectMapper mapper;
    private final AesEncryptionUtil aesUtil;

    @Value("${security.internal.kafka-aes-key}")
    private String internalAesKey;

    @Value("${spring.profiles.active:dev}")
    private String currentEnvironment;

    public Mono<Void> publishOtpEvent(String txId, String mobile, String email, String plainOtp, String userName, List<String> activeChannels) {
        return Mono.fromCallable(() -> {
                    /*
                     * ====================================================================
                     * ZERO-TRUST KAFKA PAYLOAD ARCHITECTURE
                     * ====================================================================
                     */

                    // 1. Build the sensitive inner payload
                    Map<String, Object> innerPayload = Map.of(
                            "otpPlaintext", plainOtp,
                            "expiryMins", 3,
                            "userName", userName != null ? userName : "User"
                    );
                    String innerJson = mapper.writeValueAsString(innerPayload);

                    // 2. Encrypt the inner payload (Zero-Trust on Broker)
                    String encryptedPayload = aesUtil.encrypt(innerJson, internalAesKey);

                    // 3. Build the outer routable event
                    Map<String, Object> event = Map.of(
                            "eventId", "evt-" + UUID.randomUUID().toString(),
                            "txId", txId,
                            "eventType", "LOGIN_OTP",
                            "channel", activeChannels,
                            "priority", "CRITICAL",
                            "templateId", "AUTH_LOGIN_OTP_V1",
                            "recipient", Map.of(
                                    "mobile", mobile != null ? mobile : "",
                                    "email", email != null ? email : ""
                            ),
                            "payload", encryptedPayload,
                            "createdAt", Instant.now().toString()
                    );

                    return mapper.writeValueAsString(event);

                }).flatMap(jsonString -> {
                    // Wraps standard KafkaTemplate into a non-blocking Mono
                    return Mono.fromFuture(
                            kafkaTemplate.send("fincore.auth.otp.priority", txId, jsonString)
                    );
                }).doOnSuccess(result -> log.info("Encrypted OTP event published to Kafka for txId={}", LoginUtility.sanitizeLog(txId)))
                .then();
    }
}














package com.fincore.gateway.Service;

import com.fincore.gateway.utility.LoginUtility;
import tools.jackson.core.JacksonException;
import tools.jackson.core.type.TypeReference;
import tools.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.redis.core.ReactiveStringRedisTemplate;
import org.springframework.http.HttpStatus;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.web.server.ResponseStatusException;
import reactor.core.publisher.Mono;
import reactor.util.function.Tuple2;
import reactor.util.function.Tuples;

import java.time.Duration;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * ============================================================================
 * OTP LIFECYCLE & REDIS STATE ENGINE PLAN
 * ============================================================================
 * OTP Validity               : 5 min
 * Max Wrong Attempts         : 5
 * Resend Cooldown            : 30 sec
 * Max Resend Count           : 5
 * Lock Type                  : OTP Session Lock (NOT AD/LDAP Account Lock)
 * OTP Regeneration           : New OTP every resend
 * Previous OTP Valid         : No (Overwritten in Redis)
 * Rate Limit Scope           : IP Address (To prevent SMS Toll Fraud)
 * <p>
 * REDIS KEYS PER TRANSACTION (txId):
 * 1. OTP_TX:{txId}       -> { "userId": "...", "otpHash": "..." } (TTL: 5m)
 * 2. OTP_FAILURES:{txId} -> Integer count (TTL: 5m)
 * 3. OTP_RESENDS:{txId}  -> Integer count (TTL: 5m)
 * 4. OTP_COOLDOWN:{txId} -> "locked" (TTL: 30s)
 * 5. RATE_LIMIT:OTP_REQ:IP:{ip} -> Integer count (TTL: 1h)
 * ============================================================================
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class OtpSessionService {

    private static final Duration OTP_VALIDITY = Duration.ofMinutes(5);
    private static final Duration COOLDOWN = Duration.ofSeconds(30);
    private static final int MAX_RESENDS = 5;
    private static final int MAX_FAILURES = 5;
    private static final int MAX_HOURLY_IP_REQUESTS = 50;
    private final ReactiveStringRedisTemplate redis;
    private final PasswordEncoder passwordEncoder;
    private final ObjectMapper mapper;

    /**
     * Rate limits OTP requests by IP to prevent API abuse and SMS Toll Fraud.
     */
    public Mono<Void> checkIpRateLimit(String clientIp) {
        String key = "RATE_LIMIT:OTP_REQ:IP:" + clientIp;
        return redis.opsForValue().increment(key)
                .flatMap(count -> {
                    if (count == 1) {
                        return redis.expire(key, Duration.ofHours(1)).then();
                    } else if (count > MAX_HOURLY_IP_REQUESTS) {
                        log.warn("SECURITY ALERT: IP {} exceeded hourly OTP limit.", LoginUtility.sanitizeLog(clientIp));
                        return Mono.error(new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS, "Rate limit exceeded. Try again later."));
                    }
                    return Mono.empty();
                });
    }

    /**
     * Initializes or Updates the OTP state in Redis atomically.
     */
    public Mono<Void> saveOtpState(String txId, String userId, String plainOtp, boolean isResend) {
        String hash = passwordEncoder.encode(plainOtp);

        try {
            String payload = mapper.writeValueAsString(Map.of("userId", userId, "otpHash", hash));
            List<Mono<?>> operations = new ArrayList<>();

            // 1. Core Transaction (Overwrites old OTP if resend)
            operations.add(redis.opsForValue().set("OTP_TX:" + txId, payload, OTP_VALIDITY));
            // 2. Always reset failures on a fresh OTP dispatch
            operations.add(redis.opsForValue().set("OTP_FAILURES:" + txId, "0", OTP_VALIDITY));

            if (!isResend) {
                // First generation: Initialize resend counter
                operations.add(redis.opsForValue().set("OTP_RESENDS:" + txId, "0", OTP_VALIDITY));
                // Lock the cooldown on the very first OTP dispatch
                operations.add(redis.opsForValue().set("OTP_COOLDOWN:" + txId, "locked", COOLDOWN));
            } else {
                // Resend: Extend the TTL of the resend counter so it survives the 5 min window refresh
                operations.add(redis.expire("OTP_RESENDS:" + txId, OTP_VALIDITY));
            }

            return Mono.when(operations)
                    .doOnSuccess(v -> log.info("Saved OTP State txId={} for user={} isResend={}",
                            LoginUtility.sanitizeLog(txId), LoginUtility.sanitizeLog(userId), isResend));

        } catch (JacksonException e) {
            return Mono.error(new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to process internal OTP payload"));
        }
    }

    /**
     * Safely executes an OTP Resend, enforcing cooldowns and max limits.
     * Returns Tuple of (NewPlainOtp, UserId).
     */
    public Mono<reactor.util.function.Tuple3<String, String, Long>> processResend(String txId, String newPlainOtp) {
        String cooldownKey = "OTP_COOLDOWN:" + txId;
        String resendKey = "OTP_RESENDS:" + txId;

        // 1. Atomic Cooldown Lock (SETNX)
        return redis.opsForValue().setIfAbsent(cooldownKey, "locked", COOLDOWN)
                .flatMap(acquired -> {
                    if (!Boolean.TRUE.equals(acquired)) {
                        return redis.getExpire(cooldownKey)
                                .flatMap(ttl -> Mono.error(new ResponseStatusException(
                                        HttpStatus.TOO_MANY_REQUESTS,
                                        "Please wait " + ttl.getSeconds() + " seconds before requesting another OTP."
                                )));
                    }

                    // 2. Atomic Increment Resends
                    return redis.opsForValue().increment(resendKey)
                            .flatMap(resendCount -> {
                                if (resendCount > MAX_RESENDS) {
                                    return Mono.error(new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS, "Maximum OTP resend limit exceeded."));
                                }

                                // 3. Fetch userId, update TX, and return Tuple
                                return getUserIdFromTx(txId)
                                        .switchIfEmpty(Mono.error(new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Transaction expired.")))
                                        .flatMap(userId -> saveOtpState(txId, userId, newPlainOtp, true)
                                                .thenReturn(Tuples.of(newPlainOtp, userId, resendCount)));
                            });
                });
    }

    /**
     * Verifies the OTP using constant-time cryptographic matching (BCrypt).
     */
    public Mono<String> verifyOtp(String txId, String inputOtp) {
        String txKey = "OTP_TX:" + txId;
        String failKey = "OTP_FAILURES:" + txId;

        return redis.opsForValue().get(txKey)
                .switchIfEmpty(Mono.error(new ResponseStatusException(HttpStatus.UNAUTHORIZED, "OTP Session Expired or Invalid Transaction.")))
                .flatMap(payload -> {
                    try {
                        Map<String, String> data = mapper.readValue(payload, new TypeReference<>() {
                        });
                        String userId = data.get("userId");
                        String storedHash = data.get("otpHash");

                        if (passwordEncoder.matches(inputOtp, storedHash)) {
                            // SUCCESS: Terminate transaction to prevent replay attacks
                            return redis.delete(txKey).thenReturn(userId);
                        } else {
                            //FAILURE: Atomic increment
                            return redis.opsForValue().increment(failKey)
                                    .flatMap(failCount -> {
                                        if (failCount >= MAX_FAILURES) {
                                            // Enforce Session Lockout (Do NOT lock AD account)
                                            return redis.delete(txKey)
                                                    .then(Mono.error(new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Maximum wrong attempts exceeded. Session locked.")));
                                        }
                                        return Mono.error(new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid OTP. Attempts remaining: " + (MAX_FAILURES - failCount)));
                                    });
                        }
                    } catch (JacksonException e) {
                        return Mono.error(new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Redis payload corruption"));
                    }
                });
    }

    private Mono<String> getUserIdFromTx(String txId) {
        return redis.opsForValue().get("OTP_TX:" + txId)
                .flatMap(payload -> {
                    try {
                        Map<String, String> map = mapper.readValue(payload, new TypeReference<>() {
                        });
                        return Mono.just(map.get("userId"));
                    } catch (JacksonException e) {
                        return Mono.error(new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Redis payload corruption"));
                    }
                });
    }

    /**
     * Compensating transaction: Cleans up the Redis state if Kafka fails,
     * ensuring the user isn't penalized for our infrastructure issues.
     */
    public Mono<Void> rollbackOtpState(String txId) {
        return Mono.when(
                redis.delete("OTP_TX:" + txId),
                redis.delete("OTP_FAILURES:" + txId),
                redis.delete("OTP_RESENDS:" + txId)
        ).doOnSuccess(v -> log.info("Successfully rolled back Redis state for txId={}", LoginUtility.sanitizeLog(txId)));
    }
}





















package com.fincore.gateway.Service;

import com.fincore.gateway.utility.LoginUtility;
import lombok.extern.slf4j.Slf4j;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.data.redis.core.ReactiveStringRedisTemplate;
import org.springframework.security.authentication.BadCredentialsException;
import org.springframework.security.core.Authentication;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.server.resource.authentication.JwtAuthenticationToken;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

import java.time.Duration;
import java.util.Objects;

/**
 * Validates JWT sessions against Redis using two key families:
 * <ul>
 *   <li><b>USR:&lt;username&gt;</b> → stores the latest active JTI for the user</li>
 *   <li><b>BL:&lt;jti&gt;</b> → blacklisted JTIs (revoked/expired/rotated)</li>
 * </ul>
 *
 * <p><strong>Workflow</strong></p>
 * <ol>
 *   <li><b>registerUserSession</b>: On login, blacklist any previous JTI and store the new one.</li>
 *   <li><b>validateWithRedis</b>: On each request, reject if blacklisted or if JTI != stored latest.</li>
 *   <li><b>clearUserSession</b>: On logout, remove the USR:&lt;user&gt; pointer.</li>
 *   <li><b>blacklistToken</b>: On logout or rotation, add JTI to blacklist.</li>
 * </ol>
 *
 * <p><strong>TTL</strong>: Keys are set to the same TTL as the JWT (configurable via
 * {@code security.jwt.ttl-seconds}).</p>
 */
@Component
@Slf4j
public class TokenSessionValidator {

    /**
     * Redis key prefixes.
     */
    private static final String USER_PREFIX = "USR:";
    private static final String BLACKLIST_PREFIX = "BL:";
    private static final String GRACE_PREFIX = "GRACE:";
    private final ReactiveStringRedisTemplate redis;

    /**
     * Token TTL aligned with JWT expiry.
     */
    private final Duration tokenTtl;

    /**
     * Configurable grace period (e.g., 45 seconds for in-flight requests)
     */
    private final Duration gracePeriod = Duration.ofSeconds(45);

    public TokenSessionValidator(
            ReactiveStringRedisTemplate redis,
            @Value("${security.jwt.refresh-ttl-seconds:86400}") long refreshTtlSeconds // <--- Use Refresh TTL
    ) {
        this.redis = redis;
        this.tokenTtl = Duration.ofSeconds(refreshTtlSeconds); // Set Redis to live for 12h
    }

    // --------------------------------------------------------------------------------------------
    // Session management
    // --------------------------------------------------------------------------------------------

    private static String userKey(String username) {
        return USER_PREFIX + username;
    }

    private static String blacklistKey(String jti) {
        return BLACKLIST_PREFIX + jti;
    }

    private static String graceKey(String jti) {
        return GRACE_PREFIX + jti;
    }

    /**
     * Register a new session for a user.
     * <ol>
     *   <li>Registers a new session. Old sessions are moved to a Grace Period, not instantly killed.</li>
     *   <li>Store the new JTI under {@code USR:<username>} with {@link #tokenTtl}.</li>
     * </ol>
     *
     * @param username the subject/username
     * @param newJti   the new token ID
     * @return completion signal
     */
    public Mono<Void> registerUserSession(String username, String newJti) {
        Objects.requireNonNull(username, "username must not be null");
        Objects.requireNonNull(newJti, "newJti must not be null");

        final String userKey = userKey(username);
        log.info("Registering new session user={} jti={}", username, newJti);

        return redis.opsForValue().get(userKey)
                .flatMap(oldJti -> {
                    if (oldJti != null && !oldJti.equals(newJti)) {
                        log.info("Moving old session to Grace Period for user={} -> oldJti={}", LoginUtility.sanitizeLog(username), LoginUtility.sanitizeLog(oldJti));
                        return redis.opsForValue().set(graceKey(oldJti), username, gracePeriod).then();
                    }
                    return Mono.empty();
                })
                .then(
                        redis.opsForValue()
                                .set(userKey, newJti, tokenTtl)
                                .doOnSuccess(v -> log.info("Registered active session in Redis user={} jti={}", LoginUtility.sanitizeLog(username), LoginUtility.sanitizeLog(newJti)))
                                .then()
                );
    }

    // --------------------------------------------------------------------------------------------
    // Request-time validation
    // --------------------------------------------------------------------------------------------

    /**
     * Blacklist a JTI (used on logout or token rotation).
     *
     * @param jti token id
     * @return {@code true} if set succeeded
     */
    public Mono<Boolean> blacklistToken(String jti) {
        Objects.requireNonNull(jti, "jti must not be null");
        final String blKey = blacklistKey(jti);
        return redis.opsForValue().set(blKey, "true", tokenTtl)
                .doOnSuccess(v -> log.info("Blacklisted jti={}", jti));
    }

    // --------------------------------------------------------------------------------------------
    // Key helpers
    // --------------------------------------------------------------------------------------------

    /**
     * Clear the current session pointer for a user.
     *
     * @param username the subject/username
     * @return {@code true} if a key was deleted
     */
    public Mono<Boolean> clearUserSession(String username) {
        Objects.requireNonNull(username, "username must not be null");
        return redis.delete(userKey(username))
                .map(deleted -> {
                    if (deleted > 0) {
                        log.info("Cleared session for user={}", LoginUtility.sanitizeLog(username));
                        return true;
                    }
                    return false;
                });
    }

    /**
     * Validate an incoming {@link Authentication} against Redis:
     * <ul>
     *   <li>Reject if not a {@link JwtAuthenticationToken}</li>
     *   <li>Reject if JTI is blacklisted</li>
     *   <li>Reject if JTI != {@code USR:&lt;username&gt;} stored JTI</li>
     * </ul>
     *
     * @param authentication the Spring Security authentication (expected {@link JwtAuthenticationToken})
     * @return a {@link Mono} with the same {@code authentication} on success, or an error on failure
     */
    public Mono<Authentication> validateWithRedis(Authentication authentication) {
        if (!(authentication instanceof JwtAuthenticationToken jwtAuth)) {
            log.warn("Validation failed: not a JwtAuthenticationToken -> {}", authentication);
            return Mono.error(new BadCredentialsException("Invalid authentication type"));
        }

        Jwt jwt = jwtAuth.getToken();
        String username = jwt.getSubject();
        String jti = jwt.getId();

        if (username == null || username.isBlank()) {
            log.error("Token missing subject -> rejecting");
            return Mono.error(new BadCredentialsException("Missing subject (sub)"));
        }
        if (jti == null || jti.isBlank()) {
            log.error("Token missing JTI claim -> rejecting user={}", LoginUtility.sanitizeLog(username));
            return Mono.error(new BadCredentialsException("Missing token ID (jti)"));
        }

        log.info("Validating token user={} jti={}", username, jti);

        // 1) Check explicit blacklist
        return redis.hasKey(blacklistKey(jti))
                .flatMap(isBlacklisted -> {
                    if (Boolean.TRUE.equals(isBlacklisted)) {
                        log.warn("Token is blacklisted jti={} user={}", jti, LoginUtility.sanitizeLog(username));
                        return Mono.error(new BadCredentialsException("Token revoked"));
                    }

                    // 2) Ensure JTI matches the latest session pointer
                    return redis.opsForValue().get(userKey(username))
                            .flatMap(currentJti -> {
                                log.debug("Redis stored JTI for user={} -> {}", LoginUtility.sanitizeLog(username), LoginUtility.sanitizeLog(currentJti));

                                if (currentJti != null && currentJti.equals(jti)) {
                                    log.info("Token validation success user={} jti={}", LoginUtility.sanitizeLog(username), LoginUtility.sanitizeLog(jti));
                                    return Mono.just(authentication); // Valid Primary Session
                                }

                                // 3) Check if it is in the Grace Period (Handling in-flight requests)
                                return redis.hasKey(graceKey(jti))
                                        .flatMap(isInGrace -> {
                                            if (Boolean.TRUE.equals(isInGrace)) {
                                                log.warn("Token accepted under Grace Period. user={} jti={}",
                                                        LoginUtility.sanitizeLog(username), LoginUtility.sanitizeLog(jti));
                                                return Mono.just(authentication);
                                            }

                                            // 4) If not primary and not in grace -> Concurrent Login
                                            log.warn("Token mismatch user={} expectedJti={} gotJti={}", LoginUtility.sanitizeLog(username),
                                                    LoginUtility.sanitizeLog(currentJti), LoginUtility.sanitizeLog(jti));
                                            return Mono.error(new BadCredentialsException("Another session is active"));
                                        });
                            })
                            .switchIfEmpty(Mono.error(new BadCredentialsException("No active session")));
                });
    }
