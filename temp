-- =========================================================================
-- FINCORE LOGIN SYSTEM V2 - PRODUCTION UPDATE SCRIPT
-- Target Database: Oracle
-- Safe to run on existing production data (No DROP statements)
-- =========================================================================

-- 1. Add the decoupled OTP feature flag to the LOGIN_PARAM table.
-- Note: Using "DEFAULT 'N' NOT NULL" ensures that if your LOGIN_PARAM table 
-- already has a row, it will automatically be populated with 'N' (Disabled), 
-- preventing any immediate disruption to the current production login flow.
ALTER TABLE LOGIN_PARAM 
ADD IS_OTP_ENABLED CHAR(1) DEFAULT 'N' NOT NULL;

-- 2. Add a descriptive comment to the column for future DBAs and audits
COMMENT ON COLUMN LOGIN_PARAM.IS_OTP_ENABLED IS 'Flag to dynamically enable/disable MFA (OTP) independent of LDAP/Local mode. Y=Enabled, N=Disabled';

