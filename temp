package com.fincore.gateway.JwtUtil;

import com.nimbusds.jose.*;
import com.nimbusds.jose.crypto.DirectDecrypter;
import com.nimbusds.jose.crypto.DirectEncrypter;
import com.nimbusds.jwt.JWTClaimsSet;
import com.nimbusds.jwt.EncryptedJWT;
import lombok.extern.slf4j.Slf4j;
import org.springframework.security.oauth2.jwt.JwtException;

import java.text.ParseException;
import java.time.Instant;
import java.util.Base64;
import java.util.Date;
import java.util.Map;
import java.util.UUID;

/**
 * Enterprise Cryptographic Engine for JSON Web Encryption (JWE).
 * Implements Direct Encryption (dir) with AES-256-GCM (A256GCM).
 */
@Slf4j
public class JweUtil {

    /**
     * Generates a fully encrypted JWE token.
     *
     * @param aesKeyBase64 The 256-bit AES key in Base64 format.
     * @param userId       The user ID, injected into the unencrypted 'kid' header for lookup.
     * @param ttlSeconds   Time to live in seconds.
     * @param claims       The user profile and role claims.
     * @return A 5-part JWE serialized string.
     */
    public static String generateJwe(String aesKeyBase64, String userId, long ttlSeconds, Map<String, Object> claims) {
        try {
            // 1. Decode the AES key (Must be exactly 32 bytes for A256GCM)
            byte[] keyBytes = Base64.getDecoder().decode(aesKeyBase64);
            if (keyBytes.length != 32) {
                throw new IllegalArgumentException("AES key must be exactly 256 bits (32 bytes)");
            }

            // 2. Build the unencrypted Header. 
            // CRITICAL: We expose the 'kid' (Key ID) so the backend knows which Redis key to fetch!
            JWEHeader header = new JWEHeader.Builder(JWEAlgorithm.DIR, EncryptionMethod.A256GCM)
                    .keyID(userId)
                    .contentType("JWT") // Optional but good practice
                    .build();

            // 3. Build the payload claims
            Instant now = Instant.now();
            JWTClaimsSet.Builder claimsBuilder = new JWTClaimsSet.Builder()
                    .subject(userId)
                    .jwtID(UUID.randomUUID().toString())
                    .issueTime(Date.from(now))
                    .expirationTime(Date.from(now.plusSeconds(ttlSeconds)));

            // Append custom claims (PII, roles, etc.)
            if (claims != null) {
                claims.forEach(claimsBuilder::claim);
            }
            JWTClaimsSet claimsSet = claimsBuilder.build();

            // 4. Encrypt and Serialize
            EncryptedJWT encryptedJWT = new EncryptedJWT(header, claimsSet);
            DirectEncrypter encrypter = new DirectEncrypter(keyBytes);
            
            encryptedJWT.encrypt(encrypter);
            
            return encryptedJWT.serialize();

        } catch (JOSEException e) {
            log.error("Cryptographic failure during JWE generation for user {}", userId, e);
            throw new JwtException("Failed to encrypt token payload");
        }
    }

    /**
     * Decrypts a JWE string back into a readable JWTClaimsSet.
     */
    public static JWTClaimsSet decryptJwe(String jweString, String aesKeyBase64) {
        try {
            byte[] keyBytes = Base64.getDecoder().decode(aesKeyBase64);
            
            EncryptedJWT encryptedJWT = EncryptedJWT.parse(jweString);
            DirectDecrypter decrypter = new DirectDecrypter(keyBytes);
            
            encryptedJWT.decrypt(decrypter);
            return encryptedJWT.getJWTClaimsSet();
            
        } catch (ParseException e) {
            log.warn("Failed to parse JWE string. Malformed token.");
            throw new JwtException("Malformed JWE token");
        } catch (JOSEException e) {
            log.warn("Failed to decrypt JWE. Invalid key or cipher.");
            throw new JwtException("Failed to decrypt token");
        }
    }
}













package com.fincore.gateway.Config;

import com.fincore.gateway.JwtUtil.JweUtil;
import com.fincore.gateway.utility.LoginUtility;
import com.nimbusds.jwt.EncryptedJWT;
import com.nimbusds.jwt.JWTClaimsSet;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.redis.core.ReactiveStringRedisTemplate;
import org.springframework.security.oauth2.jwt.BadJwtException;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.jwt.JwtException;
import org.springframework.security.oauth2.jwt.ReactiveJwtDecoder;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;
import reactor.core.scheduler.Schedulers;

import java.text.ParseException;
import java.time.Instant;
import java.util.Map;

/**
 * Custom Reactive JWT Decoder to handle fully encrypted JWE tokens.
 * Replaces the default Spring Security Nimbus decoder.
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class JweReactiveJwtDecoder implements ReactiveJwtDecoder {

    private static final String AES_KEY_PREFIX = "AES:USR:";
    private final ReactiveStringRedisTemplate redisTemplate;

    @Override
    public Mono<Jwt> decode(String token) throws JwtException {
        
        return Mono.fromCallable(() -> {
                    // 1. Parse the token to read the unencrypted header
                    try {
                        return EncryptedJWT.parse(token);
                    } catch (ParseException e) {
                        log.warn("Failed to parse JWE token format.");
                        throw new BadJwtException("Invalid token format");
                    }
                })
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(encryptedJWT -> {
                    // 2. Extract the User ID (kid) from the header
                    String userId = encryptedJWT.getHeader().getKeyID();
                    
                    if (userId == null || userId.isBlank()) {
                        log.warn("JWE token rejected: Missing 'kid' header.");
                        return Mono.error(new BadJwtException("Invalid token header"));
                    }

                    // 3. Fetch the AES Key from Redis dynamically
                    return redisTemplate.opsForValue().get(AES_KEY_PREFIX + userId)
                            .switchIfEmpty(Mono.defer(() -> {
                                log.warn("JWE Decryption Failed: No active AES session key found in Redis for user {}", LoginUtility.sanitizeLog(userId));
                                return Mono.error(new BadJwtException("Session expired or invalid"));
                            }))
                            .flatMap(aesKeyBase64 -> Mono.fromCallable(() -> {
                                
                                // 4. Decrypt the payload
                                JWTClaimsSet claimsSet = JweUtil.decryptJwe(token, aesKeyBase64);
                                
                                // 5. Validate Expiration
                                Instant expirationTime = claimsSet.getExpirationTime().toInstant();
                                if (expirationTime.isBefore(Instant.now())) {
                                    log.warn("JWE token expired for user {}", LoginUtility.sanitizeLog(userId));
                                    throw new BadJwtException("Token expired");
                                }

                                // 6. Map to Spring Security 'Jwt' Object
                                Map<String, Object> headers = encryptedJWT.getHeader().toJSONObject();
                                Map<String, Object> claims = claimsSet.getClaims();
                                Instant issueTime = claimsSet.getIssueTime() != null ? claimsSet.getIssueTime().toInstant() : Instant.now();

                                return new Jwt(token, issueTime, expirationTime, headers, claims);
                                
                            }).subscribeOn(Schedulers.boundedElastic()));
                });
    }
}
