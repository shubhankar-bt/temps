@Slf4j
@RestController
@RequestMapping("/api/auth")
@RequiredArgsConstructor
public class AuthController {

    private final TokenSessionValidator validator;
    private final ReactiveStringRedisTemplate redisTemplate;
    private final LoginService loginService;
    private final ObjectMapper mapper;
    private final LaunchService launchService;
    private final AesEncryptionUtil aesUtil;

    @Value("${security.jwt.hmac-base64-secret:}")
    private String hmacSecret;

    @Value("${security.jwt.ttl-seconds:900}")
    private long accessTokenTtl;

    @Value("${security.jwt.refresh-ttl-seconds:43200}")
    private long refreshTokenTtl;

    // =========================================================
    // BOOTSTRAP API (Delivers Public Key)
    // =========================================================
    @GetMapping("/start-prod")
    public ResponseEntity<LaunchResponse> getLaunchData() {
        // The LaunchServiceImpl now injects the RSA Public Key into this response
        return ResponseEntity.ok(launchService.getLaunchDetails());
    }

    // =========================================================
    // UNIFIED SINGLE-SCREEN LOGIN API
    // =========================================================
    @PostMapping(value = "/login", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<?>>> login(
            ServerHttpRequest request, ServerHttpResponse response, @RequestBody @Valid UserDto payload) {
        
        final String clientIp = LoginUtility.getClientIp(request);
        log.info("Login request for user: {}", LoginUtility.sanitizeLog(payload.getUserId()));

        return Mono.fromCallable(() -> loginService.verifyUserCredentials(payload, clientIp))
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(user -> {

                    // 1. INVALID CREDENTIALS
                    if (!user.isValidCredentials()) {
                        log.warn("Login Failed for {}. Reason: {}", LoginUtility.sanitizeLog(payload.getUserId()), user.getMessage());

                        LoginResponseDTO errorResponse = LoginResponseDTO.builder()
                                .userId(user.getUserId())
                                .validCredentials(false)
                                .attemptsLeft(user.getAttemptsLeft()) 
                                .error(user.getMessage())
                                .build();

                        // If explicitly locked/inactive, return 403. Otherwise 401.
                        HttpStatus status = user.isAccountLocked() ? HttpStatus.FORBIDDEN : HttpStatus.UNAUTHORIZED;

                        return Mono.just(ResponseEntity.status(status)
                                .body(ApiResponse.error(user.getMessage(), status.name())));
                    }

                    // 2. PASSWORD EXPIRED (Needs Update)
                    if (user.isUpdatePassword()) {
                        log.info("User {} requires password update.", LoginUtility.sanitizeLog(user.getUserId()));
                        return Mono.just(ResponseEntity.status(HttpStatus.PRECONDITION_REQUIRED)
                                .body(ApiResponse.error("Password expired. Update required.", "UPDATE_REQUIRED")));
                    }

                    // 3. MFA ENABLED (Route to OTP)
                    if (user.isOtpRequired()) {
                        log.info("MFA Enabled: Routing user {} to OTP Phase.", LoginUtility.sanitizeLog(user.getUserId()));
                        return loginService.initiateOtpPhase(user)
                                .map(otpDto -> ResponseEntity.status(HttpStatus.ACCEPTED) // <--- 202 ACCEPTED
                                        .body(ApiResponse.<OtpInitiatedResponseDTO>success(otpDto, "OTP_REQUIRED")));
                    } 
                    
                    // 4. MFA DISABLED (Direct Login)
                    log.info("MFA Disabled: Routing user {} to Direct Login.", LoginUtility.sanitizeLog(user.getUserId()));
                    return generateSessionAndTokens(user, response);
                });
    }

    // =========================================================
    // OTP VERIFICATION
    // =========================================================
    @PostMapping(value = "/verify-otp", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<?>>> verifyOtp(
            @RequestBody @Valid VerifyOtpRequestDTO requestDto, ServerHttpResponse response) {
        log.info("OTP Verification for TxId: {}", requestDto.getTransactionId());

        return loginService.verifyOtpAndGetUser(requestDto)
                .flatMap(userDto -> generateSessionAndTokens(userDto, response)); 
    }

    // =========================================================
    // OTP RESEND
    // =========================================================
    @PostMapping(value = "/resend-otp", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<OtpResendResponseDTO>>> resendOtp(
            @RequestBody @Valid ResendOtpRequestDTO requestDto, ServerHttpRequest request) {
        log.info("OTP Resend for TxId: {}", requestDto.getTransactionId());
        return loginService.resendOtp(requestDto, LoginUtility.getClientIp(request))
                .map(responseDto -> ResponseEntity.status(HttpStatus.ACCEPTED)
                        .body(ApiResponse.success(responseDto, "A new OTP has been dispatched.")));
    }

    // =========================================================
    // REFRESH TOKEN
    // =========================================================
    @PostMapping(value = "/refresh-token", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<LoginResponseDTO>>> refreshToken(ServerHttpRequest request, ServerHttpResponse response) {
        org.springframework.http.HttpCookie cookie = request.getCookies().getFirst("refresh_token");
        String refreshToken = (cookie != null) ? cookie.getValue() : null;

        if (refreshToken == null || refreshToken.isBlank()) {
            return Mono.error(new ResponseStatusException(HttpStatus.BAD_REQUEST, "Missing refresh token cookie"));
        }

        return Mono.fromCallable(() -> extractClaims(refreshToken))
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(claims -> {
                    String userId = claims.getSubject();
                    String userKey = "USR:" + userId;

                    return redisTemplate.opsForValue().get(userKey)
                            .switchIfEmpty(Mono.error(new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Session expired.")))
                            .flatMap(currentJti -> Mono.fromCallable(() -> loginService.getUserProfile(userId))
                                    .subscribeOn(Schedulers.boundedElastic())
                                    .flatMap(userDto -> Mono.fromCallable(() -> loginService.fetchRoleWiseData(userId))
                                            .subscribeOn(Schedulers.boundedElastic())
                                            .flatMap(roleData -> {

                                                Map<String, Object> claimsMap = mapper.convertValue(userDto.getUser(), new TypeReference<>() {});
                                                String newAccessToken = HmacJwtUtil.generate(hmacSecret, userId, accessTokenTtl, claimsMap);
                                                String newRefreshToken = HmacJwtUtil.generate(hmacSecret, userId, refreshTokenTtl, Map.of("type", "refresh"));
                                                String newJti = extractClaims(newAccessToken).getId();

                                                response.addCookie(createRefreshTokenCookie(newRefreshToken));

                                                return validator.registerUserSession(userId, newJti)
                                                        .then(fetchAndExtendAesKey(userId))
                                                        .map(existingAesKey -> {
                                                            // AppSec: ALE Encryption for Refresh Token
                                                            String rawUserDataJson = "";
                                                            try { rawUserDataJson = mapper.writeValueAsString(userDto.getUser()); } 
                                                            catch (Exception e) { log.error("JSON Error", e); }
                                                            String encryptedUserData = aesUtil.encrypt(rawUserDataJson, existingAesKey);

                                                            LoginResponseDTO loginResponse = LoginResponseDTO.builder()
                                                                    .accessToken(newAccessToken)
                                                                    .userId(userId)
                                                                    .jti(newJti)
                                                                    .expiresIn(accessTokenTtl)
                                                                    .validCredentials(true)
                                                                    .roleData(roleData)
                                                                    .userData(encryptedUserData) // <-- Encrypted
                                                                    .sub(userId)
                                                                    .build();

                                                            return ResponseEntity.ok()
                                                                    .header("X-Payload-Key", existingAesKey) 
                                                                    .body(ApiResponse.success(loginResponse, "Token refreshed"));
                                                        });
                                            })));
                });
    }

    // =========================================================
    // LOGOUT
    // =========================================================
    @PostMapping(value = "/logout", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<LoginResponseDTO>>> logout(
            JwtAuthenticationToken jwtAuth, ServerHttpRequest request, ServerHttpResponse response) {

        response.addCookie(ResponseCookie.from("refresh_token", "").maxAge(0).path("/").build());
        String tokenString = (jwtAuth != null && jwtAuth.getToken() != null) ? jwtAuth.getToken().getTokenValue() : null;

        if (tokenString == null || tokenString.isBlank()) {
            return Mono.just(ResponseEntity.ok(ApiResponse.success(null, "Logged out")));
        }

        final String finalToken = tokenString;
        return Mono.fromCallable(() -> {
                    try { return extractClaims(finalToken); } 
                    catch (ExpiredJwtException e) { return e.getClaims(); }
                })
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(claims -> {
                    String userId = claims.getSubject();
                    String incomingJti = claims.getId();

                    return validator.blacklistToken(incomingJti)
                            .then(redisTemplate.opsForValue().get("USR:" + userId))
                            .flatMap(activeJti -> {
                                if (activeJti != null && activeJti.equals(incomingJti)) {
                                    return validator.clearUserSession(userId)
                                            .then(redisTemplate.delete("AES:USR:" + userId))
                                            .then(Mono.just(ResponseEntity.ok(ApiResponse.<LoginResponseDTO>success(null, "Logged out successfully"))));
                                } else {
                                    return Mono.just(ResponseEntity.ok(ApiResponse.<LoginResponseDTO>success(null, "Logged out (Concurrent Session Preserved)")));
                                }
                            }).switchIfEmpty(Mono.just(ResponseEntity.ok(ApiResponse.<LoginResponseDTO>success(null, "Logged out"))));
                })
                .onErrorResume(e -> Mono.just(ResponseEntity.ok(ApiResponse.<LoginResponseDTO>success(null, "Logged out"))));
    }

    // =========================================================
    // UPDATE PASSWORD
    // =========================================================
    @PostMapping(value = "/update-password")
    public Mono<ApiResponse<UpdatePasswordDTO>> updatePassword(@RequestBody @Valid UpdatePasswordDTO dto) {
        return Mono.fromCallable(() -> loginService.updatePassword(dto))
                .subscribeOn(Schedulers.boundedElastic())
                .map(result -> ApiResponse.success(result, result.getMessage()));
    }

    // =================================================================================================
    // GENERATE TOKENS & HEADERS (AppSec: ALE Encryption Applied)
    // =================================================================================================
    private Mono<ResponseEntity<ApiResponse<?>>> generateSessionAndTokens(UserDto user, ServerHttpResponse response) {
        
        Map<String, Object> claimsMap = mapper.convertValue(user.getUser(), new TypeReference<>() {});
        String accessToken = HmacJwtUtil.generate(hmacSecret, user.getUserId(), accessTokenTtl, claimsMap);
        String refreshToken = HmacJwtUtil.generate(hmacSecret, user.getUserId(), refreshTokenTtl, Map.of("type", "refresh"));
        String jti = extractClaims(accessToken).getId();
        
        response.addCookie(createRefreshTokenCookie(refreshToken));

        return validator.registerUserSession(user.getUserId(), jti)
                .then(generateAndStoreAesKey(user.getUserId()))
                .flatMap(aesKey -> Mono.defer(() -> Mono.fromCallable(() -> loginService.fetchRoleWiseData(user.getUserId())))
                        .subscribeOn(Schedulers.boundedElastic())
                        .map(roleData -> {
                            
                            // AppSec Fix: ALE Encryption - Do not return PII in plain text JSON
                            String rawUserDataJson = "";
                            try { rawUserDataJson = mapper.writeValueAsString(user.getUser()); } 
                            catch (Exception e) { log.error("JSON parse error", e); }
                            String encryptedUserData = aesUtil.encrypt(rawUserDataJson, aesKey);

                            LoginResponseDTO loginResponse = LoginResponseDTO.builder()
                                    .userId(user.getUserId())
                                    .validCredentials(true)
                                    .accessToken(accessToken)
                                    .tokenType("Bearer")
                                    .expiresIn(accessTokenTtl)
                                    .sub(user.getUserId())
                                    .jti(jti)
                                    .roleData(roleData)
                                    .userData(encryptedUserData) // <-- Encrypted
                                    .build();

                            // Move Crypto Key to HTTP Header
                            return ResponseEntity.ok()
                                    .header("X-Payload-Key", aesKey) 
                                    .body(ApiResponse.success(loginResponse, "Login successful"));
                        }));
    }

    // --- Helpers ---
    private ResponseCookie createRefreshTokenCookie(String token) {
        return ResponseCookie.from("refresh_token", token)
                .httpOnly(true).secure(true).path("/").maxAge(Duration.ofSeconds(refreshTokenTtl)).sameSite("Strict").build();
    }

    private Claims extractClaims(String token) {
        return Jwts.parser().verifyWith(Keys.hmacShaKeyFor(Base64.getDecoder().decode(hmacSecret)))
                .build().parseSignedClaims(token).getPayload();
    }

    private String generateNewAesKey() { return aesUtil.generateBase64SessionKey(); }

    private Mono<String> generateAndStoreAesKey(String userId) {
        return Mono.fromCallable(this::generateNewAesKey)
                .flatMap(aesKey -> redisTemplate.opsForValue()
                        .set("AES:USR:" + userId, aesKey, Duration.ofSeconds(refreshTokenTtl)).thenReturn(aesKey));
    }

    private Mono<String> fetchAndExtendAesKey(String userId) {
        return redisTemplate.opsForValue().get("AES:USR:" + userId)
                .switchIfEmpty(Mono.defer(() -> Mono.just(generateNewAesKey())))
                .flatMap(aesKey -> redisTemplate.opsForValue()
                        .set("AES:USR:" + userId, aesKey, Duration.ofSeconds(refreshTokenTtl))
                        .thenReturn(aesKey));
    }
}









package com.fincore.gateway.Config;

import com.fincore.commonutilities.jwt.JwtUtil;
import com.fincore.commonutilities.security.DecryptRequestBodyAdvice;
import com.fincore.commonutilities.util.AesEncryptionUtil;
import com.fincore.gateway.Service.TokenSessionValidator;
import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Import;
import org.springframework.http.HttpStatus;
import org.springframework.security.config.Customizer;
import org.springframework.security.config.web.server.SecurityWebFiltersOrder;
import org.springframework.security.config.web.server.ServerHttpSecurity;
import org.springframework.security.core.Authentication;
import org.springframework.security.web.server.SecurityWebFilterChain;
import org.springframework.web.cors.CorsConfiguration;
import org.springframework.web.cors.reactive.CorsConfigurationSource;
import org.springframework.web.cors.reactive.UrlBasedCorsConfigurationSource;
import org.springframework.web.server.ServerWebExchange;
import org.springframework.web.server.WebFilter;
import org.springframework.web.server.WebFilterChain;

import java.util.Arrays;
import java.util.Set;

@Slf4j
@Configuration
@Import({
        JwtUtil.class,
        AesEncryptionUtil.class,
        DecryptRequestBodyAdvice.class
})
public class SecurityConfig {

    // Removed /check-user, ensured start-prod and verify-otp are present
    private static final Set<String> WHITELIST = Set.of(
            "/api/auth/login",
            "/api/auth/verify-otp",
            "/api/auth/resend-otp",
            "/api/auth/logout",
            "/actuator/info",
            "/actuator/health",
            "/api/auth/public-key",
            "/api/auth/start-prod",
            "/api/auth/update-password");
            
    private final TokenSessionValidator tokenSessionValidator;

    public SecurityConfig(TokenSessionValidator tokenSessionValidator) {
        this.tokenSessionValidator = tokenSessionValidator;
    }

    @Bean
    public SecurityWebFilterChain securityWebFilterChain(ServerHttpSecurity http) {
        log.info("Loading SecurityWebFilterChain");
        return http
                .csrf(ServerHttpSecurity.CsrfSpec::disable)
                .headers(headers -> headers
                        .xssProtection(ServerHttpSecurity.HeaderSpec.XssProtectionSpec::disable)
                        .frameOptions(ServerHttpSecurity.HeaderSpec.FrameOptionsSpec::disable)
                        .contentSecurityPolicy(csp -> csp.policyDirectives("default-src 'self'; script-src 'self'; frame-ancestors 'none';"))
                        .contentTypeOptions(Customizer.withDefaults())
                )
                .authorizeExchange(exchanges -> exchanges
                        .pathMatchers("/api/auth/**", "/actuator/**").permitAll()
                        .anyExchange().authenticated() 
                )
                .oauth2ResourceServer(oauth2 -> oauth2.jwt(Customizer.withDefaults()))
                .addFilterBefore(redisValidationFilter(), SecurityWebFiltersOrder.AUTHORIZATION)
                .build();
    }

    @Bean
    public CorsConfigurationSource corsConfigurationSource() {
        CorsConfiguration configuration = new CorsConfiguration();
        configuration.setAllowedOrigins(
                Arrays.asList(
                        "https://fincore-uat.sbi",
                        "https://localhost:1000",
                        "https://fincoreuat.sbi",
                        "https://fincorest.sbi",
                        "https://fincore.sbi"
                )
        );
        configuration.setAllowedMethods(Arrays.asList("GET", "POST", "PUT", "DELETE", "OPTIONS"));
        configuration.setAllowedHeaders(Arrays.asList("Authorization", "Content-Type", "X-Request-Type", "X-Payload-Key"));
        configuration.setExposedHeaders(Arrays.asList("X-Payload-Key")); // AppSec: Allow FE to read the custom header
        configuration.setAllowCredentials(false);

        UrlBasedCorsConfigurationSource source = new UrlBasedCorsConfigurationSource();
        source.registerCorsConfiguration("/**", configuration);
        return source;
    }

    private WebFilter redisValidationFilter() {
        return (ServerWebExchange exchange, WebFilterChain chain) -> {
            String path = exchange.getRequest().getPath().value();

            if (isWhitelisted(path)) {
                return chain.filter(exchange);
            }

            return exchange.getPrincipal().cast(Authentication.class)
                    .flatMap(auth -> tokenSessionValidator.validateWithRedis(auth)
                            .flatMap(validAuth -> {
                                if (validAuth == null) {
                                    exchange.getResponse().setStatusCode(HttpStatus.UNAUTHORIZED);
                                    return exchange.getResponse().setComplete();
                                }
                                return chain.filter(exchange);
                            })
                    )
                    .switchIfEmpty(chain.filter(exchange))
                    .onErrorResume(e -> {
                        exchange.getResponse().setStatusCode(HttpStatus.UNAUTHORIZED);
                        return exchange.getResponse().setComplete();
                    });
        };
    }

    private boolean isWhitelisted(String path) {
        return WHITELIST.contains(path) || path.startsWith("/api/auth/") || path.startsWith("/actuator/");
    }
}



















