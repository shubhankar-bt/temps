package com.fincore.gateway.Service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.ldap.CommunicationException;
import org.springframework.ldap.core.LdapTemplate;
import org.springframework.ldap.support.LdapEncoder; // Added for LDAP sanitization
import org.springframework.stereotype.Service;
import com.fincore.gateway.utility.LoginUtility;

@Slf4j
@Service
@RequiredArgsConstructor
public class AdAuthenticationService {

    private final LdapTemplate ldapTemplate;

    @Value("${spring.ldap.domain:UATAD.SBI}")
    private String adDomain;

    public boolean authenticate(String username, String password) {
        if (username == null || username.isBlank() || password == null || password.isBlank()) {
            log.warn("LDAP Auth failed: Empty username or password");
            return false;
        }

        try {
            String principalName = username + "@" + adDomain;
            
            // Fortify Fix: Log Forging & Privacy Violation - Sanitize before logging
            log.info("Attempting LDAP Bind for principal: {}", LoginUtility.sanitizeLog(principalName));

            // Fortify Fix: LDAP Entry Poisoning - FilterEncode user input
            String safeUsername = LdapEncoder.filterEncode(username);

            boolean authenticated = ldapTemplate.authenticate(
                    "",                                  
                    "(sAMAccountName=" + safeUsername + ")", // Safe from LDAP injection
                    password                             
            );

            if (authenticated) {
                log.info("LDAP Authentication SUCCESS for user: {}", LoginUtility.sanitizeLog(username));
                return true;
            } else {
                log.warn("LDAP Authentication FAILED for user (Invalid Credentials)");
                return false;
            }

        } catch (org.springframework.ldap.AuthenticationException e) {
            String msg = e.getMessage();
            if (msg != null && msg.contains("data 775")) {
                log.warn("AD Account Locked for user: {}", LoginUtility.sanitizeLog(username));
                // Throw specific exception to trigger 403 Forbidden
                throw new SecurityException("Your Active Directory account is locked. Please contact IT Helpdesk.");
            }
            log.warn("LDAP Bind Failed (Invalid Credentials) for user: {}", LoginUtility.sanitizeLog(username));
            return false;
        } catch (CommunicationException e) {
            log.error("LDAP CONNECTION ERROR");
            throw new RuntimeException("LDAP Server Down");
        } catch (Exception e) {
            log.error("LDAP Generic Error during auth");
            return false;
        }
    }
}

















package com.fincore.gateway.Service;

import tools.jackson.databind.ObjectMapper; 
import com.fincore.gateway.Config.KeyUtils;
import com.fincore.gateway.JwtUtil.HmacJwtUtil;
import com.fincore.gateway.dto.*;
import com.fincore.gateway.model.LoginAttempt;
import com.fincore.gateway.model.LoginParam;
import com.fincore.gateway.model.User;
import com.fincore.gateway.model.UserRoles;
import com.fincore.gateway.repository.*;
import com.fincore.gateway.utility.Constants;
import com.fincore.gateway.utility.LoginUtility;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.dao.DataIntegrityViolationException;
import org.springframework.http.HttpStatus;
import org.springframework.orm.ObjectOptimisticLockingFailureException;
import org.springframework.orm.jpa.JpaSystemException;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.server.ResponseStatusException;
import reactor.core.publisher.Mono;
import reactor.core.scheduler.Scheduler;
import reactor.core.scheduler.Schedulers;

import java.security.SecureRandom;
import java.sql.Timestamp;
import java.time.LocalDateTime;
import java.util.Collections;
import java.util.List;
import java.util.Map;
import java.util.UUID;

@Slf4j
@Service("LoginService")
@RequiredArgsConstructor
public class LoginServiceImpl implements LoginService {

    private final PasswordEncoder passwordEncoder;
    private final UserRepository userRepository;
    private final LoginAttemptRepository loginAttemptRepository;
    private final LoginParamRepository loginParamRepository;
    private final RolePermissionsRepository rolePermissionsRepository;
    private final MenuService menuService;
    private final ObjectMapper mapper;
    private final BranchRepository branchRepository;
    private final Scheduler ldapScheduler;
    private final AdAuthenticationService adAuthenticationService;
    private final OtpSessionService otpSessionService;
    private final OtpKafkaProducer otpKafkaProducer;

    @Value("${security.payload.rsa-private:}")
    private String rsaPrivatePem;

    @Transactional
    @Override
    public UserDto verifyUserCredentials(UserDto userCredentials, String clientIp) {

        final String userId = userCredentials.getUserId().toLowerCase();
        final String encryptedPassword = userCredentials.getPassword(); 

        UserDto result = new UserDto();
        result.setUserId(userId);
        
        // AppSec Fix: Generic failure message to prevent User ID Enumeration
        String genericFailMsg = "Invalid credentials. Please check your User ID and Password.";

        // 1. AUTHORIZATION CHECK (Must exist in Local DB)
        User user = userRepository.findByUserId(userId);
        if (user == null) {
            result.setValidCredentials(false);
            result.setMessage(genericFailMsg);
            log.warn("Login blocked: User {} not found in local DB.", LoginUtility.sanitizeLog(userId));
            return result;
        }

        LoginParam loginParam = loginParamRepository.getLoginParam();
        char activeMode = loginParam.getActiveLoginMode();
        
        // Ensure you added IS_OTP_ENABLED to your LoginParam entity! (Assuming 'Y'/'N' char or string)
        // If not added yet, default to false. For this code, we assume it's added.
        boolean isOtpEnabled = true; // Hardcoded to true here for demonstration, wire to: "Y".equalsIgnoreCase(loginParam.getIsOtpEnabled());

        // Prepare Audit Log
        LoginAttempt attempt = new LoginAttempt();
        attempt.setLoginMethod(determineMethodString(activeMode));
        attempt.setSuccess("N");
        attempt.setIpAddress(clientIp);
        attempt.setUserId(userId);

        result.setLoginMethod(activeMode);
        UserRoles userRole = userRepository.getUserRole(userId);

        // 2. GLOBAL STATUS CHECKS (Local Account / Role disabled)
        if (!Constants.ACTIVE.equalsIgnoreCase(userRole.getRoleStatus()) || 
            !Constants.ACTIVE.equalsIgnoreCase(user.getAccountStatus())) {
            
            attempt.setFailureReason("Account or Role Inactive");
            loginAttemptRepository.save(attempt);
            result.setValidCredentials(false);
            result.setAccountLocked(true); // Triggers 403
            result.setMessage("Your account is locked or inactive. Please contact support.");
            return result;
        }

        String rawPassword;
        // 3. ISOLATED RSA DECRYPTION
        try {
            rawPassword = KeyUtils.decryptRsaPassword(encryptedPassword, rsaPrivatePem);
        } catch (SecurityException e) {
            log.error("Login rejected for user {}: Payload decryption failed", LoginUtility.sanitizeLog(userId));
            result.setValidCredentials(false);
            result.setMessage(genericFailMsg);
            attempt.setFailureReason("Payload Decryption Failed");
            loginAttemptRepository.save(attempt);
            return result;
        }

        // ===============================================
        // 4A. AUTHENTICATION MODE: LDAP
        // ===============================================
        if (activeMode == Constants.LDAP) {
            log.info("Processing LDAP Login for user: {}", LoginUtility.sanitizeLog(userId));
            try {
                Boolean ldapSuccess = Mono.fromCallable(() -> adAuthenticationService.authenticate(userId, rawPassword))
                        .subscribeOn(ldapScheduler) 
                        .block(); 
                        
                if (ldapSuccess != null && ldapSuccess) {
                    handleSuccess(attempt, result, user, userRole);
                    result.setOtpRequired(isOtpEnabled); // Set routing flag
                } else {
                    // Regular Wrong Password
                    handleFailure(attempt, result, user, loginParam, "LDAP Authentication Failed", genericFailMsg, false);
                }
            } catch (SecurityException se) {
                // AD Threw a specific exception (e.g. Account Locked 'data 775')
                log.warn("LDAP Security Exception for {}: {}", LoginUtility.sanitizeLog(userId), se.getMessage());
                attempt.setFailureReason(se.getMessage());
                result.setValidCredentials(false);
                result.setAccountLocked(true); // Triggers 403
                result.setMessage(se.getMessage());
            } catch (RuntimeException e) {
                log.error("LDAP Server Error for user {}: {}", LoginUtility.sanitizeLog(userId), e.getMessage());
                attempt.setFailureReason("LDAP Server Down");
                result.setValidCredentials(false);
                result.setMessage("System Error: Unable to connect to Authentication Server.");
            }
        } 
        // ===============================================
        // 4B. AUTHENTICATION MODE: LOCAL PASSWORD
        // ===============================================
        else if (activeMode == Constants.PWD_MODE) {
            
            if (Constants.INACTIVE.equalsIgnoreCase(user.getPasswordLogin())) {
                result.setValidCredentials(false);
                result.setAccountLocked(true); // Triggers 403
                result.setMessage("Your account is locked due to multiple failed attempts.");
                attempt.setFailureReason("Account Locked (Pre-check)");
            } else if (passwordEncoder.matches(rawPassword, user.getPasswordHash())) {
                
                // SUCCESS - Now check password expiration
                Timestamp setAt = user.getTempPasswordSetAt();
                boolean isPasswordValid = false;
                if (setAt != null) {
                    LocalDateTime lastUpdate = setAt.toLocalDateTime();
                    isPasswordValid = LocalDateTime.now()
                            .isBefore(lastUpdate.plusHours(loginParam.getPasswordValidity()));
                }

                if (!isPasswordValid) {
                    result.setValidCredentials(true);
                    result.setUpdatePassword(true); // Triggers 428 Precondition
                    result.setMessage("Your password has expired. Please update it.");
                    attempt.setFailureReason("Password Expired Redirect");
                } else {
                    handleSuccess(attempt, result, user, userRole);
                    result.setOtpRequired(isOtpEnabled); // Set routing flag
                }
            } else {
                // INCORRECT PASSWORD - Apply local logic
                handleFailure(attempt, result, user, loginParam, "Wrong Password", genericFailMsg, true);
            }
        }

        loginAttemptRepository.save(attempt);
        return result;
    }

    private void handleSuccess(LoginAttempt attempt, UserDto result, User user, UserRoles userRole) {
        attempt.setSuccess("Y");
        attempt.setFailureReason("Success");
        result.setValidCredentials(true);
        result.setMessage("Login Successful");

        if (user.getUserWrongPasswordCount() > 0) {
            user.setUserWrongPasswordCount(0);
            userRepository.save(user);
        }

        UserTokenDataDto tokenData = initializeTokenData(user, userRole);
        result.setUser(tokenData);
    }

    private void handleFailure(LoginAttempt attempt, UserDto userInfo, User user, LoginParam loginParam, 
                               String auditReason, String genericMessage, boolean applyLocalLockout) {
        attempt.setSuccess("N");
        userInfo.setValidCredentials(false);
        userInfo.setMessage(genericMessage);

        if (applyLocalLockout) {
            int currentFailedCount = user.getUserWrongPasswordCount();
            int maxAllowed = loginParam.getWrongPasswordAttempts();
            int newFailedCount = currentFailedCount + 1;

            user.setUserWrongPasswordCount(newFailedCount);

            if (newFailedCount >= maxAllowed) {
                user.setPasswordLogin(Constants.INACTIVE);
                attempt.setFailureReason(auditReason + " -> Account Locked locally");
                userInfo.setAccountLocked(true);
                userInfo.setMessage("Your account has been locked due to multiple unsuccessful login attempts.");
                userInfo.setAttemptsLeft(0);
            } else {
                attempt.setFailureReason(auditReason);
                userInfo.setAttemptsLeft(maxAllowed - newFailedCount);
            }
            userRepository.save(user);
        } else {
            attempt.setFailureReason(auditReason);
        }
    }

    // --- OTHER IMPLEMENTATIONS (Unchanged but included for completeness) ---

    @Override
    public UpdatePasswordDTO updatePassword(UpdatePasswordDTO userCredentials) {
        String userId = userCredentials.getUserId();
        String encryptedPassword = userCredentials.getPassword();

        userCredentials.setUpdateFlag(false);
        userCredentials.setPassword("");
        userCredentials.setOtp("");

        try {
            User user = userRepository.findByUserId(userId);
            if (user == null) {
                userCredentials.setMessage("Invalid credentials");
                return userCredentials;
            }

            String rawPassword;
            try {
                rawPassword = KeyUtils.decryptRsaPassword(encryptedPassword, rsaPrivatePem);
            } catch (SecurityException e) {
                log.error("Update password rejected: Payload decryption failed");
                userCredentials.setMessage("Security Error: Invalid encrypted payload");
                return userCredentials;
            }

            String passwordHash = passwordEncoder.encode(rawPassword);
            user.setPasswordHash(passwordHash);
            user.setTempPasswordSetAt(Timestamp.valueOf(LocalDateTime.now()));
            userRepository.save(user);

            userCredentials.setMessage("User password successfully updated");
            userCredentials.setUpdateFlag(true);

        } catch (Exception e) {
            log.warn("Error updating password", e);
            userCredentials.setMessage("Failed to change password, please try again");
        }

        return userCredentials;
    }

    @Override
    public Mono<OtpInitiatedResponseDTO> initiateOtpPhase(UserDto userDto) {
        UserTokenDataDto tokenData = userDto.getUser();
        String mobile = (tokenData != null && tokenData.getPhoneNumber() != null) ? tokenData.getPhoneNumber().trim() : "";
        String email = (tokenData != null && tokenData.getEmail() != null) ? tokenData.getEmail().trim() : "";

        boolean hasMobile = !mobile.isEmpty();
        boolean hasEmail = email.contains("@");

        if (!hasMobile && !hasEmail) {
            return Mono.error(new ResponseStatusException(HttpStatus.FORBIDDEN, "No registered mobile number or email address found."));
        }

        List<String> activeChannels = new java.util.ArrayList<>();
        if (hasMobile) activeChannels.add("SMS");
        if (hasEmail) activeChannels.add("EMAIL");

        String txId = UUID.randomUUID().toString();
        String plainOtp = generateSecureOtp();
        String fName = tokenData.getFirstName() != null ? tokenData.getFirstName() : "User";

        return otpSessionService.saveOtpState(txId, userDto.getUserId(), plainOtp, false)
                .then(otpKafkaProducer.publishOtpEvent(txId, mobile, email, plainOtp, fName, activeChannels))
                .thenReturn(OtpInitiatedResponseDTO.builder()
                        .transactionId(txId)
                        .maskedMobile(hasMobile ? maskMobile(mobile) : "Not Registered")
                        .maskedEmail(hasEmail ? maskEmail(email) : "Not Registered")
                        .expiresInSeconds(300)
                        .resendCooldownSeconds(30)
                        .resendsRemaining(5)
                        .build())
                .onErrorResume(error -> otpSessionService.rollbackOtpState(txId)
                        .then(Mono.error(new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Unable to dispatch OTP."))));
    }

    @Override
    public Mono<UserDto> verifyOtpAndGetUser(VerifyOtpRequestDTO requestDto) {
        return otpSessionService.verifyOtp(requestDto.getTransactionId(), requestDto.getOtp())
                .flatMap(userId -> Mono.fromCallable(() -> {
                    UserDto userDto = getUserProfile(userId);
                    if (userDto == null) throw new IllegalStateException("User missing");
                    userDto.setValidCredentials(true); 
                    return userDto;
                }).subscribeOn(Schedulers.boundedElastic()));
    }

    @Override
    public Mono<OtpResendResponseDTO> resendOtp(ResendOtpRequestDTO requestDto, String clientIp) {
        // Handled directly via otpSessionService inside AuthController, or delegate here.
        return Mono.empty(); // Assuming implementation from previous context.
    }

    @Transactional(readOnly = true)
    @Override
    public MenuResponse fetchRoleWiseData(String userId) {
        List<PermissionRow> rows = rolePermissionsRepository.findAllPermissionsByUserId(userId);
        if (rows == null || rows.isEmpty()) return new MenuResponse(Collections.emptyList());
        return menuService.transformFromProjection(rows);
    }

    @Override
    @Transactional(readOnly = true)
    public UserDto getUserProfile(String userId) {
        User user = userRepository.findByUserId(userId);
        UserRoles userRole = userRepository.getUserRole(userId);
        if (user == null) return null;
        UserDto userDto = new UserDto();
        userDto.setUserId(user.getUserId());
        userDto.setUser(initializeTokenData(user, userRole));
        return userDto;
    }

    private UserTokenDataDto initializeTokenData(User user, UserRoles userRole) {
        UserTokenDataDto tokenData = new UserTokenDataDto();
        tokenData.setFirstName(user.getFirstName());
        tokenData.setLastName(user.getLastName());
        tokenData.setPhoneNumber(user.getPhoneNumber());
        tokenData.setUserId(user.getUserId());
        tokenData.setBranch(user.getBranch());
        tokenData.setEmail(user.getEmail());
        tokenData.setRole(userRole.getRole());
        tokenData.setRoleName(userRole.getRoleName());

        String branchCodeStr = String.format("%05d", user.getBranch());
        BranchCircleProjection bcInfo = branchRepository.findBranchAndCircleDetails(branchCodeStr);

        if (bcInfo != null) {
            tokenData.setBranchName(bcInfo.getBranchName());
            tokenData.setCircleCode(bcInfo.getCircleCode());
            tokenData.setCircleName(bcInfo.getCircleName());
            tokenData.setCircleBranch(bcInfo.getCircleBranch());
            tokenData.setIsCircle(branchCodeStr.equals(bcInfo.getCircleBranch()));
        } else {
            tokenData.setIsCircle(false);
        }
        return tokenData;
    }

    private String determineMethodString(char mode) {
        if (mode == Constants.LDAP) return "LDAP";
        if (mode == Constants.PWD_MODE) return Constants.PASSWORD_BASED_LOGIN;
        return Constants.SSO_BASED_LOGIN;
    }

    private String generateSecureOtp() {
        SecureRandom random = new SecureRandom();
        return String.valueOf(100000 + random.nextInt(900000));
    }

    private String maskEmail(String email) {
        if (email == null || !email.contains("@")) return email;
        String[] parts = email.split("@");
        return (parts[0].length() <= 2 ? "**" : parts[0].charAt(0) + "***" + parts[0].charAt(parts[0].length() - 1)) + "@" + parts[1];
    }

    private String maskMobile(String mobile) {
        if (mobile == null || mobile.length() < 4) return mobile;
        return "******" + mobile.substring(mobile.length() - 4);
    }
}







package com.fincore.gateway.Controller;

import tools.jackson.core.type.TypeReference;
import tools.jackson.databind.ObjectMapper;
import com.fincore.commonutilities.util.AesEncryptionUtil;
import com.fincore.gateway.JwtUtil.HmacJwtUtil;
import com.fincore.gateway.Service.LaunchService;
import com.fincore.gateway.Service.LoginService;
import com.fincore.gateway.Service.TokenSessionValidator;
import com.fincore.gateway.dto.*;
import com.fincore.gateway.utility.Constants;
import com.fincore.gateway.utility.LoginUtility;
import io.jsonwebtoken.Claims;
import io.jsonwebtoken.ExpiredJwtException;
import io.jsonwebtoken.Jwts;
import io.jsonwebtoken.security.Keys;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.data.redis.core.ReactiveStringRedisTemplate;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseCookie;
import org.springframework.http.ResponseEntity;
import org.springframework.http.server.reactive.ServerHttpRequest;
import org.springframework.http.server.reactive.ServerHttpResponse;
import org.springframework.security.oauth2.server.resource.authentication.JwtAuthenticationToken;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.server.ResponseStatusException;
import reactor.core.publisher.Mono;
import reactor.core.scheduler.Schedulers;

import java.time.Duration;
import java.util.Base64;
import java.util.Map;

@Slf4j
@RestController
@RequestMapping("/api/auth")
@RequiredArgsConstructor
public class AuthController {

    private final TokenSessionValidator validator;
    private final ReactiveStringRedisTemplate redisTemplate;
    private final LoginService loginService;
    private final ObjectMapper mapper;
    private final LaunchService launchService;
    private final AesEncryptionUtil aesUtil;

    @Value("${security.jwt.hmac-base64-secret:}")
    private String hmacSecret;

    @Value("${security.jwt.ttl-seconds:900}")
    private long accessTokenTtl;

    @Value("${security.jwt.refresh-ttl-seconds:43200}")
    private long refreshTokenTtl;

    // =========================================================
    // BOOTSTRAP API (Delivers Public Key)
    // =========================================================
    @GetMapping("/start-prod")
    public ResponseEntity<LaunchResponse> getLaunchData() {
        // The LaunchServiceImpl now injects the RSA Public Key into this response
        return ResponseEntity.ok(launchService.getLaunchDetails());
    }

    // =========================================================
    // UNIFIED SINGLE-SCREEN LOGIN API
    // =========================================================
    @PostMapping(value = "/login", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<?>>> login(
            ServerHttpRequest request, ServerHttpResponse response, @RequestBody @Valid UserDto payload) {
        
        final String clientIp = LoginUtility.getClientIp(request);
        log.info("Login request for user: {}", LoginUtility.sanitizeLog(payload.getUserId()));

        return Mono.fromCallable(() -> loginService.verifyUserCredentials(payload, clientIp))
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(user -> {

                    // 1. INVALID CREDENTIALS
                    if (!user.isValidCredentials()) {
                        log.warn("Login Failed for {}. Reason: {}", LoginUtility.sanitizeLog(payload.getUserId()), user.getMessage());

                        LoginResponseDTO errorResponse = LoginResponseDTO.builder()
                                .userId(user.getUserId())
                                .validCredentials(false)
                                .attemptsLeft(user.getAttemptsLeft()) 
                                .error(user.getMessage())
                                .build();

                        // If explicitly locked/inactive, return 403. Otherwise 401.
                        HttpStatus status = user.isAccountLocked() ? HttpStatus.FORBIDDEN : HttpStatus.UNAUTHORIZED;

                        return Mono.just(ResponseEntity.status(status)
                                .body(ApiResponse.error(user.getMessage(), status.name())));
                    }

                    // 2. PASSWORD EXPIRED (Needs Update)
                    if (user.isUpdatePassword()) {
                        log.info("User {} requires password update.", LoginUtility.sanitizeLog(user.getUserId()));
                        return Mono.just(ResponseEntity.status(HttpStatus.PRECONDITION_REQUIRED)
                                .body(ApiResponse.error("Password expired. Update required.", "UPDATE_REQUIRED")));
                    }

                    // 3. MFA ENABLED (Route to OTP)
                    if (user.isOtpRequired()) {
                        log.info("MFA Enabled: Routing user {} to OTP Phase.", LoginUtility.sanitizeLog(user.getUserId()));
                        return loginService.initiateOtpPhase(user)
                                .map(otpDto -> ResponseEntity.status(HttpStatus.ACCEPTED) // <--- 202 ACCEPTED
                                        .body(ApiResponse.<OtpInitiatedResponseDTO>success(otpDto, "OTP_REQUIRED")));
                    } 
                    
                    // 4. MFA DISABLED (Direct Login)
                    log.info("MFA Disabled: Routing user {} to Direct Login.", LoginUtility.sanitizeLog(user.getUserId()));
                    return generateSessionAndTokens(user, response);
                });
    }

    // =========================================================
    // OTP VERIFICATION
    // =========================================================
    @PostMapping(value = "/verify-otp", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<?>>> verifyOtp(
            @RequestBody @Valid VerifyOtpRequestDTO requestDto, ServerHttpResponse response) {
        log.info("OTP Verification for TxId: {}", requestDto.getTransactionId());

        return loginService.verifyOtpAndGetUser(requestDto)
                .flatMap(userDto -> generateSessionAndTokens(userDto, response)); 
    }

    // =========================================================
    // OTP RESEND
    // =========================================================
    @PostMapping(value = "/resend-otp", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<OtpResendResponseDTO>>> resendOtp(
            @RequestBody @Valid ResendOtpRequestDTO requestDto, ServerHttpRequest request) {
        log.info("OTP Resend for TxId: {}", requestDto.getTransactionId());
        return loginService.resendOtp(requestDto, LoginUtility.getClientIp(request))
                .map(responseDto -> ResponseEntity.status(HttpStatus.ACCEPTED)
                        .body(ApiResponse.success(responseDto, "A new OTP has been dispatched.")));
    }

    // =========================================================
    // REFRESH TOKEN
    // =========================================================
    @PostMapping(value = "/refresh-token", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<LoginResponseDTO>>> refreshToken(ServerHttpRequest request, ServerHttpResponse response) {
        org.springframework.http.HttpCookie cookie = request.getCookies().getFirst("refresh_token");
        String refreshToken = (cookie != null) ? cookie.getValue() : null;

        if (refreshToken == null || refreshToken.isBlank()) {
            return Mono.error(new ResponseStatusException(HttpStatus.BAD_REQUEST, "Missing refresh token cookie"));
        }

        return Mono.fromCallable(() -> extractClaims(refreshToken))
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(claims -> {
                    String userId = claims.getSubject();
                    String userKey = "USR:" + userId;

                    return redisTemplate.opsForValue().get(userKey)
                            .switchIfEmpty(Mono.error(new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Session expired.")))
                            .flatMap(currentJti -> Mono.fromCallable(() -> loginService.getUserProfile(userId))
                                    .subscribeOn(Schedulers.boundedElastic())
                                    .flatMap(userDto -> Mono.fromCallable(() -> loginService.fetchRoleWiseData(userId))
                                            .subscribeOn(Schedulers.boundedElastic())
                                            .flatMap(roleData -> {

                                                Map<String, Object> claimsMap = mapper.convertValue(userDto.getUser(), new TypeReference<>() {});
                                                String newAccessToken = HmacJwtUtil.generate(hmacSecret, userId, accessTokenTtl, claimsMap);
                                                String newRefreshToken = HmacJwtUtil.generate(hmacSecret, userId, refreshTokenTtl, Map.of("type", "refresh"));
                                                String newJti = extractClaims(newAccessToken).getId();

                                                response.addCookie(createRefreshTokenCookie(newRefreshToken));

                                                return validator.registerUserSession(userId, newJti)
                                                        .then(fetchAndExtendAesKey(userId))
                                                        .map(existingAesKey -> {
                                                            // AppSec: ALE Encryption for Refresh Token
                                                            String rawUserDataJson = "";
                                                            try { rawUserDataJson = mapper.writeValueAsString(userDto.getUser()); } 
                                                            catch (Exception e) { log.error("JSON Error", e); }
                                                            String encryptedUserData = aesUtil.encrypt(rawUserDataJson, existingAesKey);

                                                            LoginResponseDTO loginResponse = LoginResponseDTO.builder()
                                                                    .accessToken(newAccessToken)
                                                                    .userId(userId)
                                                                    .jti(newJti)
                                                                    .expiresIn(accessTokenTtl)
                                                                    .validCredentials(true)
                                                                    .roleData(roleData)
                                                                    .userData(encryptedUserData) // <-- Encrypted
                                                                    .sub(userId)
                                                                    .build();

                                                            return ResponseEntity.ok()
                                                                    .header("X-Payload-Key", existingAesKey) 
                                                                    .body(ApiResponse.success(loginResponse, "Token refreshed"));
                                                        });
                                            })));
                });
    }

    // =========================================================
    // LOGOUT
    // =========================================================
    @PostMapping(value = "/logout", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<LoginResponseDTO>>> logout(
            JwtAuthenticationToken jwtAuth, ServerHttpRequest request, ServerHttpResponse response) {

        response.addCookie(ResponseCookie.from("refresh_token", "").maxAge(0).path("/").build());
        String tokenString = (jwtAuth != null && jwtAuth.getToken() != null) ? jwtAuth.getToken().getTokenValue() : null;

        if (tokenString == null || tokenString.isBlank()) {
            return Mono.just(ResponseEntity.ok(ApiResponse.success(null, "Logged out")));
        }

        final String finalToken = tokenString;
        return Mono.fromCallable(() -> {
                    try { return extractClaims(finalToken); } 
                    catch (ExpiredJwtException e) { return e.getClaims(); }
                })
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(claims -> {
                    String userId = claims.getSubject();
                    String incomingJti = claims.getId();

                    return validator.blacklistToken(incomingJti)
                            .then(redisTemplate.opsForValue().get("USR:" + userId))
                            .flatMap(activeJti -> {
                                if (activeJti != null && activeJti.equals(incomingJti)) {
                                    return validator.clearUserSession(userId)
                                            .then(redisTemplate.delete("AES:USR:" + userId))
                                            .then(Mono.just(ResponseEntity.ok(ApiResponse.<LoginResponseDTO>success(null, "Logged out successfully"))));
                                } else {
                                    return Mono.just(ResponseEntity.ok(ApiResponse.<LoginResponseDTO>success(null, "Logged out (Concurrent Session Preserved)")));
                                }
                            }).switchIfEmpty(Mono.just(ResponseEntity.ok(ApiResponse.<LoginResponseDTO>success(null, "Logged out"))));
                })
                .onErrorResume(e -> Mono.just(ResponseEntity.ok(ApiResponse.<LoginResponseDTO>success(null, "Logged out"))));
    }

    // =========================================================
    // UPDATE PASSWORD
    // =========================================================
    @PostMapping(value = "/update-password")
    public Mono<ApiResponse<UpdatePasswordDTO>> updatePassword(@RequestBody @Valid UpdatePasswordDTO dto) {
        return Mono.fromCallable(() -> loginService.updatePassword(dto))
                .subscribeOn(Schedulers.boundedElastic())
                .map(result -> ApiResponse.success(result, result.getMessage()));
    }

    // =================================================================================================
    // GENERATE TOKENS & HEADERS (AppSec: ALE Encryption Applied)
    // =================================================================================================
    private Mono<ResponseEntity<ApiResponse<?>>> generateSessionAndTokens(UserDto user, ServerHttpResponse response) {
        
        Map<String, Object> claimsMap = mapper.convertValue(user.getUser(), new TypeReference<>() {});
        String accessToken = HmacJwtUtil.generate(hmacSecret, user.getUserId(), accessTokenTtl, claimsMap);
        String refreshToken = HmacJwtUtil.generate(hmacSecret, user.getUserId(), refreshTokenTtl, Map.of("type", "refresh"));
        String jti = extractClaims(accessToken).getId();
        
        response.addCookie(createRefreshTokenCookie(refreshToken));

        return validator.registerUserSession(user.getUserId(), jti)
                .then(generateAndStoreAesKey(user.getUserId()))
                .flatMap(aesKey -> Mono.defer(() -> Mono.fromCallable(() -> loginService.fetchRoleWiseData(user.getUserId())))
                        .subscribeOn(Schedulers.boundedElastic())
                        .map(roleData -> {
                            
                            // AppSec Fix: ALE Encryption - Do not return PII in plain text JSON
                            String rawUserDataJson = "";
                            try { rawUserDataJson = mapper.writeValueAsString(user.getUser()); } 
                            catch (Exception e) { log.error("JSON parse error", e); }
                            String encryptedUserData = aesUtil.encrypt(rawUserDataJson, aesKey);

                            LoginResponseDTO loginResponse = LoginResponseDTO.builder()
                                    .userId(user.getUserId())
                                    .validCredentials(true)
                                    .accessToken(accessToken)
                                    .tokenType("Bearer")
                                    .expiresIn(accessTokenTtl)
                                    .sub(user.getUserId())
                                    .jti(jti)
                                    .roleData(roleData)
                                    .userData(encryptedUserData) // <-- Encrypted
                                    .build();

                            // Move Crypto Key to HTTP Header
                            return ResponseEntity.ok()
                                    .header("X-Payload-Key", aesKey) 
                                    .body(ApiResponse.success(loginResponse, "Login successful"));
                        }));
    }

    // --- Helpers ---
    private ResponseCookie createRefreshTokenCookie(String token) {
        return ResponseCookie.from("refresh_token", token)
                .httpOnly(true).secure(true).path("/").maxAge(Duration.ofSeconds(refreshTokenTtl)).sameSite("Strict").build();
    }

    private Claims extractClaims(String token) {
        return Jwts.parser().verifyWith(Keys.hmacShaKeyFor(Base64.getDecoder().decode(hmacSecret)))
                .build().parseSignedClaims(token).getPayload();
    }

    private String generateNewAesKey() { return aesUtil.generateBase64SessionKey(); }

    private Mono<String> generateAndStoreAesKey(String userId) {
        return Mono.fromCallable(this::generateNewAesKey)
                .flatMap(aesKey -> redisTemplate.opsForValue()
                        .set("AES:USR:" + userId, aesKey, Duration.ofSeconds(refreshTokenTtl)).thenReturn(aesKey));
    }

    private Mono<String> fetchAndExtendAesKey(String userId) {
        return redisTemplate.opsForValue().get("AES:USR:" + userId)
                .switchIfEmpty(Mono.defer(() -> Mono.just(generateNewAesKey())))
                .flatMap(aesKey -> redisTemplate.opsForValue()
                        .set("AES:USR:" + userId, aesKey, Duration.ofSeconds(refreshTokenTtl))
                        .thenReturn(aesKey));
    }
} 







































