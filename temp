package com.fincore.CommunicationService.client;

import com.fincore.CommunicationService.exception.CommunicationExceptions.VendorDeliveryException;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.core.io.Resource;
import org.springframework.http.HttpStatusCode;
import org.springframework.http.MediaType;
import org.springframework.http.StreamingHttpOutputMessage;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestClient;
import org.springframework.web.client.RestClientException;
import tools.jackson.core.JacksonException;
import tools.jackson.core.JsonEncoding;
import tools.jackson.core.JsonGenerator;
import tools.jackson.core.ObjectWriteContext;
import tools.jackson.core.json.JsonFactory;

import java.io.*;
import java.util.List;
import java.util.Map;
import java.util.UUID;

/**
 * <p>Email Vendor Gateway.</p>
 *
 * @since 2026-08-04
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class EmailGatewayClient {

    private final RestClient restClient;
    private final JsonFactory jsonFactory = JsonFactory.builder().build();

    /**
     * Streams the email and optional attachment to the vendor.
     */
    public int sendEmail(Map<String, Object> emailRequest, Resource attachment) {
        try {
            String apiUrl = (String) emailRequest.get("url");
            String apiKey = (String) emailRequest.get("api_key");

            //execute non blocking request
            HttpStatusCode status = restClient.post()
                    .uri(apiUrl)
                    .header("api_key", apiKey)
                    .contentType(MediaType.APPLICATION_JSON)
                    .body(buildBody(emailRequest,attachment))
                    .retrieve()
                    .toBodilessEntity()
                    .getStatusCode();

            int responseCode = status.value();
            log.info("Vendor Email API responded with HTTP {}", responseCode);

            return responseCode;

        } catch (JacksonException e) {
            log.error("JSON Streaming failed: {}", e.getMessage());
            throw new RuntimeException(e.getMessage());
        } catch (RestClientException e) {
            log.error("Network I/O Exception calling Email Vendor API: {}", e.getMessage());
            throw new VendorDeliveryException("Network communication with Email Vendor failed", e);
        }
    }

    /**
     * V1021256
     * Chunked JSON constructor for streaming request payload.
     */
    private StreamingHttpOutputMessage.Body buildBody(Map<String, Object> emailRequest, Resource attachment) throws JacksonException {
        return outputStream -> {
            try (JsonGenerator jsonGenerator = jsonFactory.createGenerator(ObjectWriteContext.empty(), outputStream, JsonEncoding.UTF8);
            ) {
                // --- "JSON START" ---
                jsonGenerator.writeStartObject();

                // --- "from" ---
                jsonGenerator.writeObjectPropertyStart("from");
                jsonGenerator.writeStringProperty("email", (String) emailRequest.get("senderId"));
                jsonGenerator.writeStringProperty("name", "FINCORE");
                jsonGenerator.writeEndObject();

                // --- "subject" ---
                jsonGenerator.writeStringProperty("subject", (String) emailRequest.get("subject"));

                // --- "content" ---
                jsonGenerator.writeName("content");
                jsonGenerator.writeStartArray();
                jsonGenerator.writeStartObject();
                jsonGenerator.writeStringProperty("type", "html");
                jsonGenerator.writeStringProperty("value", (String) emailRequest.get("emailBody"));
                jsonGenerator.writeEndObject();
                jsonGenerator.writeEndArray();

                // --- "personalizations" ---
                jsonGenerator.writeName("personalizations");
                jsonGenerator.writeStartArray();
                jsonGenerator.writeStartObject();

                if (emailRequest.containsKey("toEmail")) {
                    jsonGenerator.writeName("to");
                    jsonGenerator.writeStartArray();
                    jsonGenerator.writeStartObject();
                    jsonGenerator.writeStringProperty("email", (String) emailRequest.get("toEmail"));
                    jsonGenerator.writeEndObject();
                    jsonGenerator.writeEndArray();
                }

                if (emailRequest.containsKey("bccEmails")) {
                    @SuppressWarnings("unchecked")
                    List<String> bccEmails = (List<String>) emailRequest.get("bccEmails");
                    jsonGenerator.writeName("bcc");
                    jsonGenerator.writeStartArray();
                    for (String email : bccEmails) {
                        jsonGenerator.writeStartObject();
                        jsonGenerator.writeStringProperty("email", email);
                        jsonGenerator.writeEndObject();
                    }
                    jsonGenerator.writeEndArray();
                }

                if (emailRequest.containsKey("ccToEmail")) {
                    jsonGenerator.writeName("cc");
                    jsonGenerator.writeStartArray();
                    jsonGenerator.writeStartObject();
                    jsonGenerator.writeStringProperty("email", (String) emailRequest.get("ccToEmail"));
                    jsonGenerator.writeEndObject();
                    jsonGenerator.writeEndArray();
                }
                jsonGenerator.writeEndObject(); // personalizations[0]
                jsonGenerator.writeEndArray();  // personalizations

                // --- "settings" ---
                jsonGenerator.writeObjectPropertyStart("settings");
                jsonGenerator.writeBooleanProperty("open_track", true);
                jsonGenerator.writeBooleanProperty("click_track", true);
                jsonGenerator.writeBooleanProperty("unsubscribe_track", true);
                jsonGenerator.writeEndObject();

                // --- "attachments" ---
                if (attachment != null) {
                    InputStream fileInputStream = attachment.getInputStream();
                    jsonGenerator.writeName("attachments");
                    jsonGenerator.writeStartArray();
                    jsonGenerator.writeStartObject();
                    jsonGenerator.writeStringProperty("name","attachment_" + UUID.randomUUID().toString() + ".zip");
                    jsonGenerator.writeName("content");
                    jsonGenerator.writeBinary(fileInputStream, -1); // streams base64 in chunks
                    jsonGenerator.writeEndObject();
                    jsonGenerator.writeEndArray();
                    fileInputStream.close();
                }

                // --- "JSON END" ---
                jsonGenerator.writeEndObject();
                jsonGenerator.flush();
            }
        };
    }


}









package com.fincore.CommunicationService.client;

import com.fincore.CommunicationService.dto.SmsResponseDTO;
import com.fincore.CommunicationService.model.FincoreSettings;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Component;
import org.springframework.util.LinkedMultiValueMap;
import org.springframework.util.MultiValueMap;
import org.springframework.web.client.RestClient;
import org.springframework.web.client.RestClientException;

import java.nio.charset.StandardCharsets;
import java.util.Base64;

/**
 * <p>SMS Vendor Gateway.</p>
 *

 * @since 2026-08-04
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class SmsGatewayClient {

    private final RestClient restClient;

    public SmsResponseDTO sendSms(FincoreSettings config, String mobileNumber, String message) {
        try {
            log.info("Sending SMS to ******{}", mobileNumber.substring(Math.max(mobileNumber.length() - 4, 0)));

            // 1. Build Basic Auth Header safely
            String authHeader = null;
            if (config.getUsername() != null && config.getPassword() != null) {
                String auth = config.getUsername() + ":" + config.getPassword();
                authHeader = "Basic " + Base64.getEncoder().encodeToString(auth.getBytes(StandardCharsets.UTF_8));
            }

            // 2. Build x-www-form-urlencoded Body
            MultiValueMap<String, String> formData = new LinkedMultiValueMap<>();
            formData.add("content_type", "text");
            formData.add("sender_id", config.getSenderId());
            formData.add("mobile", "0" + mobileNumber);
            formData.add("message", message);
            formData.add("intflag", "0");
            formData.add("charging", "0");

            // 3. Execute Request Builder
            var requestSpec = restClient.post()
                    .uri(config.getUrl())
                    .contentType(MediaType.APPLICATION_FORM_URLENCODED)
                    .accept(MediaType.APPLICATION_FORM_URLENCODED)
                    .body(formData);

            if (authHeader != null) {
                requestSpec.header(HttpHeaders.AUTHORIZATION, authHeader);
            }

            // 4. Retrieve Response
            ResponseEntity<String> response = requestSpec.retrieve().toEntity(String.class);

            int responseCode = response.getStatusCode().value();
            String responseBody = response.getBody() != null ? response.getBody() : "";

            log.info("SMS Response Code : {}", responseCode);
            log.debug("SMS Provider Response : {}", responseBody);

            boolean success = (responseCode >= 200 && responseCode < 300) && responseBody.contains("MESSAGE_SUBMIT_SUCCESS");

            return SmsResponseDTO.builder()
                    .success(success)
                    .message(success ? "SMS Sent Successfully" : "SMS Sending Failed")
                    .providerResponse(responseBody)
                    .build();

        } catch (RestClientException ex) {
            log.error("Network Exception while sending SMS: {}", ex.getMessage());
            return SmsResponseDTO.builder()
                    .success(false)
                    .message("Network exception occurred!")
                    .build();
        }
    }
}








package com.fincore.CommunicationService.config;

import com.github.benmanes.caffeine.cache.Caffeine;
import org.springframework.cache.CacheManager;
import org.springframework.cache.annotation.EnableCaching;
import org.springframework.cache.caffeine.CaffeineCacheManager;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import java.util.concurrent.TimeUnit;

/**
 * Caching Configuration for Communication Service.
 * Implements a High-Speed L1 (In-Memory) Cache using Caffeine.
 */
@EnableCaching
@Configuration
public class CacheConfig {

    @Bean
    public CacheManager cacheManager() {
        CaffeineCacheManager cacheManager = new CaffeineCacheManager();

        cacheManager.setCaffeine(Caffeine.newBuilder()
                // Evict entries 12 hours after they were written to the cache
                .expireAfterWrite(12, TimeUnit.HOURS)
                // Prevent memory leaks by capping the maximum number of cached templates
                .maximumSize(1000)
                // Record stats for APM (e.g., Datadog/Prometheus) tracking cache hit ratios
                .recordStats());

        return cacheManager;
    }
}












package com.fincore.CommunicationService.config;

import com.fincore.CommunicationService.subscriber.CacheSyncSubscriber;
import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.data.redis.connection.RedisConnectionFactory;
import org.springframework.data.redis.listener.ChannelTopic;
import org.springframework.data.redis.listener.RedisMessageListenerContainer;
import org.springframework.data.redis.listener.adapter.MessageListenerAdapter;

/**
 * <p>Distributed Cache Synchronization Configuration.</p>
 *
 * <p><b>Architectural Context:</b>
 * This configuration establishes a Redis Pub/Sub subscriber that listens for invalidation events.
 * When a business user updates a template, an event is published here, causing all Kubernetes pods
 * to instantly flush their local L1 caches simultaneously.</p>
 *
 * @since 2026-07
 */
@Slf4j
@Configuration
public class CacheSyncConfig {

    public static final String CACHE_EVICT_TOPIC = "fincore_cache_evict_topic";

    @Bean
    public ChannelTopic cacheEvictTopic() {
        return new ChannelTopic(CACHE_EVICT_TOPIC);
    }

    /**
     * Creates the container that binds the Redis connection directly to our native listener.
     */
    @Bean
    public RedisMessageListenerContainer redisContainer(
            RedisConnectionFactory connectionFactory,
            CacheSyncSubscriber cacheSyncSubscriber) {
        log.info("Initializing Redis Pub/Sub Container for Distributed Cache Synchronization.");

        RedisMessageListenerContainer container = new RedisMessageListenerContainer();
        container.setConnectionFactory(connectionFactory);
        container.addMessageListener(cacheSyncSubscriber, cacheEvictTopic());

        return container;
    }
}







package com.fincore.CommunicationService.config;

import org.apache.kafka.clients.consumer.ConsumerConfig;
import org.apache.kafka.common.serialization.StringDeserializer;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.kafka.annotation.EnableKafka;
import org.springframework.kafka.config.ConcurrentKafkaListenerContainerFactory;
import org.springframework.kafka.core.DefaultKafkaConsumerFactory;
import org.springframework.kafka.listener.ContainerProperties;

import java.util.HashMap;
import java.util.Map;

@EnableKafka
@Configuration
public class KafkaConsumerConfig {

    @Value("${spring.kafka.consumer.bootstrap-servers}")
    private String bootstrapServers;

    @Bean
    public DefaultKafkaConsumerFactory<String, String> stringConsumerFactory() {
        Map<String, Object> props = new HashMap<>();
        props.put(ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, bootstrapServers);
        props.put(ConsumerConfig.AUTO_OFFSET_RESET_CONFIG, "earliest");
        props.put(ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class);
        props.put(ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class);
        return new DefaultKafkaConsumerFactory<>(props);
    }

    /**
     * THE BULKHEAD: Dedicated Thread Pool for Tier-0 OTPs.
     * Prevents End-of-Day PDF emails from starving the OTP pipeline.
     */
    @Bean("priorityOtpContainerFactory")
    public ConcurrentKafkaListenerContainerFactory<String, String> priorityOtpContainerFactory() {
        ConcurrentKafkaListenerContainerFactory<String, String> factory = new ConcurrentKafkaListenerContainerFactory<>();
        factory.setConsumerFactory(stringConsumerFactory());
        // Match this concurrency to the number of partitions on
        // 'fincore.auth.otp.priority' (e.g., 10-20)
        factory.setConcurrency(10);
        // Strict Manual Acknowledgment. We only ACK when the SMS/Email is securely
        // handed to the Vendor.
        factory.getContainerProperties().setAckMode(ContainerProperties.AckMode.MANUAL_IMMEDIATE);
        // We set the poll interval high enough to outlast the Resilience4j max timeout.
        factory.getContainerProperties().setPollTimeout(3000);

        return factory;
    }

    /**
     * Dedicated Kafka Listener Container for Generic Communication Events.
     *
     * Supports bulk communication processing independently
     * from the Priority OTP pipeline.
     */
    @Bean("genericCommunicationContainerFactory")
    public ConcurrentKafkaListenerContainerFactory<String, String> genericCommunicationContainerFactory() {

        ConcurrentKafkaListenerContainerFactory<String, String> factory = new ConcurrentKafkaListenerContainerFactory<>();

        factory.setConsumerFactory(stringConsumerFactory());

        /*
         * Configure according to the number of partitions
         * on fincore.communication.generic topic.
         */
        factory.setConcurrency(5);

        /*
         * Manual acknowledgement.
         */
        factory.getContainerProperties()
                .setAckMode(ContainerProperties.AckMode.MANUAL_IMMEDIATE);

        /*
         * Poll timeout.
         */
        factory.getContainerProperties()
                .setPollTimeout(3000);

        return factory;
    }
}






package com.fincore.CommunicationService.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.client.JdkClientHttpRequestFactory;
import org.springframework.web.client.RestClient;

import javax.net.ssl.SSLContext;
import javax.net.ssl.TrustManager;
import javax.net.ssl.X509TrustManager;
import java.net.http.HttpClient;
import java.security.SecureRandom;
import java.security.cert.X509Certificate;
import java.time.Duration;

/**
 * <p>Centralized HTTP Configuration for Virtual Thread Native I/O.</p>
 *
 * <p><b>Architectural Context:</b>
 * Utilizes Java's native {@link HttpClient} via {@link JdkClientHttpRequestFactory}.
 * This specific combination ensures that blocking network calls are seamlessly intercepted
 * by Java 21, parking the Virtual Thread without pinning the OS carrier thread.</p>
 *
 * @since 2026-07
 */
@Slf4j
@Configuration
public class RestClientConfig {

    @Value("${app.preIpString:UAT}")
    private String environment;

    @Bean
    public RestClient restClient(RestClient.Builder builder) {
        log.info("Initializing Virtual-Thread Optimized RestClient.");

        HttpClient.Builder httpClientBuilder = HttpClient.newBuilder()
                .connectTimeout(Duration.ofSeconds(3));

        if (!"PROD".equalsIgnoreCase(environment)) {
            log.warn("SECURITY OVERRIDE: Bypassing SSL Verification for environment [{}]", environment);
            httpClientBuilder.sslContext(insecureSslContext());
        }

        JdkClientHttpRequestFactory factory = new JdkClientHttpRequestFactory(httpClientBuilder.build());
        factory.setReadTimeout(Duration.ofSeconds(3));

        return builder
                .requestFactory(factory)
                .build();
    }

    /**
     * Generates a TrustManager that accepts all certificates (For UAT/DEV only).
     */
    private SSLContext insecureSslContext() {
        try {
            TrustManager[] trustAllCerts = new TrustManager[]{
                    new X509TrustManager() {
                        public X509Certificate[] getAcceptedIssuers() { return null; }
                        public void checkClientTrusted(X509Certificate[] certs, String authType) {}
                        public void checkServerTrusted(X509Certificate[] certs, String authType) {}
                    }
            };
            SSLContext sc = SSLContext.getInstance("TLS");
            sc.init(null, trustAllCerts, new SecureRandom());
            return sc;
        } catch (Exception e) {
            log.error("Failed to initialize insecure SSL context", e);
            throw new RuntimeException(e);
        }
    }
}






