import reactor.util.function.Tuples;

import java.time.Duration;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * ============================================================================
 * OTP LIFECYCLE & REDIS STATE ENGINE PLAN (UPDATED PER PHASE 3 MFA DOC)
 * ============================================================================
 * OTP Validity               : 5 min (Section 2.2.7)
 * OTP Screen Idle Timeout    : 15 min (Section 2.2.9)
 * Max Wrong Attempts         : 5 (Section 2.2.6)
 * Resend Cooldown            : 60 sec (Section 2.2.5)
 * Max Resend Count           : 3 within a 10-minute window (Section 2.2.5)
 * Lock Type                  : OTP Code Expiration (NOT AD/LDAP Account Lock)
 * OTP Regeneration           : New OTP every resend + resets attempt counter
 * Previous OTP Valid         : No (Overwritten in Redis)
 * Rate Limit Scope           : IP Address (To prevent SMS Toll Fraud)
 * <p>
 * REDIS KEYS PER TRANSACTION (txId):
 * 1. OTP_SESSION:{txId}  -> userId (TTL: 15m - Tracks overall OTP screen idle timeout)
 * 2. OTP_TX:{txId}       -> { "userId": "...", "otpHash": "..." } (TTL: 5m - Active code)
 * 3. OTP_FAILURES:{txId} -> Integer count (TTL: 5m)
 * 4. OTP_RESENDS:{txId}  -> Integer count (TTL: 10m window)
 * 5. OTP_COOLDOWN:{txId} -> "locked" (TTL: 60s)
 * 6. RATE_LIMIT:OTP_REQ:IP:{ip} -> Integer count (TTL: 1h)
 * ============================================================================
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class OtpSessionService {

    private static final Duration OTP_VALIDITY = Duration.ofMinutes(5);
    private static final Duration SESSION_IDLE_TIMEOUT = Duration.ofMinutes(15);
    private static final Duration RESEND_WINDOW = Duration.ofMinutes(10);
    private static final Duration COOLDOWN = Duration.ofSeconds(60);
    private static final int MAX_RESENDS = 3;
    private static final int MAX_FAILURES = 5;
    private static final int MAX_HOURLY_IP_REQUESTS = 50;

    private final ReactiveStringRedisTemplate redis;
    private final PasswordEncoder passwordEncoder;
    private final ObjectMapper mapper;

    /**
     * Rate limits OTP requests by IP to prevent API abuse and SMS Toll Fraud.
     */
    public Mono<Void> checkIpRateLimit(String clientIp) {
        String key = "RATE_LIMIT:OTP_REQ:IP:" + clientIp;
        return redis.opsForValue().increment(key)
                .flatMap(count -> {
                    if (count == 1) {
                        return redis.expire(key, Duration.ofHours(1)).then();
                    } else if (count > MAX_HOURLY_IP_REQUESTS) {
                        log.warn("SECURITY ALERT: IP {} exceeded hourly OTP limit.", LoginUtility.sanitizeLog(clientIp));
                        return Mono.error(new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS, "Maximum resend limit reached. Kindly Wait."));
                    }
                    return Mono.empty();
                });
    }

    /**
     * Initializes or Updates the OTP state in Redis atomically.
     */
    public Mono<Void> saveOtpState(String txId, String userId, String plainOtp, boolean isResend) {
        String hash = passwordEncoder.encode(plainOtp);

        try {
            String payload = mapper.writeValueAsString(Map.of("userId", userId, "otpHash", hash));
            List<Mono<?>> operations = new ArrayList<>();

            // 1. Overall 15-Minute OTP Screen Session Tracker (Section 2.2.9)
            operations.add(redis.opsForValue().set("OTP_SESSION:" + txId, userId, SESSION_IDLE_TIMEOUT));

            // 2. Core Transaction / Active Code (Overwrites old OTP if resend, 5-min TTL per Section 2.2.7)
            operations.add(redis.opsForValue().set("OTP_TX:" + txId, payload, OTP_VALIDITY));

            // 3. Always reset failures on a fresh OTP dispatch or resend (Section 2.2.5)
            operations.add(redis.opsForValue().set("OTP_FAILURES:" + txId, "0", OTP_VALIDITY));

            if (!isResend) {
                // First generation: Initialize resend counter for the 10-minute window (Section 2.2.5)
                operations.add(redis.opsForValue().set("OTP_RESENDS:" + txId, "0", RESEND_WINDOW));
                // Lock the 60-second cooldown on the very first OTP dispatch
                operations.add(redis.opsForValue().set("OTP_COOLDOWN:" + txId, "locked", COOLDOWN));
            }

            return Mono.when(operations)
                    .doOnSuccess(v -> log.info("Saved OTP State txId={} for user={} isResend={}",
                            LoginUtility.sanitizeLog(txId), LoginUtility.sanitizeLog(userId), isResend));

        } catch (JacksonException e) {
            return Mono.error(new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to process internal OTP payload"));
        }
    }

    /**
     * Safely executes an OTP Resend, enforcing the 15-minute session timeout,
     * 60-second cooldown, and maximum 3 resends per 10-minute window.
     * Returns Tuple3 of (NewPlainOtp, UserId, ResendCount).
     */
    public Mono<reactor.util.function.Tuple3<String, String, Long>> processResend(String txId, String newPlainOtp) {
        String sessionKey = "OTP_SESSION:" + txId;
        String cooldownKey = "OTP_COOLDOWN:" + txId;
        String resendKey = "OTP_RESENDS:" + txId;

        // 1. Check 15-Minute OTP Entry Screen Timeout first (Section 2.2.9)
        return redis.opsForValue().get(sessionKey)
                .switchIfEmpty(Mono.error(new ResponseStatusException(
                        HttpStatus.UNAUTHORIZED,
                        "Your session has timed out. Please log in again."
                )))
                .flatMap(userId ->
                        // 2. Check 60-Second Cooldown Lock (Section 2.2.5 & 2.4)
                        redis.opsForValue().setIfAbsent(cooldownKey, "locked", COOLDOWN)
                                .flatMap(acquired -> {
                                    if (!Boolean.TRUE.equals(acquired)) {
                                        return redis.getExpire(cooldownKey)
                                                .flatMap(ttl -> {
                                                    long secondsLeft = Math.max(1, ttl.getSeconds());
                                                    return Mono.error(new ResponseStatusException(
                                                            HttpStatus.TOO_MANY_REQUESTS,
                                                            "Please wait " + secondsLeft + " seconds before requesting another code."
                                                    ));
                                                });
                                    }

                                    // 3. Atomic Increment Resends within 10-Minute Window (Section 2.2.5 & 2.4)
                                    return redis.opsForValue().increment(resendKey)
                                            .flatMap(resendCount -> {
                                                if (resendCount == 1) {
                                                    // Ensure the 10-minute window TTL is set if key was recreated
                                                    return redis.expire(resendKey, RESEND_WINDOW).thenReturn(resendCount);
                                                }
                                                return Mono.just(resendCount);
                                            })
                                            .flatMap(resendCount -> {
                                                if (resendCount > MAX_RESENDS) {
                                                    // Release the cooldown lock since no OTP was sent, and reject
                                                    return redis.delete(cooldownKey)
                                                            .then(Mono.error(new ResponseStatusException(
                                                                    HttpStatus.TOO_MANY_REQUESTS,
                                                                    "Maximum resend limit reached. Kindly Wait."
                                                            )));
                                                }

                                                // 4. Save new OTP state (resets failure count to 0) and return Tuple
                                                return saveOtpState(txId, userId, newPlainOtp, true)
                                                        .thenReturn(Tuples.of(newPlainOtp, userId, resendCount));
                                            });
                                })
                );
    }

    /**
     * Verifies the OTP using constant-time cryptographic matching (BCrypt).
     * Enforces 15-min screen timeout, 5-min code expiry, and 5 max wrong attempts.
     */
    public Mono<String> verifyOtp(String txId, String inputOtp) {
        String sessionKey = "OTP_SESSION:" + txId;
        String txKey = "OTP_TX:" + txId;
        String failKey = "OTP_FAILURES:" + txId;

        // 1. Check if the 15-minute OTP entry screen session has timed out (Section 2.2.9)
        return redis.hasKey(sessionKey)
                .flatMap(sessionExists -> {
                    if (!Boolean.TRUE.equals(sessionExists)) {
                        return Mono.error(new ResponseStatusException(
                                HttpStatus.UNAUTHORIZED,
                                "Your session has timed out. Please log in again."
                        ));
                    }

                    // 2. Fetch the active 5-minute OTP code payload (Section 2.2.7)
                    return redis.opsForValue().get(txKey)
                            .switchIfEmpty(Mono.error(new ResponseStatusException(
                                    HttpStatus.BAD_REQUEST,
                                    "The code is invalid or has expired. Please request a new code."
                            )))
                            .flatMap(payload -> {
                                try {
                                    Map<String, String> data = mapper.readValue(payload, new TypeReference<>() {
                                    });
                                    String userId = data.get("userId");
                                    String storedHash = data.get("otpHash");

                                    if (passwordEncoder.matches(inputOtp, storedHash)) {
                                        // SUCCESS (Section 2.2.8): Immediately invalidate and delete all OTP keys for one-time use
                                        return cleanupAllOtpKeys(txId).thenReturn(userId);
                                    } else {
                                        // FAILURE (Section 2.2.6): Atomic increment wrong attempts
                                        return redis.opsForValue().increment(failKey)
                                                .flatMap(failCount -> {
                                                    if (failCount >= MAX_FAILURES) {
                                                        // On 5th failed attempt: Mark code as expired by deleting OTP_TX,
                                                        // but keep OTP_SESSION alive so the user can click Resend!
                                                        return Mono.when(redis.delete(txKey), redis.delete(failKey))
                                                                .then(Mono.error(new ResponseStatusException(
                                                                        HttpStatus.BAD_REQUEST,
                                                                        "Too many incorrect attempts. The code has been expired. Please request a new code."
                                                                )));
                                                    }
                                                    long remaining = MAX_FAILURES - failCount;
                                                    return Mono.error(new ResponseStatusException(
                                                            HttpStatus.BAD_REQUEST,
                                                            "Invalid code. " + remaining + " attempts remaining."
                                                    ));
                                                });
                                    }
                                } catch (JacksonException e) {
                                    return Mono.error(new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Redis payload corruption"));
                                }
                            });
                });
    }

    /**
     * Deletes all Redis keys associated with the transaction upon successful verification.
     */
    private Mono<Void> cleanupAllOtpKeys(String txId) {
        return Mono.when(
                redis.delete("OTP_SESSION:" + txId),
                redis.delete("OTP_TX:" + txId),
                redis.delete("OTP_FAILURES:" + txId),
                redis.delete("OTP_RESENDS:" + txId),
                redis.delete("OTP_COOLDOWN:" + txId)
        );
    }

    /**
     * Compensating transaction: Cleans up the Redis state if Kafka fails,
     * ensuring the user isn't penalized for our infrastructure issues.
     */
    public Mono<Void> rollbackOtpState(String txId) {
        return cleanupAllOtpKeys(txId)
                .doOnSuccess(v -> log.info("Successfully rolled back Redis state for txId={}", LoginUtility.sanitizeLog(txId)));
    }
}






