package com.fincore.DashboardService.dto.response;

import java.util.List;

/**
 * Encapsulates the entire 7-day columnar trend response (Approach B).
 */
public record TrendResponse(
    ChartTrendDTO demandDeposits,
    ChartTrendDTO timeDeposits,
    ChartTrendDTO loans
) {}

record ChartTrendDTO(
    String title,
    String key,
    List<String> dates,      // Shared X-Axis
    List<SeriesDTO> series   // Parallel Y-Axes
) {}

record SeriesDTO(
    String name,
    String type,
    List<Double> values
) {}









package com.fincore.DashboardService.service;

import com.fincore.DashboardService.dto.response.ChartTrendDTO;
import com.fincore.DashboardService.dto.response.SeriesDTO;
import com.fincore.DashboardService.dto.response.TrendResponse;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.stereotype.Service;

import java.time.Duration;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.*;

/**
 * Service responsible for generating the highly optimized Columnar Trend payload (Approach B).
 * Integrates directly with Druid (Analytics Service) and Redis for cache orchestration.
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class DashboardTrendService {

    // Spring Boot auto-configures this. Ensure your Redis config supports Object serialization (e.g., GenericJackson2JsonRedisSerializer)
    private final RedisTemplate<String, Object> redisTemplate; 
    
    private static final DateTimeFormatter DATE_FORMATTER = DateTimeFormatter.ofPattern("dd-MM-yyyy");
    private final Random random = new Random();

    @Value("${fincore.cache.trend.base-ttl-minutes:120}")
    private long baseTtlMinutes;

    @Value("${fincore.cache.trend.jitter-max-minutes:30}")
    private int jitterMaxMinutes;

    /**
     * Fetches the 7-day trend. Checks Redis first to protect Druid from heavy grouping queries.
     */
    public TrendResponse fetchTrendData(int days) {
        if (days <= 0 || days > 365) {
            log.warn("Invalid days parameter requested: {}. Defaulting to 7.", days);
            days = 7;
        }

        // 1. Generate Scope-Aware Cache Key (Assuming Bank level for now, update with DataScopeResolver later)
        String cacheKey = "dashboard:trend:global:days:" + days;
        
        // 2. Check Redis Cache
        try {
            TrendResponse cachedResponse = (TrendResponse) redisTemplate.opsForValue().get(cacheKey);
            if (cachedResponse != null) {
                log.info("Redis Cache HIT for key: {}", cacheKey);
                return cachedResponse;
            }
        } catch (Exception e) {
            // Never fail the request if Redis is temporarily down; fail safely and hit the DB
            log.error("Redis cache retrieval failed, falling back to Druid: {}", e.getMessage());
        }

        log.info("Redis Cache MISS for key: {}. Fetching from Analytics Service (Druid).", cacheKey);

        LocalDate endDate = LocalDate.now();
        
        // 3. Fetch Raw Data from Druid (Currently Mocked)
        // TODO: Replace this method call with druidRestClient.executeQuery(payload) when Druid is online.
        List<Map<String, Object>> druidResults = getMockDruidResponse(endDate, days);
        
        // 4. Transform Druid Rows into Columnar Format (Approach B)
        TrendResponse response = processColumnarData(druidResults, endDate, days);

        // 5. Save to Cache with Jitter
        cacheResultWithJitter(cacheKey, response);

        return response;
    }

    /**
     * Transforms standard SQL/Druid rows into the strict Array/Columnar format expected by React.
     */
    private TrendResponse processColumnarData(List<Map<String, Object>> druidResults, LocalDate endDate, int days) {
        // Step A: Build the Shared X-Axis (Chronological Dates)
        List<String> sharedDates = new ArrayList<>(days);
        for (int i = days - 1; i >= 0; i--) {
            sharedDates.add(endDate.minusDays(i).format(DATE_FORMATTER));
        }

        // Step B: Restructure Druid results for fast lookup -> Map<Domain, Map<Description, Map<Date, Amount>>>
        Map<String, Map<String, Map<String, Double>>> lookupMap = new HashMap<>();
        
        for (Map<String, Object> row : druidResults) {
            String dateStr = (String) row.get("BUSINESS_DATE");
            String domain = (String) row.get("DOMAIN");
            String description = (String) row.get("DESCRIPTION");
            Double amount = ((Number) row.get("TOTAL_AMOUNT")).doubleValue();

            lookupMap.computeIfAbsent(domain, k -> new HashMap<>())
                     .computeIfAbsent(description, k -> new HashMap<>())
                     .put(dateStr, amount);
        }

        // Step C: Build strict aligned series arrays
        ChartTrendDTO demandTrend = buildChartDTO("Demand Deposits", "demandDepositsTrend", sharedDates, lookupMap.getOrDefault("DEPOSIT", Collections.emptyMap()), 
                List.of("Saving Bank A/c", "Current A/c", "Cash Credit Cr Balance", "Other Demand Deposit"));
        
        ChartTrendDTO timeTrend = buildChartDTO("Time Deposits", "timeDepositsTrend", sharedDates, lookupMap.getOrDefault("DEPOSIT", Collections.emptyMap()), 
                List.of("Term Deposit", "Special Term Deposit", "Other Term Deposit", "Certificate of Deposit"));
        
        ChartTrendDTO loanTrend = buildChartDTO("Loans", "loansTrend", sharedDates, lookupMap.getOrDefault("LOAN", Collections.emptyMap()), 
                List.of("Term Loan Account", "Agri Cash Credit", "Cash Credit", "Demand Loan", "Overdraft", "Bills Payable"));

        return new TrendResponse(demandTrend, timeTrend, loanTrend);
    }

    /**
     * Enforces the Index Alignment Rule for Approach B. 
     * If a date is missing in Druid, it explicitly injects 0.0 into the array.
     */
    private ChartTrendDTO buildChartDTO(String title, String key, List<String> sharedDates, Map<String, Map<String, Double>> domainData, List<String> categories) {
        List<SeriesDTO> seriesList = new ArrayList<>();
        
        for (String category : categories) {
            Map<String, Double> dateAmounts = domainData.getOrDefault(category, Collections.emptyMap());
            List<Double> values = new ArrayList<>(sharedDates.size());
            
            for (String date : sharedDates) {
                // IMPORTANT: If Druid missed a day, default to 0.0 to prevent the React chart from breaking alignment
                values.add(dateAmounts.getOrDefault(date, 0.0));
            }
            seriesList.add(new SeriesDTO(category, title, values));
        }
        
        return new ChartTrendDTO(title, key, sharedDates, seriesList);
    }

    /**
     * Caches the payload in Redis with a randomized Jitter.
     * Prevents cache stampedes (Thundering Herd).
     */
    private void cacheResultWithJitter(String cacheKey, TrendResponse response) {
        try {
            int jitter = random.nextInt(jitterMaxMinutes + 1);
            Duration ttl = Duration.ofMinutes(baseTtlMinutes).plusMinutes(jitter);
            
            redisTemplate.opsForValue().set(cacheKey, response, ttl);
            log.info("Cached trend data in Redis. Key: {} | TTL: {} minutes (includes {}m jitter)", cacheKey, ttl.toMinutes(), jitter);
        } catch (Exception e) {
            log.error("Failed to write to Redis cache: {}", e.getMessage());
        }
    }

    /**
     * MOCKS the raw row response we expect from Druid via the Analytics Service.
     * When Druid is up, delete this method and replace its invocation with actual API calls.
     */
    private List<Map<String, Object>> getMockDruidResponse(LocalDate endDate, int days) {
        List<Map<String, Object>> mockRows = new ArrayList<>();
        String[] demandCategories = {"Saving Bank A/c", "Current A/c", "Cash Credit Cr Balance", "Other Demand Deposit"};
        String[] timeCategories = {"Term Deposit", "Special Term Deposit", "Other Term Deposit", "Certificate of Deposit"};
        String[] loanCategories = {"Term Loan Account", "Agri Cash Credit", "Cash Credit", "Demand Loan", "Overdraft", "Bills Payable"};

        for (int i = days - 1; i >= 0; i--) {
            String dateStr = endDate.minusDays(i).format(DATE_FORMATTER);

            // Mock Deposit Rows
            for (String category : demandCategories) {
                mockRows.add(Map.of("BUSINESS_DATE", dateStr, "DOMAIN", "DEPOSIT", "DESCRIPTION", category, "TOTAL_AMOUNT", 40.0 + random.nextInt(10)));
            }
            for (String category : timeCategories) {
                mockRows.add(Map.of("BUSINESS_DATE", dateStr, "DOMAIN", "DEPOSIT", "DESCRIPTION", category, "TOTAL_AMOUNT", 50.0 + random.nextInt(10)));
            }
            // Mock Loan Rows
            for (String category : loanCategories) {
                mockRows.add(Map.of("BUSINESS_DATE", dateStr, "DOMAIN", "LOAN", "DESCRIPTION", category, "TOTAL_AMOUNT", 30.0 + random.nextInt(15)));
            }
        }
        return mockRows;
    }
}

