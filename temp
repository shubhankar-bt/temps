-- =====================================================================================
-- FINCORE ANALYTICS SEMANTIC LAYER - PRODUCTION INITIALIZATION SCRIPT
-- Description: Drops existing tables, recreates schema, and seeds base metadata.
-- Note: Hierarchy uses Gapped Sequence (HeadCode=10, Geo=20, CGL=30, Product=40)
-- =====================================================================================

-- -------------------------------------------------------------------------------------
-- PHASE 1: CLEANUP (Drop tables in reverse order of Foreign Key dependencies)
-- -------------------------------------------------------------------------------------
BEGIN
   EXECUTE IMMEDIATE 'DROP TABLE "FINCORE"."DR_VIEW_METRIC" CASCADE CONSTRAINTS';
EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF;
END;
/
BEGIN
   EXECUTE IMMEDIATE 'DROP TABLE "FINCORE"."DR_VIEW_DIMENSION" CASCADE CONSTRAINTS';
EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF;
END;
/
BEGIN
   EXECUTE IMMEDIATE 'DROP TABLE "FINCORE"."DR_REPORT_VIEW" CASCADE CONSTRAINTS';
EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF;
END;
/
BEGIN
   EXECUTE IMMEDIATE 'DROP TABLE "FINCORE"."DR_REPORT" CASCADE CONSTRAINTS';
EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF;
END;
/
BEGIN
   EXECUTE IMMEDIATE 'DROP TABLE "FINCORE"."DR_DATASOURCE" CASCADE CONSTRAINTS';
EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF;
END;
/

-- -------------------------------------------------------------------------------------
-- PHASE 2: SCHEMA DEFINITION (DDL)
-- -------------------------------------------------------------------------------------

CREATE TABLE "FINCORE"."DR_DATASOURCE" 
(	
    "ID" NUMBER(19,0) GENERATED BY DEFAULT AS IDENTITY START WITH 100 CACHE 20 NOT NULL ENABLE, 
    "DATASOURCE_CODE" VARCHAR2(50 BYTE) NOT NULL ENABLE, 
    "DRUID_TABLE_NAME" VARCHAR2(100 BYTE) NOT NULL ENABLE, 
    "CLUSTER_URL" VARCHAR2(255 BYTE), 
    "IS_ACTIVE" NUMBER(1,0) DEFAULT 1 NOT NULL ENABLE, 
    "CREATED_BY" VARCHAR2(50 BYTE) DEFAULT 'SYSTEM' NOT NULL ENABLE, 
    "CREATED_DT" TIMESTAMP (6) DEFAULT SYSTIMESTAMP NOT NULL ENABLE, 
    "UPDATED_BY" VARCHAR2(50 BYTE), 
    "UPDATED_DT" TIMESTAMP (6), 
    PRIMARY KEY ("ID"),
    UNIQUE ("DATASOURCE_CODE")
);
COMMENT ON COLUMN "FINCORE"."DR_DATASOURCE"."DATASOURCE_CODE" IS 'Internal lookup code (e.g., GLIF_PROD).';
COMMENT ON COLUMN "FINCORE"."DR_DATASOURCE"."DRUID_TABLE_NAME" IS 'Exact physical table name in Apache Druid (e.g., GLIF).';
COMMENT ON TABLE "FINCORE"."DR_DATASOURCE"  IS 'Registry of physical Druid datasources/tables.';

CREATE TABLE "FINCORE"."DR_REPORT" 
(	
    "ID" NUMBER(19,0) GENERATED BY DEFAULT AS IDENTITY START WITH 100 CACHE 20 NOT NULL ENABLE, 
    "REPORT_CODE" VARCHAR2(50 BYTE) NOT NULL ENABLE, 
    "DISPLAY_NAME" VARCHAR2(100 BYTE) NOT NULL ENABLE, 
    "IS_ACTIVE" NUMBER(1,0) DEFAULT 1 NOT NULL ENABLE, 
    "CREATED_BY" VARCHAR2(50 BYTE) DEFAULT 'SYSTEM' NOT NULL ENABLE, 
    "CREATED_DT" TIMESTAMP (6) DEFAULT SYSTIMESTAMP NOT NULL ENABLE, 
    PRIMARY KEY ("ID"),
    UNIQUE ("REPORT_CODE")
);
COMMENT ON TABLE "FINCORE"."DR_REPORT"  IS 'High-level business reports (e.g., YSA, NWSA).';

CREATE TABLE "FINCORE"."DR_REPORT_VIEW" 
(	
    "ID" NUMBER(19,0) GENERATED BY DEFAULT AS IDENTITY START WITH 100 CACHE 20 NOT NULL ENABLE, 
    "REPORT_ID" NUMBER(19,0) NOT NULL ENABLE, 
    "DATASOURCE_ID" NUMBER(19,0) NOT NULL ENABLE, 
    "VIEW_CODE" VARCHAR2(50 BYTE) NOT NULL ENABLE, 
    "DISPLAY_NAME" VARCHAR2(100 BYTE) NOT NULL ENABLE, 
    "REQUIRED_ROLE_IDS" VARCHAR2(255 BYTE), 
    "IS_ACTIVE" NUMBER(1,0) DEFAULT 1 NOT NULL ENABLE, 
    "CREATED_BY" VARCHAR2(50 BYTE) DEFAULT 'SYSTEM' NOT NULL ENABLE, 
    "CREATED_DT" TIMESTAMP (6) DEFAULT SYSTIMESTAMP NOT NULL ENABLE, 
    PRIMARY KEY ("ID"),
    UNIQUE ("VIEW_CODE"),
    CONSTRAINT "FK_DR_VIEW_REPORT" FOREIGN KEY ("REPORT_ID") REFERENCES "FINCORE"."DR_REPORT" ("ID") ENABLE, 
    CONSTRAINT "FK_DR_VIEW_DS" FOREIGN KEY ("DATASOURCE_ID") REFERENCES "FINCORE"."DR_DATASOURCE" ("ID") ENABLE
);
CREATE INDEX "FINCORE"."IDX_DR_VIEW_DS_ID" ON "FINCORE"."DR_REPORT_VIEW" ("DATASOURCE_ID");
CREATE INDEX "FINCORE"."IDX_DR_VIEW_REPORT_ID" ON "FINCORE"."DR_REPORT_VIEW" ("REPORT_ID");
COMMENT ON COLUMN "FINCORE"."DR_REPORT_VIEW"."VIEW_CODE" IS 'The unique string the frontend sends to initiate a drill-down.';
COMMENT ON COLUMN "FINCORE"."DR_REPORT_VIEW"."REQUIRED_ROLE_IDS" IS 'Comma-separated list of permitted integer Role IDs. Null means public access.';

CREATE TABLE "FINCORE"."DR_VIEW_DIMENSION" 
(	
    "ID" NUMBER(19,0) GENERATED BY DEFAULT AS IDENTITY START WITH 1000 NOT NULL ENABLE, 
    "VIEW_ID" NUMBER(19,0) NOT NULL ENABLE, 
    "LOGICAL_NAME" VARCHAR2(50 BYTE) NOT NULL ENABLE, 
    "PHYSICAL_COLUMN" VARCHAR2(100 BYTE) NOT NULL ENABLE, 
    "DRILL_LEVEL" NUMBER(5,0) NOT NULL ENABLE, 
    "CREATED_BY" VARCHAR2(50 BYTE) DEFAULT 'SYSTEM' NOT NULL ENABLE, 
    "CREATED_DT" TIMESTAMP (6) DEFAULT SYSTIMESTAMP NOT NULL ENABLE, 
    "IS_EXPRESSION" NUMBER(1,0) DEFAULT 0 NOT NULL ENABLE, 
    PRIMARY KEY ("ID"),
    CONSTRAINT "UQ_VIEW_LOGICAL_DIM" UNIQUE ("VIEW_ID", "LOGICAL_NAME"),
    CONSTRAINT "UQ_VIEW_DRILL_LVL" UNIQUE ("VIEW_ID", "DRILL_LEVEL"),
    CONSTRAINT "FK_DR_DIM_VIEW" FOREIGN KEY ("VIEW_ID") REFERENCES "FINCORE"."DR_REPORT_VIEW" ("ID") ENABLE
);
CREATE INDEX "FINCORE"."IDX_DR_DIM_VIEW_ID" ON "FINCORE"."DR_VIEW_DIMENSION" ("VIEW_ID");

CREATE TABLE "FINCORE"."DR_VIEW_METRIC" 
(	
    "ID" NUMBER GENERATED BY DEFAULT AS IDENTITY START WITH 100 NOT NULL ENABLE, 
    "VIEW_ID" NUMBER NOT NULL ENABLE, 
    "LOGICAL_NAME" VARCHAR2(100 BYTE) NOT NULL ENABLE, 
    "DISPLAY_NAME" VARCHAR2(150 BYTE) NOT NULL ENABLE, 
    "SQL_EXPRESSION" VARCHAR2(500 BYTE) NOT NULL ENABLE, 
    PRIMARY KEY ("ID"),
    CONSTRAINT "UQ_DR_VIEW_METRIC_LOGICAL" UNIQUE ("VIEW_ID", "LOGICAL_NAME"),
    CONSTRAINT "FK_DR_VIEW_METRIC_VIEW" FOREIGN KEY ("VIEW_ID") REFERENCES "FINCORE"."DR_REPORT_VIEW" ("ID") ON DELETE CASCADE ENABLE
);
CREATE INDEX "FINCORE"."IDX_DR_VIEW_METRIC_VIEW_ID" ON "FINCORE"."DR_VIEW_METRIC" ("VIEW_ID");


