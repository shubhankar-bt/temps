    @Override
    public Mono<OtpInitiatedResponseDTO> initiateOtpPhase(UserDto userDto) {
        UserTokenDataDto tokenData = userDto.getUser();

        String mobile = (tokenData != null && tokenData.getPhoneNumber() != null) ? tokenData.getPhoneNumber().trim() : "";
        String email = (tokenData != null && tokenData.getEmail() != null) ? tokenData.getEmail().trim() : "";

        // 1. THE FAIL-FAST BARRIER
        boolean hasMobile = !mobile.isEmpty();
        boolean hasEmail = email.contains("@");

        if (!hasMobile && !hasEmail) {
            log.error("Login halted for user {}: No registered mobile or email found.", LoginUtility.sanitizeLog(userDto.getUserId()));
            return Mono.error(new ResponseStatusException(
                    HttpStatus.BAD_REQUEST,
                    "OTP cannot be sent: No valid mobile number or email address is mapped with User ID."
            ));
        }

        // 2. DYNAMIC CHANNEL ROUTER
        List<String> activeChannels = new java.util.ArrayList<>();
        if (hasMobile) activeChannels.add("SMS");
        if (hasEmail) activeChannels.add("EMAIL");

        String txId = UUID.randomUUID().toString();
        String plainOtp = generateSecureOtp();
        String fName = (tokenData != null && tokenData.getFirstName() != null) ? tokenData.getFirstName() : "User";
        String mName = (tokenData != null) ? tokenData.getMiddleName() : null;
        String lName = (tokenData != null) ? tokenData.getLastName() : null;

        // Build clean full userName for OTP Screen display
        String fullUserName = Stream.of(fName, mName, lName)
                .filter(s -> s != null && !s.isBlank())
                .collect(Collectors.joining(" "));

        String maskedMob = hasMobile ? maskMobile(mobile) : "Not Registered";
        String maskedEm = hasEmail ? maskEmail(email) : "Not Registered";

        String message;
        if (hasMobile && hasEmail) {
            message = "OTP sent to " + maskedMob + " and " + maskedEm;
        } else if (hasMobile) {
            message = "OTP sent to " + maskedMob;
        } else {
            message = "OTP sent to " + maskedEm;
        }
        final String finalMessage = message;

        // 3. THE SAGA PIPELINE (Initiate or Smart-Resume Session -> Conditionally Publish Kafka)
        return otpSessionService.initiateUserOtpSession(txId, userDto.getUserId(), plainOtp)
                .flatMap(initResult -> {
                    OtpInitiatedResponseDTO responseDto = OtpInitiatedResponseDTO.builder()
                            .transactionId(txId)
                            .maskedMobile(maskedMob)
                            .maskedEmail(maskedEm)
                            .expiresInSeconds(initResult.expiresInSeconds())
                            .resendCooldownSeconds(initResult.resendCooldownSeconds())
                            .resendsRemaining(initResult.resendsRemaining())
                            .otpScreenTimeoutMin(initResult.otpScreenTimeoutMin())
                            .screenTimeoutSeconds(initResult.otpScreenTimeoutMin() * 60)
                            .userId(userDto.getUserId())
                            .userName(fullUserName)
                            .firstName(fName)
                            .middleName(mName)
                            .lastName(lName)
                            .message(finalMessage)
                            .build();

                    if (!initResult.shouldDispatchNewOtp()) {
                        return Mono.just(responseDto);
                    }

                    return otpKafkaProducer.publishOtpEvent(txId, mobile, email, plainOtp, fName, activeChannels)
                            .thenReturn(responseDto)
                            .onErrorResume(error -> {
                                log.error("Infrastructure failure during OTP dispatch for txId={}. Rolling back Redis state.",
                                        LoginUtility.sanitizeLog(txId), error);

                                return otpSessionService.rollbackInitialOtpState(txId, userDto.getUserId())
                                        .then(Mono.error(new ResponseStatusException(
                                                HttpStatus.SERVICE_UNAVAILABLE,
                                                "Unable to reach the SMS/email provider. Please try again after some time."
                                        )));
                            });
                });
    }

    @Override
    public Mono<UserDto> verifyOtpAndGetUser(VerifyOtpRequestDTO requestDto) {
        return Mono.fromCallable(() -> resolveAndValidateOtp(requestDto.getOtp()))
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(plainOtp -> otpSessionService.verifyOtp(requestDto.getTransactionId(), plainOtp))
                .flatMap(userId -> Mono.fromCallable(() -> {
                    UserDto userDto = getUserProfile(userId);
                    if (userDto == null) {
                        throw new IllegalStateException("User missing post OTP verification");
                    }
                    userDto.setValidCredentials(true);
                    return userDto;
                }).subscribeOn(Schedulers.boundedElastic()));
    }

    /**
     * Backward-compatible OTP resolver using pre-compiled regex pattern and cached RSA PrivateKey.
     */
    private String resolveAndValidateOtp(String incomingOtp) {
        String trimmed = incomingOtp != null ? incomingOtp.trim() : "";

        // Path 1: Plain-text 6-digit numeric OTP (Backward Compatible)
        if (SIX_DIGIT_OTP_PATTERN.matcher(trimmed).matches()) {
            return trimmed;
        }

        // Path 2: RSA-OAEP Encrypted Base64 OTP from Frontend
        if (trimmed.length() > 64) {
            try {
                String decrypted = KeyUtils.decryptRsaPassword(trimmed, rsaPrivatePem);
                if (decrypted != null && SIX_DIGIT_OTP_PATTERN.matcher(decrypted.trim()).matches()) {
                    return decrypted.trim();
                }
            } catch (SecurityException e) {
                log.warn("OTP RSA decryption failed: Invalid encrypted OTP payload.");
            }
        }

        throw new ResponseStatusException(
                HttpStatus.BAD_REQUEST,
                "Please enter a valid 6-digit numeric code."
        );
    }

    @Override
    public Mono<OtpResendResponseDTO> resendOtp(ResendOtpRequestDTO requestDto, String clientIp) {
        String txId = requestDto.getTransactionId();
        LoginParam params = loginParamCacheService.getCachedLoginParam();
        final int cooldownSeconds = params.getSafeOtpResendCooldownSec();
        final int expirySeconds = params.getSafeOtpValidityMin() * 60;
        final int screenTimeoutMin = params.getSafeOtpScreenTimeoutMin();

        return otpSessionService.checkIpRateLimit(clientIp)
                .then(otpSessionService.processResend(txId, generateSecureOtp()))
                .flatMap(tuple -> {

                    String plainOtp = tuple.getT1();
                    String userId = tuple.getT2();
                    int remaining = tuple.getT3();

                    return Mono.fromCallable(() -> getUserProfile(userId))
                            .subscribeOn(Schedulers.boundedElastic())
                            .flatMap(userDto -> {

                                UserTokenDataDto tokenData = userDto.getUser();
                                String mobile = (tokenData != null && tokenData.getPhoneNumber() != null) ?
                                        tokenData.getPhoneNumber().trim() : "";
                                String email = (tokenData != null && tokenData.getEmail() != null) ?
                                        tokenData.getEmail().trim() : "";

                                boolean hasMobile = !mobile.isEmpty();
                                boolean hasEmail = email.contains("@");

                                if (!hasMobile && !hasEmail) {
                                    log.error("OTP Resend halted for user {}: No registered mobile or email found.", LoginUtility.sanitizeLog(userId));
                                    return Mono.error(new ResponseStatusException(
                                            HttpStatus.BAD_REQUEST,
                                            "OTP cannot be sent: No valid mobile number or email address is mapped with User ID."
                                    ));
                                }

                                List<String> activeChannels = new java.util.ArrayList<>();
                                if (hasMobile) activeChannels.add("SMS");
                                if (hasEmail) activeChannels.add("EMAIL");

                                String fName = tokenData.getFirstName() != null ? tokenData.getFirstName() : "User";

                                String maskedMob = hasMobile ? maskMobile(mobile) : "";
                                String maskedEm = hasEmail ? maskEmail(email) : "";
                                String message;
                                if (hasMobile && hasEmail) {
                                    message = "New OTP sent to " + maskedMob + " and " + maskedEm;
                                } else if (hasMobile) {
                                    message = "New OTP sent to " + maskedMob;
                                } else {
                                    message = "New OTP sent to " + maskedEm;
                                }

                                final String finalMessage = message;

                                return otpKafkaProducer.publishOtpEvent(txId, mobile, email, plainOtp, fName, activeChannels)
                                        .thenReturn(OtpResendResponseDTO.builder()
                                                .expiresInSeconds(expirySeconds)
                                                .resendCooldownSeconds(cooldownSeconds)
                                                .resendsRemaining(remaining)
                                                .otpScreenTimeoutMin(screenTimeoutMin)
                                                .screenTimeoutSeconds(screenTimeoutMin * 60)
                                                .message(finalMessage)
                                                .build())
                                        .onErrorResume(error -> {
                                            log.error("Infrastructure failure during OTP resend for txId={}. Rolling back resend state.", LoginUtility.sanitizeLog(txId), error);
                                            return otpSessionService.rollbackResendState(txId, userId)
                                                    .then(Mono.error(new ResponseStatusException(
                                                            HttpStatus.SERVICE_UNAVAILABLE,
                                                            "Unable to reach the SMS/email provider. Please try again after some time."
                                                    )));
                                        });
                            });
                });
    }

