/**
 * REST controller for managing authentication workflows in a reactive Spring WebFlux application.
 *
 * <p>This controller provides endpoints for:
 * <ul>
 *   <li>User login with credential validation</li>
 *   <li>Token refresh using refresh tokens</li>
 *   <li>Logout with token invalidation</li>
 *   <li>Checking current user session status</li>
 *   <li>Password Update</li>
 *   <li>Returns public key to client to encrypt login payload with check user</li>
 * </ul>
 *
 * <p>All endpoints return a standardized {@link ApiResponse} structure to ensure consistent
 * client-side handling. Security is implemented using JWT-based stateless authentication,
 * integrated with Spring Security's reactive stack.
 *
 * <p><b>Note:</b> This controller is designed to work with non-blocking, reactive types
 * ({@link Mono}
 *
 * <a href="mailto:shubhankar.das.cbstcs@sbi.co.in">shubhankar.das.cbstcs@sbi.co.in</a>
 * @version 1.2.0
 * @since 2026-05-13
 */
@Slf4j
@RestController
@RequestMapping("/api/auth")
@RequiredArgsConstructor
public class AuthController {

    private static final String USER_PREFIX = "USR:";
    private static final String AES_KEY_PREFIX = "AES:USR:";

    private final TokenSessionValidator validator;
    private final ReactiveStringRedisTemplate redisTemplate;
    private final LoginService loginService;
    private final ObjectMapper mapper;
    private final LaunchService launchService;
    private final AesEncryptionUtil aesUtil;

    @Value("${security.jwt.hmac-base64-secret:}")
    private String hmacSecret;

    @Value("${security.jwt.ttl-seconds:900}")
    private long accessTokenTtl;

    @Value("${security.jwt.refresh-ttl-seconds:43200}")
    private long refreshTokenTtl;

    @Value("${security.login.blocked-ips:}")
    private String blockedIpsConfig;

    @Value("${security.payload.rsa-public:}")
    private String rsaPublicPem;

    // =================================================================================================
    // INITIALIZATION & LOGIN
    // =================================================================================================

    /**
     * Replaces /start-prod. Called when the frontend application loads.
     * Delivers environment info and the RSA Public Key for login payload encryption.
     */
    @GetMapping("/init")
    public ResponseEntity<LaunchResponse> getLaunchData() {
        return ResponseEntity.ok(launchService.getLaunchDetails());
    }

    /**
     * LOGIN ENDPOINT
     * 1. Validates credentials (Blocking DB call on Elastic Scheduler).
     * 2. Generates Access Token & Refresh Token.
     * 3. Stores Access Token JTI in Redis (Session Start).
     * 4. Returns Access Token in Body, Refresh Token in HttpOnly Cookie.
     */
    @PostMapping(value = "/login", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<?>>> login(
            ServerHttpRequest request, ServerHttpResponse response, @RequestBody @Valid UserDto payload) {
        final String clientIp = LoginUtility.getClientIp(request);
        log.info("Login request for user: {} from IP: {}", LoginUtility.sanitizeLog(payload.getUserId()), clientIp);

        // 1. IP BLOCK CHECK
        if (isIpBlocked(clientIp)) {
            return Mono.just(ResponseEntity.status(HttpStatus.FORBIDDEN)
                    .body(ApiResponse.error("Access denied: Your IP address is blocked.", "IP_BLOCKED")));
        }

        return Mono.fromCallable(() -> loginService.verifyUserCredentials(payload, clientIp))
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(user -> {

                    // =========================================================
                    // CASE 1: INVALID CREDENTIALS (Wrong Password / Locked)
                    // =========================================================
                    if (!user.isValidCredentials()) {

                        log.warn("Login Failed for user: {}. Reason: {}", LoginUtility.sanitizeLog(payload.getUserId()), user.getMessage());

                        // Build response to show Attempts Left
                        LoginResponseDTO errorResponse = LoginResponseDTO.builder()
                                .userId(user.getUserId())
                                .validCredentials(false)
                                .userStatus(user.getUserStatus())
                                .passwordLoginStatus(user.getPasswordLoginStatus())
                                .attemptsLeft(user.getAttemptsLeft()) // <--- PASS COUNT TO FRONTEND
                                .error(user.getMessage())
                                .build();

                        // If attempts are 0 OR status is INACTIVE -> 403 Forbidden (Locked)
                        // Otherwise -> 401 Unauthorized (Try again)
                        HttpStatus status = (user.getAttemptsLeft() == 0) ||
                                user.isAccountLocked() ||
                                Constants.INACTIVE.equalsIgnoreCase(user.getPasswordLoginStatus())
                                ? HttpStatus.FORBIDDEN
                                : HttpStatus.UNAUTHORIZED;

                        return Mono.just(ResponseEntity.status(status)
                                .body(ApiResponse.success(errorResponse, user.getMessage())));
                    }

//                    // =========================================================
//                    // CASE 2: PASSWORD EXPIRED (Force Update)
//                    // =========================================================
//                    if (user.isUpdatePassword()) {
//                        log.info("Password expired for user {}", LoginUtility.sanitizeLog(user.getUserId()));
//                        return Mono.just(ResponseEntity.status(HttpStatus.PRECONDITION_REQUIRED) // 428
//                                .body(ApiResponse.error("Password expired. Update required.", "UPDATE_REQUIRED")));
//                    }

                    // =========================================================
                    // CASE 3: CONFIG ERROR
                    // =========================================================
                    if (hmacSecret == null || hmacSecret.isBlank()) {
                        return Mono.just(ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                                .body(ApiResponse.error("Server Config Error", "CONFIG_ERROR")));
                    }

                    // =========================================================
                    // Dynamic Routing based on MFA Flag
                    // =========================================================
                    if (user.isOtpRequired()) {
                        log.info("MFA Enabled: Routing user {} to OTP Phase.", LoginUtility.sanitizeLog(user.getUserId()));
                        return loginService.initiateOtpPhase(user)
                                .map(otpDto -> ResponseEntity.status(HttpStatus.ACCEPTED)
                                        .body(ApiResponse.<OtpInitiatedResponseDTO>success(otpDto, "OTP Sent to registered contacts.")));
                    } else {
                        log.info("MFA Disabled: Routing user {} to Direct Login.", LoginUtility.sanitizeLog(user.getUserId()));
                        return generateSessionAndTokens(user, response);
                    }
                });
    }


    // =================================================================================================
    // REFRESH TOKEN METHOD
    // =================================================================================================

    /**
     * REFRESH TOKEN ENDPOINT
     * 1. Reads Refresh Token from Cookie.
     * 2. Validates JWE decryption & Expiry.
     * 3. Checks Redis to ensure User Session is still valid/active.
     * 4. Rotates Tokens (New JWE Access Token + New JWE Refresh Cookie).
     */
    @PostMapping(value = "/refresh-token", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ApiResponse<LoginResponseDTO>> refreshToken(ServerHttpRequest request, ServerHttpResponse response) {
        org.springframework.http.HttpCookie cookie = request.getCookies().getFirst("refresh_token");
        String refreshToken = (cookie != null) ? cookie.getValue() : null;

        if (refreshToken == null || refreshToken.isBlank()) {
            log.warn("Refresh failed: No refresh token cookie.");
            return Mono.error(new ResponseStatusException(HttpStatus.BAD_REQUEST, "Missing refresh token cookie"));
        }

        // JWE CHANGE: Using manual decryption helper instead of JJWT extractClaims
        return decryptTokenManually(refreshToken)
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(claims -> {
                    String userId = claims.getSubject();
                    String userKey = USER_PREFIX + userId;
                    log.info("Refreshing Token for User: {}", LoginUtility.sanitizeLog(userId));

                    // Check Session in Redis
                    return redisTemplate.opsForValue().get(userKey)
                            .switchIfEmpty(Mono.defer(() -> {
                                log.warn("Redis returned EMPTY for key: {}. Session expired.", userKey);
                                return Mono.error(new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Session expired. Please login again."));
                            }))
                            .flatMap(currentJti -> {
                                log.info("Session Active in Redis. Fetching Full Profile.");

                                return Mono.fromCallable(() -> loginService.getUserProfile(userId))
                                        .subscribeOn(Schedulers.boundedElastic())
                                        .flatMap(userDto -> {
                                            if (userDto == null) {
                                                return Mono.error(new ResponseStatusException(HttpStatus.NOT_FOUND, "User not found"));
                                            }

                                            return Mono.fromCallable(() -> loginService.fetchRoleWiseData(userId))
                                                    .subscribeOn(Schedulers.boundedElastic())
                                                    .flatMap(roleData -> fetchAndExtendAesKey(userId)
                                                            .flatMap(existingAesKey -> {

                                                                // JWE CHANGE: Generate new JTI and inject into claims explicitly
                                                                String newJti = UUID.randomUUID().toString();

                                                                @SuppressWarnings("unchecked")
                                                                Map<String, Object> claimsMap = mapper.convertValue(userDto.getUser(), Map.class);
                                                                claimsMap.put("jti", newJti);

                                                                // Generate New JWE Tokens using JweUtil
                                                                String newAccessToken = JweUtil.generateJwe(existingAesKey, userId, accessTokenTtl, claimsMap);

                                                                Map<String, Object> refreshClaims = Map.of("type", "refresh", "jti", UUID.randomUUID().toString());
                                                                String newRefreshToken = JweUtil.generateJwe(existingAesKey, userId, refreshTokenTtl, refreshClaims);

                                                                response.addCookie(createRefreshTokenCookie(newRefreshToken));

                                                                // Rotate JWT Session in Redis
                                                                return validator.registerUserSession(userId, newJti)
                                                                        .map(v -> {
                                                                            // Add the AES Key to the HTTP Response Headers
                                                                            response.getHeaders().add("X-Payload-Key", existingAesKey);

                                                                            // Build Response
                                                                            return ApiResponse.success(
                                                                                    LoginResponseDTO.builder()
                                                                                            .accessToken(newAccessToken)
                                                                                            .userId(userId)
                                                                                            .jti(newJti)
                                                                                            .expiresIn(accessTokenTtl)
                                                                                            .validCredentials(true)
                                                                                            .roleData(roleData)
                                                                                            .userStatus(userDto.getUserStatus())
                                                                                            .passwordLoginStatus(userDto.getPasswordLoginStatus())
                                                                                            .sub(userId)
                                                                                            .build(),
                                                                                    "Token refreshed successfully"
                                                                            );
                                                                        });
                                                            }));
                                        });
                            });
                });
    }



    // =================================================================================================
    // LOGOUT METHOD
    // =================================================================================================

    /**
     * LOGOUT ENDPOINT
     * Handles:
     * 1. Valid Tokens -> Standard Logout
     * 2. Expired Tokens -> Manually extracts claims via JWE Decryption -> Cleans up Redis if JTI matches
     * 3. Concurrent Logins -> Blacklists current token, but PRESERVES the active session in Redis
     * 4. Missing/Malformed Tokens -> Clears cookies and returns success (Idempotent)
     */
    @PostMapping(value = "/logout", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<LoginResponseDTO>>> logout(
            JwtAuthenticationToken jwtAuth, ServerHttpRequest request, ServerHttpResponse response) {

        // 1. Clearing the Refresh Token Cookie (Idempotent)
        response.addCookie(createEmptyCookie());
        String tokenString = null;

        // Strategy A: Valid Context
        if (jwtAuth != null && jwtAuth.getToken() != null) {
            tokenString = jwtAuth.getToken().getTokenValue();
        }
        // Strategy B: Manual Header Extraction (Expired Tokens)
        else {
            String header = request.getHeaders().getFirst("Authorization");
            if (header != null && header.startsWith("Bearer ")) {
                tokenString = header.substring(7);
            }
        }

        // 3. Fast Exit: If no token found anywhere, just return success so frontend can clear state
        if (tokenString == null || tokenString.isBlank()) {
            log.warn("Logout called without token. Cleaning up cookies only.");
            return Mono.just(ResponseEntity.ok(
                    ApiResponse.<LoginResponseDTO>success(
                            LoginResponseDTO.builder().userId("anonymous").build(),
                            "Logged out (No Token)"
                    )
            ));
        }

        final String finalToken = tokenString;

        // 4. Processing Chain (JWE CHANGE: Use decryptTokenManually instead of JJWT extractClaims)
        return decryptTokenManually(finalToken)
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(claims -> {
                    String userId = claims.getSubject();
                    // JWE CHANGE: Nimbus uses getJWTID() instead of getId()
                    String incomingJti = claims.getJWTID();

                    if (userId == null || incomingJti == null) {
                        return Mono.just(ResponseEntity.ok(
                                ApiResponse.<LoginResponseDTO>success(null, "Invalid Token Claims during logout")
                        ));
                    }

                    log.info("Logout Processing for User: {} | JTI: {}", LoginUtility.sanitizeLog(userId), LoginUtility.sanitizeLog(incomingJti));

                    // 5. Blacklist the Token (Always blacklist the incoming token)
                    return validator.blacklistToken(incomingJti)
                            .then(redisTemplate.opsForValue().get(USER_PREFIX + userId))
                            .flatMap(activeJti -> {
                                // 6. Conditional Redis Cleanup
                                if (activeJti != null && activeJti.equals(incomingJti)) {
                                    // SCENARIO: Normal Logout. The session in Redis belongs to THIS token.
                                    log.info("Session MATCH. Deleting active session for user: {}", LoginUtility.sanitizeLog(userId));
                                    return validator.clearUserSession(userId)
                                            .then(redisTemplate.delete(AES_KEY_PREFIX + userId))
                                            .then(Mono.just(ResponseEntity.ok(
                                                    ApiResponse.<LoginResponseDTO>success(
                                                            LoginResponseDTO.builder().userId(userId).error("Logged out").build(),
                                                            "Logged out successfully"
                                                    )
                                            )));
                                } else {
                                    // SCENARIO: Concurrent Login.
                                    log.warn("Session MISMATCH or ALREADY GONE. Active JTI: {}. Incoming JTI: {}. Preserving Redis Session.", LoginUtility.sanitizeLog(activeJti), LoginUtility.sanitizeLog(incomingJti));
                                    return Mono.just(ResponseEntity.ok(
                                            ApiResponse.<LoginResponseDTO>success(
                                                    LoginResponseDTO.builder().userId(userId).error("Logged out (Concurrent Session Preserved)").build(),
                                                    "Logged out (Concurrent Session Preserved)"
                                            )
                                    ));
                                }
                            })
                            // If key is missing in Redis (Already timed out), return success
                            .switchIfEmpty(Mono.just(ResponseEntity.ok(
                                    ApiResponse.<LoginResponseDTO>success(
                                            LoginResponseDTO.builder().userId(userId).error("Logged out (Session already expired)").build(),
                                            "Logged out (Session already expired)"
                                    )
                            )));
                })
                .onErrorResume(e -> {
                    log.error("Logout Unexpected Error: {}", e.getMessage());
                    return Mono.just(ResponseEntity.ok(
                            ApiResponse.<LoginResponseDTO>success(null, "Logged out (System Error handled or Token already expired)")
                    ));
                });
    }


    // =================================================================================================
    // UPDATE-PASSWORD, VERIFY-OTP, RESEND-OTP
    // =================================================================================================

    @PostMapping(value = "/update-password")
    public Mono<ApiResponse<UpdatePasswordDTO>> updatePassword(@RequestBody @Valid UpdatePasswordDTO dto) {
        return Mono.fromCallable(() -> loginService.updatePassword(dto))
                .subscribeOn(Schedulers.boundedElastic())
                .map(result -> ApiResponse.success(result, result.getMessage()));
    }

    @PostMapping(value = "/verify-otp", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<?>>> verifyOtp(
            @RequestBody @Valid VerifyOtpRequestDTO requestDto, ServerHttpResponse response) {
        log.info("OTP Verification for TxId: {}", LoginUtility.sanitizeLog(requestDto.getTransactionId()));

        return loginService.verifyOtpAndGetUser(requestDto)
                .flatMap(userDto -> generateSessionAndTokens(userDto, response));
    }

    @PostMapping(value = "/resend-otp", produces = MediaType.APPLICATION_JSON_VALUE)
    public Mono<ResponseEntity<ApiResponse<OtpResendResponseDTO>>> resendOtp(
            @RequestBody @Valid ResendOtpRequestDTO requestDto, ServerHttpRequest request) {

        log.info("OTP Resend for TxId: {}", LoginUtility.sanitizeLog(requestDto.getTransactionId()));

        return loginService.resendOtp(requestDto, LoginUtility.getClientIp(request))
                .map(responseDto -> ResponseEntity.status(HttpStatus.ACCEPTED)
                        .body(ApiResponse.success(responseDto, "A new OTP has been dispatched.")));
    }

    // =========================================================================================================
    //                                          GENERATE SESSION METHOD
    // =========================================================================================================

    /**
     * Generate Session and Tokens after successful logic pass for both /login and /verify-otp
     */
    private Mono<ResponseEntity<ApiResponse<?>>> generateSessionAndTokens(UserDto user, ServerHttpResponse response) {
        log.info("Generating JWE Tokens for user {}.", LoginUtility.sanitizeLog(user.getUserId()));

        // JWE CHANGE: Because JWE needs the encryption key first, we generate/fetch it before token creation.
        return generateAndStoreAesKey(user.getUserId())
                .flatMap(aesKey -> Mono.defer(() -> Mono.fromCallable(() -> loginService.fetchRoleWiseData(user.getUserId())))
                        .subscribeOn(Schedulers.boundedElastic())
                        .flatMap(roleData -> {

                            // JWE CHANGE: Explicitly generate JTI and put it in claims (can't read it after encryption)
                            String jti = UUID.randomUUID().toString();

                            @SuppressWarnings("unchecked")
                            Map<String, Object> claimsMap = mapper.convertValue(user.getUser(), Map.class);
                            claimsMap.put("jti", jti);

                            // Generate JWE strings
                            String accessToken = JweUtil.generateJwe(aesKey, user.getUserId(), accessTokenTtl, claimsMap);

                            Map<String, Object> refreshClaims = Map.of("type", "refresh", "jti", UUID.randomUUID().toString());
                            String refreshToken = JweUtil.generateJwe(aesKey, user.getUserId(), refreshTokenTtl, refreshClaims);

                            response.addCookie(createRefreshTokenCookie(refreshToken));

                            // Register JWT Session
                            return validator.registerUserSession(user.getUserId(), jti)
                                    .thenReturn(ResponseEntity.ok()
                                            .header("X-Payload-Key", aesKey)
                                            .body(ApiResponse.success(
                                                    LoginResponseDTO.builder()
                                                            .userId(user.getUserId())
                                                            .validCredentials(true)
                                                            .accessToken(accessToken)
                                                            .tokenType("Bearer")
                                                            .expiresIn(accessTokenTtl)
                                                            .sub(user.getUserId())
                                                            .jti(jti)
                                                            .roleData(roleData)
                                                            .userStatus(user.getUserStatus())
                                                            .passwordLoginStatus(user.getPasswordLoginStatus())
                                                            .attemptsLeft(null)
                                                            .build(),
                                                    "Login successful"
                                            )));
                        }));
    }


    // =========================================================================================================
    //                                              HELPERS
    // =========================================================================================================

    private String sanitizeIp(String rawIp) {
        if (rawIp == null) return "";
        String ip = rawIp;
        if (ip.startsWith("/")) ip = ip.substring(1);
        int colonIndex = ip.indexOf(':');
        if (colonIndex != -1) ip = ip.substring(0, colonIndex);
        return ip;
    }

    private boolean isIpBlocked(String rawClientIp) {
        if (blockedIpsConfig == null || blockedIpsConfig.trim().isEmpty()) return false;
        String cleanIp = sanitizeIp(rawClientIp);
        List<String> blockedIps = Arrays.asList(blockedIpsConfig.split("\\s*,\\s*"));
        boolean blocked = blockedIps.contains(cleanIp);
        if (blocked) {
            log.warn("Blocked IP Match Found: Raw='{}' -> Clean='{}'", LoginUtility.sanitizeLog(rawClientIp), LoginUtility.sanitizeLog(cleanIp));
        }
        return blocked;
    }

    /**
     * Creates a secure HttpOnly cookie for the refresh token.
     * Prevents XSS attacks as JavaScript cannot read this cookie.
     * <p>
     * CONFIG NOTE:
     * - secure(false): Allows HTTP (Localhost). Set to true in PROD with HTTPS.
     * - sameSite("Lax"): Allows cross-origin navigation in Localhost dev.
     * - path("/"): Ensures cookie is sent to all auth endpoints.
     */
    private ResponseCookie createRefreshTokenCookie(String token) {
        return ResponseCookie.from("refresh_token", token)
                .httpOnly(true)
                .secure(true) // Set to true in PROD
                .path("/")
                .maxAge(Duration.ofSeconds(refreshTokenTtl))
                .sameSite("Strict")
                .build();
    }

    /**
     * Creates an empty cookie to clear the refresh token on logout.
     */
    private ResponseCookie createEmptyCookie() {
        return ResponseCookie.from("refresh_token", "")
                .httpOnly(true)
                .secure(true) // Set to true in PROD
                .path("/")
                .maxAge(0)
                .sameSite("Strict")
                .build();
    }

    /**
     * Helper to generate a new AES key if one doesn't exist.
     */
    private String generateNewAesKey() {
        return aesUtil.generateBase64SessionKey();
    }

    /**
     * Generates a new AES key and saves it to Redis. Used during Initial Login.
     */
    private Mono<String> generateAndStoreAesKey(String userId) {
        return Mono.fromCallable(this::generateNewAesKey)
                .flatMap(aesKey -> redisTemplate.opsForValue()
                        .set(AES_KEY_PREFIX + userId, aesKey, Duration.ofSeconds(refreshTokenTtl))
                        .thenReturn(aesKey)
                );
    }

    /**
     * Fetches the existing AES key, heals it if missing, and extends the TTL. Used during Refresh.
     */
    private Mono<String> fetchAndExtendAesKey(String userId) {
        return redisTemplate.opsForValue().get(AES_KEY_PREFIX + userId)
                .switchIfEmpty(Mono.defer(() -> {
                    log.warn("AES key missing/evicted for user {} during refresh. Generating new fallback key.", LoginUtility.sanitizeLog(userId));
                    return Mono.just(generateNewAesKey());
                }))
                .flatMap(aesKey ->
                        // Extend the TTL for the rolling session
                        redisTemplate.opsForValue()
                                .set(AES_KEY_PREFIX + userId, aesKey, Duration.ofSeconds(refreshTokenTtl))
                                .thenReturn(aesKey)
                );
    }

    /**
     * Helper method to manually decrypt a JWE token.
     * Used for endpoints outside the standard Spring Security filter chain (Refresh/Logout).
     */
    private Mono<JWTClaimsSet> decryptTokenManually(String jweToken) {
        return Mono.fromCallable(() -> {
            try {
                return EncryptedJWT.parse(jweToken);
            } catch (ParseException e) {
                throw new BadJwtException("Invalid token format");
            }
        }).flatMap(encryptedJWT -> {
            String userId = encryptedJWT.getHeader().getKeyID();
            if (userId == null) {
                return Mono.error(new BadJwtException("Missing kid header"));
            }

            return redisTemplate.opsForValue().get(AES_KEY_PREFIX + userId)
                    .switchIfEmpty(Mono.error(new BadJwtException("Session expired or AES key missing")))
                    .map(aesKey -> JweUtil.decryptJwe(jweToken, aesKey));
        });
    }

}











package com.fincore.gateway.Config;

import com.fincore.gateway.JwtUtil.JweUtil;
import com.fincore.gateway.utility.LoginUtility;
import com.nimbusds.jwt.EncryptedJWT;
import com.nimbusds.jwt.JWTClaimsSet;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.redis.core.ReactiveStringRedisTemplate;
import org.springframework.security.oauth2.jwt.BadJwtException;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.jwt.JwtException;
import org.springframework.security.oauth2.jwt.ReactiveJwtDecoder;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;
import reactor.core.scheduler.Schedulers;

import java.text.ParseException;
import java.time.Instant;
import java.util.Map;

/**
 * Custom Reactive JWT Decoder to handle fully encrypted JWE tokens.
 * Replaces the default Spring Security Nimbus decoder.
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class JweReactiveJwtDecoder implements ReactiveJwtDecoder {

    private static final String AES_KEY_PREFIX = "AES:USR:";
    private final ReactiveStringRedisTemplate redisTemplate;

    @Override
    public Mono<Jwt> decode(String token) throws JwtException {

        return Mono.fromCallable(() -> {
                    // 1. Parse the token to read the unencrypted header
                    try {
                        return EncryptedJWT.parse(token);
                    } catch (ParseException e) {
                        log.warn("Failed to parse JWE token format.");
                        throw new BadJwtException("Invalid token format");
                    }
                })
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(encryptedJWT -> {
                    // 2. Extract the User ID (kid) from the header
                    String userId = encryptedJWT.getHeader().getKeyID();

                    if (userId == null || userId.isBlank()) {
                        log.warn("JWE token rejected: Missing 'kid' header.");
                        return Mono.error(new BadJwtException("Invalid token header"));
                    }

                    // 3. Fetch the AES Key from Redis dynamically
                    return redisTemplate.opsForValue().get(AES_KEY_PREFIX + userId)
                            .switchIfEmpty(Mono.defer(() -> {
                                log.warn("JWE Decryption Failed: No active AES session key found in Redis for user {}", LoginUtility.sanitizeLog(userId));
                                return Mono.error(new BadJwtException("Session expired or invalid"));
                            }))
                            .flatMap(aesKeyBase64 -> Mono.fromCallable(() -> {

                                // 4. Decrypt the payload
                                JWTClaimsSet claimsSet = JweUtil.decryptJwe(token, aesKeyBase64);

                                // 5. Validate Expiration
                                Instant expirationTime = claimsSet.getExpirationTime().toInstant();
                                if (expirationTime.isBefore(Instant.now())) {
                                    log.warn("JWE token expired for user {}", LoginUtility.sanitizeLog(userId));
                                    throw new BadJwtException("Token expired");
                                }

                                // 6. Map to Spring Security 'Jwt' Object
                                Map<String, Object> headers = encryptedJWT.getHeader().toJSONObject();
                                Map<String, Object> claims = claimsSet.getClaims();
                                Instant issueTime = claimsSet.getIssueTime() != null ? claimsSet.getIssueTime().toInstant() : Instant.now();

                                return new Jwt(token, issueTime, expirationTime, headers, claims);

                            }).subscribeOn(Schedulers.boundedElastic()));
                });
    }
}








package com.fincore.gateway.Config;

import lombok.extern.slf4j.Slf4j;

import java.nio.charset.StandardCharsets;
import java.security.KeyFactory;
import java.security.NoSuchAlgorithmException;
import java.security.PrivateKey;
import java.security.interfaces.RSAPublicKey;
import java.security.spec.InvalidKeySpecException;
import java.security.spec.PKCS8EncodedKeySpec;
import java.security.spec.X509EncodedKeySpec;
import java.util.Base64;
import javax.crypto.Cipher;

/**
 * Utility class for handling cryptographic keys, specifically for parsing
 * PEM-formatted RSA public keys into Java's {@link RSAPublicKey} object format.
 */
@Slf4j
public class KeyUtils {

    /**
     * Parses a PEM (Privacy Enhanced Mail) formatted String containing an RSA public key
     * into a standard {@link RSAPublicKey} object.
     * <p>
     * This method handles removing standard PEM headers/footers and whitespace before
     * decoding the Base64 content and generating the key specification.
     * </p>
     *
     * @param pem The PEM formatted public key string (e.g., including "-----BEGIN PUBLIC KEY-----" headers).
     * @return The resulting {@link RSAPublicKey} object.
     * @throws IllegalArgumentException if the provided PEM string is invalid, poorly formatted,
     *                                  or does not represent a valid RSA public key.
     */
    public static RSAPublicKey parseRsaPublicKey(String pem) {
        try {
            // Remove PEM headers, footers, and all whitespace
            String clean = pem
                    .replace("-----BEGIN PUBLIC KEY-----", "")
                    .replace("-----END PUBLIC KEY-----", "")
                    .replaceAll("\\s", "");

            // Decode the Base64 content into raw bytes
            byte[] decoded = Base64.getDecoder().decode(clean);

            // Define the key specification using X509 encoding (standard for public keys)
            X509EncodedKeySpec spec = new X509EncodedKeySpec(decoded);

            // Get an instance of the RSA KeyFactory and generate the public key
            KeyFactory kf = KeyFactory.getInstance("RSA");
            return (RSAPublicKey) kf.generatePublic(spec);

        } catch (NoSuchAlgorithmException e) {
            // RSA algorithm is expected to be present in standard JVMs
            throw new IllegalStateException("RSA algorithm not available in the runtime environment", e);
        } catch (InvalidKeySpecException e) {
            // Thrown if the decoded bytes do not form a valid RSA public key structure
            throw new IllegalArgumentException("Invalid RSA public key specification provided in PEM string", e);
        }
    }

    /**
     * Parses a PKCS#8 PEM formatted private key.
     */
    public static PrivateKey parseRsaPrivateKey(String pem) {
        try {
            String clean = pem.replace("-----BEGIN PRIVATE KEY-----", "")
                    .replace("-----END PRIVATE KEY-----", "")
                    .replaceAll("\\s", "");
            byte[] decoded = Base64.getDecoder().decode(clean);
            PKCS8EncodedKeySpec spec = new PKCS8EncodedKeySpec(decoded);
            KeyFactory kf = KeyFactory.getInstance("RSA");
            return kf.generatePrivate(spec);
        } catch (NoSuchAlgorithmException | InvalidKeySpecException e) {
            log.error("Failed to parse RSA Private Key. Check configuration format.");
            throw new IllegalArgumentException("Invalid RSA private key", e);
        }
    }

    /**
     * Decrypts the Base64 encoded RSA ciphertext.
     */
    public static String decryptRsaPassword(String encryptedBase64, String privateKeyPem) {
        if (encryptedBase64 == null || encryptedBase64.isBlank()) {
            return "";
        }
        try {
            PrivateKey privateKey = parseRsaPrivateKey(privateKeyPem);
            // PKCS1Padding aligns with standard frontend JSEncrypt libraries
            Cipher cipher = Cipher.getInstance("RSA/ECB/PKCS1Padding");
            cipher.init(Cipher.DECRYPT_MODE, privateKey);

            byte[] decodedBytes = Base64.getDecoder().decode(encryptedBase64);
            byte[] decryptedBytes = cipher.doFinal(decodedBytes);

            return new String(decryptedBytes, StandardCharsets.UTF_8);
        } catch (Exception e) {
            // PROD SECURITY: Never log the exact cryptographic failure reason to prevent Padding Oracle attacks.
            log.warn("Payload decryption failed. Invalid ciphertext provided.");
            throw new SecurityException("Invalid encrypted payload");
        }
    }
}









package com.fincore.gateway.Config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.core.io.Resource;
import org.springframework.core.io.ResourceLoader;
import org.springframework.ldap.core.LdapTemplate;
import org.springframework.ldap.core.support.LdapContextSource;

import java.io.IOException;
import java.net.InetAddress;
import java.net.URI;
import java.util.HashMap;
import java.util.Map;

@Slf4j
@Configuration
public class LdapConfig {

    private final ResourceLoader resourceLoader;

    @Value("${spring.ldap.urls:ldaps://uatrootdc1.uatad.sbi:3269}")
    private String ldapUrls; // Note: Can be space-separated

    @Value("${spring.ldap.base:DC=UATAD,DC=SBI}")
    private String ldapBaseDn;

    @Value("${spring.ldap.username:}")
    private String ldapUsername;

    @Value("${spring.ldap.password:}")
    private String ldapPassword;

    @Value("${security.ldap.truststore-path:}")
    private String trustStorePath;

    @Value("${security.ldap.truststore-password:changeit}")
    private String trustStorePassword;

    public LdapConfig(ResourceLoader resourceLoader) {
        this.resourceLoader = resourceLoader;
    }

    @Bean
    public LdapContextSource contextSource() {
        log.info("===================================================");
        log.info("INITIALIZING LDAP CONTEXT SOURCE");
        log.info("Configured URLs: {}", ldapUrls);

        // 0. DIAGNOSTIC: Print DNS Resolution for all configured URLs
        printDnsResolution(ldapUrls);

        // 1. SSL TRUSTSTORE SETUP
        if (ldapUrls.toLowerCase().contains("ldaps") && trustStorePath != null && !trustStorePath.isBlank()) {
            try {
                Resource trustStore = resourceLoader.getResource(trustStorePath);
                if (trustStore.exists()) {
                    String absolutePath = trustStore.getFile().getAbsolutePath();
                    log.info("Loading External Truststore from: {}", absolutePath);
                    System.setProperty("javax.net.ssl.trustStore", absolutePath);
                    System.setProperty("javax.net.ssl.trustStorePassword", trustStorePassword);
                } else {
                    log.error("CRITICAL: Truststore configured at '{}' but FILE NOT FOUND.", trustStorePath);
                }
            } catch (IOException e) {
                log.error("Error loading truststore file", e);
            }
        }

        // 2. CONFIGURE CONNECTION
        LdapContextSource contextSource = new LdapContextSource();
        // Spring natively parses space-separated URLs for High Availability
        contextSource.setUrls(ldapUrls.split("\\s+"));
        contextSource.setBase(ldapBaseDn);

        // 3. SET BIND CREDENTIALS
        if (ldapUsername != null && !ldapUsername.isBlank()) {
            log.info("Setting LDAP Bind User (Service Account): {}", ldapUsername);
            contextSource.setUserDn(ldapUsername);
            contextSource.setPassword(ldapPassword);
        }

        // 4. TIMEOUTS & PROTOCOL SETTINGS
        Map<String, Object> baseEnv = new HashMap<>();
        if (ldapUrls.toLowerCase().contains("ldaps")) {
            baseEnv.put("java.naming.security.protocol", "ssl");
        }

        // 10 Second Timeouts as requested
        baseEnv.put("com.sun.jndi.ldap.connect.timeout", "2000");
        baseEnv.put("com.sun.jndi.ldap.read.timeout", "5000");

        // Follow referrals across PR/DR
        baseEnv.put("java.naming.referral", "follow");

        // Native pooling enabled (Fallback since commons-pool2 is missing)
        contextSource.setPooled(true);
        contextSource.setBaseEnvironmentProperties(baseEnv);

        log.info("===================================================");
        return contextSource;
    }

    @Bean
    public LdapTemplate ldapTemplate() {
        LdapTemplate template = new LdapTemplate(contextSource());
        template.setIgnorePartialResultException(true);
        template.setIgnoreNameNotFoundException(true);
        return template;
    }

    /**
     * Utility method to print the exact IP addresses the JVM resolves
     * at startup to diagnose DNS Round-Robin blind spots.
     */
    private void printDnsResolution(String urls) {
        String[] urlArray = urls.split("\\s+");
        for (String url : urlArray) {
            try {
                URI uri = new URI(url);
                String host = uri.getHost();
                if (host != null) {
                    InetAddress[] addresses = InetAddress.getAllByName(host);
                    log.info("DNS Lookup for Host [{}]:", host);
                    for (InetAddress addr : addresses) {
                        log.info("  -> Resolved IP: {}", addr.getHostAddress());
                    }
                }
            } catch (Exception e) {
                log.warn("  -> Failed to resolve DNS for URL: {}", url, e);
            }
        }
    }
}












