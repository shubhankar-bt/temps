/**
 * Service implementation handling user login/verification, menu resolution, and password updates.
 *
 * <p><strong>Responsibilities</strong>
 * <ul>
 *   <li>Validate credentials (password-based and LDAP-based)</li>
 *   <li>Issue HS256 JWTs and embed limited user/role claims</li>
 *   <li>Transform role permissions into menu responses</li>
 *   <li>Track login attempts and enforce wrong password limits</li>
 * </ul>
 *
 * <p><strong>Notes</strong>
 * <ul>
 *   <li>JWT generation uses an HMAC Base64 secret; ensure it is configured for the environment.</li>
 *   <li>{@code BCryptPasswordEncoder} is created locally for convenience; consider injecting a singleton bean instead.</li>
 *   <li>Write operations are wrapped in {@link Transactional} where appropriate.</li>
 * </ul>
 */
@Slf4j
@Service("LoginService")
@RequiredArgsConstructor
public class LoginServiceImpl implements LoginService {

    /**
     * Prefer injecting a singleton bean; retained local instance for compatibility.
     */
    private final PasswordEncoder passwordEncoder;

    // ======= Config =======
    private final UserRepository userRepository;
    private final LoginAttemptRepository loginAttemptRepository;

    // ======= Dependencies =======
    private final LoginParamCacheService loginParamCacheService;
    private final RolePermissionsRepository rolePermissionsRepository;
    private final MenuService menuService;
    private final ObjectMapper mapper;
    private final BranchRepository branchRepository;
    private final Scheduler ldapScheduler;
    private final AdAuthenticationService adAuthenticationService;

    // ========== OTP ==========
    private final OtpSessionService otpSessionService;
    private final OtpKafkaProducer otpKafkaProducer;

    @Value("${security.payload.rsa-private:}")
    private String rsaPrivatePem;

    /**
     * Base64-encoded HMAC secret used to sign HS256 JWTs.
     */
    @Value("${security.jwt.hmac-base64-secret:}")
    private String hmacSecret;

    /**
     * Token time-to-live in seconds.
     */
    @Value("${security.jwt.ttl-seconds:900}")
    private long ttlSeconds;

    // =========================================================================================
    //                                    AUTH METHODS
    // =========================================================================================

    /**
     * Fetches role-wise permissions for the given user and transforms them into a menu response.
     *
     * @param userId ID of the user
     * @return {@link MenuResponse} built from ordered permissions; empty if none or on error
     */
    @Transactional(readOnly = true)
    @Override
    public MenuResponse fetchRoleWiseData(String userId) {
        log.info("Fetching role-wise data for userId: {}", LoginUtility.sanitizeLog(userId));
        try {
            List<PermissionRow> rows = rolePermissionsRepository.findAllPermissionsByUserId(userId);

            if (rows == null || rows.isEmpty()) {
                log.info("No permissions found for userId: {}", LoginUtility.sanitizeLog(userId));
                return new MenuResponse(Collections.emptyList());
            }
            return menuService.transformFromProjection(rows);
        } catch (Exception e) {
            log.error("Error fetching permissions for userId: {}", LoginUtility.sanitizeLog(userId), e);
            return new MenuResponse(Collections.emptyList());
        }
    }


    /**
     * Verifies user credentials and, on success, builds {@link UserDto} populated with an access token and token data.
     * <p>Also records the login attempt and enforces password attempt limits.</p>
     * NOTE: Local password expiration checks have been disabled as per enterprise environment config.</p>
     *
     * @param userCredentials payload containing {@code userId} and (for password mode) {@code password}
     * @param clientIp        caller's IP address for audit
     * @return {@link UserDto} with validity flags, statuses, and (if valid) a signed access token
     */
    public UserDto verifyUserCredentials(UserDto userCredentials, String clientIp) {

        final String userId = userCredentials.getUserId() != null ? userCredentials.getUserId().trim().toLowerCase() : "";
        final String encryptedPassword = userCredentials.getPassword();

        UserDto result = new UserDto();
        result.setUserId(userId);

        // Anti-Enumeration Generic Message
        String genericAuthError = "Invalid User ID or Password.";

        // 1. LOCAL DB EXISTENCE CHECK
        User user = userRepository.findByUserId(userId);
        if (user == null) {
            result.setValidCredentials(false);
            result.setAccountLocked(false);
            result.setMessage(genericAuthError);
            log.warn("Login blocked: User {} not found in local DB.", LoginUtility.sanitizeLog(userId));
            return result;
        }

        // Read from high-speed Caffeine Cache instead of hitting Oracle DB on every login
        LoginParam loginParam = loginParamCacheService.getCachedLoginParam();
        char activeMode = loginParam.getActiveLoginMode();

        // Audit prep
        LoginAttempt attempt = new LoginAttempt();
        attempt.setLoginMethod(determineMethodString(activeMode));
        attempt.setSuccess("N");
        attempt.setIpAddress(clientIp);
        attempt.setUserId(userId);

        result.setLoginMethod(activeMode);
        result.setOtpRequired("Y".equalsIgnoreCase(loginParam.getIsOtpEnabled()));

        UserRoles userRole = userRepository.getUserRole(userId);
        result.setRoleStatus(userRole.getRoleStatus());
        result.setUserStatus(user.getAccountStatus());
        result.setPasswordLoginStatus(user.getPasswordLogin());

        // 2. GLOBAL ROLE & ACCOUNT CHECKS
        if (!Constants.ACTIVE.equalsIgnoreCase(userRole.getRoleStatus())) {
            attempt.setFailureReason("Role Inactive");
            loginAttemptRepository.save(attempt);
            result.setValidCredentials(false);
            result.setAccountLocked(true); // Triggers 403
            result.setMessage("Your account role is inactive. Please contact support.");
            return result;
        }

        if (!Constants.ACTIVE.equalsIgnoreCase(user.getAccountStatus())) {
            attempt.setFailureReason("User Inactive/Locked in DB");
            loginAttemptRepository.save(attempt);
            result.setValidCredentials(false);
            result.setAccountLocked(true); // Triggers 403
            result.setMessage("Your account is locked or inactive. Please contact support.");
            return result;
        }

        // 3. TIGHTLY SCOPED RSA DECRYPTION
        // Explicitly isolated so it doesn't swallow LDAP security exceptions
        String rawPassword;
        try {
            rawPassword = KeyUtils.decryptRsaPassword(encryptedPassword, rsaPrivatePem);
        } catch (SecurityException e) {
            log.error("Login rejected for user {}: Payload decryption failed", LoginUtility.sanitizeLog(userId));
            result.setValidCredentials(false);
            result.setAccountLocked(false);
            result.setMessage("Security Error: Invalid encrypted payload.");
            attempt.setFailureReason("Payload Decryption Failed");
            loginAttemptRepository.save(attempt);
            return result;
        }

        // 4. BRANCHED AUTHENTICATION
        if (activeMode == Constants.LDAP) {
            // ============================================
            // MODE: LDAP
            // ============================================
            log.info("Processing LDAP Login for user: {}", LoginUtility.sanitizeLog(userId));
            try {
                Boolean ldapSuccess = Mono.fromCallable(() -> adAuthenticationService.authenticate(userId, rawPassword))
                        .subscribeOn(ldapScheduler)
                        .block();

                if (Boolean.TRUE.equals(ldapSuccess)) {
                    handleSuccess(attempt, result, user, userRole);
                } else {
                    // AD rejected password. Do NOT increment local count.
                    attempt.setFailureReason("LDAP Authentication Failed");
                    result.setValidCredentials(false);
                    result.setAccountLocked(false);
                    result.setMessage(genericAuthError);
                }
            } catch (SecurityException se) {
                // Catches explicit Active Directory errors (e.g. data 775 - Account Locked)
                log.warn("LDAP Security Exception for {}: {}", LoginUtility.sanitizeLog(userId), se.getMessage());
                attempt.setFailureReason(se.getMessage());
                result.setValidCredentials(false);
                result.setAccountLocked(se.getMessage().toLowerCase().contains("locked"));
                result.setMessage(se.getMessage());
            } catch (RuntimeException e) {
                log.error("LDAP Server Error for user {}: {}", LoginUtility.sanitizeLog(userId), e.getMessage());
                attempt.setFailureReason("LDAP Server Down");
                result.setValidCredentials(false);
                result.setAccountLocked(false);
                result.setMessage("System Error: Unable to connect to Authentication Server. Please try again later.");
            }
        } else if (activeMode == Constants.PWD_MODE) {
            // ============================================
            // MODE: LOCAL PASSWORD (DB tracked limits)
            // ============================================
            if (Constants.INACTIVE.equalsIgnoreCase(user.getPasswordLogin())) {
                handleAccountLocked(attempt, result, user);
            } else {
                // Simply validate password. NO local expiration/1-month validity checks required here.
                passwordBasedLogin(rawPassword, attempt, result, user, loginParam);

//                // Expiry Check ONLY for local passwords
//                if (result.isValidCredentials()) {
//                    Timestamp setAt = user.getTempPasswordSetAt();
//                    boolean isPasswordValid = false;
//                    if (setAt != null) {
//                        LocalDateTime lastUpdate = setAt.toLocalDateTime();
//                        isPasswordValid = LocalDateTime.now().isBefore(lastUpdate.plusHours(loginParam.getPasswordValidity()));
//                    }
//                    if (!isPasswordValid) {
//                        result.setUpdatePassword(true); // Triggers 428 Precondition Required
//                        result.setMessage("Your password has expired. Please update it.");
//                    }
//                }
            }
        }

        loginAttemptRepository.save(attempt);
        return result;
    }


    /**
     * Password-based authentication flow that enforces wrong password limits and updates counters/flags.
     * 1. Increments count on failure.
     * 2. Calculates remaining attempts.
     * 3. Locks account immediately if limit reached.
     *
     * @param password     raw password from the request
     * @param loginAttempt login attempt entity to be updated with success/failure
     * @param userInfo     output DTO updated with validity and attempts left
     * @param user         the user entity being authenticated
     * @param loginParam   login parameter configuration (e.g., permitted attempts)
     */
    @Transactional
    @Override
    public void passwordBasedLogin(String password, LoginAttempt loginAttempt, UserDto userInfo,
                                   User user, LoginParam loginParam) {
        log.info("Password-based login for userId={}", LoginUtility.sanitizeLog(user.getUserId()));

        if (Constants.INACTIVE.equalsIgnoreCase(user.getPasswordLogin())) {
            handleAccountLocked(loginAttempt, userInfo, user);
            return;
        }

        if (passwordEncoder.matches(password, user.getPasswordHash())) {
            UserRoles userRole = userRepository.getUserRole(user.getUserId());
            handleSuccess(loginAttempt, userInfo, user, userRole);
        } else {
            handleFailure(loginAttempt, userInfo, user, loginParam, "Wrong Password");
        }
    }

    /**
     * Produces a human-readable message describing a blocked login due to {@code status} of a given {@code type}.
     *
     * @param status status string (e.g., ACTIVE/INACTIVE/LOCKED)
     * @param type   subject type (e.g., "user", "role")
     * @return formatted message
     */
    @Override
    public String generateStatusMessage(String status, String type) {
        return String.format("Trying to login with a %s %s", status, type);
    }

    /**
     * Checks the status and requirements for a user attempting to log in (without performing login).
     *
     * @param userId the user identifier
     * @return {@link VerifyUserDTO} describing status, password update requirements, and messages
     */
    @Transactional(readOnly = true)
    public VerifyUserDTO checkUser(String userId) {
        final String cleanUserId = userId != null ? userId.trim().toLowerCase() : "";
        VerifyUserDTO out = new VerifyUserDTO();
        out.setUserId(cleanUserId);

        User user = userRepository.findByUserId(cleanUserId);
        LoginParam loginParam = loginParamCacheService.getCachedLoginParam();
        out.setLoginMethod(loginParam.getActiveLoginMode());

        if (user == null) {
            out.setUserCheck(false);
            out.setUserStatus(Constants.INVALID);
            out.setMessage("Invalid credentials. Please check your User ID or Password.");
            return out;
        }

        if (Constants.ACTIVE.equalsIgnoreCase(user.getAccountStatus())) {
            Timestamp setAt = user.getTempPasswordSetAt();
            boolean isPasswordValid = false;

            // Validate password expiration only for Password Mode
            if (loginParam.getActiveLoginMode() == Constants.PWD_MODE && setAt != null) {
                LocalDateTime lastUpdate = setAt.toLocalDateTime();
                isPasswordValid = LocalDateTime.now()
                        .isBefore(lastUpdate.plusHours(loginParam.getPasswordValidity()));
            } else {
                // For LDAP/SSO, we rely on their policies, so treat local validity as true
                isPasswordValid = true;
            }

            UserRoles userRole = userRepository.getUserRole(cleanUserId);
            out.setRoleStatus(userRole.getRoleStatus());

            // Logic: Update Password only needed if Mode is Password AND (Password is null OR Expired)
            boolean updateNeeded = (loginParam.getActiveLoginMode() == Constants.PWD_MODE)
                    && (user.getPasswordHash() == null || !isPasswordValid);

            out.setUpdatePassword(updateNeeded);
            out.setUserStatus(Constants.ACTIVE);
            out.setMessage(Constants.ACTIVE_USER);
            out.setPasswordLoginStatus(user.getPasswordLogin());
        } else {
            String accountStatus = user.getAccountStatus();
            out.setUserCheck(true);
            out.setUserStatus(accountStatus);
            out.setMessage(
                    accountStatus.equalsIgnoreCase("locked") ? "Your account is locked. Please contact support."
                            : accountStatus.equalsIgnoreCase("inactive") ? "Inactive User" : "Verification Pending"
            );
        }

        return out;
    }

    /**
     * Updates the user's password hash and resets the temporary password timestamp.
     *
     * @param userCredentials input DTO with {@code userId} and new raw {@code password}
     * @return {@link UpdatePasswordDTO} indicating success and message; sensitive fields are cleared
     */
    @Transactional
    public UpdatePasswordDTO updatePassword(UpdatePasswordDTO userCredentials) {
        String userId = userCredentials.getUserId() != null ? userCredentials.getUserId().trim().toLowerCase() : "";
        String encryptedPassword = userCredentials.getPassword();

        // Always sanitize outbound fields
        userCredentials.setUpdateFlag(false);
        userCredentials.setPassword("");
        userCredentials.setOtp("");

        try {
            User user = userRepository.findByUserId(userId);
            if (user == null) {
                userCredentials.setMessage("Invalid user id");
                return userCredentials;
            }

            String rawPassword;
            try {
                rawPassword = KeyUtils.decryptRsaPassword(encryptedPassword, rsaPrivatePem);
            } catch (SecurityException e) {
                log.error("Update password rejected for user {}: Payload decryption failed", LoginUtility.sanitizeLog(userId));
                userCredentials.setMessage("Security Error: Invalid encrypted payload");
                return userCredentials;
            }

            String passwordHash = passwordEncoder.encode(rawPassword);
            user.setPasswordHash(passwordHash);
            user.setTempPasswordSetAt(Timestamp.valueOf(LocalDateTime.now()));
            userRepository.save(user);

            userCredentials.setMessage("User password successfully updated");
            userCredentials.setUpdateFlag(true);

        } catch (DataIntegrityViolationException e) {
            log.warn("Data integrity violation while updating password for userId={}", LoginUtility.sanitizeLog(userId), e);
            userCredentials.setMessage("Failed to change password, please try again");
        } catch (ObjectOptimisticLockingFailureException e) {
            log.warn("Optimistic locking failure while updating password for userId={}", LoginUtility.sanitizeLog(userId), e);
            userCredentials.setMessage("The user data was modified by another process, please retry");
        } catch (JpaSystemException e) {
            log.error("JPA system error while updating password for userId={}", LoginUtility.sanitizeLog(userId), e);
            userCredentials.setMessage("A database error occurred, please try again later");
        }

        return userCredentials;
    }


    // =========================================================================================
    //                           NEW OTP LIFECYCLE METHODS
    // =========================================================================================

    @Override
    public Mono<OtpInitiatedResponseDTO> initiateOtpPhase(UserDto userDto) {
        UserTokenDataDto tokenData = userDto.getUser();

        String mobile = (tokenData != null && tokenData.getPhoneNumber() != null) ? tokenData.getPhoneNumber().trim() : "";
        String email = (tokenData != null && tokenData.getEmail() != null) ? tokenData.getEmail().trim() : "";

        // 1. THE FAIL-FAST BARRIER (Table 2.4 exact message)
        boolean hasMobile = !mobile.isEmpty();
        boolean hasEmail = email.contains("@");

        if (!hasMobile && !hasEmail) {
            log.error("Login halted for user {}: No registered mobile or email found.", LoginUtility.sanitizeLog(userDto.getUserId()));
            return Mono.error(new ResponseStatusException(
                    HttpStatus.BAD_REQUEST,
                    "Code cannot be sent: No valid mobile number or email address is mapped with User ID."
            ));
        }

        // 2. DYNAMIC CHANNEL ROUTER
        List<String> activeChannels = new java.util.ArrayList<>();
        if (hasMobile) activeChannels.add("SMS");
        if (hasEmail) activeChannels.add("EMAIL");

        String txId = UUID.randomUUID().toString();
        String plainOtp = generateSecureOtp();
        String fName = (tokenData != null && tokenData.getFirstName() != null) ? tokenData.getFirstName() : "User";
        String mName = (tokenData != null) ? tokenData.getMiddleName() : null;
        String lName = (tokenData != null) ? tokenData.getLastName() : null;

        // Build clean full userName and AppSec-sanitized userDetails for OTP Screen display
        String fullUserName = Stream.of(fName, mName, lName)
                .filter(s -> s != null && !s.isBlank())
                .collect(Collectors.joining(" "));

        String maskedMob = hasMobile ? maskMobile(mobile) : "Not Registered";
        String maskedEm = hasEmail ? maskEmail(email) : "Not Registered";

        UserTokenDataDto safeUserDetails = null;
        if (tokenData != null) {
            safeUserDetails = new UserTokenDataDto();
            BeanUtils.copyProperties(tokenData, safeUserDetails);
            // Mask raw PII before MFA is verified
            safeUserDetails.setPhoneNumber(maskedMob);
            safeUserDetails.setEmail(maskedEm);
        }
        final UserTokenDataDto finalSafeUserDetails = safeUserDetails;

        // Construct exact Table 2.4 user message
        String message;
        if (hasMobile && hasEmail) {
            message = "Code sent to " + maskedMob + " and " + maskedEm;
        } else if (hasMobile) {
            message = "Code sent to " + maskedMob;
        } else {
            message = "Code sent to " + maskedEm;
        }
        final String finalMessage = message;

        // 3. THE SAGA PIPELINE (Initiate or Smart-Resume Session -> Conditionally Publish Kafka)
        return otpSessionService.initiateUserOtpSession(txId, userDto.getUserId(), plainOtp)
                .flatMap(initResult -> {
                    OtpInitiatedResponseDTO responseDto = OtpInitiatedResponseDTO.builder()
                            .transactionId(txId)
                            .maskedMobile(maskedMob)
                            .maskedEmail(maskedEm)
                            .expiresInSeconds(initResult.expiresInSeconds())
                            .resendCooldownSeconds(initResult.resendCooldownSeconds())
                            .resendsRemaining(initResult.resendsRemaining())
                            .otpScreenTimeoutMin(initResult.otpScreenTimeoutMin())
                            .screenTimeoutSeconds(initResult.otpScreenTimeoutMin() * 60)
                            .userId(userDto.getUserId())
                            .userName(fullUserName)
                            .firstName(fName)
                            .middleName(mName)
                            .lastName(lName)
                            .userDetails(finalSafeUserDetails)
                            .message(finalMessage)
                            .build();

                    // If Smart Session Resumption reused an existing valid OTP (< 60s cooldown or 0 resends left),
                    // skip Kafka dispatch so no duplicate SMS/Email is sent!
                    if (!initResult.shouldDispatchNewOtp()) {
                        return Mono.just(responseDto);
                    }

                    return otpKafkaProducer.publishOtpEvent(txId, mobile, email, plainOtp, fName, activeChannels)
                            .thenReturn(responseDto)
                            .onErrorResume(error -> {
                                // 4. COMPENSATING TRANSACTION (KAFKA DOWN - Table 2.4 message)
                                log.error("Infrastructure failure during OTP dispatch for txId={}. Rolling back Redis state.",
                                        LoginUtility.sanitizeLog(txId), error);

                                return otpSessionService.rollbackInitialOtpState(txId, userDto.getUserId())
                                        .then(Mono.error(new ResponseStatusException(
                                                HttpStatus.SERVICE_UNAVAILABLE,
                                                "Unable to reach the SMS/email provider. Please try again after some time."
                                        )));
                            });
                });
    }


    @Override
    public Mono<UserDto> verifyOtpAndGetUser(VerifyOtpRequestDTO requestDto) {
        return otpSessionService.verifyOtp(requestDto.getTransactionId(), requestDto.getOtp())
                .flatMap(userId -> Mono.fromCallable(() -> {
                    UserDto userDto = getUserProfile(userId);
                    if (userDto == null) {
                        throw new IllegalStateException("User missing post OTP verification");
                    }
                    userDto.setValidCredentials(true);
                    return userDto;
                }).subscribeOn(Schedulers.boundedElastic()));
    }

    @Override
    public Mono<OtpResendResponseDTO> resendOtp(ResendOtpRequestDTO requestDto, String clientIp) {
        String txId = requestDto.getTransactionId();
        LoginParam params = loginParamCacheService.getCachedLoginParam();
        final int cooldownSeconds = params.getSafeOtpResendCooldownSec();
        final int expirySeconds = params.getSafeOtpValidityMin() * 60;
        final int screenTimeoutMin = params.getSafeOtpScreenTimeoutMin();

        return otpSessionService.checkIpRateLimit(clientIp)
                // 1. Process Resend atomically in Redis (Enforces DB-configured cooldown & max resends per user)
                .then(otpSessionService.processResend(txId, generateSecureOtp()))
                .flatMap(tuple -> {

                    String plainOtp = tuple.getT1();
                    String userId = tuple.getT2();
                    int remaining = tuple.getT3();

                    // 2. Fetch User Profile for contact info
                    return Mono.fromCallable(() -> getUserProfile(userId))
                            .subscribeOn(Schedulers.boundedElastic())
                            .flatMap(userDto -> {

                                UserTokenDataDto tokenData = userDto.getUser();
                                String mobile = (tokenData != null && tokenData.getPhoneNumber() != null) ?
                                        tokenData.getPhoneNumber().trim() : "";
                                String email = (tokenData != null && tokenData.getEmail() != null) ?
                                        tokenData.getEmail().trim() : "";

                                // 3. THE FAIL-FAST BARRIER
                                boolean hasMobile = !mobile.isEmpty();
                                boolean hasEmail = email.contains("@");

                                if (!hasMobile && !hasEmail) {
                                    log.error("OTP Resend halted for user {}: No registered mobile or email found.", LoginUtility.sanitizeLog(userId));
                                    return Mono.error(new ResponseStatusException(
                                            HttpStatus.BAD_REQUEST,
                                            "Code cannot be sent: No valid mobile number or email address is mapped with User ID."
                                    ));
                                }

                                // 4. DYNAMIC CHANNEL ROUTER
                                List<String> activeChannels = new java.util.ArrayList<>();
                                if (hasMobile) activeChannels.add("SMS");
                                if (hasEmail) activeChannels.add("EMAIL");

                                String fName = tokenData.getFirstName() != null ? tokenData.getFirstName() : "User";

                                // Construct exact Table 2.4 RESEND message (Prefixed with "New ")
                                String maskedMob = hasMobile ? maskMobile(mobile) : "";
                                String maskedEm = hasEmail ? maskEmail(email) : "";
                                String message;
                                if (hasMobile && hasEmail) {
                                    message = "New Code sent to " + maskedMob + " and " + maskedEm;
                                } else if (hasMobile) {
                                    message = "New Code sent to " + maskedMob;
                                } else {
                                    message = "New Code sent to " + maskedEm;
                                }

                                final String finalMessage = message;

                                // 5. THE SAGA PIPELINE (Kafka Publish -> Rollback Resend Increment on Failure)
                                return otpKafkaProducer.publishOtpEvent(txId, mobile, email, plainOtp, fName, activeChannels)
                                        .thenReturn(OtpResendResponseDTO.builder()
                                                .expiresInSeconds(expirySeconds)
                                                .resendCooldownSeconds(cooldownSeconds)
                                                .resendsRemaining(remaining)
                                                .otpScreenTimeoutMin(screenTimeoutMin)
                                                .screenTimeoutSeconds(screenTimeoutMin * 60)
                                                .message(finalMessage)
                                                .build())
                                        .onErrorResume(error -> {
                                            log.error("Infrastructure failure during OTP resend for txId={}. Rolling back resend state.", LoginUtility.sanitizeLog(txId), error);
                                            return otpSessionService.rollbackResendState(txId, userId)
                                                    .then(Mono.error(new ResponseStatusException(
                                                            HttpStatus.SERVICE_UNAVAILABLE,
                                                            "Unable to reach the SMS/email provider. Please try again after some time."
                                                    )));
                                        });
                            });
                });
    }


    // =========================================================================================
    //                                   HELPERS
    // =========================================================================================

    /**
     * Initializes the token-visible user data embedded/returned alongside the JWT.
     * Fetches branch and circle mapping dynamically.
     *
     * @param user     the user entity
     * @param userRole the role mapping for the user
     * @return user token DTO with non-sensitive fields
     */
    private UserTokenDataDto initializeTokenData(User user, UserRoles userRole) {
        UserTokenDataDto tokenData = new UserTokenDataDto();
        tokenData.setFirstName(user.getFirstName());
        tokenData.setMiddleName(user.getMiddleName());
        tokenData.setLastName(user.getLastName());
        tokenData.setPhoneNumber(user.getPhoneNumber());
        tokenData.setUserId(user.getUserId());
        tokenData.setBranch(user.getBranch());
        tokenData.setEmail(user.getEmail());
        tokenData.setRole(userRole.getRole());
        tokenData.setRoleName(userRole.getRoleName());

        // ========== New code changes as per requirement for role access ========== added by v1015698
        tokenData.setRoleDescription(userRole.getRoleDescription());
        tokenData.setRoleAccess(userRole.getRoleAccess());
        tokenData.setAccessName(userRole.getAccessName());
        tokenData.setAccessDescription(userRole.getAccessDescription());

        // FORMAT the branch integer to a 5-digit string (e.g., 8080 -> "08080")
        String branchCodeStr = String.format("%05d", user.getBranch());

        // Fetch specific details from the database
        BranchCircleProjection bcInfo = branchRepository.findBranchAndCircleDetails(branchCodeStr);

        if (bcInfo != null) {
            tokenData.setBranchName(bcInfo.getBranchName());
            tokenData.setCity(bcInfo.getCity());
            tokenData.setAddress(bcInfo.getAddress());
            tokenData.setPincode(bcInfo.getPincode());
            tokenData.setNmrCode(bcInfo.getNmrCode());
            tokenData.setBranchStatus(bcInfo.getBranchStatus());
            tokenData.setBranchType(bcInfo.getBranchType());
            tokenData.setCircleCode(bcInfo.getCircleCode());
            tokenData.setCircleName(bcInfo.getCircleName());
            tokenData.setZoneCode(bcInfo.getZoneCode());
            tokenData.setZoneName(bcInfo.getZoneName());
            tokenData.setCircleBranch(bcInfo.getCircleBranch());
            tokenData.setStateName(bcInfo.getStateName());
            tokenData.setStateCode(bcInfo.getStateCode());


            // Check if user's branch matches the Circle's designated branch code
            boolean isCircle = branchCodeStr.equals(bcInfo.getCircleBranch());
            tokenData.setIsCircle(isCircle);
        } else {
            // Fallback if branch is somehow missing in the master table
            tokenData.setIsCircle(false);
            log.warn("Branch details not found in BRANCH_MASTER for branch code: {}", branchCodeStr);
        }

        return tokenData;
    }


    /**
     * Retrieves the full user profile for Token Refresh.
     * Uses the exact same structure as verifyUserCredentials to ensure token claims are identical.
     */
    @Override
    @Transactional(readOnly = true)
    public UserDto getUserProfile(String userId) {
        final String cleanUserId = userId != null ? userId.trim().toLowerCase() : "";
        User user = userRepository.findByUserId(cleanUserId);
        UserRoles userRole = userRepository.getUserRole(cleanUserId);

        // Return null if user doesn't exist, caller handles the error
        if (user == null) {
            return null;
        }
        UserDto userDto = new UserDto();
        userDto.setUserId(cleanUserId);
        userDto.setUserStatus(user.getPasswordLogin());
        userDto.setPasswordLoginStatus(user.getPasswordLogin());
        userDto.setUser(initializeTokenData(user, userRole));
        return userDto;
    }


    private String determineMethodString(char mode) {
        if (mode == Constants.LDAP) return "LDAP";
        if (mode == Constants.PWD_MODE) return Constants.PASSWORD_BASED_LOGIN;
        return Constants.SSO_BASED_LOGIN;
    }

    private void handleAccountLocked(LoginAttempt attempt, UserDto result, User user) {
        result.setValidCredentials(false);
        result.setPasswordLoginStatus(user.getPasswordLogin());
        result.setMessage("Your account is locked due to multiple failed attempts.");

        if (Constants.INACTIVE.equalsIgnoreCase(user.getPasswordLogin())) {
            result.setAttemptsLeft(0);
            attempt.setFailureReason("Account Locked (Pre-check)");
        } else {
            result.setMessage("Password login is disabled.");
            attempt.setFailureReason("Password login disabled");
        }
    }

    private void handleSuccess(LoginAttempt attempt, UserDto result, User user, UserRoles userRole) {
        attempt.setSuccess("Y");
        attempt.setFailureReason("Success");
        result.setValidCredentials(true);
        result.setMessage("Login Successful");

        // Reset wrong password count on successful login
        if (user.getUserWrongPasswordCount() > 0) {
            user.setUserWrongPasswordCount(0);
            userRepository.save(user);
        }

        log.info("Credentials validated. Issuing token for userId={}", LoginUtility.sanitizeLog(user.getUserId()));

        // Fetch contextual user data (including branch and circle)
        UserTokenDataDto tokenData = initializeTokenData(user, userRole);

        @SuppressWarnings("unchecked")
        String accessToken = HmacJwtUtil.generate(
                hmacSecret,
                user.getUserId(),
                ttlSeconds,
                mapper.convertValue(tokenData, Map.class) // Embed all tokenData properties into the JWT claims
        );

        result.setAccessToken(accessToken);
        result.setUser(tokenData);
    }

    private void handleFailure(LoginAttempt attempt, UserDto userInfo, User user, LoginParam loginParam, String reason) {
        log.warn("Login failed for user {}: {}", LoginUtility.sanitizeLog(user.getUserId()), reason);
        attempt.setSuccess("N");

        int currentFailedCount = user.getUserWrongPasswordCount();
        int maxAllowed = loginParam.getWrongPasswordAttempts();
        int newFailedCount = currentFailedCount + 1;

        user.setUserWrongPasswordCount(newFailedCount);
        userInfo.setValidCredentials(false);

        if (newFailedCount >= maxAllowed) {
            user.setPasswordLogin(Constants.INACTIVE);
            // user.setAccountStatus(Constants.LOCKED); // Optional: Depending on business rule
            attempt.setFailureReason(reason + " -> Account Locked");
            userInfo.setMessage("Your account has been locked due to multiple unsuccessful login attempts.");
            userInfo.setPasswordLoginStatus(Constants.INACTIVE);
            userInfo.setAttemptsLeft(0);
        } else {
            int remaining = maxAllowed - newFailedCount;
            attempt.setFailureReason(reason);
            if (remaining > 1) {
                userInfo.setMessage("Invalid User ID or Password. Please check and try again.");
            } else {
                userInfo.setMessage("Invalid User ID or Password. Final attempt before lock.");
            }
            userInfo.setAttemptsLeft(remaining);
        }
        userRepository.save(user);
    }


    // ================== OTP Format Utilities ====================

    private String generateSecureOtp() {
        SecureRandom random = new SecureRandom();
        int otp = 100000 + random.nextInt(900000);
        return String.valueOf(otp);
    }

    private String maskEmail(String email) {
        if (email == null || !email.contains("@")) return email;
        String[] parts = email.split("@");
        return (parts[0].length() <= 2 ? "**" : parts[0].charAt(0) + "***" + parts[0].charAt(parts[0].length() - 1)) + "@" + parts[1];
    }

    /**
     * Updated to return 3 asterisks (e.g. ***1234) per Table 2.4 of the MFA Solution Document.
     */
    private String maskMobile(String mobile) {
        if (mobile == null || mobile.length() < 4) return mobile;
        return "***" + mobile.substring(mobile.length() - 4);
    }
}
















package com.fincore.gateway.Service;

import com.fincore.gateway.model.LoginParam;
import com.fincore.gateway.utility.LoginUtility;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.redis.core.ReactiveStringRedisTemplate;
import org.springframework.http.HttpStatus;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.web.server.ResponseStatusException;
import reactor.core.publisher.Mono;
import reactor.core.scheduler.Schedulers;
import reactor.util.function.Tuple3;
import reactor.util.function.Tuples;
import tools.jackson.core.type.TypeReference;
import tools.jackson.databind.ObjectMapper;

import java.time.Duration;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * ============================================================================
 * OTP LIFECYCLE, SMART SESSION RESUMPTION & CONCURRENCY ENGINE
 * ============================================================================
 * All timers and limits are dynamically fetched from LoginParamCacheService:
 * - OTP Validity               : LOGIN_PARAM.OTP_VALIDITY (Default: 5 min)
 * - OTP Screen Idle Timeout    : LOGIN_PARAM.OTP_SCREEN_TIMEOUT_MIN (Default: 15 min)
 * - Max Wrong Attempts         : LOGIN_PARAM.OTP_MAX_ATTEMPTS (Default: 5)
 * - Resend Cooldown            : LOGIN_PARAM.OTP_RESEND_COOLDOWN_SEC (Default: 60 sec)
 * - Max Resend Count           : LOGIN_PARAM.OTP_MAX_RESENDS (Default: 3)
 * - Resend Window              : LOGIN_PARAM.OTP_RESEND_WINDOW_MIN (Default: 10 min)
 * <p>
 * REDIS KEYS ARCHITECTURE:
 * 1. OTP_ACTIVE_TX:USR:{userId} -> Active txId (TTL: 15m - Enforces 1 OTP session per user)
 * 2. OTP_COOLDOWN:USR:{userId}  -> "locked" (TTL: 60s - Enforces cooldown across Resend AND Back-to-Login)
 * 3. OTP_RESENDS:USR:{userId}   -> Integer count (TTL: 10m - Enforces max 3 resends per user in 10m)
 * 4. OTP_SESSION:{txId}         -> userId (TTL: 15m - Tracks overall OTP screen idle timeout)
 * 5. OTP_TX:{txId}              -> { "userId": "...", "otpHash": "..." } (TTL: 5m - Active code)
 * 6. OTP_FAILURES:{txId}        -> Integer count (TTL: 5m)
 * 7. OTP_VERIFY_LOCK:{txId}     -> "verifying" (TTL: 10s - Prevents double-click race condition)
 * 8. RATE_LIMIT:OTP_REQ:IP:{ip} -> Integer count (TTL: 1h)
 * ============================================================================
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class OtpSessionService {

    private static final int MAX_HOURLY_IP_REQUESTS = 50;

    private final ReactiveStringRedisTemplate redis;
    private final PasswordEncoder passwordEncoder;
    private final ObjectMapper mapper;
    private final LoginParamCacheService loginParamCacheService;

    /**
     * Rate limits OTP requests by IP to prevent API abuse and SMS Toll Fraud.
     */
    public Mono<Void> checkIpRateLimit(String clientIp) {
        String key = "RATE_LIMIT:OTP_REQ:IP:" + clientIp;
        return redis.opsForValue().increment(key)
                .flatMap(count -> {
                    if (count == 1) {
                        return redis.expire(key, Duration.ofHours(1)).then();
                    } else if (count > MAX_HOURLY_IP_REQUESTS) {
                        log.warn("SECURITY ALERT: IP {} exceeded hourly OTP limit.", LoginUtility.sanitizeLog(clientIp));
                        return Mono.error(new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS,
                                "Maximum resend limit reached. Kindly Wait."));
                    }
                    return Mono.empty();
                });
    }

    /**
     * Initiates or smartly resumes an OTP session on /login.
     */
    public Mono<OtpSessionInitResult> initiateUserOtpSession(String newTxId, String userId, String newPlainOtp) {
        final String cleanUserId = userId.trim();
        final LoginParam params = loginParamCacheService.getCachedLoginParam();

        final int otpValidityMin = params.getSafeOtpValidityMin();
        final int cooldownSec = params.getSafeOtpResendCooldownSec();
        final int maxResends = params.getSafeOtpMaxResends();
        final int resendWindowMin = params.getSafeOtpResendWindowMin();
        final int screenTimeoutMin = params.getSafeOtpScreenTimeoutMin();

        final Duration cooldownDuration = Duration.ofSeconds(cooldownSec);
        final Duration resendWindowDuration = Duration.ofMinutes(resendWindowMin);
        final Duration screenTimeoutDuration = Duration.ofMinutes(screenTimeoutMin);

        final String activeTxKey = "OTP_ACTIVE_TX:USR:" + cleanUserId;
        final String userCooldownKey = "OTP_COOLDOWN:USR:" + cleanUserId;
        final String userResendKey = "OTP_RESENDS:USR:" + cleanUserId;

        return Mono.zip(
                redis.opsForValue().get(activeTxKey).defaultIfEmpty(""),
                redis.getExpire(userCooldownKey).defaultIfEmpty(Duration.ZERO),
                redis.opsForValue().get(userResendKey).defaultIfEmpty("")
        ).flatMap(userState -> {
            String oldTxId = userState.getT1();
            long cooldownRemainingSec = Math.max(0, userState.getT2().getSeconds());
            String resendCountStr = userState.getT3();

            boolean hasResendWindow = !resendCountStr.isEmpty();
            int currentResends = hasResendWindow ? Integer.parseInt(resendCountStr) : 0;
            boolean isCooldownActive = cooldownRemainingSec > 0;
            boolean isQuotaExhausted = hasResendWindow && currentResends >= maxResends;

            // Inspect and clean up any previous OTP transaction for this user (Single Active Session enforcement)
            Mono<Tuple3<String, Duration, String>> inspectAndEvictOldTx;
            if (!oldTxId.isEmpty()) {
                inspectAndEvictOldTx = Mono.zip(
                        redis.opsForValue().get("OTP_TX:" + oldTxId).defaultIfEmpty(""),
                        redis.getExpire("OTP_TX:" + oldTxId).defaultIfEmpty(Duration.ZERO),
                        redis.opsForValue().get("OTP_FAILURES:" + oldTxId).defaultIfEmpty("0")
                ).flatMap(oldTxData ->
                        Mono.when(
                                redis.delete("OTP_SESSION:" + oldTxId),
                                redis.delete("OTP_TX:" + oldTxId),
                                redis.delete("OTP_FAILURES:" + oldTxId),
                                redis.delete("OTP_VERIFY_LOCK:" + oldTxId)
                        ).thenReturn(oldTxData)
                );
            } else {
                inspectAndEvictOldTx = Mono.just(Tuples.of("", Duration.ZERO, "0"));
            }

            return inspectAndEvictOldTx.flatMap(oldTxData -> {
                String existingOtpPayload = oldTxData.getT1();
                Duration existingOtpTtl = oldTxData.getT2();
                String existingFailures = oldTxData.getT3();

                boolean hasValidExistingOtp = !existingOtpPayload.isEmpty() && existingOtpTtl.getSeconds() > 5;

                // =========================================================================
                // BRANCH 1: SMART SESSION RESUMPTION ("Back to Sign In" with valid OTP)
                // =========================================================================
                if (hasValidExistingOtp && (isCooldownActive || isQuotaExhausted)) {
                    int remainingOtpSec = (int) existingOtpTtl.getSeconds();
                    int remainingCooldown = isCooldownActive ? (int) cooldownRemainingSec : 0;
                    int remainingResends = Math.max(0, maxResends - currentResends);

                    log.info("Smart Session Resumption for user={}: Migrating valid OTP to newTxId={} (cooldown={}s, resendsLeft={})",
                            LoginUtility.sanitizeLog(cleanUserId), LoginUtility.sanitizeLog(newTxId), remainingCooldown, remainingResends);

                    return Mono.when(
                            redis.opsForValue().set(activeTxKey, newTxId, screenTimeoutDuration),
                            redis.opsForValue().set("OTP_SESSION:" + newTxId, cleanUserId, screenTimeoutDuration),
                            redis.opsForValue().set("OTP_TX:" + newTxId, existingOtpPayload, existingOtpTtl),
                            redis.opsForValue().set("OTP_FAILURES:" + newTxId, existingFailures, existingOtpTtl)
                    ).thenReturn(new OtpSessionInitResult(
                            false, // Do NOT send a duplicate SMS/Email!
                            remainingOtpSec,
                            remainingCooldown,
                            remainingResends,
                            screenTimeoutMin
                    ));
                }

                // =========================================================================
                // BRANCH 2: BLOCK IF PREVIOUS OTP WAS BURNED/EXPIRED & LIMITS ARE ACTIVE
                // =========================================================================
                if (isCooldownActive) {
                    return Mono.error(new ResponseStatusException(
                            HttpStatus.TOO_MANY_REQUESTS,
                            "Please wait " + cooldownRemainingSec + " seconds before requesting another code."
                    ));
                }

                if (isQuotaExhausted) {
                    return Mono.error(new ResponseStatusException(
                            HttpStatus.TOO_MANY_REQUESTS,
                            "Maximum resend limit reached. Kindly Wait."
                    ));
                }

                // =========================================================================
                // BRANCH 3: GENERATE & DISPATCH FRESH OTP (Enforcing Cooldown & 10m Quota)
                // =========================================================================
                return redis.opsForValue().setIfAbsent(userCooldownKey, "locked", cooldownDuration)
                        .flatMap(acquired -> {
                            if (!Boolean.TRUE.equals(acquired)) {
                                return redis.getExpire(userCooldownKey)
                                        .flatMap(ttl -> Mono.error(new ResponseStatusException(
                                                HttpStatus.TOO_MANY_REQUESTS,
                                                "Please wait " + Math.max(1, ttl.getSeconds()) + " seconds before requesting another code."
                                        )));
                            }

                            Mono<Long> updateResendCounter;
                            if (!hasResendWindow) {
                                // First login in the 10-minute window: Initialize counter to 0
                                updateResendCounter = redis.opsForValue()
                                        .set(userResendKey, "0", resendWindowDuration)
                                        .thenReturn(0L);
                            } else {
                                // User re-initiated login after 60s within the 10m window: Count as 1 resend
                                updateResendCounter = redis.opsForValue().increment(userResendKey);
                            }

                            return updateResendCounter.flatMap(updatedResends -> {
                                if (updatedResends > maxResends) {
                                    return redis.delete(userCooldownKey)
                                            .then(Mono.error(new ResponseStatusException(
                                                    HttpStatus.TOO_MANY_REQUESTS,
                                                    "Maximum resend limit reached. Kindly Wait."
                                            )));
                                }

                                int remainingResends = maxResends - updatedResends.intValue();

                                return saveOtpStateInternal(newTxId, cleanUserId, newPlainOtp, params)
                                        .thenReturn(new OtpSessionInitResult(
                                                true, // Dispatch new OTP to Kafka
                                                otpValidityMin * 60,
                                                cooldownSec,
                                                remainingResends,
                                                screenTimeoutMin
                                        ));
                            });
                        });
            });
        });
    }

    /**
     * Executes an OTP Resend on the OTP screen.
     * Enforces 15-minute screen timeout, 60-second cooldown, and maximum 3 resends per 10-minute window.
     * Refreshes the 15-minute sliding idle window on success.
     * Returns Tuple3 of (NewPlainOtp, UserId, RemainingResends).
     */
    public Mono<Tuple3<String, String, Integer>> processResend(String txId, String newPlainOtp) {
        final LoginParam params = loginParamCacheService.getCachedLoginParam();
        final Duration cooldownDuration = Duration.ofSeconds(params.getSafeOtpResendCooldownSec());
        final Duration resendWindowDuration = Duration.ofMinutes(params.getSafeOtpResendWindowMin());
        final int maxResends = params.getSafeOtpMaxResends();

        final String sessionKey = "OTP_SESSION:" + txId;

        // 1. Check 15-Minute OTP Entry Screen Timeout
        return redis.opsForValue().get(sessionKey)
                .switchIfEmpty(Mono.error(new ResponseStatusException(
                        HttpStatus.UNAUTHORIZED,
                        "Your session has timed out. Please log in again."
                )))
                .flatMap(userId -> {
                    final String cleanUserId = userId.trim();
                    final String userCooldownKey = "OTP_COOLDOWN:USR:" + cleanUserId;
                    final String userResendKey = "OTP_RESENDS:USR:" + cleanUserId;

                    // 2. Check 60-Second User Cooldown Lock (Section 2.2.5 & 2.4)
                    return redis.opsForValue().setIfAbsent(userCooldownKey, "locked", cooldownDuration)
                            .flatMap(acquired -> {
                                if (!Boolean.TRUE.equals(acquired)) {
                                    return redis.getExpire(userCooldownKey)
                                            .flatMap(ttl -> {
                                                long secondsLeft = Math.max(1, ttl.getSeconds());
                                                return Mono.error(new ResponseStatusException(
                                                        HttpStatus.TOO_MANY_REQUESTS,
                                                        "Please wait " + secondsLeft + " seconds before requesting another code."
                                                ));
                                            });
                                }

                                // 3. Atomic Increment User Resends within 10-Minute Window (Section 2.2.5 & 2.4)
                                return redis.opsForValue().increment(userResendKey)
                                        .flatMap(resendCount -> {
                                            if (resendCount == 1) {
                                                return redis.expire(userResendKey, resendWindowDuration).thenReturn(resendCount);
                                            }
                                            return Mono.just(resendCount);
                                        })
                                        .flatMap(resendCount -> {
                                            if (resendCount > maxResends) {
                                                return redis.delete(userCooldownKey)
                                                        .then(Mono.error(new ResponseStatusException(
                                                                HttpStatus.TOO_MANY_REQUESTS,
                                                                "Maximum resend limit reached. Kindly Wait."
                                                        )));
                                            }

                                            int remainingResends = maxResends - resendCount.intValue();

                                            // 4. Save new OTP state (resets failure count to 0 & refreshes 15m idle session)
                                            return saveOtpStateInternal(txId, cleanUserId, newPlainOtp, params)
                                                    .thenReturn(Tuples.of(newPlainOtp, cleanUserId, remainingResends));
                                        });
                            });
                });
    }

    /**
     * Verifies the OTP using constant-time cryptographic matching (BCrypt) on boundedElastic scheduler.
     * Refreshes the 15-minute sliding idle window on user activity.
     * Protected by an atomic lock to prevent double-click race conditions.
     */
    public Mono<String> verifyOtp(String txId, String inputOtp) {
        final LoginParam params = loginParamCacheService.getCachedLoginParam();
        final int maxFailures = params.getSafeOtpMaxAttempts();
        final Duration screenTimeout = Duration.ofMinutes(params.getSafeOtpScreenTimeoutMin());

        final String sessionKey = "OTP_SESSION:" + txId;
        final String txKey = "OTP_TX:" + txId;
        final String failKey = "OTP_FAILURES:" + txId;
        final String verifyLockKey = "OTP_VERIFY_LOCK:" + txId;

        // 0. Atomic Double-Click Protection Lock (10s TTL)
        return redis.opsForValue().setIfAbsent(verifyLockKey, "verifying", Duration.ofSeconds(10))
                .flatMap(lockAcquired -> {
                    if (!Boolean.TRUE.equals(lockAcquired)) {
                        return Mono.error(new ResponseStatusException(
                                HttpStatus.TOO_MANY_REQUESTS,
                                "Verification already in progress. Please wait."
                        ));
                    }

                    // 1. Check if the 15-minute OTP entry screen session is still active
                    return redis.opsForValue().get(sessionKey)
                            .switchIfEmpty(
                                    redis.delete(verifyLockKey).then(Mono.error(new ResponseStatusException(
                                            HttpStatus.UNAUTHORIZED,
                                            "Your session has timed out. Please log in again."
                                    )))
                            )
                            .flatMap(sessionUserId -> {
                                final String cleanUserId = sessionUserId.trim();
                                // Refresh the 15-minute sliding idle timeout since the user is actively interacting
                                return Mono.when(
                                                redis.expire(sessionKey, screenTimeout),
                                                redis.expire("OTP_ACTIVE_TX:USR:" + cleanUserId, screenTimeout)
                                        )
                                        .then(redis.opsForValue().get(txKey))
                                        .switchIfEmpty(
                                                redis.delete(verifyLockKey).then(Mono.error(new ResponseStatusException(
                                                        HttpStatus.BAD_REQUEST,
                                                        "The code is invalid or has expired. Please request a new code."
                                                )))
                                        )
                                        .flatMap(payload ->
                                                Mono.fromCallable(() -> {
                                                            Map<String, String> data = mapper.readValue(payload, new TypeReference<>() {
                                                            });
                                                            String userId = data.get("userId");
                                                            String storedHash = data.get("otpHash");
                                                            boolean matched = passwordEncoder.matches(inputOtp, storedHash);
                                                            return Tuples.of(userId, matched);
                                                        })
                                                        .subscribeOn(Schedulers.boundedElastic())
                                                        .flatMap(result -> {
                                                            String userId = result.getT1().trim();
                                                            boolean matched = result.getT2();

                                                            if (matched) {
                                                                // SUCCESS (Section 2.2.8): Delete all OTP & User quota keys
                                                                return cleanupAllOtpKeysOnSuccess(txId, userId).thenReturn(userId);
                                                            } else {
                                                                // FAILURE (Section 2.2.6): Atomic increment wrong attempts
                                                                return redis.opsForValue().increment(failKey)
                                                                        .flatMap(failCount -> {
                                                                            if (failCount >= maxFailures) {
                                                                                return Mono.when(
                                                                                                redis.delete(txKey),
                                                                                                redis.delete(failKey),
                                                                                                redis.delete(verifyLockKey)
                                                                                        )
                                                                                        .then(Mono.error(new ResponseStatusException(
                                                                                                HttpStatus.BAD_REQUEST,
                                                                                                "Too many incorrect attempts. The code has been expired. Please request a new code."
                                                                                        )));
                                                                            }
                                                                            long remaining = maxFailures - failCount;
                                                                            return redis.delete(verifyLockKey)
                                                                                    .then(Mono.error(new ResponseStatusException(
                                                                                            HttpStatus.BAD_REQUEST,
                                                                                            "Invalid code. " + remaining + " attempts remaining."
                                                                                    )));
                                                                        });
                                                            }
                                                        })
                                        );
                            })
                            .onErrorResume(e -> {
                                if (e instanceof ResponseStatusException) {
                                    return Mono.error(e);
                                }
                                log.error("Unexpected error during OTP verification for txId={}", LoginUtility.sanitizeLog(txId), e);
                                return redis.delete(verifyLockKey)
                                        .then(Mono.error(new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,
                                                "Redis payload corruption")));
                            });
                });
    }

    /**
     * Internal helper: Hashes the OTP on boundedElastic and saves the transaction state in Redis.
     */
    private Mono<Void> saveOtpStateInternal(String txId, String userId, String plainOtp, LoginParam params) {
        final Duration otpValidity = Duration.ofMinutes(params.getSafeOtpValidityMin());
        final Duration screenTimeout = Duration.ofMinutes(params.getSafeOtpScreenTimeoutMin());

        return Mono.fromCallable(() -> {
                    String hash = passwordEncoder.encode(plainOtp);
                    return mapper.writeValueAsString(Map.of("userId", userId, "otpHash", hash));
                })
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(payload -> {
                    List<Mono<?>> operations = new ArrayList<>();

                    // 1. Register this txId as the ONLY active OTP session for this user
                    operations.add(redis.opsForValue().set("OTP_ACTIVE_TX:USR:" + userId, txId, screenTimeout));

                    // 2. Overall 15-Minute OTP Screen Session Tracker
                    operations.add(redis.opsForValue().set("OTP_SESSION:" + txId, userId, screenTimeout));

                    // 3. Active 5-Minute OTP Code Hash
                    operations.add(redis.opsForValue().set("OTP_TX:" + txId, payload, otpValidity));

                    // 4. Reset wrong attempt counter to 0 for the new code
                    operations.add(redis.opsForValue().set("OTP_FAILURES:" + txId, "0", otpValidity));

                    return Mono.when(operations)
                            .doOnSuccess(v -> log.info("Saved OTP State txId={} for user={}",
                                    LoginUtility.sanitizeLog(txId), LoginUtility.sanitizeLog(userId)));
                });
    }

    /**
     * Deletes all Redis keys (both txId keys and User quota keys) upon successful verification.
     */
    private Mono<Void> cleanupAllOtpKeysOnSuccess(String txId, String userId) {
        return Mono.when(
                redis.delete("OTP_SESSION:" + txId),
                redis.delete("OTP_TX:" + txId),
                redis.delete("OTP_FAILURES:" + txId),
                redis.delete("OTP_VERIFY_LOCK:" + txId),
                redis.delete("OTP_ACTIVE_TX:USR:" + userId),
                redis.delete("OTP_COOLDOWN:USR:" + userId),
                redis.delete("OTP_RESENDS:USR:" + userId)
        );
    }

    /**
     * Compensating transaction for Initial Login: Cleans up the Redis state if Kafka fails during /login.
     * Also rolls back the OTP_RESENDS counter so a retry after Kafka failure is not penalized.
     */
    public Mono<Void> rollbackInitialOtpState(String txId, String userId) {
        final String cleanUserId = userId != null ? userId.trim() : "";
        final String userResendKey = "OTP_RESENDS:USR:" + cleanUserId;

        Mono<Void> rollbackResendWindow = redis.opsForValue().get(userResendKey)
                .flatMap(val -> {
                    if ("0".equals(val)) {
                        return redis.delete(userResendKey).then();
                    } else {
                        return redis.opsForValue().decrement(userResendKey).then();
                    }
                });

        return Mono.when(
                redis.delete("OTP_SESSION:" + txId),
                redis.delete("OTP_TX:" + txId),
                redis.delete("OTP_FAILURES:" + txId),
                redis.delete("OTP_ACTIVE_TX:USR:" + cleanUserId),
                redis.delete("OTP_COOLDOWN:USR:" + cleanUserId),
                rollbackResendWindow
        ).doOnSuccess(v -> log.info("Rolled back initial OTP state for txId={}", LoginUtility.sanitizeLog(txId)));
    }

    /**
     * Compensating transaction for Resend: If Kafka fails during /resend-otp,
     * preserves OTP_SESSION, decrements the resend counter, and releases the 60s cooldown lock.
     */
    public Mono<Void> rollbackResendState(String txId, String userId) {
        final String cleanUserId = userId != null ? userId.trim() : "";
        return Mono.when(
                redis.delete("OTP_COOLDOWN:USR:" + cleanUserId),
                redis.opsForValue().decrement("OTP_RESENDS:USR:" + cleanUserId)
        ).doOnSuccess(v -> log.info("Rolled back resend increment and cooldown for txId={}", LoginUtility.sanitizeLog(txId)));
    }

    /**
     * Value object returned when initiating or resuming a user's OTP session on /login.
     */
    public record OtpSessionInitResult(
            boolean shouldDispatchNewOtp,
            int expiresInSeconds,
            int resendCooldownSeconds,
            int resendsRemaining,
            int otpScreenTimeoutMin
    ) {
    }
}



























package com.fincore.gateway.Service;

import com.fincore.gateway.utility.LoginUtility;
import tools.jackson.databind.ObjectMapper;
import com.fincore.commonutilities.util.AesEncryptionUtil;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.kafka.core.KafkaTemplate;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

import java.time.Instant;
import java.util.List;
import java.util.Map;
import java.util.UUID;

/**
 * Publishes encrypted PII payloads to Kafka.
 * * INTERNAL AES KEY INSTRUCTION:
 * The `security.internal.kafka-aes-key` property is a static, shared secret between
 * the Fincore Gateway and the Communication Service.
 * Generate this once using `AesEncryptionUtil.generateBase64SessionKey()` and store
 * it in your application-dev/uat/prod.properties.
 * Example: security.internal.kafka-aes-key=bWV0a...
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class OtpKafkaProducer {

    private final KafkaTemplate<String, String> kafkaTemplate;
    private final ObjectMapper mapper;
    private final AesEncryptionUtil aesUtil;
    private final LoginParamCacheService loginParamCacheService;

    @Value("${security.internal.kafka-aes-key}")
    private String internalAesKey;

    @Value("${spring.profiles.active:dev}")
    private String currentEnvironment;

    public Mono<Void> publishOtpEvent(String txId, String mobile, String email, String plainOtp, String userName, List<String> activeChannels) {
        return Mono.fromCallable(() -> {
                    /*
                     * ====================================================================
                     * ZERO-TRUST KAFKA PAYLOAD ARCHITECTURE
                     * ====================================================================
                     */
                    int expiryMins = loginParamCacheService.getCachedLoginParam().getSafeOtpValidityMin();

                    // 1. Build the sensitive inner payload (Dynamically parameterized from LOGIN_PARAM)
                    Map<String, Object> innerPayload = Map.of(
                            "otpPlaintext", plainOtp,
                            "expiryMins", expiryMins,
                            "userName", userName != null ? userName : "User"
                    );
                    String innerJson = mapper.writeValueAsString(innerPayload);

                    // 2. Encrypt the inner payload (Zero-Trust on Broker)
                    String encryptedPayload = aesUtil.encrypt(innerJson, internalAesKey);

                    // 3. Build the outer routable event
                    Map<String, Object> event = Map.of(
                            "eventId", "evt-" + UUID.randomUUID().toString(),
                            "txId", txId,
                            "eventType", "LOGIN_OTP",
                            "channel", activeChannels,
                            "priority", "CRITICAL",
                            "templateId", "AUTH_LOGIN_OTP_V1",
                            "recipient", Map.of(
                                    "mobile", mobile != null ? mobile : "",
                                    "email", email != null ? email : ""
                            ),
                            "payload", encryptedPayload,
                            "createdAt", Instant.now().toString()
                    );

                    return mapper.writeValueAsString(event);

                }).flatMap(jsonString -> {
                    // Wraps standard KafkaTemplate into a non-blocking Mono
                    return Mono.fromFuture(
                            kafkaTemplate.send("fincore.auth.otp.priority", txId, jsonString)
                    );
                }).doOnSuccess(result -> log.info("Encrypted OTP event published to Kafka for txId={}", LoginUtility.sanitizeLog(txId)))
                .then();
    }
}
















