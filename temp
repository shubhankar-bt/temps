package com.fincore.DashboardService.controller;

import com.fincore.DashboardService.dto.ApiResponse;
import com.fincore.DashboardService.dto.DashboardDataResponse;
import com.fincore.DashboardService.dto.response.TrendResponse;
import com.fincore.DashboardService.service.DashboardService;
import com.fincore.DashboardService.service.DashboardTrendService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

/**
 * Main REST Controller for the FinCore Executive Dashboard.
 * 
 * This controller serves as the primary entry point for all dashboard-related UI components.
 * It strictly acts as an HTTP routing and orchestration layer, delegating business logic 
 * and database interactions to the underlying service layers.
 * 
 * Please see the comprehensive architectural documentation at the bottom of this file 
 * regarding API separation and UI lifecycle behavior.
 */
@Slf4j
@RestController
@RequestMapping("/api/dashboard")
@RequiredArgsConstructor
public class DashboardController {

    // Existing service created by team mate for Single-Day Point-In-Time Snapshot
    private final DashboardService dashboardService;
    
    // New service for 7-Day Columnar Time-Series (Approach B)
    private final DashboardTrendService dashboardTrendService;

    // ===================================================================================
    // API 1: THE OVERVIEW (Current Snapshot) - Maintained as-is
    // ===================================================================================
    /**
     * Fetches the single-day snapshot for the dashboard (CASA Ratio, Composition, etc.).
     * This API is highly optimized via a single bulk Druid query to prevent N+1 latency.
     * 
     * @param token JWT Authorization token containing user scope and roles.
     * @return DashboardDataResponse containing nested JSON for the top-fold KPI charts.
     */
    @GetMapping("/dashboard-data")
    public ResponseEntity<ApiResponse<DashboardDataResponse>> executeDashBoard(
            @RequestHeader("Authorization") String token) {

        log.info("Received request for Dashboard Overview Snapshot.");
        
        // Execute the existing parallel processing logic
        DashboardDataResponse response = dashboardService.fetchDashboardData(token);
        
        return ResponseEntity.ok(ApiResponse.success(response, "Dashboard overview stats loaded"));
    }

    // ===================================================================================
    // API 2: THE TREND DATA (7-Day Historical) - New Implementation
    // ===================================================================================
    /**
     * Fetches the time-series trend data for the requested number of days.
     * Utilizes a columnar JSON structure (Approach B) to drastically reduce network payload.
     * 
     * @param token JWT Authorization token.
     * @param days  Number of historical days to fetch (Defaults to 7).
     * @return TrendResponse containing flat date arrays and parallel series arrays.
     */
    @GetMapping("/trend-data")
    public ResponseEntity<ApiResponse<TrendResponse>> getTrendData(
            @RequestHeader("Authorization") String token,
            @RequestParam(defaultValue = "7") int days) {

        log.info("Received request for Dashboard Trend Data. Days requested: {}", days);

        // Delegate to the new Trend Service
        TrendResponse response = dashboardTrendService.fetchTrendData(days);

        return ResponseEntity.ok(ApiResponse.success(response, days + "-Day trend data loaded successfully"));
    }

    // ===================================================================================
    // FUTURE API 3: FORECASTING (Predictive ML)
    // ===================================================================================
    /**
     * Fetches ARIMA-based predictive trends for the next 30/60/90 days.
     * Reads strictly from the offline-generated FINANCIAL_FORECAST Oracle table.
     */
    @GetMapping("/forecast-data")
    public ResponseEntity<ApiResponse<Object>> getForecastData(
            @RequestHeader("Authorization") String token,
            @RequestParam(defaultValue = "30") int forecastHorizon) {
        
        log.info("Received request for Forecast Data. Horizon: {}", forecastHorizon);
        return ResponseEntity.ok(ApiResponse.success(null, "Forecast API coming in Phase 3"));
    }

    // ===================================================================================
    // FUTURE API 4: GEOGRAPHY & HEATMAPS
    // ===================================================================================
    /**
     * Fetches geographic distribution data for Circle/Branch heat maps.
     * Lazy-loaded by the UI to prevent blocking the initial page render.
     */
    @GetMapping("/geography-data")
    public ResponseEntity<ApiResponse<Object>> getGeographyData(
            @RequestHeader("Authorization") String token,
            @RequestParam(defaultValue = "CIRCLE") String level) {

        log.info("Received request for Geography Data. Level: {}", level);
        return ResponseEntity.ok(ApiResponse.success(null, "Geography API coming in Phase 4"));
    }

    // ===================================================================================
    // FUTURE API 5: DRILL-DOWN
    // ===================================================================================
    /**
     * Fetches detailed sub-ledger data when a user clicks a specific Circle or Branch.
     * Will enforce strict DataScopeResolver security rules.
     */
    @GetMapping("/drill-down")
    public ResponseEntity<ApiResponse<Object>> getDrillDownData(
            @RequestHeader("Authorization") String token,
            @RequestParam String circleCode,
            @RequestParam(required = false) String branchCode) {

        log.info("Received request for Drill-Down Data. Circle: {}, Branch: {}", circleCode, branchCode);
        return ResponseEntity.ok(ApiResponse.success(null, "Drill-down API coming in Phase 5"));
    }
}

/* 
 * ===================================================================================
 * ARCHITECTURAL DOCUMENTATION: API STRATEGY & DASHBOARD LIFECYCLE
 * ===================================================================================
 * 
 * 1. WHY SEPARATE APIS INSTEAD OF A SINGLE '/dashboard' MONOLITH?
 * ----------------------------------------------------------------
 * Early dashboard designs often attempt to fetch all data (KPIs, Trends, Maps, Forecasts)
 * in a single API call. We explicitly reject that design for the following reasons:
 * 
 * A. Progressive Rendering (UX): 
 *    If the Geographical Map takes 3 seconds to compute, a single API forces the user 
 *    to stare at a blank screen for 3 seconds. By splitting the APIs, the top-fold 
 *    KPIs (Overview) load in milliseconds, while the Trend Charts show a skeleton 
 *    loader in the background. The user perceives the system as instantly responsive.
 * 
 * B. Fault Isolation (Resilience):
 *    If the ARIMA ML model (Forecast) goes offline, or if the offline Oracle batch fails, 
 *    only the Forecast API returns a 502/500 error. The rest of the dashboard remains 
 *    100% functional. A single API would cause the entire dashboard to crash.
 * 
 * C. Caching Granularity:
 *    The 7-Day Trend data only changes once a day at midnight. It can be cached in Redis 
 *    with a 24-hour TTL. The Overview data might require real-time Druid querying. 
 *    Separating them allows distinct cache strategies.
 * 
 * D. Payload Optimization:
 *    Loading everything at once results in massive JSON payloads (megabytes of data). 
 *    This spikes JVM memory on the backend and causes browser jank (stuttering) on the frontend.
 * 
 * 
 * 2. THE END-TO-END DASHBOARD LIFECYCLE (How it behaves)
 * ----------------------------------------------------------------
 * Step 1: User Login & Context
 *    - The user logs in via the Auth Service.
 *    - The frontend receives a JWT. This JWT contains the User ID, Role, and Branch Code.
 * 
 * Step 2: The Initial Page Load (Parallel Fetch)
 *    - The user navigates to the Dashboard route.
 *    - The React frontend immediately fires TWO asynchronous requests simultaneously:
 *      1) GET /api/dashboard/dashboard-data (Overview)
 *      2) GET /api/dashboard/trend-data?days=7 (Trends)
 * 
 * Step 3: Progressive Display
 *    - The 'dashboard-data' API returns almost instantly. The UI immediately renders 
 *      the CASA Gauge, the Demand vs Time Donut chart, and the summary KPI cards.
 *    - The 'trend-data' API arrives shortly after, and the skeleton loaders in the 
 *      bottom half of the screen are replaced by the Stacked Bar Charts.
 * 
 * Step 4: Lazy Loading (Scroll Event)
 *    - As the user scrolls down to the Map section, the frontend fires a request 
 *      to GET /api/dashboard/geography-data. This ensures we don't query heavy 
 *      geographic coordinates unless the user actually wants to see them.
 * 
 * Step 5: User Interaction (Drill-Down)
 *    - The user (e.g., a Bank-level manager) clicks on "Circle C01" in the Heat Map.
 *    - The frontend fires GET /api/dashboard/drill-down?circleCode=C01.
 *    - The Backend intercepts this, verifies the user has authorization to view C01 
 *      via the DataScopeResolver, and returns the specific branch details.
 * 
 * CONCLUSION:
 * This design strictly adheres to the Single Responsibility Principle (SRP) and aligns 
 * perfectly with modern React 'Suspense' and asynchronous data-fetching standards.
 * ===================================================================================
 */
