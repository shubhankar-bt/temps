        // 2. Format massive numbers to prevent Scientific Notation (E10)
        for (String metric : metrics) {
            Object amountObj = row.get(metric);
            if (amountObj != null) {
                try {
                    // Convert to BigDecimal and strictly set scale to 2 decimals
                    BigDecimal bd = new BigDecimal(amountObj.toString()).setScale(2, RoundingMode.HALF_UP);
                    
                    // CRITICAL FIX: Put the BigDecimal directly into the map!
                    // Do NOT call .doubleValue(). This forces Jackson to print the full number.
                    row.put(metric, bd); 
                    
                } catch (NumberFormatException ignored) {
                    row.put(metric, BigDecimal.ZERO);
                }
            }
        }
