-- 1. Compare FINCORE_SETTINGS vs old working FINCORE_SETTINGS_TEMP
SELECT 'NEW' AS SRC, ID, FUNCTIONALITY, ENV, URL, USERNAME, PASSWORD, API_KEY, EMAIL_SENDER_ID
FROM FINCORE_SETTINGS
WHERE ENV = 'UAT'
UNION ALL
SELECT 'OLD' AS SRC, ID, FUNCTIONALITY, ENV, URL, USERNAME, PASSWORD, API_KEY, EMAIL_SENDER_ID
FROM FINCORE_SETTINGS_TEMP
WHERE ENV = 'UAT'
ORDER BY FUNCTIONALITY, SRC;

-- 2. Verify the SMS template body being rendered for AUTH_LOGIN_OTP_V1
SELECT TEMPLATE_CODE, CHANNEL, LANGUAGE, IS_ACTIVE, BODY_CONTENT
FROM COMM_TEMPLATE_MASTER
WHERE TEMPLATE_CODE = 'AUTH_LOGIN_OTP_V1'
  AND CHANNEL = 'SMS';
