package com.fincore.gateway.exception;

import com.fincore.gateway.dto.ApiResponse;
import io.jsonwebtoken.ExpiredJwtException;
import io.jsonwebtoken.JwtException;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;
import org.springframework.web.bind.support.WebExchangeBindException;
import org.springframework.web.server.ResponseStatusException;

@Slf4j
@RestControllerAdvice
public class GlobalExceptionHandler {

    @ExceptionHandler(ResponseStatusException.class)
    public ResponseEntity<ApiResponse<Void>> handleResponseStatusException(ResponseStatusException ex) {
        log.warn("Auth Status Error: {} - {}", ex.getStatusCode(), ex.getReason());
        String errorCode = mapStatusToCode(ex.getStatusCode().value());
        return ResponseEntity.status(ex.getStatusCode())
                .body(ApiResponse.error(ex.getReason(), errorCode));
    }

    @ExceptionHandler(ExpiredJwtException.class)
    public ResponseEntity<ApiResponse<Void>> handleExpiredJwt(ExpiredJwtException ex) {
        log.warn("Token Expired: {}", ex.getMessage());
        return ResponseEntity.status(HttpStatus.UNAUTHORIZED)
                .body(ApiResponse.error("Token has expired", "TOKEN_EXPIRED"));
    }

    @ExceptionHandler(JwtException.class)
    public ResponseEntity<ApiResponse<Void>> handleJwtException(JwtException ex) {
        log.error("JWT Error: {}", ex.getMessage());
        return ResponseEntity.status(HttpStatus.UNAUTHORIZED)
                .body(ApiResponse.error("Invalid token", "INVALID_TOKEN"));
    }

    @ExceptionHandler(SecurityException.class)
    public ResponseEntity<ApiResponse<Void>> handleSecurityException(SecurityException ex) {
        log.warn("Security Violation: {}", ex.getMessage());
        return ResponseEntity.status(HttpStatus.FORBIDDEN)
                .body(ApiResponse.error(ex.getMessage(), "ACCESS_DENIED"));
    }

    @ExceptionHandler(WebExchangeBindException.class)
    public ResponseEntity<ApiResponse<Void>> handleValidationException(WebExchangeBindException ex) {
        String errorMsg = ex.getBindingResult().getAllErrors().get(0).getDefaultMessage();
        return ResponseEntity.status(HttpStatus.BAD_REQUEST)
                .body(ApiResponse.error(errorMsg, "VALIDATION_ERROR"));
    }

    @ExceptionHandler(Exception.class)
    public ResponseEntity<ApiResponse<Void>> handleGenericException(Exception ex) {
        log.error("System Error", ex);
        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                .body(ApiResponse.error("Internal System Error", "SYSTEM_ERROR"));
    }

    private String mapStatusToCode(int status) {
        return switch (status) {
            case 401 -> "UNAUTHORIZED";
            case 403 -> "FORBIDDEN";
            case 400 -> "BAD_REQUEST";
            case 404 -> "NOT_FOUND";
            case 429 -> "TOO_MANY_REQUESTS";
            case 503 -> "SERVICE_UNAVAILABLE";
            default -> "ERROR";
        };
    }
}






    @Override
    public Mono<OtpInitiatedResponseDTO> initiateOtpPhase(UserDto userDto) {
        UserTokenDataDto tokenData = userDto.getUser();

        String mobile = (tokenData != null && tokenData.getPhoneNumber() != null) ? tokenData.getPhoneNumber().trim() : "";
        String email = (tokenData != null && tokenData.getEmail() != null) ? tokenData.getEmail().trim() : "";

        // 1. THE FAIL-FAST BARRIER (Table 2.4 exact message)
        boolean hasMobile = !mobile.isEmpty();
        boolean hasEmail = email.contains("@");

        if (!hasMobile && !hasEmail) {
            log.error("Login halted for user {}: No registered mobile or email found.", LoginUtility.sanitizeLog(userDto.getUserId()));
            return Mono.error(new ResponseStatusException(
                    HttpStatus.BAD_REQUEST,
                    "Code cannot be sent: No valid mobile number or email address is mapped with User ID."
            ));
        }

        // 2. DYNAMIC CHANNEL ROUTER
        List<String> activeChannels = new java.util.ArrayList<>();
        if (hasMobile) activeChannels.add("SMS");
        if (hasEmail) activeChannels.add("EMAIL");

        String txId = UUID.randomUUID().toString();
        String plainOtp = generateSecureOtp();
        String fName = tokenData.getFirstName() != null ? tokenData.getFirstName() : "User";

        // Construct exact Table 2.4 user message
        String maskedMob = hasMobile ? maskMobile(mobile) : "";
        String maskedEm = hasEmail ? maskEmail(email) : "";
        String message;
        if (hasMobile && hasEmail) {
            message = "Code sent to " + maskedMob + " and " + maskedEm;
        } else if (hasMobile) {
            message = "Code sent to " + maskedMob;
        } else {
            message = "Code sent to " + maskedEm;
        }

        final String finalMessage = message;

        // 3. THE SAGA PIPELINE (Redis -> Kafka -> Success OR Rollback)
        return otpSessionService.saveOtpState(txId, userDto.getUserId(), plainOtp, false)
                .then(otpKafkaProducer.publishOtpEvent(txId, mobile, email, plainOtp, fName, activeChannels))
                .thenReturn(OtpInitiatedResponseDTO.builder()
                        .transactionId(txId)
                        .maskedMobile(hasMobile ? maskedMob : "Not Registered")
                        .maskedEmail(hasEmail ? maskedEm : "Not Registered")
                        .expiresInSeconds(300)
                        .resendCooldownSeconds(60) // Updated to 60s per Section 2.2.5
                        .resendsRemaining(3)       // Updated to 3 max resends per Section 2.2.5
                        .message(finalMessage)     // Injected exact message
                        .build())
                .onErrorResume(error -> {
                    // 4. COMPENSATING TRANSACTION (KAFKA DOWN - Table 2.4 message)
                    log.error("Infrastructure failure during OTP dispatch for txId={}. Rolling back Redis state.", LoginUtility.sanitizeLog(txId), error);

                    return otpSessionService.rollbackOtpState(txId)
                            .then(Mono.error(new ResponseStatusException(
                                    HttpStatus.SERVICE_UNAVAILABLE,
                                    "Unable to reach the SMS/email provider. Please try again after some time."
                            )));
                });
    }

    @Override
    public Mono<UserDto> verifyOtpAndGetUser(VerifyOtpRequestDTO requestDto) {
        return otpSessionService.verifyOtp(requestDto.getTransactionId(), requestDto.getOtp())
                .flatMap(userId -> Mono.fromCallable(() -> {
                    UserDto userDto = getUserProfile(userId);
                    if (userDto == null) {
                        throw new IllegalStateException("User missing post OTP verification");
                    }
                    userDto.setValidCredentials(true);
                    return userDto;
                }).subscribeOn(Schedulers.boundedElastic()));
    }

    @Override
    public Mono<OtpResendResponseDTO> resendOtp(ResendOtpRequestDTO requestDto, String clientIp) {
        String txId = requestDto.getTransactionId();

        return otpSessionService.checkIpRateLimit(clientIp)
                // 1. Process Resend atomically in Redis (Enforces 60s cooldown & max 3 resends)
                .then(otpSessionService.processResend(txId, generateSecureOtp()))
                .flatMap(tuple -> {

                    String plainOtp = tuple.getT1();
                    String userId = tuple.getT2();
                    Long currentResendCount = tuple.getT3();

                    int remaining = 3 - currentResendCount.intValue(); // Max(3) - Current

                    // 2. Fetch User Profile for contact info
                    return Mono.fromCallable(() -> getUserProfile(userId))
                            .subscribeOn(Schedulers.boundedElastic())
                            .flatMap(userDto -> {

                                UserTokenDataDto tokenData = userDto.getUser();
                                String mobile = (tokenData != null && tokenData.getPhoneNumber() != null) ?
                                        tokenData.getPhoneNumber().trim() : "";
                                String email = (tokenData != null && tokenData.getEmail() != null) ?
                                        tokenData.getEmail().trim() : "";

                                // 3. THE FAIL-FAST BARRIER
                                boolean hasMobile = !mobile.isEmpty();
                                boolean hasEmail = email.contains("@");

                                if (!hasMobile && !hasEmail) {
                                    log.error("OTP Resend halted for user {}: No registered mobile or email found.", LoginUtility.sanitizeLog(userId));
                                    return Mono.error(new ResponseStatusException(
                                            HttpStatus.BAD_REQUEST,
                                            "Code cannot be sent: No valid mobile number or email address is mapped with User ID."
                                    ));
                                }

                                // 4. DYNAMIC CHANNEL ROUTER
                                List<String> activeChannels = new java.util.ArrayList<>();
                                if (hasMobile) activeChannels.add("SMS");
                                if (hasEmail) activeChannels.add("EMAIL");

                                String fName = tokenData.getFirstName() != null ? tokenData.getFirstName() : "User";

                                // Construct exact Table 2.4 RESEND message (Prefixed with "New ")
                                String maskedMob = hasMobile ? maskMobile(mobile) : "";
                                String maskedEm = hasEmail ? maskEmail(email) : "";
                                String message;
                                if (hasMobile && hasEmail) {
                                    message = "New Code sent to " + maskedMob + " and " + maskedEm;
                                } else if (hasMobile) {
                                    message = "New Code sent to " + maskedMob;
                                } else {
                                    message = "New Code sent to " + maskedEm;
                                }

                                final String finalMessage = message;

                                // 5. THE SAGA PIPELINE (Kafka Publish -> Rollback on Failure)
                                return otpKafkaProducer.publishOtpEvent(txId, mobile, email, plainOtp, fName, activeChannels)
                                        .thenReturn(OtpResendResponseDTO.builder()
                                                .resendCooldownSeconds(60)
                                                .resendsRemaining(remaining)
                                                .message(finalMessage)
                                                .build())
                                        .onErrorResume(error -> {
                                            log.error("Infrastructure failure during OTP resend for txId={}. Rolling back Redis state.", LoginUtility.sanitizeLog(txId), error);
                                            return otpSessionService.rollbackOtpState(txId)
                                                    .then(Mono.error(new ResponseStatusException(
                                                            HttpStatus.SERVICE_UNAVAILABLE,
                                                            "Unable to reach the SMS/email provider. Please try again after some time."
                                                    )));
                                        });
                            });
                });
    }
























