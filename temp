    private UserTokenDataDto initializeTokenData(User user, UserRoles userRole) {
        UserTokenDataDto tokenData = new UserTokenDataDto();
        tokenData.setFirstName(user.getFirstName());
        tokenData.setMiddleName(user.getMiddleName());
        tokenData.setLastName(user.getLastName());
        tokenData.setPhoneNumber(user.getPhoneNumber());
        tokenData.setUserId(user.getUserId());
        tokenData.setBranch(user.getBranch());
        tokenData.setEmail(user.getEmail());
        if (userRole != null) {
            tokenData.setRole(userRole.getRole());
            tokenData.setRoleName(userRole.getRoleName());
            tokenData.setRoleDescription(userRole.getRoleDescription());
            tokenData.setRoleAccess(userRole.getRoleAccess());
            tokenData.setAccessName(userRole.getAccessName());
            tokenData.setAccessDescription(userRole.getAccessDescription());
        }

        // FORMAT the branch integer to a 5-digit string (e.g., 8080 -> "08080")
        String branchCodeStr = String.format("%05d", user.getBranch());

        // Fetch specific details from the Jittered Caffeine Cache (falls back to 4-table DB join on miss)
        BranchCircleProjection bcInfo = loginParamCacheService.getCachedBranchCircle(
                branchCodeStr,
                branchRepository::findBranchAndCircleDetails
        );

        if (bcInfo != null) {
            tokenData.setBranchName(bcInfo.getBranchName());
            tokenData.setCity(bcInfo.getCity());
            tokenData.setAddress(bcInfo.getAddress());
            tokenData.setPincode(bcInfo.getPincode());
            tokenData.setNmrCode(bcInfo.getNmrCode());
            tokenData.setBranchStatus(bcInfo.getBranchStatus());
            tokenData.setBranchType(bcInfo.getBranchType());
            tokenData.setCircleCode(bcInfo.getCircleCode());
            tokenData.setCircleName(bcInfo.getCircleName());
            tokenData.setZoneCode(bcInfo.getZoneCode());
            tokenData.setZoneName(bcInfo.getZoneName());
            tokenData.setCircleBranch(bcInfo.getCircleBranch());
            tokenData.setStateName(bcInfo.getStateName());
            tokenData.setStateCode(bcInfo.getStateCode());

            boolean isCircle = branchCodeStr.equals(bcInfo.getCircleBranch());
            tokenData.setIsCircle(isCircle);
        } else {
            tokenData.setIsCircle(false);
            log.warn("Branch details not found in BRANCH_MASTER for branch code: {}", LoginUtility.sanitizeLog(branchCodeStr));
        }

        return tokenData;
    }

    @Override
    @Transactional(readOnly = true)
    public UserDto getUserProfile(String userId) {
        final String cleanUserId = sanitizeAndValidateUserId(userId);
        if (cleanUserId.isEmpty()) {
            return null;
        }
        User user = userRepository.findByUserId(cleanUserId);
        UserRoles userRole = userRepository.getUserRole(cleanUserId);

        if (user == null || userRole == null) {
            return null;
        }

        UserDto userDto = new UserDto();
        userDto.setUserId(user.getUserId());
        userDto.setUserStatus(user.getPasswordLogin());
        userDto.setPasswordLoginStatus(user.getPasswordLogin());
        userDto.setUser(initializeTokenData(user, userRole));
        return userDto;
    }

    /**
     * Fortify Taint Validation Barrier for Database Primary/Foreign Key lookups.
     */
    private String sanitizeAndValidateUserId(String rawUserId) {
        if (rawUserId == null) {
            return "";
        }
        String clean = rawUserId.trim().toLowerCase();
        if (!SAFE_USER_ID_PATTERN.matcher(clean).matches()) {
            log.warn("Rejected malformed userId input: {}", LoginUtility.sanitizeLog(rawUserId));
            return "";
        }
        return clean;
    }

    private String determineMethodString(char mode) {
        if (mode == Constants.LDAP) return "LDAP";
        if (mode == Constants.PWD_MODE) return Constants.PASSWORD_BASED_LOGIN;
        return Constants.SSO_BASED_LOGIN;
    }

    private void handleAccountLocked(LoginAttempt attempt, UserDto result, User user) {
        result.setValidCredentials(false);
        result.setPasswordLoginStatus(user.getPasswordLogin());
        result.setMessage("Your account is locked due to multiple failed attempts.");

        if (Constants.INACTIVE.equalsIgnoreCase(user.getPasswordLogin())) {
            result.setAttemptsLeft(0);
            attempt.setFailureReason("Account Locked (Pre-check)");
        } else {
            result.setMessage("Password login is disabled.");
            attempt.setFailureReason("Password login disabled");
        }
    }

    private void handleSuccess(LoginAttempt attempt, UserDto result, User user, UserRoles userRole) {
        attempt.setSuccess("Y");
        attempt.setFailureReason("Success");
        result.setValidCredentials(true);
        result.setMessage("Login Successful");

        if (user.getUserWrongPasswordCount() > 0) {
            user.setUserWrongPasswordCount(0);
            userRepository.save(user);
        }

        log.info("Credentials validated for userId={}", LoginUtility.sanitizeLog(user.getUserId()));

        // Optimization: Removed dead HmacJwtUtil.generate() call since AuthController issues JWE tokens.
        UserTokenDataDto tokenData = initializeTokenData(user, userRole);
        result.setUser(tokenData);
    }

    private void handleFailure(LoginAttempt attempt, UserDto userInfo, User user, LoginParam loginParam, String reason) {
        log.warn("Login failed for user {}: {}", LoginUtility.sanitizeLog(user.getUserId()), LoginUtility.sanitizeLog(reason));
        attempt.setSuccess("N");

        int currentFailedCount = user.getUserWrongPasswordCount();
        int maxAllowed = loginParam.getWrongPasswordAttempts();
        int newFailedCount = currentFailedCount + 1;

        user.setUserWrongPasswordCount(newFailedCount);
        userInfo.setValidCredentials(false);

        if (newFailedCount >= maxAllowed) {
            user.setPasswordLogin(Constants.INACTIVE);
            attempt.setFailureReason(reason + " -> Account Locked");
            userInfo.setMessage("Your account has been locked due to multiple unsuccessful login attempts.");
            userInfo.setPasswordLoginStatus(Constants.INACTIVE);
            userInfo.setAttemptsLeft(0);
        } else {
            int remaining = maxAllowed - newFailedCount;
            attempt.setFailureReason(reason);
            if (remaining > 1) {
                userInfo.setMessage("Invalid User ID or Password. Please check and try again.");
            } else {
                userInfo.setMessage("Invalid User ID or Password. Final attempt before lock.");
            }
            userInfo.setAttemptsLeft(remaining);
        }
        userRepository.save(user);
    }

    // =========================================================================================
    //                                OTP Format Utilities
    // =========================================================================================

    private String generateSecureOtp() {
        int otp = 100000 + SECURE_RANDOM.nextInt(900000);
        return String.valueOf(otp);
    }

    private String maskEmail(String email) {
        if (email == null || !email.contains("@")) return email;
        String[] parts = email.split("@");
        return (parts[0].length() <= 2 ? "**" : parts[0].charAt(0) + "***" + parts[0].charAt(parts[0].length() - 1)) + "@" + parts[1];
    }

    private String maskMobile(String mobile) {
        if (mobile == null || mobile.length() < 4) return mobile;
        return "***" + mobile.substring(mobile.length() - 4);
    }
