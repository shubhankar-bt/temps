package com.fincore.gateway.model;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import lombok.Getter;
import lombok.Setter;
import lombok.ToString;

/**
 * Entity representing the system-wide login and MFA configuration parameters.
 *
 * Maps to the LOGIN_PARAM table, which holds information such as
 * the active login mode, OTP validity period, password validity period,
 * allowed wrong attempts, and MFA session/resend timers.
 */
@Entity
@Getter
@Setter
@ToString
@Table(name = "LOGIN_PARAM")
public class LoginParam {

    /** Defines the currently active login mode in the system. */
    @Id
    @Column(name = "ACTIVE_LOGIN_MODE")
    private char activeLoginMode;

    /** OTP validity period in minutes (Default: 5). */
    @Column(name = "OTP_VALIDITY")
    private Integer otpValidity = 5;

    /** Password validity period in days/hours. */
    @Column(name = "PASSWORD_VALIDITY")
    private int passwordValidity;

    /** Number of consecutive wrong password attempts allowed before blocking. */
    @Column(name = "WRONG_PASSWORD_ATTEMPTS")
    private int wrongPasswordAttempts;

    /** Time interval (in minutes) after which a new login attempt is allowed. */
    @Column(name = "ATTEMPT_INTERVAL")
    private int attemptInterval;

    /** Flag to indicate if OTP/MFA is required after primary authentication ('Y'/'N'). */
    @Column(name = "IS_OTP_ENABLED")
    private String isOtpEnabled;

    /** Maximum wrong verification attempts per generated OTP code (Default: 5). */
    @Column(name = "OTP_MAX_ATTEMPTS")
    private Integer otpMaxAttempts = 5;

    /** Cooldown in seconds before Resend OTP is allowed (Default: 60). */
    @Column(name = "OTP_RESEND_COOLDOWN_SEC")
    private Integer otpResendCooldownSec = 60;

    /** Maximum number of resends allowed per user within the window (Default: 3). */
    @Column(name = "OTP_MAX_RESENDS")
    private Integer otpMaxResends = 3;

    /** Time window in minutes for tracking maximum OTP resends (Default: 10). */
    @Column(name = "OTP_RESEND_WINDOW_MIN")
    private Integer otpResendWindowMin = 10;

    /** Overall idle timeout in minutes for the OTP entry screen (Default: 15). */
    @Column(name = "OTP_SCREEN_TIMEOUT_MIN")
    private Integer otpScreenTimeoutMin = 15;

    // Safe getters with fallback defaults in case DB columns contain unexpected nulls/zeros
    public int getSafeOtpValidityMin() {
        return (otpValidity != null && otpValidity > 0) ? otpValidity : 5;
    }

    public int getSafeOtpMaxAttempts() {
        return (otpMaxAttempts != null && otpMaxAttempts > 0) ? otpMaxAttempts : 5;
    }

    public int getSafeOtpResendCooldownSec() {
        return (otpResendCooldownSec != null && otpResendCooldownSec > 0) ? otpResendCooldownSec : 60;
    }

    public int getSafeOtpMaxResends() {
        return (otpMaxResends != null && otpMaxResends > 0) ? otpMaxResends : 3;
    }

    public int getSafeOtpResendWindowMin() {
        return (otpResendWindowMin != null && otpResendWindowMin > 0) ? otpResendWindowMin : 10;
    }

    public int getSafeOtpScreenTimeoutMin() {
        return (otpScreenTimeoutMin != null && otpScreenTimeoutMin > 0) ? otpScreenTimeoutMin : 15;
    }
}











package com.fincore.gateway.Service;

import com.fincore.gateway.model.LoginParam;
import com.fincore.gateway.repository.LoginParamRepository;
import com.github.benmanes.caffeine.cache.Cache;
import com.github.benmanes.caffeine.cache.Caffeine;
import jakarta.annotation.PostConstruct;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

/**
 * High-performance Caffeine Cache wrapper for LOGIN_PARAM configuration.
 * <p>
 * Loads the DB configuration into JVM memory once and serves all subsequent
 * requests with zero database I/O. Restarting the Login Service automatically
 * evicts the cache and reloads fresh parameters from Oracle DB.
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class LoginParamCacheService {

    private static final String CACHE_KEY = "GLOBAL_LOGIN_PARAM";

    private final LoginParamRepository loginParamRepository;

    /**
     * In-memory Caffeine cache bounded to 1 entry with no time-based eviction.
     * Evicts automatically upon service restart.
     */
    private final Cache<String, LoginParam> paramCache = Caffeine.newBuilder()
            .maximumSize(1)
            .build();

    /**
     * Pre-warms the cache on application startup so the very first user login
     * experiences zero cache-miss latency.
     */
    @PostConstruct
    public void initCache() {
        try {
            LoginParam param = loginParamRepository.getLoginParam();
            if (param != null) {
                paramCache.put(CACHE_KEY, param);
                log.info("Successfully pre-warmed Caffeine cache with LOGIN_PARAM: {}", param);
            } else {
                log.warn("LOGIN_PARAM table returned null during startup cache warm-up. Using fallback defaults.");
            }
        } catch (Exception e) {
            log.error("Failed to pre-warm LOGIN_PARAM cache at startup. Will retry lazily on first login.", e);
        }
    }

    /**
     * Returns the cached LoginParam instance, loading from DB only if missing.
     */
    public LoginParam getCachedLoginParam() {
        LoginParam param = paramCache.get(CACHE_KEY, key -> {
            log.info("Loading LOGIN_PARAM from Oracle Database into Caffeine Cache...");
            return loginParamRepository.getLoginParam();
        });

        if (param == null) {
            log.warn("LOGIN_PARAM not found in DB! Returning default safe LoginParam instance.");
            return new LoginParam();
        }
        return param;
    }
}









package com.fincore.gateway.Service;

import com.fincore.gateway.model.LoginParam;
import com.fincore.gateway.utility.LoginUtility;
import tools.jackson.core.JacksonException;
import tools.jackson.core.type.TypeReference;
import tools.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.redis.core.ReactiveStringRedisTemplate;
import org.springframework.http.HttpStatus;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.web.server.ResponseStatusException;
import reactor.core.publisher.Mono;
import reactor.core.scheduler.Schedulers;
import reactor.util.function.Tuple3;
import reactor.util.function.Tuples;

import java.time.Duration;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * ============================================================================
 * ENTERPRISE OTP LIFECYCLE & CONCURRENCY STATE ENGINE
 * ============================================================================
 * All timers and limits are dynamically fetched from LoginParamCacheService:
 * - OTP Validity               : LOGIN_PARAM.OTP_VALIDITY (Default: 5 min)
 * - OTP Screen Idle Timeout    : LOGIN_PARAM.OTP_SCREEN_TIMEOUT_MIN (Default: 15 min)
 * - Max Wrong Attempts         : LOGIN_PARAM.OTP_MAX_ATTEMPTS (Default: 5)
 * - Resend Cooldown            : LOGIN_PARAM.OTP_RESEND_COOLDOWN_SEC (Default: 60 sec)
 * - Max Resend Count           : LOGIN_PARAM.OTP_MAX_RESENDS (Default: 3)
 * - Resend Window              : LOGIN_PARAM.OTP_RESEND_WINDOW_MIN (Default: 10 min)
 *
 * REDIS KEYS ARCHITECTURE:
 * 1. OTP_ACTIVE_TX:USR:{userId} -> Active txId (TTL: 15m - Enforces 1 OTP session per user)
 * 2. OTP_COOLDOWN:USR:{userId}  -> "locked" (TTL: 60s - Enforces cooldown across Resend AND Back-to-Login)
 * 3. OTP_RESENDS:USR:{userId}   -> Integer count (TTL: 10m - Enforces max 3 resends per user in 10m)
 * 4. OTP_SESSION:{txId}         -> userId (TTL: 15m - Tracks overall OTP screen idle timeout)
 * 5. OTP_TX:{txId}              -> { "userId": "...", "otpHash": "..." } (TTL: 5m - Active code)
 * 6. OTP_FAILURES:{txId}        -> Integer count (TTL: 5m)
 * 7. OTP_VERIFY_LOCK:{txId}     -> "verifying" (TTL: 10s - Prevents double-click race condition)
 * 8. RATE_LIMIT:OTP_REQ:IP:{ip} -> Integer count (TTL: 1h)
 * ============================================================================
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class OtpSessionService {

    private static final int MAX_HOURLY_IP_REQUESTS = 50;

    private final ReactiveStringRedisTemplate redis;
    private final PasswordEncoder passwordEncoder;
    private final ObjectMapper mapper;
    private final LoginParamCacheService loginParamCacheService;

    /**
     * Rate limits OTP requests by IP to prevent API abuse and SMS Toll Fraud.
     */
    public Mono<Void> checkIpRateLimit(String clientIp) {
        String key = "RATE_LIMIT:OTP_REQ:IP:" + clientIp;
        return redis.opsForValue().increment(key)
                .flatMap(count -> {
                    if (count == 1) {
                        return redis.expire(key, Duration.ofHours(1)).then();
                    } else if (count > MAX_HOURLY_IP_REQUESTS) {
                        log.warn("SECURITY ALERT: IP {} exceeded hourly OTP limit.", LoginUtility.sanitizeLog(clientIp));
                        return Mono.error(new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS, "Maximum resend limit reached. Kindly Wait."));
                    }
                    return Mono.empty();
                });
    }

    /**
     * Initiates a new OTP session on Login.
     * <p>
     * 1. Enforces User-level 60s Cooldown (Blocks rapid "Back to Sign In" and simultaneous 2-device login).
     * 2. Enforces User-level 10-minute Resend Quota (If user already has an active 10m window, re-login counts against quota).
     * 3. Invalidates any previous pending OTP transaction (txId) for this user on other devices/tabs.
     * 4. Returns the remaining resends count for this user so the UI displays accurate state.
     */
    public Mono<Integer> initiateUserOtpSession(String txId, String userId, String plainOtp) {
        final String cleanUserId = userId.trim();
        final LoginParam params = loginParamCacheService.getCachedLoginParam();

        final Duration cooldownDuration = Duration.ofSeconds(params.getSafeOtpResendCooldownSec());
        final Duration resendWindowDuration = Duration.ofMinutes(params.getSafeOtpResendWindowMin());
        final int maxResends = params.getSafeOtpMaxResends();

        final String userCooldownKey = "OTP_COOLDOWN:USR:" + cleanUserId;
        final String userResendKey = "OTP_RESENDS:USR:" + cleanUserId;
        final String activeTxKey = "OTP_ACTIVE_TX:USR:" + cleanUserId;

        // 1. Atomic User Cooldown Lock (Prevents concurrent 2-device OTP generation & rapid Back-to-Sign-In abuse)
        return redis.opsForValue().setIfAbsent(userCooldownKey, "locked", cooldownDuration)
                .flatMap(acquired -> {
                    if (!Boolean.TRUE.equals(acquired)) {
                        return redis.getExpire(userCooldownKey)
                                .flatMap(ttl -> {
                                    long secondsLeft = Math.max(1, ttl.getSeconds());
                                    return Mono.error(new ResponseStatusException(
                                            HttpStatus.TOO_MANY_REQUESTS,
                                            "Please wait " + secondsLeft + " seconds before requesting another code."
                                    ));
                                });
                    }

                    // 2. Check if user is already within an active 10-minute OTP window ("Back to Sign In" case)
                    return redis.hasKey(userResendKey)
                            .flatMap(windowExists -> {
                                if (!Boolean.TRUE.equals(windowExists)) {
                                    // Fresh 10-minute window: Initialize resend counter to 0
                                    return redis.opsForValue().set(userResendKey, "0", resendWindowDuration)
                                            .thenReturn(0L);
                                } else {
                                    // User clicked "Back to Sign In" within 10m window: Increment resend counter
                                    return redis.opsForValue().increment(userResendKey);
                                }
                            })
                            .flatMap(currentResends -> {
                                if (currentResends > maxResends) {
                                    // Release the 60s cooldown lock since we are rejecting due to 10m max limit
                                    return redis.delete(userCooldownKey)
                                            .then(Mono.error(new ResponseStatusException(
                                                    HttpStatus.TOO_MANY_REQUESTS,
                                                    "Maximum resend limit reached. Kindly Wait."
                                            )));
                                }

                                int remainingResends = maxResends - currentResends.intValue();

                                // 3. Single Active OTP Session per User: Evict any old txId from another device/tab
                                return invalidatePreviousUserTx(activeTxKey)
                                        // 4. Save new OTP state and register new active txId
                                        .then(saveOtpStateInternal(txId, cleanUserId, plainOtp, params))
                                        .thenReturn(remainingResends);
                            });
                });
    }

    /**
     * Safely executes an OTP Resend on the OTP screen.
     * Enforces 15-minute screen timeout, 60-second cooldown, and maximum 3 resends per 10-minute window.
     * Returns Tuple3 of (NewPlainOtp, UserId, RemainingResends).
     */
    public Mono<Tuple3<String, String, Integer>> processResend(String txId, String newPlainOtp) {
        final LoginParam params = loginParamCacheService.getCachedLoginParam();
        final Duration cooldownDuration = Duration.ofSeconds(params.getSafeOtpResendCooldownSec());
        final Duration resendWindowDuration = Duration.ofMinutes(params.getSafeOtpResendWindowMin());
        final int maxResends = params.getSafeOtpMaxResends();

        final String sessionKey = "OTP_SESSION:" + txId;

        // 1. Check 15-Minute OTP Entry Screen Timeout (Also catches if another device invalidated this txId)
        return redis.opsForValue().get(sessionKey)
                .switchIfEmpty(Mono.error(new ResponseStatusException(
                        HttpStatus.UNAUTHORIZED,
                        "Your session has timed out. Please log in again."
                )))
                .flatMap(userId -> {
                    final String cleanUserId = userId.trim();
                    final String userCooldownKey = "OTP_COOLDOWN:USR:" + cleanUserId;
                    final String userResendKey = "OTP_RESENDS:USR:" + cleanUserId;

                    // 2. Check 60-Second User Cooldown Lock (Section 2.2.5 & 2.4)
                    return redis.opsForValue().setIfAbsent(userCooldownKey, "locked", cooldownDuration)
                            .flatMap(acquired -> {
                                if (!Boolean.TRUE.equals(acquired)) {
                                    return redis.getExpire(userCooldownKey)
                                            .flatMap(ttl -> {
                                                long secondsLeft = Math.max(1, ttl.getSeconds());
                                                return Mono.error(new ResponseStatusException(
                                                        HttpStatus.TOO_MANY_REQUESTS,
                                                        "Please wait " + secondsLeft + " seconds before requesting another code."
                                                ));
                                            });
                                }

                                // 3. Atomic Increment User Resends within 10-Minute Window (Section 2.2.5 & 2.4)
                                return redis.opsForValue().increment(userResendKey)
                                        .flatMap(resendCount -> {
                                            if (resendCount == 1) {
                                                // If 10m window had just expired while 15m screen was still open, set 10m TTL
                                                return redis.expire(userResendKey, resendWindowDuration).thenReturn(resendCount);
                                            }
                                            return Mono.just(resendCount);
                                        })
                                        .flatMap(resendCount -> {
                                            if (resendCount > maxResends) {
                                                // Release the cooldown lock since no OTP was sent, and reject
                                                return redis.delete(userCooldownKey)
                                                        .then(Mono.error(new ResponseStatusException(
                                                                HttpStatus.TOO_MANY_REQUESTS,
                                                                "Maximum resend limit reached. Kindly Wait."
                                                        )));
                                            }

                                            int remainingResends = maxResends - resendCount.intValue();

                                            // 4. Save new OTP state (resets failure count to 0) and return Tuple
                                            return saveOtpStateInternal(txId, cleanUserId, newPlainOtp, params)
                                                    .thenReturn(Tuples.of(newPlainOtp, cleanUserId, remainingResends));
                                        });
                            });
                });
    }

    /**
     * Verifies the OTP using constant-time cryptographic matching (BCrypt) on boundedElastic scheduler.
     * Protected by an atomic lock to prevent double-click race conditions.
     */
    public Mono<String> verifyOtp(String txId, String inputOtp) {
        final LoginParam params = loginParamCacheService.getCachedLoginParam();
        final int maxFailures = params.getSafeOtpMaxAttempts();

        final String sessionKey = "OTP_SESSION:" + txId;
        final String txKey = "OTP_TX:" + txId;
        final String failKey = "OTP_FAILURES:" + txId;
        final String verifyLockKey = "OTP_VERIFY_LOCK:" + txId;

        // 0. Atomic Double-Click Protection Lock (10s TTL)
        return redis.opsForValue().setIfAbsent(verifyLockKey, "verifying", Duration.ofSeconds(10))
                .flatMap(lockAcquired -> {
                    if (!Boolean.TRUE.equals(lockAcquired)) {
                        return Mono.error(new ResponseStatusException(
                                HttpStatus.TOO_MANY_REQUESTS,
                                "Verification already in progress. Please wait."
                        ));
                    }

                    // 1. Check if the 15-minute OTP entry screen session is still active
                    return redis.opsForValue().get(sessionKey)
                            .switchIfEmpty(
                                    redis.delete(verifyLockKey).then(Mono.error(new ResponseStatusException(
                                            HttpStatus.UNAUTHORIZED,
                                            "Your session has timed out. Please log in again."
                                    )))
                            )
                            .flatMap(sessionUserId ->
                                    // 2. Fetch the active 5-minute OTP code payload
                                    redis.opsForValue().get(txKey)
                                            .switchIfEmpty(
                                                    redis.delete(verifyLockKey).then(Mono.error(new ResponseStatusException(
                                                            HttpStatus.BAD_REQUEST,
                                                            "The code is invalid or has expired. Please request a new code."
                                                    )))
                                            )
                                            .flatMap(payload ->
                                                    // 3. Offload CPU-intensive BCrypt matching to boundedElastic thread pool
                                                    Mono.fromCallable(() -> {
                                                        Map<String, String> data = mapper.readValue(payload, new TypeReference<>() {});
                                                        String userId = data.get("userId");
                                                        String storedHash = data.get("otpHash");
                                                        boolean matched = passwordEncoder.matches(inputOtp, storedHash);
                                                        return Tuples.of(userId, matched);
                                                    })
                                                    .subscribeOn(Schedulers.boundedElastic())
                                                    .flatMap(result -> {
                                                        String userId = result.getT1().trim();
                                                        boolean matched = result.getT2();

                                                        if (matched) {
                                                            // SUCCESS (Section 2.2.8): Delete all OTP & User quota keys
                                                            return cleanupAllOtpKeysOnSuccess(txId, userId).thenReturn(userId);
                                                        } else {
                                                            // FAILURE (Section 2.2.6): Atomic increment wrong attempts
                                                            return redis.opsForValue().increment(failKey)
                                                                    .flatMap(failCount -> {
                                                                        if (failCount >= maxFailures) {
                                                                            // On 5th failed attempt: Mark code expired by deleting OTP_TX,
                                                                            // keep OTP_SESSION alive so user can click Resend!
                                                                            return Mono.when(
                                                                                            redis.delete(txKey),
                                                                                            redis.delete(failKey),
                                                                                            redis.delete(verifyLockKey)
                                                                                    )
                                                                                    .then(Mono.error(new ResponseStatusException(
                                                                                            HttpStatus.BAD_REQUEST,
                                                                                            "Too many incorrect attempts. The code has been expired. Please request a new code."
                                                                                    )));
                                                                        }
                                                                        long remaining = maxFailures - failCount;
                                                                        return redis.delete(verifyLockKey)
                                                                                .then(Mono.error(new ResponseStatusException(
                                                                                        HttpStatus.BAD_REQUEST,
                                                                                        "Invalid code. " + remaining + " attempts remaining."
                                                                                )));
                                                                    });
                                                        }
                                                    })
                                            )
                            )
                            .onErrorResume(e -> {
                                if (e instanceof ResponseStatusException) {
                                    return Mono.error(e);
                                }
                                log.error("Unexpected error during OTP verification for txId={}", LoginUtility.sanitizeLog(txId), e);
                                return redis.delete(verifyLockKey)
                                        .then(Mono.error(new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Redis payload corruption")));
                            });
                });
    }

    /**
     * Internal helper: Hashes the OTP on boundedElastic and saves the transaction state in Redis.
     */
    private Mono<Void> saveOtpStateInternal(String txId, String userId, String plainOtp, LoginParam params) {
        final Duration otpValidity = Duration.ofMinutes(params.getSafeOtpValidityMin());
        final Duration screenTimeout = Duration.ofMinutes(params.getSafeOtpScreenTimeoutMin());

        return Mono.fromCallable(() -> {
                    String hash = passwordEncoder.encode(plainOtp);
                    return mapper.writeValueAsString(Map.of("userId", userId, "otpHash", hash));
                })
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(payload -> {
                    List<Mono<?>> operations = new ArrayList<>();

                    // 1. Register this txId as the ONLY active OTP session for this user
                    operations.add(redis.opsForValue().set("OTP_ACTIVE_TX:USR:" + userId, txId, screenTimeout));

                    // 2. Overall 15-Minute OTP Screen Session Tracker
                    operations.add(redis.opsForValue().set("OTP_SESSION:" + txId, userId, screenTimeout));

                    // 3. Active 5-Minute OTP Code Hash
                    operations.add(redis.opsForValue().set("OTP_TX:" + txId, payload, otpValidity));

                    // 4. Reset wrong attempt counter to 0 for the new code
                    operations.add(redis.opsForValue().set("OTP_FAILURES:" + txId, "0", otpValidity));

                    return Mono.when(operations)
                            .doOnSuccess(v -> log.info("Saved OTP State txId={} for user={}",
                                    LoginUtility.sanitizeLog(txId), LoginUtility.sanitizeLog(userId)));
                });
    }

    /**
     * Evicts any previous pending OTP transaction for the same user (Concurrent Device / Tab protection).
     */
    private Mono<Void> invalidatePreviousUserTx(String activeTxKey) {
        return redis.opsForValue().get(activeTxKey)
                .flatMap(oldTxId -> {
                    log.info("Evicting previous pending OTP session oldTxId={} due to new login initiation", LoginUtility.sanitizeLog(oldTxId));
                    return Mono.when(
                            redis.delete("OTP_SESSION:" + oldTxId),
                            redis.delete("OTP_TX:" + oldTxId),
                            redis.delete("OTP_FAILURES:" + oldTxId),
                            redis.delete("OTP_VERIFY_LOCK:" + oldTxId)
                    );
                })
                .then();
    }

    /**
     * Deletes all Redis keys (both txId keys and User quota keys) upon successful verification.
     */
    private Mono<Void> cleanupAllOtpKeysOnSuccess(String txId, String userId) {
        return Mono.when(
                redis.delete("OTP_SESSION:" + txId),
                redis.delete("OTP_TX:" + txId),
                redis.delete("OTP_FAILURES:" + txId),
                redis.delete("OTP_VERIFY_LOCK:" + txId),
                redis.delete("OTP_ACTIVE_TX:USR:" + userId),
                redis.delete("OTP_COOLDOWN:USR:" + userId),
                redis.delete("OTP_RESENDS:USR:" + userId)
        );
    }

    /**
     * Compensating transaction for Initial Login: Cleans up the Redis state if Kafka fails during /login,
     * releasing the user cooldown lock so the user can try logging in again.
     */
    public Mono<Void> rollbackInitialOtpState(String txId, String userId) {
        final String cleanUserId = userId != null ? userId.trim() : "";
        return Mono.when(
                redis.delete("OTP_SESSION:" + txId),
                redis.delete("OTP_TX:" + txId),
                redis.delete("OTP_FAILURES:" + txId),
                redis.delete("OTP_ACTIVE_TX:USR:" + cleanUserId),
                redis.delete("OTP_COOLDOWN:USR:" + cleanUserId)
        ).doOnSuccess(v -> log.info("Rolled back initial OTP state for txId={}", LoginUtility.sanitizeLog(txId)));
    }

    /**
     * Compensating transaction for Resend: If Kafka fails during /resend-otp,
     * preserves the user's 15-minute OTP screen session (OTP_SESSION), decrements the resend counter
     * so the user is not penalized, and releases the 60s cooldown lock so they can click Resend again.
     */
    public Mono<Void> rollbackResendState(String txId, String userId) {
        final String cleanUserId = userId != null ? userId.trim() : "";
        return Mono.when(
                redis.delete("OTP_COOLDOWN:USR:" + cleanUserId),
                redis.opsForValue().decrement("OTP_RESENDS:USR:" + cleanUserId)
        ).doOnSuccess(v -> log.info("Rolled back resend increment and cooldown for txId={}", LoginUtility.sanitizeLog(txId)));
    }
}











