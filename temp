-- Adding the remaining configurable MFA parameters:

ALTER TABLE LOGIN_PARAM ADD (
    OTP_MAX_ATTEMPTS        NUMBER(3) DEFAULT 5  NOT NULL,
    OTP_RESEND_COOLDOWN_SEC NUMBER(5) DEFAULT 60 NOT NULL,
    OTP_MAX_RESENDS         NUMBER(3) DEFAULT 3  NOT NULL,
    OTP_RESEND_WINDOW_MIN   NUMBER(5) DEFAULT 10 NOT NULL,
    OTP_SCREEN_TIMEOUT_MIN  NUMBER(5) DEFAULT 15 NOT NULL
);

-- Ensure existing row has OTP_VALIDITY set to 5 minutes per Section 2.2.7
UPDATE LOGIN_PARAM SET OTP_VALIDITY = 5 WHERE OTP_VALIDITY IS NULL OR OTP_VALIDITY <= 0;
