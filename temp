 * - OTP Validity               : LOGIN_PARAM.OTP_VALIDITY (Default: 5 min)
 * - OTP Screen Idle Timeout    : LOGIN_PARAM.OTP_SCREEN_TIMEOUT_MIN (Default: 15 min)
 * - Max Wrong Attempts         : LOGIN_PARAM.OTP_MAX_ATTEMPTS (Default: 5)
 * - Resend Cooldown            : LOGIN_PARAM.OTP_RESEND_COOLDOWN_SEC (Default: 60 sec)
 * - Max Resend Count           : LOGIN_PARAM.OTP_MAX_RESENDS (Default: 3)
 * - Resend Window              : LOGIN_PARAM.OTP_RESEND_WINDOW_MIN (Default: 10 min)
 * ============================================================================
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class OtpSessionService {

    private static final int MAX_HOURLY_IP_REQUESTS = 50;

    private final ReactiveStringRedisTemplate redis;
    private final PasswordEncoder passwordEncoder;
    private final ObjectMapper mapper;
    private final LoginParamCacheService loginParamCacheService;

    /**
     * Value object returned when initiating or resuming a user's OTP session on /login.
     */
    public record OtpSessionInitResult(
            boolean shouldDispatchNewOtp,
            int expiresInSeconds,
            int resendCooldownSeconds,
            int resendsRemaining,
            int otpScreenTimeoutMin
    ) {}

    /**
     * Rate limits OTP requests by IP to prevent API abuse and SMS Toll Fraud.
     */
    public Mono<Void> checkIpRateLimit(String clientIp) {
        String key = "RATE_LIMIT:OTP_REQ:IP:" + clientIp;
        return redis.opsForValue().increment(key)
                .flatMap(count -> {
                    if (count == 1) {
                        return redis.expire(key, Duration.ofHours(1)).then();
                    } else if (count > MAX_HOURLY_IP_REQUESTS) {
                        log.warn("SECURITY ALERT: IP {} exceeded hourly OTP limit.", LoginUtility.sanitizeLog(clientIp));
                        return Mono.error(new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS, "Maximum resend limit reached. Kindly Wait."));
                    }
                    return Mono.empty();
                });
    }

    /**
     * Initiates or smartly resumes an OTP session on /login.
     * <p>
     * - If the user clicked "Back to Sign In" and re-authenticated while an existing OTP code is STILL VALID
     *   and either the 60s cooldown is active OR all 3 resends are used, it seamlessly migrates the active OTP
     *   to the new txId without sending a duplicate SMS/Email (Smart Session Resumption).
     * - If the previous OTP was burned/expired and the 60s cooldown or 3-resend limit is reached, it blocks with 429.
     * - Otherwise, it generates a fresh OTP, enforces the 10-minute resend quota, and signals Kafka to dispatch.
     */
    public Mono<OtpSessionInitResult> initiateUserOtpSession(String newTxId, String userId, String newPlainOtp) {
        final String cleanUserId = userId.trim();
        final LoginParam params = loginParamCacheService.getCachedLoginParam();

        final int otpValidityMin = params.getSafeOtpValidityMin();
        final int cooldownSec = params.getSafeOtpResendCooldownSec();
        final int maxResends = params.getSafeOtpMaxResends();
        final int resendWindowMin = params.getSafeOtpResendWindowMin();
        final int screenTimeoutMin = params.getSafeOtpScreenTimeoutMin();

        final Duration cooldownDuration = Duration.ofSeconds(cooldownSec);
        final Duration resendWindowDuration = Duration.ofMinutes(resendWindowMin);
        final Duration screenTimeoutDuration = Duration.ofMinutes(screenTimeoutMin);

        final String activeTxKey = "OTP_ACTIVE_TX:USR:" + cleanUserId;
        final String userCooldownKey = "OTP_COOLDOWN:USR:" + cleanUserId;
        final String userResendKey = "OTP_RESENDS:USR:" + cleanUserId;

        return Mono.zip(
                redis.opsForValue().get(activeTxKey).defaultIfEmpty(""),
                redis.getExpire(userCooldownKey).defaultIfEmpty(Duration.ZERO),
                redis.opsForValue().get(userResendKey).defaultIfEmpty("")
        ).flatMap(userState -> {
            String oldTxId = userState.getT1();
            long cooldownRemainingSec = Math.max(0, userState.getT2().getSeconds());
            String resendCountStr = userState.getT3();

            boolean hasResendWindow = !resendCountStr.isEmpty();
            int currentResends = hasResendWindow ? Integer.parseInt(resendCountStr) : 0;
            boolean isCooldownActive = cooldownRemainingSec > 0;
            boolean isQuotaExhausted = hasResendWindow && currentResends >= maxResends;

            // Inspect and clean up any previous OTP transaction for this user (Single Active Session enforcement)
            Mono<Tuple3<String, Duration, String>> inspectAndEvictOldTx;
            if (!oldTxId.isEmpty()) {
                inspectAndEvictOldTx = Mono.zip(
                        redis.opsForValue().get("OTP_TX:" + oldTxId).defaultIfEmpty(""),
                        redis.getExpire("OTP_TX:" + oldTxId).defaultIfEmpty(Duration.ZERO),
                        redis.opsForValue().get("OTP_FAILURES:" + oldTxId).defaultIfEmpty("0")
                ).flatMap(oldTxData ->
                        Mono.when(
                                redis.delete("OTP_SESSION:" + oldTxId),
                                redis.delete("OTP_TX:" + oldTxId),
                                redis.delete("OTP_FAILURES:" + oldTxId),
                                redis.delete("OTP_VERIFY_LOCK:" + oldTxId)
                        ).thenReturn(oldTxData)
                );
            } else {
                inspectAndEvictOldTx = Mono.just(Tuples.of("", Duration.ZERO, "0"));
            }

            return inspectAndEvictOldTx.flatMap(oldTxData -> {
                String existingOtpPayload = oldTxData.getT1();
                Duration existingOtpTtl = oldTxData.getT2();
                String existingFailures = oldTxData.getT3();

                boolean hasValidExistingOtp = !existingOtpPayload.isEmpty() && existingOtpTtl.getSeconds() > 5;

                // =========================================================================
                // BRANCH 1: SMART SESSION RESUMPTION ("Back to Sign In" with valid OTP)
                // =========================================================================
                if (hasValidExistingOtp && (isCooldownActive || isQuotaExhausted)) {
                    int remainingOtpSec = (int) existingOtpTtl.getSeconds();
                    int remainingCooldown = isCooldownActive ? (int) cooldownRemainingSec : 0;
                    int remainingResends = Math.max(0, maxResends - currentResends);

                    log.info("Smart Session Resumption for user={}: Migrating valid OTP to newTxId={} (cooldown={}s, resendsLeft={})",
                            LoginUtility.sanitizeLog(cleanUserId), LoginUtility.sanitizeLog(newTxId), remainingCooldown, remainingResends);

                    return Mono.when(
                            redis.opsForValue().set(activeTxKey, newTxId, screenTimeoutDuration),
                            redis.opsForValue().set("OTP_SESSION:" + newTxId, cleanUserId, screenTimeoutDuration),
                            redis.opsForValue().set("OTP_TX:" + newTxId, existingOtpPayload, existingOtpTtl),
                            redis.opsForValue().set("OTP_FAILURES:" + newTxId, existingFailures, existingOtpTtl)
                    ).thenReturn(new OtpSessionInitResult(
                            false, // Do NOT send a duplicate SMS/Email!
                            remainingOtpSec,
                            remainingCooldown,
                            remainingResends,
                            screenTimeoutMin
                    ));
                }

                // =========================================================================
                // BRANCH 2: BLOCK IF PREVIOUS OTP WAS BURNED/EXPIRED & LIMITS ARE ACTIVE
                // =========================================================================
                if (isCooldownActive) {
                    return Mono.error(new ResponseStatusException(
                            HttpStatus.TOO_MANY_REQUESTS,
                            "Please wait " + cooldownRemainingSec + " seconds before requesting another code."
                    ));
                }

                if (isQuotaExhausted) {
                    return Mono.error(new ResponseStatusException(
                            HttpStatus.TOO_MANY_REQUESTS,
                            "Maximum resend limit reached. Kindly Wait."
                    ));
                }

                // =========================================================================
                // BRANCH 3: GENERATE & DISPATCH FRESH OTP (Enforcing Cooldown & 10m Quota)
                // =========================================================================
                return redis.opsForValue().setIfAbsent(userCooldownKey, "locked", cooldownDuration)
                        .flatMap(acquired -> {
                            if (!Boolean.TRUE.equals(acquired)) {
                                return redis.getExpire(userCooldownKey)
                                        .flatMap(ttl -> Mono.error(new ResponseStatusException(
                                                HttpStatus.TOO_MANY_REQUESTS,
                                                "Please wait " + Math.max(1, ttl.getSeconds()) + " seconds before requesting another code."
                                        )));
                            }

                            Mono<Long> updateResendCounter;
                            if (!hasResendWindow) {
                                // First login in the 10-minute window: Initialize counter to 0
                                updateResendCounter = redis.opsForValue()
                                        .set(userResendKey, "0", resendWindowDuration)
                                        .thenReturn(0L);
                            } else {
                                // User re-initiated login after 60s within the 10m window: Count as 1 resend
                                updateResendCounter = redis.opsForValue().increment(userResendKey);
                            }

                            return updateResendCounter.flatMap(updatedResends -> {
                                if (updatedResends > maxResends) {
                                    return redis.delete(userCooldownKey)
                                            .then(Mono.error(new ResponseStatusException(
                                                    HttpStatus.TOO_MANY_REQUESTS,
                                                    "Maximum resend limit reached. Kindly Wait."
                                            )));
                                }

                                int remainingResends = maxResends - updatedResends.intValue();

                                return saveOtpStateInternal(newTxId, cleanUserId, newPlainOtp, params)
                                        .thenReturn(new OtpSessionInitResult(
                                                true, // Dispatch new OTP to Kafka
                                                otpValidityMin * 60,
                                                cooldownSec,
                                                remainingResends,
                                                screenTimeoutMin
                                        ));
                            });
                        });
            });
        });
    }

    /**
     * Safely executes an OTP Resend on the OTP screen.
     * Enforces 15-minute screen timeout, 60-second cooldown, and maximum 3 resends per 10-minute window.
     * Refreshes the 15-minute sliding idle window on success.
     */
    public Mono<Tuple3<String, String, Integer>> processResend(String txId, String newPlainOtp) {
        final LoginParam params = loginParamCacheService.getCachedLoginParam();
        final Duration cooldownDuration = Duration.ofSeconds(params.getSafeOtpResendCooldownSec());
        final Duration resendWindowDuration = Duration.ofMinutes(params.getSafeOtpResendWindowMin());
        final int maxResends = params.getSafeOtpMaxResends();

        final String sessionKey = "OTP_SESSION:" + txId;

        // 1. Check 15-Minute OTP Entry Screen Timeout
        return redis.opsForValue().get(sessionKey)
                .switchIfEmpty(Mono.error(new ResponseStatusException(
                        HttpStatus.UNAUTHORIZED,
                        "Your session has timed out. Please log in again."
                )))
                .flatMap(userId -> {
                    final String cleanUserId = userId.trim();
                    final String userCooldownKey = "OTP_COOLDOWN:USR:" + cleanUserId;
                    final String userResendKey = "OTP_RESENDS:USR:" + cleanUserId;

                    // 2. Check 60-Second User Cooldown Lock (Section 2.2.5 & 2.4)
                    return redis.opsForValue().setIfAbsent(userCooldownKey, "locked", cooldownDuration)
                            .flatMap(acquired -> {
                                if (!Boolean.TRUE.equals(acquired)) {
                                    return redis.getExpire(userCooldownKey)
                                            .flatMap(ttl -> {
                                                long secondsLeft = Math.max(1, ttl.getSeconds());
                                                return Mono.error(new ResponseStatusException(
                                                        HttpStatus.TOO_MANY_REQUESTS,
                                                        "Please wait " + secondsLeft + " seconds before requesting another code."
                                                ));
                                            });
                                }

                                // 3. Atomic Increment User Resends within 10-Minute Window (Section 2.2.5 & 2.4)
                                return redis.opsForValue().increment(userResendKey)
                                        .flatMap(resendCount -> {
                                            if (resendCount == 1) {
                                                return redis.expire(userResendKey, resendWindowDuration).thenReturn(resendCount);
                                            }
                                            return Mono.just(resendCount);
                                        })
                                        .flatMap(resendCount -> {
                                            if (resendCount > maxResends) {
                                                return redis.delete(userCooldownKey)
                                                        .then(Mono.error(new ResponseStatusException(
                                                                HttpStatus.TOO_MANY_REQUESTS,
                                                                "Maximum resend limit reached. Kindly Wait."
                                                        )));
                                            }

                                            int remainingResends = maxResends - resendCount.intValue();

                                            // 4. Save new OTP state (resets failure count to 0 & refreshes 15m idle session)
                                            return saveOtpStateInternal(txId, cleanUserId, newPlainOtp, params)
                                                    .thenReturn(Tuples.of(newPlainOtp, cleanUserId, remainingResends));
                                        });
                            });
                });
    }

    /**
     * Verifies the OTP using constant-time cryptographic matching (BCrypt) on boundedElastic scheduler.
     * Refreshes the 15-minute sliding idle window on user activity.
     */
    public Mono<String> verifyOtp(String txId, String inputOtp) {
        final LoginParam params = loginParamCacheService.getCachedLoginParam();
        final int maxFailures = params.getSafeOtpMaxAttempts();
        final Duration screenTimeout = Duration.ofMinutes(params.getSafeOtpScreenTimeoutMin());

        final String sessionKey = "OTP_SESSION:" + txId;
        final String txKey = "OTP_TX:" + txId;
        final String failKey = "OTP_FAILURES:" + txId;
        final String verifyLockKey = "OTP_VERIFY_LOCK:" + txId;

        // 0. Atomic Double-Click Protection Lock (10s TTL)
        return redis.opsForValue().setIfAbsent(verifyLockKey, "verifying", Duration.ofSeconds(10))
                .flatMap(lockAcquired -> {
                    if (!Boolean.TRUE.equals(lockAcquired)) {
                        return Mono.error(new ResponseStatusException(
                                HttpStatus.TOO_MANY_REQUESTS,
                                "Verification already in progress. Please wait."
                        ));
                    }

                    // 1. Check if the 15-minute OTP entry screen session is still active
                    return redis.opsForValue().get(sessionKey)
                            .switchIfEmpty(
                                    redis.delete(verifyLockKey).then(Mono.error(new ResponseStatusException(
                                            HttpStatus.UNAUTHORIZED,
                                            "Your session has timed out. Please log in again."
                                    )))
                            )
                            .flatMap(sessionUserId -> {
                                final String cleanUserId = sessionUserId.trim();
                                // Refresh the 15-minute sliding idle timeout since the user is actively interacting
                                return Mono.when(
                                                redis.expire(sessionKey, screenTimeout),
                                                redis.expire("OTP_ACTIVE_TX:USR:" + cleanUserId, screenTimeout)
                                        )
                                        .then(redis.opsForValue().get(txKey))
                                        .switchIfEmpty(
                                                redis.delete(verifyLockKey).then(Mono.error(new ResponseStatusException(
                                                        HttpStatus.BAD_REQUEST,
                                                        "The code is invalid or has expired. Please request a new code."
                                                )))
                                        )
                                        .flatMap(payload ->
                                                Mono.fromCallable(() -> {
                                                    Map<String, String> data = mapper.readValue(payload, new TypeReference<>() {});
                                                    String userId = data.get("userId");
                                                    String storedHash = data.get("otpHash");
                                                    boolean matched = passwordEncoder.matches(inputOtp, storedHash);
                                                    return Tuples.of(userId, matched);
                                                })
                                                .subscribeOn(Schedulers.boundedElastic())
                                                .flatMap(result -> {
                                                    String userId = result.getT1().trim();
                                                    boolean matched = result.getT2();

                                                    if (matched) {
                                                        // SUCCESS (Section 2.2.8): Delete all OTP & User quota keys
                                                        return cleanupAllOtpKeysOnSuccess(txId, userId).thenReturn(userId);
                                                    } else {
                                                        // FAILURE (Section 2.2.6): Atomic increment wrong attempts
                                                        return redis.opsForValue().increment(failKey)
                                                                .flatMap(failCount -> {
                                                                    if (failCount >= maxFailures) {
                                                                        return Mono.when(
                                                                                        redis.delete(txKey),
                                                                                        redis.delete(failKey),
                                                                                        redis.delete(verifyLockKey)
                                                                                )
                                                                                .then(Mono.error(new ResponseStatusException(
                                                                                        HttpStatus.BAD_REQUEST,
                                                                                        "Too many incorrect attempts. The code has been expired. Please request a new code."
                                                                                )));
                                                                    }
                                                                    long remaining = maxFailures - failCount;
                                                                    return redis.delete(verifyLockKey)
                                                                            .then(Mono.error(new ResponseStatusException(
                                                                                    HttpStatus.BAD_REQUEST,
                                                                                    "Invalid code. " + remaining + " attempts remaining."
                                                                            )));
                                                                });
                                                    }
                                                })
                                        );
                            })
                            .onErrorResume(e -> {
                                if (e instanceof ResponseStatusException) {
                                    return Mono.error(e);
                                }
                                log.error("Unexpected error during OTP verification for txId={}", LoginUtility.sanitizeLog(txId), e);
                                return redis.delete(verifyLockKey)
                                        .then(Mono.error(new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Redis payload corruption")));
                            });
                });
    }

    /**
     * Internal helper: Hashes the OTP on boundedElastic and saves the transaction state in Redis.
     */
    private Mono<Void> saveOtpStateInternal(String txId, String userId, String plainOtp, LoginParam params) {
        final Duration otpValidity = Duration.ofMinutes(params.getSafeOtpValidityMin());
        final Duration screenTimeout = Duration.ofMinutes(params.getSafeOtpScreenTimeoutMin());

        return Mono.fromCallable(() -> {
                    String hash = passwordEncoder.encode(plainOtp);
                    return mapper.writeValueAsString(Map.of("userId", userId, "otpHash", hash));
                })
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(payload -> {
                    List<Mono<?>> operations = new ArrayList<>();

                    operations.add(redis.opsForValue().set("OTP_ACTIVE_TX:USR:" + userId, txId, screenTimeout));
                    operations.add(redis.opsForValue().set("OTP_SESSION:" + txId, userId, screenTimeout));
                    operations.add(redis.opsForValue().set("OTP_TX:" + txId, payload, otpValidity));
                    operations.add(redis.opsForValue().set("OTP_FAILURES:" + txId, "0", otpValidity));

                    return Mono.when(operations)
                            .doOnSuccess(v -> log.info("Saved OTP State txId={} for user={}",
                                    LoginUtility.sanitizeLog(txId), LoginUtility.sanitizeLog(userId)));
                });
    }

    /**
     * Deletes all Redis keys (both txId keys and User quota keys) upon successful verification.
     */
    private Mono<Void> cleanupAllOtpKeysOnSuccess(String txId, String userId) {
        return Mono.when(
                redis.delete("OTP_SESSION:" + txId),
                redis.delete("OTP_TX:" + txId),
                redis.delete("OTP_FAILURES:" + txId),
                redis.delete("OTP_VERIFY_LOCK:" + txId),
                redis.delete("OTP_ACTIVE_TX:USR:" + userId),
                redis.delete("OTP_COOLDOWN:USR:" + userId),
                redis.delete("OTP_RESENDS:USR:" + userId)
        );
    }

    /**
     * Compensating transaction for Initial Login: Cleans up the Redis state if Kafka fails during /login.
     */
    public Mono<Void> rollbackInitialOtpState(String txId, String userId) {
        final String cleanUserId = userId != null ? userId.trim() : "";
        return Mono.when(
                redis.delete("OTP_SESSION:" + txId),
                redis.delete("OTP_TX:" + txId),
                redis.delete("OTP_FAILURES:" + txId),
                redis.delete("OTP_ACTIVE_TX:USR:" + cleanUserId),
                redis.delete("OTP_COOLDOWN:USR:" + cleanUserId)
        ).doOnSuccess(v -> log.info("Rolled back initial OTP state for txId={}", LoginUtility.sanitizeLog(txId)));
    }

    /**
     * Compensating transaction for Resend: If Kafka fails during /resend-otp,
     * preserves OTP_SESSION, decrements the resend counter, and releases the 60s cooldown lock.
     */
    public Mono<Void> rollbackResendState(String txId, String userId) {
        final String cleanUserId = userId != null ? userId.trim() : "";
        return Mono.when(
                redis.delete("OTP_COOLDOWN:USR:" + cleanUserId),
                redis.opsForValue().decrement("OTP_RESENDS:USR:" + cleanUserId)
        ).doOnSuccess(v -> log.info("Rolled back resend increment and cooldown for txId={}", LoginUtility.sanitizeLog(txId)));
    }
}

















