    private static boolean isBlank(Object s) {
        if (s == null) return true;
        return s.toString().isBlank();
    }

    private static String display(Object value) {
        if (value == null) return "NULL";
        String s = value.toString();
        if (s.isBlank()) return "'(blank)'";
        return "'" + s + "'";
    }

    @Override
    public DashboardDataResponse fetchDashboardData(String token) {
        long start = System.currentTimeMillis();

        // 1. EXTRACT CONTEXT (Fast, In-Memory)
        String userId = jwtUtil.getUserIdFromToken(token);
        int roleIdInt = jwtUtil.getUserRoleFromToken(token);
        String roleIdStr = String.valueOf(roleIdInt);

        log.info(" Starting Parallel Dashboard Load for User: {}", userId);

        // 2. FIRE INDEPENDENT TASKS (Async)

        // Task A: Announcements (DB Call 1)
        CompletableFuture<List<Map<String, ChartDTO>>> staticDashboardData = CompletableFuture.supplyAsync(() -> {
            List<Map<String, ChartDTO>> res = staticDashboardData(roleIdInt);
            return res;
        });

        // 4. WAIT FOR ALL & ASSEMBLE
        // This will block only as long as the SLOWEST task takes.
        DashboardDataResponse response = new DashboardDataResponse();
        try {
            CompletableFuture.allOf(
                    staticDashboardData
            ).join();
            response.setStaticDashboardData(staticDashboardData.get());


        } catch (Exception e) {
            log.error("Error during parallel dashboard execution", e);
            throw new RuntimeException("Failed to load dashboard data", e);
        }

        long duration = System.currentTimeMillis() - start;
        log.info("Dashboard Loaded in {} ms (Parallel Execution)", duration);

        return response;
    }

    public List<Map<String, ChartDTO>> staticDashboardData(Integer roleId) {


