import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;

/**
 * <p>HTTP Client for upstream Report Service interactions.</p>
 *
 * @since 2026-07
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class ReportServiceClient {

    // Injected automatically from common-utilities (S2SRestClientConfig)
    private final RestClient interServiceClient;

    @Value("${app.temp-report.dir}")
    private String tempDir;

    private final String preFix="attach-";
    private final String suffix=".tmp";


    @Value("${report.service.url}")
    private String reportServiceUrl;

    @Value("${security.internal.report-service-token:TEST_TOKEN_123}")
    private String internalServiceToken;

    /**
     * V1021256
     * fetch zip file and save to the disk.
     */
    public Resource downloadAttachments(AttachmentDownloadRequest request) throws IOException {
        String endpoint = reportServiceUrl + "/api/reports/attachment/download";
        log.info("Initiating upstream request to Report Service: {}", endpoint);

        Path path=interServiceClient.post()
                .uri(endpoint)
                .contentType(MediaType.APPLICATION_JSON)   // ← request is a JSON object
                .accept(MediaType.APPLICATION_OCTET_STREAM,MediaType.APPLICATION_JSON)
                .body(request)
                .exchange((req, resp) -> {
                    if(resp.getStatusCode().is2xxSuccessful()) {
                        // Read filename from Content-Disposition
//                        String disposition = resp.getHeaders().getFirst(HttpHeaders.CONTENT_DISPOSITION);
//                        String filename = "fallback";
//                        if (disposition != null && disposition.contains("filename=")) {
//                            filename = disposition
//                                    .substring(disposition.indexOf("filename=") + "filename=".length())
//                                    .replace("\"", "")
//                                    .trim();
//                        }

                        Path dir = Path.of(tempDir);
                        if (!Files.exists(dir)) {
                            Files.createDirectory(dir);
                        }
                        Path filePath = Files.createTempFile(dir, preFix, suffix);

                        //fetching chunks and writing to file
                        try (InputStream in = resp.getBody()) {
                            Files.copy(in, filePath, StandardCopyOption.REPLACE_EXISTING);
                        } catch (IOException e) {
                            Files.deleteIfExists(filePath);
                            throw new CommunicationExceptions.AttachmentStreamingException("Attachment could not be fetched!", e);
                        }
                        return filePath;
                    }else{
                        String errorMessage = new String(resp.getBody().readAllBytes(), StandardCharsets.UTF_8);
                        throw new CommunicationExceptions.AttachmentDownloadException(String.format("Report download exception: [%s] %s",resp.getStatusCode(),errorMessage));
                    }
                });
        if(path==null){
            throw new CommunicationExceptions.AttachmentDownloadException("Attachment could not be fetched!");
        }
        log.info("Attachment fetched to disk!");
        return new FileSystemResource(path.toFile());
    }

    @PostConstruct
    public void init() {
        // Check the condition and modify the variable
        if (reportServiceUrl != null && !reportServiceUrl.startsWith("http://") && !reportServiceUrl.startsWith("https://")) {
            reportServiceUrl = "http://" + reportServiceUrl;
        }
    }
}










