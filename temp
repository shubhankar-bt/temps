    // =========================================================================================================
    //                                          GENERATE SESSION METHOD
    // =========================================================================================================

    private Mono<ResponseEntity<ApiResponse<?>>> generateSessionAndTokens(UserDto user, ServerHttpResponse response) {
        final String cleanUserId = user.getUserId() != null ? user.getUserId().trim() : "";
        log.info("Generating JWE Tokens for user {}.", LoginUtility.sanitizeLog(cleanUserId));

        return generateAndStoreAesKey(cleanUserId)
                .flatMap(aesKey -> Mono.defer(() -> Mono.fromCallable(() -> loginService.fetchRoleWiseData(cleanUserId)))
                        .subscribeOn(Schedulers.boundedElastic())
                        .flatMap(roleData -> {

                            String jti = UUID.randomUUID().toString();

                            @SuppressWarnings("unchecked")
                            Map<String, Object> claimsMap = mapper.convertValue(user.getUser(), Map.class);
                            claimsMap.put("jti", jti);

                            String accessToken = JweUtil.generateJwe(aesKey, cleanUserId, accessTokenTtl, claimsMap);

                            Map<String, Object> refreshClaims = Map.of("type", "refresh", "jti", UUID.randomUUID().toString());
                            String refreshToken = JweUtil.generateJwe(aesKey, cleanUserId, refreshTokenTtl, refreshClaims);

                            response.addCookie(createRefreshTokenCookie(refreshToken));

                            // Fortify Fix: Strip CR/LF before setting HTTP response header
                            final String safeHeaderKey = aesKey.replaceAll("[\\r\\n]", "");

                            return validator.registerUserSession(cleanUserId, jti)
                                    .thenReturn(ResponseEntity.ok()
                                            .header("X-Payload-Key", safeHeaderKey)
                                            .body(ApiResponse.success(
                                                    LoginResponseDTO.builder()
                                                            .userId(cleanUserId)
                                                            .validCredentials(true)
                                                            .accessToken(accessToken)
                                                            .tokenType("Bearer")
                                                            .expiresIn(accessTokenTtl)
                                                            .sub(cleanUserId)
                                                            .jti(jti)
                                                            .roleData(roleData)
                                                            .userStatus(user.getUserStatus())
                                                            .passwordLoginStatus(user.getPasswordLoginStatus())
                                                            .attemptsLeft(null)
                                                            .build(),
                                                    "Login successful"
                                            )));
                        }));
    }

    // =========================================================================================================
    //                                              HELPERS
    // =========================================================================================================

    private String sanitizeIp(String rawIp) {
        if (rawIp == null) return "";
        String ip = rawIp;
        if (ip.startsWith("/")) ip = ip.substring(1);
        int colonIndex = ip.indexOf(':');
        if (colonIndex != -1) ip = ip.substring(0, colonIndex);
        return ip;
    }

    private boolean isIpBlocked(String rawClientIp) {
        if (blockedIpsConfig == null || blockedIpsConfig.trim().isEmpty()) return false;
        String cleanIp = sanitizeIp(rawClientIp);
        List<String> blockedIps = Arrays.asList(blockedIpsConfig.split("\\s*,\\s*"));
        boolean blocked = blockedIps.contains(cleanIp);
        if (blocked) {
            log.warn("Blocked IP Match Found: Raw='{}' -> Clean='{}'", LoginUtility.sanitizeLog(rawClientIp), LoginUtility.sanitizeLog(cleanIp));
        }
        return blocked;
    }

    private ResponseCookie createRefreshTokenCookie(String token) {
        String safeToken = token != null ? token.replaceAll("[\\r\\n]", "") : "";
        return ResponseCookie.from("refresh_token", safeToken)
                .httpOnly(true)
                .secure(true)
                .path("/")
                .maxAge(Duration.ofSeconds(refreshTokenTtl))
                .sameSite("Strict")
                .build();
    }

    private ResponseCookie createEmptyCookie() {
        return ResponseCookie.from("refresh_token", "")
                .httpOnly(true)
                .secure(true)
                .path("/")
                .maxAge(0)
                .sameSite("Strict")
                .build();
    }

    private String generateNewAesKey() {
        return aesUtil.generateBase64SessionKey();
    }

    private Mono<String> generateAndStoreAesKey(String userId) {
        final String cleanUserId = userId != null ? userId.trim() : "";
        final String redisKey = AES_KEY_PREFIX + cleanUserId;

        return Mono.fromCallable(this::generateNewAesKey)
                .flatMap(aesKey -> {
                    log.info("Attempting to write AES key to Redis. Key: '{}', TTL: {} seconds",
                            LoginUtility.sanitizeLog(redisKey), refreshTokenTtl);

                    return redisTemplate.opsForValue()
                            .set(redisKey, aesKey, Duration.ofSeconds(refreshTokenTtl))
                            .doOnSuccess(success -> {
                                if (Boolean.TRUE.equals(success)) {
                                    log.info("SUCCESS: AES Key definitively written to Redis for User: {}", LoginUtility.sanitizeLog(cleanUserId));
                                } else {
                                    log.warn("WARNING: Redis returned FALSE. The AES key was NOT saved for User: {}", LoginUtility.sanitizeLog(cleanUserId));
                                }
                            })
                            .doOnError(error -> log.error("CRITICAL ERROR writing AES key to Redis: {}", LoginUtility.sanitizeLog(error.getMessage()), error))
                            .thenReturn(aesKey);
                });
    }

    private Mono<String> fetchAndExtendAesKey(String userId) {
        final String cleanUserId = userId != null ? userId.trim() : "";
        final String redisKey = AES_KEY_PREFIX + cleanUserId;

        return redisTemplate.opsForValue().get(redisKey)
                .switchIfEmpty(Mono.defer(() -> {
                    log.warn("AES key missing/evicted for user {} during refresh. Generating new fallback key.", LoginUtility.sanitizeLog(cleanUserId));
                    return Mono.just(generateNewAesKey());
                }))
                .flatMap(aesKey ->
                        redisTemplate.opsForValue()
                                .set(redisKey, aesKey, Duration.ofSeconds(refreshTokenTtl))
                                .thenReturn(aesKey)
                );
    }

    private Mono<JWTClaimsSet> decryptTokenManually(String jweToken) {
        return Mono.fromCallable(() -> {
            try {
                return EncryptedJWT.parse(jweToken);
            } catch (ParseException e) {
                throw new BadJwtException("Invalid token format");
            }
        }).flatMap(encryptedJWT -> {
            String rawUserId = encryptedJWT.getHeader().getKeyID();
            if (rawUserId == null || rawUserId.isBlank()) {
                return Mono.error(new BadJwtException("Missing kid header"));
            }
            String cleanUserId = rawUserId.trim();

            return redisTemplate.opsForValue().get(AES_KEY_PREFIX + cleanUserId)
                    .switchIfEmpty(Mono.error(new BadJwtException("Session expired or AES key missing")))
                    .map(aesKey -> JweUtil.decryptJwe(jweToken, aesKey));
        });
    }
}





















package com.fincore.gateway.Config;

import com.fincore.commonutilities.config.ResilienceConfig;
import com.fincore.commonutilities.jwt.JwtUtil;
import com.fincore.commonutilities.security.DecryptRequestBodyAdvice;
import com.fincore.commonutilities.util.AesEncryptionUtil;
import com.fincore.gateway.Service.TokenSessionValidator;
import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Import;
import org.springframework.http.HttpStatus;
import org.springframework.security.config.Customizer;
import org.springframework.security.config.web.server.SecurityWebFiltersOrder;
import org.springframework.security.config.web.server.ServerHttpSecurity;
import org.springframework.security.core.Authentication;
import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.security.web.server.SecurityWebFilterChain;
import org.springframework.web.cors.CorsConfiguration;
import org.springframework.web.cors.reactive.CorsConfigurationSource;
import org.springframework.web.cors.reactive.UrlBasedCorsConfigurationSource;
import org.springframework.web.server.ServerWebExchange;
import org.springframework.web.server.WebFilter;
import org.springframework.web.server.WebFilterChain;
import reactor.core.publisher.Mono;

import java.util.Arrays;
import java.util.Set;

@Slf4j
@Configuration
@Import({
        JwtUtil.class,
        AesEncryptionUtil.class,
        DecryptRequestBodyAdvice.class,
        ResilienceConfig.class,
})
public class SecurityConfig {

    private static final Set<String> WHITELIST = Set.of(
            "/api/auth/login",
            "/api/auth/verify-otp",
            "/api/auth/resend-otp",
            "/api/auth/logout",
            "/actuator/info",
            "/actuator/health",
            "/api/auth/public-key",
            "/api/auth/init",
            "/api/auth/update-password");

    private final TokenSessionValidator tokenSessionValidator;
    private final JweReactiveJwtDecoder jweReactiveJwtDecoder;

    public SecurityConfig(TokenSessionValidator tokenSessionValidator, JweReactiveJwtDecoder jweReactiveJwtDecoder) {
        this.tokenSessionValidator = tokenSessionValidator;
        this.jweReactiveJwtDecoder = jweReactiveJwtDecoder;
    }

    @Bean
    public PasswordEncoder passwordEncoder() {
        return new BCryptPasswordEncoder();
    }

    @Bean
    public SecurityWebFilterChain securityWebFilterChain(ServerHttpSecurity http) {
        log.info("Loading SecurityWebFilterChain with JWE Decoder");
        return http
                .csrf(ServerHttpSecurity.CsrfSpec::disable)
                .headers(headers -> headers
                        .xssProtection(ServerHttpSecurity.HeaderSpec.XssProtectionSpec::disable)
                        .frameOptions(ServerHttpSecurity.HeaderSpec.FrameOptionsSpec::disable)
                        .contentTypeOptions(Customizer.withDefaults())
                )
                .authorizeExchange(exchanges -> exchanges
                        .pathMatchers("/api/auth/**", "/actuator/**").permitAll()
                        .anyExchange().authenticated()
                )
                .oauth2ResourceServer(oauth2 -> oauth2
                        .jwt(jwt -> jwt.jwtDecoder(jweReactiveJwtDecoder))
                )
                .addFilterBefore(redisValidationFilter(), SecurityWebFiltersOrder.AUTHORIZATION)
                .build();
    }

    @Bean
    public CorsConfigurationSource corsConfigurationSource() {
        CorsConfiguration configuration = new CorsConfiguration();
        // Fortify Fix: Removed "*" wildcard to resolve 'HTML5: Overly Permissive CORS Policy'
        configuration.setAllowedOrigins(
                Arrays.asList(
                        "https://fincore-uat.sbi",
                        "https://localhost:1000",
                        "https://fincoreuat.sbi",
                        "https://fincorest.sbi",
                        "https://fincore.sbi"
                )
        );
        configuration.setAllowedMethods(Arrays.asList("GET", "POST", "PUT", "DELETE", "OPTIONS"));
        configuration.setAllowedHeaders(Arrays.asList("Authorization", "Content-Type", "X-Request-Type"));
        configuration.setExposedHeaders(Arrays.asList("X-Payload-Key"));
        configuration.setAllowCredentials(false);

        UrlBasedCorsConfigurationSource source = new UrlBasedCorsConfigurationSource();
        source.registerCorsConfiguration("/**", configuration);
        return source;
    }

    private WebFilter redisValidationFilter() {
        return (ServerWebExchange exchange, WebFilterChain chain) -> {
            String path = exchange.getRequest().getPath().value();

            if (isWhitelisted(path)) {
                return chain.filter(exchange);
            }

            Mono<Authentication> principalMono = exchange.getPrincipal().cast(Authentication.class);

            return principalMono
                    .hasElement()
                    .flatMap(hasPrincipal -> {
                        if (!hasPrincipal) {
                            return chain.filter(exchange);
                        }

                        return principalMono
                                .flatMap(auth -> tokenSessionValidator.validateWithRedis(auth)
                                        .flatMap(validAuth -> {
                                            if (validAuth == null) {
                                                log.warn("Redis validation failed for {}", auth.getName());
                                                exchange.getResponse().setStatusCode(HttpStatus.UNAUTHORIZED);
                                                return exchange.getResponse().setComplete();
                                            }
                                            log.info("Redis validated for {}", validAuth.getName());
                                            return chain.filter(exchange);
                                        })
                                );
                    })
                    .onErrorResume(e -> {
                        log.error("RedisValidationFilter error: {}", e.getMessage(), e);
                        exchange.getResponse().setStatusCode(HttpStatus.UNAUTHORIZED);
                        return exchange.getResponse().setComplete();
                    });
        };
    }

    private boolean isWhitelisted(String path) {
        return WHITELIST.contains(path) || path.startsWith("/api/auth/") || path.startsWith("/actuator/");
    }
}






















