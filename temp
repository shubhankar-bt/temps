package com.fincore.DashboardService.dto.response;

import java.util.List;

/**
 * Encapsulates a single time-series chart configuration and its data.
 * Formatted specifically for React charting libraries (Row-based matrix).
 */
public record ChartTrendDTO(
    String key,
    String title,
    List<ProductMetaDTO> products,
    List<TrendDataPointDTO> data
) {}

/**
 * Represents the metadata for the categories in the chart.
 * The index of the product in the 'products' array strictly matches 
 * the index of its measurement in the 'values' array.
 */
public record ProductMetaDTO(
    String name,
    String type
) {}

/**
 * Represents a single point on the X-Axis (Date) and all parallel Y-values.
 */
public record TrendDataPointDTO(
    String date,
    List<Double> values
) {}











package com.fincore.DashboardService.service;

import com.fincore.DashboardService.dto.response.ChartTrendDTO;
import com.fincore.DashboardService.dto.response.ProductMetaDTO;
import com.fincore.DashboardService.dto.response.TrendDataPointDTO;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;
import java.util.Random;

/**
 * Handles the retrieval and formatting of time-series trend data.
 * Outputs a strict row-based array matrix requested by the frontend team.
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class DashboardTrendService {

    private static final DateTimeFormatter DATE_FORMATTER = DateTimeFormatter.ofPattern("yyyy-MM-dd");

    /**
     * Fetches the trend data for the requested number of historical days.
     * 
     * @param days The number of historical days to fetch (e.g., 7)
     * @return List of ChartTrendDTOs matching the exact frontend contract
     */
    public List<ChartTrendDTO> fetchTrendData(int days) {
        if (days <= 0 || days > 365) {
            log.warn("Invalid days parameter requested: {}. Defaulting to 7.", days);
            days = 7;
        }

        log.info("Generating {}-day row-based trend data for Frontend", days);
        
        LocalDate endDate = LocalDate.now();
        Random random = new Random();

        List<ChartTrendDTO> charts = new ArrayList<>();

        // 1. Demand Deposits Chart
        charts.add(buildChart(
            "demandDeposits", "Demand Deposits", "Demand Deposit", 
            List.of("Saving Bank A/c", "Current A/c", "Cash Credit Cr Balance", "Other Demand Deposit"),
            List.of(45.0, 12.0, 78.0, 33.0), // Base values for mocking
            days, endDate, random
        ));

        // 2. Time Deposits Chart
        charts.add(buildChart(
            "timeDeposits", "Time Deposits", "Time Deposit", 
            List.of("Certificate of Deposit", "Other Term Deposit", "Special Term Deposit", "Term Deposit"),
            List.of(64.0, 27.0, 91.0, 56.0), 
            days, endDate, random
        ));

        // 3. Loans Chart
        charts.add(buildChart(
            "loansBreakdown", "Loan Distribution", "Loan", 
            List.of("Term Loan Account", "Agri Cash Credit", "Cash Credit", "Demand Loan", "Overdraft", "Bills Payable"),
            List.of(28.0, 55.0, 41.0, 82.0, 73.0, 19.0), 
            days, endDate, random
        ));

        return charts;
    }

    /**
     * Helper method to dynamically construct the Chart matrix.
     * Ensures strict index alignment between products and their daily values.
     */
    private ChartTrendDTO buildChart(
            String key, String title, String typeName, 
            List<String> productNames, List<Double> baseValues, 
            int days, LocalDate endDate, Random random) {

        // Build Product Metadata
        List<ProductMetaDTO> products = productNames.stream()
                .map(name -> new ProductMetaDTO(name, typeName))
                .toList();

        // Build Data Points (Row by Row, Date by Date)
        List<TrendDataPointDTO> dataPoints = new ArrayList<>(days);
        
        // Loop backwards to ensure chronological order
        for (int i = days - 1; i >= 0; i--) {
            String dateStr = endDate.minusDays(i).format(DATE_FORMATTER);
            List<Double> dailyValues = new ArrayList<>(productNames.size());
            
            // Generate values strictly mapped to the index of the products array
            for (Double baseValue : baseValues) {
                double variance = (random.nextDouble() * 4) - 2; // slight realistic variance
                double finalValue = Math.max(0, baseValue + variance);
                dailyValues.add(Math.round(finalValue * 10.0) / 10.0);
            }
            
            dataPoints.add(new TrendDataPointDTO(dateStr, dailyValues));
        }

        return new ChartTrendDTO(key, title, products, dataPoints);
    }
}








