package com.fincore.dashboard.api.response;

import java.time.Instant;

/**
 * Standardized API envelope for all Fincore responses.
 */
public record ApiResponse<T>(
    boolean success,
    String message,
    String timestamp,
    T data
) {
    public static <T> ApiResponse<T> success(T data, String message) {
        return new ApiResponse<>(true, message, Instant.now().toString(), data);
    }

    public static <T> ApiResponse<T> error(String message) {
        return new ApiResponse<>(false, message, Instant.now().toString(), null);
    }
}















package com.fincore.dashboard.api.exception;

public abstract class DashboardBaseException extends RuntimeException {
    protected DashboardBaseException(String message) { super(message); }
    protected DashboardBaseException(String message, Throwable cause) { super(message, cause); }
}

public class ResourceNotFoundException extends DashboardBaseException {
    public ResourceNotFoundException(String message) { super(message); }
}

public class DownstreamServiceException extends DashboardBaseException {
    public DownstreamServiceException(String message, Throwable cause) { super(message, cause); }
}

public class UnauthorizedScopeException extends DashboardBaseException {
    public UnauthorizedScopeException(String message) { super(message); }
}












package com.fincore.dashboard.api.exception;

import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpStatus;
import org.springframework.http.ProblemDetail;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

import java.net.URI;

@Slf4j
@RestControllerAdvice
public class GlobalExceptionHandler {

    @ExceptionHandler(ResourceNotFoundException.class)
    public ProblemDetail handleNotFound(ResourceNotFoundException ex) {
        log.warn("Resource not found: {}", ex.getMessage());
        ProblemDetail problemDetail = ProblemDetail.forStatusAndDetail(HttpStatus.NOT_FOUND, ex.getMessage());
        problemDetail.setType(URI.create("https://api.fincore.com/errors/not-found"));
        problemDetail.setTitle("Resource Not Found");
        return problemDetail;
    }

    @ExceptionHandler(DownstreamServiceException.class)
    public ProblemDetail handleDownstreamFailure(DownstreamServiceException ex) {
        log.error("Downstream service failure: {}", ex.getMessage(), ex);
        ProblemDetail problemDetail = ProblemDetail.forStatusAndDetail(HttpStatus.BAD_GATEWAY, "A dependent service failed to respond.");
        problemDetail.setType(URI.create("https://api.fincore.com/errors/downstream-failure"));
        problemDetail.setTitle("Upstream Dependency Error");
        return problemDetail;
    }

    // Catch-all for unexpected bugs (Prevents stack traces from leaking to the frontend)
    @ExceptionHandler(Exception.class)
    public ProblemDetail handleUnhandledException(Exception ex) {
        log.error("Unhandled system exception occurred", ex);
        ProblemDetail problemDetail = ProblemDetail.forStatusAndDetail(HttpStatus.INTERNAL_SERVER_ERROR, "An unexpected system error occurred.");
        problemDetail.setType(URI.create("https://api.fincore.com/errors/internal-error"));
        problemDetail.setTitle("Internal Server Error");
        return problemDetail;
    }
}











package com.fincore.dashboard.api.controller;

import com.fincore.dashboard.api.response.ApiResponse;
import com.fincore.dashboard.dto.response.DashboardOverviewResponse;
import com.fincore.dashboard.dto.response.TrendResponse;
import com.fincore.dashboard.service.DashboardOverviewService;
import com.fincore.dashboard.service.DashboardTrendService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.time.LocalDate;

/**
 * REST Controller for the Fincore Executive Dashboard.
 * 
 * ARCHITECTURE NOTE:
 * We explicitly separate the Overview (Point-in-time) from Trends (Time-series).
 * This prevents the N+1 API payload bloat and allows the React frontend to 
 * utilize Progressive Rendering (React Suspense). The overview loads instantly, 
 * while heavier historical trend charts load asynchronously.
 */
@Slf4j
@RestController
@RequestMapping("/api/v1/dashboard")
@RequiredArgsConstructor
public class DashboardController {

    private final DashboardOverviewService overviewService;
    private final DashboardTrendService trendService;

    /**
     * API 1: Fast Point-in-Time Overview.
     * Uses a single bulk Druid query internally.
     */
    @GetMapping("/overview")
    public ResponseEntity<ApiResponse<DashboardOverviewResponse>> getOverview(
            @RequestHeader("Authorization") String token,
            @RequestParam(required = false) String asOfDate) {
        
        String queryDate = (asOfDate != null) ? asOfDate : LocalDate.now().toString();
        log.info("Received request for Dashboard Overview. Date: {}", queryDate);
        
        DashboardOverviewResponse data = overviewService.fetchOverview(token, queryDate);
        return ResponseEntity.ok(ApiResponse.success(data, "Overview loaded successfully"));
    }

    /**
     * API 2: Time-Series Trend Data (Columnar Approach B).
     * Decoupled to prevent blocking the main dashboard render.
     */
    @GetMapping("/trend")
    public ResponseEntity<ApiResponse<TrendResponse>> getTrend(
            @RequestHeader("Authorization") String token,
            @RequestParam(defaultValue = "7") int days) {
        
        log.info("Received request for Dashboard Trend. Days: {}", days);
        
        TrendResponse data = trendService.fetchTrend(token, days);
        return ResponseEntity.ok(ApiResponse.success(data, days + "-Day trend loaded successfully"));
    }
}

















package com.fincore.dashboard.dto.response;

import java.util.List;

/**
 * Encapsulates the entire 7-day trend response for the dashboard.
 * Designed to separate the charts into distinct objects so the frontend 
 * can route them directly to the respective UI components.
 */
public record TrendResponse(
    ChartTrendDTO demandDeposits,
    ChartTrendDTO timeDeposits,
    ChartTrendDTO loans
) {}











package com.fincore.dashboard.dto.response;

import java.util.List;

/**
 * Represents a single time-series chart.
 * 
 * ARCHITECTURE NOTE (Approach B): 
 * We explicitly separate the X-axis (dates) from the Y-axis (series).
 * This drastically reduces JSON payload size over the network by preventing 
 * date and name strings from being repeated for every single data point.
 */
public record ChartTrendDTO(
    String title,
    String key,
    List<String> dates,      // The shared X-axis (e.g., ["2026-09-12", "2026-09-13"])
    List<SeriesDTO> series   // The multiple Y-axes plotting against the dates
) {}










package com.fincore.dashboard.dto.response;

import java.util.List;

/**
 * Represents one line or bar segment in the trend chart.
 * 
 * CRITICAL RULE: The 'values' array size and index MUST perfectly match 
 * the 'dates' array in the parent ChartTrendDTO. If a value is missing 
 * for a specific date, it must be explicitly populated as 0.0.
 */
public record SeriesDTO(
    String name,
    String type,
    List<Double> values
) {}
















package com.fincore.dashboard.service;

import com.fincore.dashboard.dto.response.ChartTrendDTO;
import com.fincore.dashboard.dto.response.SeriesDTO;
import com.fincore.dashboard.dto.response.TrendResponse;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;
import java.util.Random;

/**
 * Handles the retrieval and formatting of time-series trend data.
 * Currently runs in a mocked state to unblock frontend development.
 * Will be wired to Oracle/Druid via the PySpark pipeline in Phase 2.
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class DashboardTrendService {

    private static final DateTimeFormatter DATE_FORMATTER = DateTimeFormatter.ofPattern("yyyy-MM-dd");

    /**
     * Fetches the trend data for the requested number of historical days.
     * 
     * @param token The user's JWT token (used for scope resolution later)
     * @param days  The number of historical days to fetch (e.g., 7)
     * @return TrendResponse containing strictly aligned columnar data
     */
    public TrendResponse fetchTrend(String token, int days) {
        // Guard clause: Protect against bad inputs that could crash the array logic
        if (days <= 0 || days > 365) {
            log.warn("Invalid days parameter requested: {}. Defaulting to 7.", days);
            days = 7;
        }

        log.info("Generating {}-day columnar trend data (Approach B)", days);
        
        LocalDate endDate = LocalDate.now();
        Random random = new Random();

        // 1. Generate the Shared Date Axis (The X-Axis)
        // We pre-allocate the ArrayList capacity to avoid memory resizing overhead
        List<String> sharedDates = new ArrayList<>(days);
        
        // Loop backwards from (days - 1) down to 0 to ensure chronological order (oldest to newest)
        for (int i = days - 1; i >= 0; i--) {
            sharedDates.add(endDate.minusDays(i).format(DATE_FORMATTER));
        }

        // 2. Build the Series Data (The Y-Axes)
        ChartTrendDTO demandTrend = buildDemandTrend(sharedDates, days, random);
        ChartTrendDTO timeTrend = buildTimeTrend(sharedDates, days, random);
        ChartTrendDTO loanTrend = buildLoanTrend(sharedDates, days, random);

        return new TrendResponse(demandTrend, timeTrend, loanTrend);
    }

    private ChartTrendDTO buildDemandTrend(List<String> sharedDates, int days, Random random) {
        List<SeriesDTO> series = List.of(
            createMockSeries("Saving Bank A/c", "Demand Deposit", 45.0, days, random),
            createMockSeries("Current A/c", "Demand Deposit", 12.0, days, random),
            createMockSeries("Cash Credit Cr Balance", "Demand Deposit", 78.0, days, random),
            createMockSeries("Other Demand Deposit", "Demand Deposit", 33.0, days, random)
        );
        return new ChartTrendDTO("Demand Deposits", "demandDepositsTrend", sharedDates, series);
    }

    private ChartTrendDTO buildTimeTrend(List<String> sharedDates, int days, Random random) {
        List<SeriesDTO> series = List.of(
            createMockSeries("Term Deposit", "Time Deposit", 56.0, days, random),
            createMockSeries("Special Term Deposit", "Time Deposit", 91.0, days, random),
            createMockSeries("Other Term Deposit", "Time Deposit", 27.0, days, random),
            createMockSeries("Certificate of Deposit", "Time Deposit", 64.0, days, random)
        );
        return new ChartTrendDTO("Time Deposits", "timeDepositsTrend", sharedDates, series);
    }

    private ChartTrendDTO buildLoanTrend(List<String> sharedDates, int days, Random random) {
        List<SeriesDTO> series = List.of(
            createMockSeries("Term Loan Account", "Loan", 28.0, days, random),
            createMockSeries("Agri Cash Credit", "Loan", 55.0, days, random),
            createMockSeries("Cash Credit", "Loan", 41.0, days, random),
            createMockSeries("Demand Loan", "Loan", 82.0, days, random),
            createMockSeries("Overdraft", "Loan", 73.0, days, random),
            createMockSeries("Bills Payable", "Loan", 19.0, days, random)
        );
        return new ChartTrendDTO("Loans", "loansTrend", sharedDates, series);
    }

    /**
     * Helper method to generate an array of values that perfectly aligns with the dates array.
     */
    private SeriesDTO createMockSeries(String name, String type, double baseValue, int days, Random random) {
        List<Double> values = new ArrayList<>(days);
        
        for (int i = 0; i < days; i++) {
            // Add a slight variance to the base value to make the chart look realistic
            double variance = (random.nextDouble() * 10) - 5; // Variance between -5 and +5
            double finalValue = Math.max(0, baseValue + variance); // Prevent negative balances in UI
            
            // Round to 2 decimal places (Standard for currency in Trillions/Billions)
            values.add(Math.round(finalValue * 100.0) / 100.0);
        }
        return new SeriesDTO(name, type, values);
    }
}
























