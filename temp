package com.fincore.commonutilities.jwt;

import com.nimbusds.jose.JOSEException;
import com.nimbusds.jose.crypto.DirectDecrypter;
import com.nimbusds.jwt.EncryptedJWT;
import io.jsonwebtoken.Claims;
import io.jsonwebtoken.Jwts;
import io.jsonwebtoken.io.Decoders;
import io.jsonwebtoken.security.Keys;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.stereotype.Component;

import javax.crypto.SecretKey;
import java.text.ParseException;
import java.util.Base64;
import java.util.Date;
import java.util.Map;
import java.util.UUID;
import java.util.function.Function;

/**
 * Utility class for manipulating and validating JSON Web Tokens (JWT).
 * This class is shared across microservices to ensure consistent token parsing logic.
 * Features Smart Routing to support both JWE (Frontend) and JWS (M2M Service) tokens.
 *
 *  @author SHUBHANKAR DAS [Emp ID: V1018405]
 *  <a href="mailto:shubhankar.das.cbstcs@sbi.co.in">shubhankar.das.cbstcs@sbi.co.in</a>
 *  @version 1.1.0 (Added Security Context Bridging for JWE backward compatibility)
 *  @since 2025-08-01
 */
@Component
@Slf4j
public class JwtUtil {

    // Default value provided for dev, override in application.properties
    @Value("${jwt.secret:bWV0aGlvbnlsdGhyZW9ueWx0aHJlb255bGdsdXRhbWlueWxhbGFueWw=}")
    private String secretKey;

    /**
     * Extracts the User ID (Subject) from the token.
     * Smartly routes between JWE (Frontend) and JWS (M2M Service) tokens.
     *
     * @param token The Bearer token.
     * @return The userId string.
     */
    public String getUserIdFromToken(String token) {
        String cleanToken = removeBearerPrefix(token);
        String[] parts = cleanToken.split("\\.");

        if (parts.length == 5) {
            // JWE FLOW: Security Context Bridging
            // Filter has already authenticated this. Fetching from context is faster and safer.
            Authentication auth = SecurityContextHolder.getContext().getAuthentication();
            if (auth != null && auth.getName() != null) {
                return auth.getName();
            }
            // Fallback if called outside HTTP request scope
            return extractUserIdFromJweHeader(cleanToken);
        } else {
            // JWS FLOW: M2M tokens using JJWT
            return extractClaim(cleanToken, Claims::getSubject);
        }
    }

    /**
     * Extracts the Role ID from the token.
     * Maintains backward compatibility for legacy Controller calls.
     *
     * @param token The Bearer token.
     * @return The Role ID as an integer.
     */
    public int getUserRoleFromToken(String token) {
        String cleanToken = removeBearerPrefix(token);
        String[] parts = cleanToken.split("\\.");

        if (parts.length == 5) {
            // JWE FLOW: Security Context Bridging
            // JWE payloads are encrypted. We CANNOT parse them here without Redis.
            // Since ContextRbacFilter already decrypted it, we fetch the role from the SecurityContext natively.
            Authentication auth = SecurityContextHolder.getContext().getAuthentication();
            if (auth != null && auth.getAuthorities() != null) {
                return auth.getAuthorities().stream()
                        .filter(a -> a.getAuthority().startsWith("ROLE_"))
                        .map(a -> Integer.parseInt(a.getAuthority().substring(5)))
                        .findFirst()
                        .orElseThrow(() -> new SecurityException("No Role found in SecurityContext for JWE"));
            }
            throw new SecurityException("Cannot extract Role from JWE token outside of an authenticated HTTP request.");
        } else {
            // JWS FLOW: Legacy parsing for M2M tokens
            return extractClaim(cleanToken, claims -> {
                Object role = claims.get("role");
                if (role instanceof Number n) return n.intValue();
                if (role instanceof String s) {
                    try { return Integer.parseInt(s); } catch (NumberFormatException ignored) {}
                }
                throw new IllegalArgumentException("Token role claim is not a number");
            });
        }
    }

    /**
     * Validates the cryptographic signature and expiration of the token.
     */
    public boolean isTokenValid(String token) {
        String cleanToken = removeBearerPrefix(token);
        return !isTokenExpired(cleanToken);
    }

    /**
     * GENERIC CLAIM EXTRACTOR (Made Public for Filter access).
     */
    public <T> T extractClaim(String token, Function<Claims, T> claimsResolver) {
        final Claims claims = extractAllClaims(token);
        return claimsResolver.apply(claims);
    }

    // --- Internal Helpers ---

    private String removeBearerPrefix(String token) {
        if (token != null && token.startsWith("Bearer ")) {
            return token.substring(7);
        }
        return token;
    }

    private boolean isTokenExpired(String token) {
        return extractExpiration(token).before(new Date());
    }

    private Date extractExpiration(String token) {
        return extractClaim(token, Claims::getExpiration);
    }

    private Claims extractAllClaims(String token) {
        return Jwts.parser()
                .verifyWith(getSigningKey())
                .build()
                .parseSignedClaims(token)
                .getPayload();
    }

    private SecretKey getSigningKey() {
        byte[] keyBytes = Decoders.BASE64.decode(secretKey);
        return Keys.hmacShaKeyFor(keyBytes);
    }

    /**
     * Generates a short-lived JSON Web Token specifically for Service-to-Service (M2M) communication.
     */
    public String generateServiceToken(String serviceName) {
        long currentTimeMillis = System.currentTimeMillis();
        long expirationTimeMillis = currentTimeMillis + (1000 * 60 * 5); // 5 Minutes maximum lifespan

        return Jwts.builder()
                .subject(serviceName)
                .claim("type", "SERVICE")
                .id(UUID.randomUUID().toString())
                .issuedAt(new Date(currentTimeMillis))
                .expiration(new Date(expirationTimeMillis))
                .signWith(getSigningKey())
                .compact();
    }

    //=========================== JWE Methods =========================

    /**
     * Extracts the 'kid' (Key ID) from the unencrypted JWE header.
     */
    public String extractUserIdFromJweHeader(String jweToken) {
        try {
            var jwt = EncryptedJWT.parse(jweToken);
            return jwt.getHeader().getKeyID();
        } catch (ParseException e) {
            throw new IllegalArgumentException("Malformed JWE token. Cannot read header.", e);
        }
    }

    /**
     * Decrypts a Nimbus JWE token using the AES-256-GCM key fetched from Redis.
     */
    public Map<String, Object> decryptNimbusJwe(String jweToken, String base64Key) {
        try {
            var jwt = EncryptedJWT.parse(jweToken);
            var keyBytes = Base64.getDecoder().decode(base64Key);

            if (keyBytes.length != 32) {
                throw new IllegalArgumentException("Invalid AES key length. Expected 32 bytes.");
            }

            jwt.decrypt(new DirectDecrypter(keyBytes));
            return jwt.getJWTClaimsSet().getClaims();

        } catch (ParseException e) {
            throw new IllegalArgumentException("Malformed JWE token structure.", e);
        } catch (JOSEException e) {
            throw new SecurityException("JWE Decryption failed. Key mismatch or tampered payload.", e);
        }
    }
}
