package com.fincore.gateway.Service;

import com.fincore.gateway.model.LoginParam;
import com.fincore.gateway.utility.LoginUtility;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.redis.core.ReactiveStringRedisTemplate;
import org.springframework.http.HttpStatus;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.web.server.ResponseStatusException;
import reactor.core.publisher.Mono;
import reactor.core.scheduler.Schedulers;
import reactor.util.function.Tuple3;
import reactor.util.function.Tuples;
import tools.jackson.core.type.TypeReference;
import tools.jackson.databind.ObjectMapper;

import java.time.Duration;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * ============================================================================
 * PRODUCTION OTP LIFECYCLE, SLIDING WINDOW & CONCURRENCY ENGINE
 * ============================================================================
 * All timers and limits are dynamically fetched from LoginParamCacheService:
 * - OTP Validity               : LOGIN_PARAM.OTP_VALIDITY (Default: 5 min)
 * - OTP Screen Idle Timeout    : LOGIN_PARAM.OTP_SCREEN_TIMEOUT_MIN (Default: 15 min)
 * - Max Wrong Attempts         : LOGIN_PARAM.OTP_MAX_ATTEMPTS (Default: 5)
 * - Resend Cooldown            : LOGIN_PARAM.OTP_RESEND_COOLDOWN_SEC (Default: 60 sec)
 * - Max Resend Count           : LOGIN_PARAM.OTP_MAX_RESENDS (Default: 3)
 * - Sliding Resend Window      : LOGIN_PARAM.OTP_RESEND_WINDOW_MIN (Default: 10 min)
 * <p>
 * REDIS KEYS ARCHITECTURE:
 * 1. OTP_ACTIVE_TX:USR:{userId} -> Active txId (TTL: 15m - Enforces 1 OTP session per user)
 * 2. OTP_COOLDOWN:USR:{userId}  -> "locked" (TTL: 60s - Enforces cooldown across Resend AND Back-to-Login)
 * 3. OTP_RESENDS:USR:{userId}   -> JSON { "initAtMs": 170..., "resends": [170..., 170...] }
 *                                  (TTL: 10m from latest action - Enforces true 10m sliding window)
 * 4. OTP_SESSION:{txId}         -> userId (TTL: 15m - Tracks overall OTP screen sliding idle timeout)
 * 5. OTP_TX:{txId}              -> { "userId": "...", "otpHash": "..." } (TTL: 5m - Active code)
 * 6. OTP_FAILURES:{txId}        -> Integer count (TTL: 5m)
 * 7. OTP_VERIFY_LOCK:{txId}     -> "verifying" (TTL: 10s - Prevents double-click race condition)
 * 8. RATE_LIMIT:OTP_REQ:IP:{ip} -> Integer count (TTL: 1h)
 * ============================================================================
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class OtpSessionService {

    private static final int MAX_HOURLY_IP_REQUESTS = 50;

    private final ReactiveStringRedisTemplate redis;
    private final PasswordEncoder passwordEncoder;
    private final ObjectMapper mapper;
    private final LoginParamCacheService loginParamCacheService;

    /**
     * Rate limits OTP requests by IP to prevent API abuse and SMS Toll Fraud.
     * Reserves HTTP 429 for true IP-level rate limiting.
     */
    public Mono<Void> checkIpRateLimit(String clientIp) {
        String key = "RATE_LIMIT:OTP_REQ:IP:" + clientIp;
        return redis.opsForValue().increment(key)
                .flatMap(count -> {
                    if (count == 1) {
                        return redis.expire(key, Duration.ofHours(1)).then();
                    } else if (count > MAX_HOURLY_IP_REQUESTS) {
                        log.warn("SECURITY ALERT: IP {} exceeded hourly OTP limit.", LoginUtility.sanitizeLog(clientIp));
                        return Mono.error(new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS,
                                "Maximum resend limit reached. Kindly Wait."));
                    }
                    return Mono.empty();
                });
    }

    /**
     * Initiates a fresh OTP session on /login using a True 10-Minute Sliding Window:
     * 1. Evaluates the user's sliding 10-minute resend window [now - 10m, now].
     *    Any resend timestamp older than 10 minutes automatically drops out of the window.
     * 2. If all 3 resend slots in the current 10-minute window are occupied, blocks immediately
     *    on the Sign-In screen with 400 Bad Request ("Maximum resend limit reached. Kindly Wait.").
     * 3. Checks the 60-second cooldown BEFORE touching oldTxId (protecting an active Device 1 session).
     * 4. If allowed, evicts any previous abandoned OTP session (oldTxId) for this user, updates the
     *    sliding window timestamps, and saves the new OTP state.
     */
    public Mono<OtpSessionInitResult> initiateUserOtpSession(String newTxId, String userId, String newPlainOtp) {
        final String cleanUserId = userId.trim();
        final LoginParam params = loginParamCacheService.getCachedLoginParam();

        final int otpValidityMin = params.getSafeOtpValidityMin();
        final int cooldownSec = params.getSafeOtpResendCooldownSec();
        final int maxResends = params.getSafeOtpMaxResends();
        final int resendWindowMin = params.getSafeOtpResendWindowMin();
        final int screenTimeoutMin = params.getSafeOtpScreenTimeoutMin();

        final Duration cooldownDuration = Duration.ofSeconds(cooldownSec);
        final Duration resendWindowDuration = Duration.ofMinutes(resendWindowMin);
        final long windowMs = resendWindowDuration.toMillis();

        final String activeTxKey = "OTP_ACTIVE_TX:USR:" + cleanUserId;
        final String userCooldownKey = "OTP_COOLDOWN:USR:" + cleanUserId;
        final String userResendKey = "OTP_RESENDS:USR:" + cleanUserId;

        return Mono.zip(
                redis.opsForValue().get(activeTxKey).defaultIfEmpty(""),
                redis.getExpire(userCooldownKey).defaultIfEmpty(Duration.ZERO),
                redis.opsForValue().get(userResendKey).defaultIfEmpty("")
        ).flatMap(userState -> {
            final long nowMs = System.currentTimeMillis();
            final String oldTxId = userState.getT1();
            final long cooldownRemainingSec = Math.max(0, userState.getT2().getSeconds());
            final String rawResendState = userState.getT3();

            // Prune any resend timestamps older than (nowMs - 10 minutes)
            final ResendWindowState windowState = parseAndPruneWindowState(rawResendState, nowMs, windowMs);
            final boolean hasActiveWindow = windowState.initAtMs() > 0;
            final int activeResendsInWindow = windowState.resends().size();

            // 1. FAIL-FAST QUOTA CHECK: If all 3 slots in [now - 10m, now] are full, block immediately
            // Checked first so a user with 0 resends left gets "Maximum resend limit reached" immediately
            if (hasActiveWindow && activeResendsInWindow >= maxResends) {
                log.warn("Login OTP blocked for user={}: Sliding {}-min window full ({}/{} resends active).",
                        LoginUtility.sanitizeLog(cleanUserId), resendWindowMin, activeResendsInWindow, maxResends);
                return Mono.error(new ResponseStatusException(
                        HttpStatus.BAD_REQUEST,
                        "Maximum resend limit reached. Kindly Wait."
                ));
            }

            // 2. FAIL-FAST COOLDOWN CHECK: Block BEFORE touching oldTxId (Protects active Device 1 session)
            // Uses BAD_REQUEST (400) so Frontend global 429 interceptor does not show a duplicate snackbar
            if (cooldownRemainingSec > 0) {
                return Mono.error(new ResponseStatusException(
                        HttpStatus.BAD_REQUEST,
                        "Please wait " + cooldownRemainingSec + " seconds before requesting another code."
                ));
            }

            // 3. Acquire Atomic 60s User Cooldown Lock (SETNX prevents simultaneous 2-device race condition)
            return redis.opsForValue().setIfAbsent(userCooldownKey, "locked", cooldownDuration)
                    .flatMap(acquired -> {
                        if (!Boolean.TRUE.equals(acquired)) {
                            return redis.getExpire(userCooldownKey)
                                    .flatMap(ttl -> Mono.error(new ResponseStatusException(
                                            HttpStatus.BAD_REQUEST,
                                            "Please wait " + Math.max(1, ttl.getSeconds()) + " seconds before requesting another code."
                                    )));
                        }

                        // 4. Evict any previous abandoned OTP session for this user (Single Active Session enforcement)
                        Mono<Void> evictOldTx = oldTxId.isEmpty()
                                ? Mono.empty()
                                : Mono.when(
                                        redis.delete("OTP_SESSION:" + oldTxId),
                                        redis.delete("OTP_TX:" + oldTxId),
                                        redis.delete("OTP_FAILURES:" + oldTxId),
                                        redis.delete("OTP_VERIFY_LOCK:" + oldTxId)
                                ).doOnSuccess(v -> log.info("Evicted previous OTP txId={} for user={}",
                                        LoginUtility.sanitizeLog(oldTxId), LoginUtility.sanitizeLog(cleanUserId)));

                        // 5. Update 10-Minute Sliding Resend Window State
                        final ResendWindowState updatedState;
                        final int remainingResends;

                        if (!hasActiveWindow) {
                            // First login in the rolling 10-minute window: 0 resends used, 3 remaining
                            updatedState = new ResendWindowState(nowMs, List.of());
                            remainingResends = maxResends;
                        } else {
                            // Re-login within an active 10-minute window: consumes 1 resend slot at nowMs
                            List<Long> updatedResends = new ArrayList<>(windowState.resends());
                            updatedResends.add(nowMs);
                            updatedState = new ResendWindowState(windowState.initAtMs(), updatedResends);
                            remainingResends = Math.max(0, maxResends - updatedResends.size());
                        }

                        String serializedState = serializeWindowState(updatedState);
                        log.info("Sliding Window OTP Init for user={}: activeResendsInLast{}m={}, resendsRemaining={}",
                                LoginUtility.sanitizeLog(cleanUserId), resendWindowMin,
                                updatedState.resends().size(), remainingResends);

                        return evictOldTx
                                .then(redis.opsForValue().set(userResendKey, serializedState, resendWindowDuration))
                                .then(saveOtpStateInternal(newTxId, cleanUserId, newPlainOtp, params))
                                .thenReturn(new OtpSessionInitResult(
                                        otpValidityMin * 60,
                                        cooldownSec,
                                        remainingResends,
                                        screenTimeoutMin
                                ));
                    });
        });
    }

    /**
     * Executes an OTP Resend on the OTP screen using the True 10-Minute Sliding Window.
     * - Evicts any resend timestamps older than 10 minutes [now - 10m, now].
     * - If < 3 resends exist in the last 10 minutes, records the new resend timestamp and dispatches.
     * - Refreshes the 15-minute sliding screen idle timeout on success.
     * Returns Tuple3 of (NewPlainOtp, UserId, RemainingResends).
     */
    public Mono<Tuple3<String, String, Integer>> processResend(String txId, String newPlainOtp) {
        final LoginParam params = loginParamCacheService.getCachedLoginParam();
        final int resendWindowMin = params.getSafeOtpResendWindowMin();
        final Duration cooldownDuration = Duration.ofSeconds(params.getSafeOtpResendCooldownSec());
        final Duration resendWindowDuration = Duration.ofMinutes(resendWindowMin);
        final long windowMs = resendWindowDuration.toMillis();
        final int maxResends = params.getSafeOtpMaxResends();

        final String sessionKey = "OTP_SESSION:" + txId;

        // 1. Check 15-Minute OTP Entry Screen Timeout
        return redis.opsForValue().get(sessionKey)
                .switchIfEmpty(Mono.error(new ResponseStatusException(
                        HttpStatus.UNAUTHORIZED,
                        "Your session has timed out. Please log in again."
                )))
                .flatMap(userId -> {
                    final String cleanUserId = userId.trim();
                    final String userCooldownKey = "OTP_COOLDOWN:USR:" + cleanUserId;
                    final String userResendKey = "OTP_RESENDS:USR:" + cleanUserId;

                    // 2. Inspect Sliding Window first so if all 3 slots are full, user immediately sees Max Resend message
                    return redis.opsForValue().get(userResendKey).defaultIfEmpty("")
                            .flatMap(preCheckRawState -> {
                                long preCheckNowMs = System.currentTimeMillis();
                                ResendWindowState preCheckState = parseAndPruneWindowState(preCheckRawState, preCheckNowMs, windowMs);
                                if (preCheckState.resends().size() >= maxResends) {
                                    log.warn("OTP Resend blocked for user={}: Sliding {}-min window full ({}/{} resends active).",
                                            LoginUtility.sanitizeLog(cleanUserId), resendWindowMin,
                                            preCheckState.resends().size(), maxResends);
                                    return Mono.error(new ResponseStatusException(
                                            HttpStatus.BAD_REQUEST,
                                            "Maximum resend limit reached. Kindly Wait."
                                    ));
                                }

                                // 3. Acquire 60-Second User Cooldown Lock (Also serializes concurrent requests for this user)
                                return redis.opsForValue().setIfAbsent(userCooldownKey, "locked", cooldownDuration)
                                        .flatMap(acquired -> {
                                            if (!Boolean.TRUE.equals(acquired)) {
                                                return redis.getExpire(userCooldownKey)
                                                        .flatMap(ttl -> {
                                                            long secondsLeft = Math.max(1, ttl.getSeconds());
                                                            return Mono.error(new ResponseStatusException(
                                                                    HttpStatus.BAD_REQUEST,
                                                                    "Please wait " + secondsLeft + " seconds before requesting another code."
                                                            ));
                                                        });
                                            }

                                            // 4. Re-verify & update Sliding 10-Minute Window atomically under the cooldown lock
                                            return redis.opsForValue().get(userResendKey).defaultIfEmpty("")
                                                    .flatMap(rawState -> {
                                                        long nowMs = System.currentTimeMillis();
                                                        ResendWindowState currentState = parseAndPruneWindowState(rawState, nowMs, windowMs);

                                                        if (currentState.resends().size() >= maxResends) {
                                                            return redis.delete(userCooldownKey)
                                                                    .then(Mono.error(new ResponseStatusException(
                                                                            HttpStatus.BAD_REQUEST,
                                                                            "Maximum resend limit reached. Kindly Wait."
                                                                    )));
                                                        }

                                                        List<Long> updatedResends = new ArrayList<>(currentState.resends());
                                                        updatedResends.add(nowMs);
                                                        long initAt = currentState.initAtMs() > 0 ? currentState.initAtMs() : nowMs;
                                                        ResendWindowState updatedState = new ResendWindowState(initAt, updatedResends);

                                                        int remainingResends = Math.max(0, maxResends - updatedResends.size());
                                                        String serializedState = serializeWindowState(updatedState);

                                                        log.info("Sliding Window OTP Resend for user={}: activeResendsInLast{}m={}, resendsRemaining={}",
                                                                LoginUtility.sanitizeLog(cleanUserId), resendWindowMin,
                                                                updatedResends.size(), remainingResends);

                                                        // 5. Save updated sliding window & new OTP state (resets failure count to 0 & refreshes 15m idle session)
                                                        return redis.opsForValue().set(userResendKey, serializedState, resendWindowDuration)
                                                                .then(saveOtpStateInternal(txId, cleanUserId, newPlainOtp, params))
                                                                .thenReturn(Tuples.of(newPlainOtp, cleanUserId, remainingResends));
                                                    });
                                        });
                            });
                });
    }

    /**
     * Verifies the OTP using constant-time cryptographic matching (BCrypt) on boundedElastic scheduler.
     * Refreshes the 15-minute sliding idle window on user activity.
     * Protected by an atomic lock to prevent double-click race conditions.
     */
    public Mono<String> verifyOtp(String txId, String inputOtp) {
        final LoginParam params = loginParamCacheService.getCachedLoginParam();
        final int maxFailures = params.getSafeOtpMaxAttempts();
        final Duration screenTimeout = Duration.ofMinutes(params.getSafeOtpScreenTimeoutMin());

        final String sessionKey = "OTP_SESSION:" + txId;
        final String txKey = "OTP_TX:" + txId;
        final String failKey = "OTP_FAILURES:" + txId;
        final String verifyLockKey = "OTP_VERIFY_LOCK:" + txId;

        // 0. Atomic Double-Click Protection Lock (10s TTL)
        return redis.opsForValue().setIfAbsent(verifyLockKey, "verifying", Duration.ofSeconds(10))
                .flatMap(lockAcquired -> {
                    if (!Boolean.TRUE.equals(lockAcquired)) {
                        return Mono.error(new ResponseStatusException(
                                HttpStatus.BAD_REQUEST,
                                "Verification already in progress. Please wait."
                        ));
                    }

                    // 1. Check if the 15-minute OTP entry screen session is still active
                    return redis.opsForValue().get(sessionKey)
                            .switchIfEmpty(
                                    redis.delete(verifyLockKey).then(Mono.error(new ResponseStatusException(
                                            HttpStatus.UNAUTHORIZED,
                                            "Your session has timed out. Please log in again."
                                    )))
                            )
                            .flatMap(sessionUserId -> {
                                final String cleanUserId = sessionUserId.trim();
                                // Refresh the 15-minute sliding idle timeout since the user is actively interacting
                                return Mono.when(
                                                redis.expire(sessionKey, screenTimeout),
                                                redis.expire("OTP_ACTIVE_TX:USR:" + cleanUserId, screenTimeout)
                                        )
                                        .then(redis.opsForValue().get(txKey))
                                        .switchIfEmpty(
                                                redis.delete(verifyLockKey).then(Mono.error(new ResponseStatusException(
                                                        HttpStatus.BAD_REQUEST,
                                                        "The code is invalid or has expired. Please request a new code."
                                                )))
                                        )
                                        .flatMap(payload ->
                                                Mono.fromCallable(() -> {
                                                            Map<String, String> data = mapper.readValue(payload, new TypeReference<>() {
                                                            });
                                                            String userId = data.get("userId");
                                                            String storedHash = data.get("otpHash");
                                                            boolean matched = passwordEncoder.matches(inputOtp, storedHash);
                                                            return Tuples.of(userId, matched);
                                                        })
                                                        .subscribeOn(Schedulers.boundedElastic())
                                                        .flatMap(result -> {
                                                            String userId = result.getT1().trim();
                                                            boolean matched = result.getT2();

                                                            if (matched) {
                                                                // SUCCESS (Section 2.2.8): Delete all OTP & User quota keys
                                                                return cleanupAllOtpKeysOnSuccess(txId, userId).thenReturn(userId);
                                                            } else {
                                                                // FAILURE (Section 2.2.6): Atomic increment wrong attempts
                                                                return redis.opsForValue().increment(failKey)
                                                                        .flatMap(failCount -> {
                                                                            if (failCount >= maxFailures) {
                                                                                return Mono.when(
                                                                                                redis.delete(txKey),
                                                                                                redis.delete(failKey),
                                                                                                redis.delete(verifyLockKey)
                                                                                        )
                                                                                        .then(Mono.error(new ResponseStatusException(
                                                                                                HttpStatus.BAD_REQUEST,
                                                                                                "Too many incorrect attempts. The code has been expired. Please request a new code."
                                                                                        )));
                                                                            }
                                                                            long remaining = maxFailures - failCount;
                                                                            return redis.delete(verifyLockKey)
                                                                                    .then(Mono.error(new ResponseStatusException(
                                                                                            HttpStatus.BAD_REQUEST,
                                                                                            "Invalid code. " + remaining + " attempts remaining."
                                                                                    )));
                                                                        });
                                                            }
                                                        })
                                        );
                            })
                            .onErrorResume(e -> {
                                if (e instanceof ResponseStatusException) {
                                    return Mono.error(e);
                                }
                                log.error("Unexpected error during OTP verification for txId={}", LoginUtility.sanitizeLog(txId), e);
                                return redis.delete(verifyLockKey)
                                        .then(Mono.error(new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,
                                                "Redis payload corruption")));
                            });
                });
    }

    /**
     * Internal helper: Hashes the OTP on boundedElastic and saves the transaction state in Redis.
     */
    private Mono<Void> saveOtpStateInternal(String txId, String userId, String plainOtp, LoginParam params) {
        final Duration otpValidity = Duration.ofMinutes(params.getSafeOtpValidityMin());
        final Duration screenTimeout = Duration.ofMinutes(params.getSafeOtpScreenTimeoutMin());

        return Mono.fromCallable(() -> {
                    String hash = passwordEncoder.encode(plainOtp);
                    return mapper.writeValueAsString(Map.of("userId", userId, "otpHash", hash));
                })
                .subscribeOn(Schedulers.boundedElastic())
                .flatMap(payload -> {
                    List<Mono<?>> operations = new ArrayList<>();

                    // 1. Register this txId as the ONLY active OTP session for this user
                    operations.add(redis.opsForValue().set("OTP_ACTIVE_TX:USR:" + userId, txId, screenTimeout));

                    // 2. Overall 15-Minute OTP Screen Session Tracker
                    operations.add(redis.opsForValue().set("OTP_SESSION:" + txId, userId, screenTimeout));

                    // 3. Active 5-Minute OTP Code Hash
                    operations.add(redis.opsForValue().set("OTP_TX:" + txId, payload, otpValidity));

                    // 4. Reset wrong attempt counter to 0 for the new code
                    operations.add(redis.opsForValue().set("OTP_FAILURES:" + txId, "0", otpValidity));

                    return Mono.when(operations)
                            .doOnSuccess(v -> log.info("Saved OTP State txId={} for user={}",
                                    LoginUtility.sanitizeLog(txId), LoginUtility.sanitizeLog(userId)));
                });
    }

    /**
     * Deletes all Redis keys (both txId keys and User quota keys) upon successful verification.
     */
    private Mono<Void> cleanupAllOtpKeysOnSuccess(String txId, String userId) {
        return Mono.when(
                redis.delete("OTP_SESSION:" + txId),
                redis.delete("OTP_TX:" + txId),
                redis.delete("OTP_FAILURES:" + txId),
                redis.delete("OTP_VERIFY_LOCK:" + txId),
                redis.delete("OTP_ACTIVE_TX:USR:" + userId),
                redis.delete("OTP_COOLDOWN:USR:" + userId),
                redis.delete("OTP_RESENDS:USR:" + userId)
        );
    }

    /**
     * Compensating transaction for Initial Login: Cleans up the Redis state if Kafka fails during /login.
     * Removes only the latest sliding-window entry added by this failed attempt.
     */
    public Mono<Void> rollbackInitialOtpState(String txId, String userId) {
        final String cleanUserId = userId != null ? userId.trim() : "";
        return Mono.when(
                redis.delete("OTP_SESSION:" + txId),
                redis.delete("OTP_TX:" + txId),
                redis.delete("OTP_FAILURES:" + txId),
                redis.delete("OTP_ACTIVE_TX:USR:" + cleanUserId),
                redis.delete("OTP_COOLDOWN:USR:" + cleanUserId),
                rollbackSlidingWindowEntry(cleanUserId, true)
        ).doOnSuccess(v -> log.info("Rolled back initial OTP state for txId={}", LoginUtility.sanitizeLog(txId)));
    }

    /**
     * Compensating transaction for Resend: If Kafka fails during /resend-otp,
     * preserves OTP_SESSION, removes the latest resend timestamp from the sliding window,
     * and releases the 60s cooldown lock so the user can retry.
     */
    public Mono<Void> rollbackResendState(String txId, String userId) {
        final String cleanUserId = userId != null ? userId.trim() : "";
        return Mono.when(
                redis.delete("OTP_COOLDOWN:USR:" + cleanUserId),
                rollbackSlidingWindowEntry(cleanUserId, false)
        ).doOnSuccess(v -> log.info("Rolled back resend sliding window entry and cooldown for txId={}", LoginUtility.sanitizeLog(txId)));
    }

    // =========================================================================================
    //                        SLIDING WINDOW SERIALIZATION & PRUNING HELPERS
    // =========================================================================================

    /**
     * Parses the user's sliding window state from Redis and prunes any resend timestamps
     * older than (nowMs - windowMs). Gracefully handles empty or legacy integer values.
     */
    private ResendWindowState parseAndPruneWindowState(String rawJson, long nowMs, long windowMs) {
        if (rawJson == null || rawJson.isBlank()) {
            return new ResendWindowState(0L, List.of());
        }

        final long cutoffMs = nowMs - windowMs;
        final String trimmed = rawJson.trim();

        try {
            // Backward compatibility: If a pre-deployment integer string ("0", "1", etc.) exists in Redis
            if (!trimmed.startsWith("{")) {
                int legacyCount = Integer.parseInt(trimmed);
                List<Long> migrated = new ArrayList<>(Math.max(0, legacyCount));
                for (int i = 0; i < legacyCount; i++) {
                    migrated.add(nowMs);
                }
                return new ResendWindowState(nowMs, migrated);
            }

            ResendWindowState parsed = mapper.readValue(trimmed, ResendWindowState.class);
            List<Long> validResends = new ArrayList<>();
            if (parsed.resends() != null) {
                for (Long ts : parsed.resends()) {
                    if (ts != null && ts > cutoffMs) {
                        validResends.add(ts);
                    }
                }
            }

            boolean isInitRecent = parsed.initAtMs() > cutoffMs;
            if (!isInitRecent && validResends.isEmpty()) {
                return new ResendWindowState(0L, List.of());
            }

            long effectiveInitAt = isInitRecent
                    ? parsed.initAtMs()
                    : validResends.get(0);

            return new ResendWindowState(effectiveInitAt, validResends);
        } catch (Exception e) {
            log.warn("Failed to parse OTP sliding window state '{}'. Resetting window.", LoginUtility.sanitizeLog(trimmed));
            return new ResendWindowState(0L, List.of());
        }
    }

    /**
     * Serializes the sliding window state to JSON for Redis storage.
     */
    private String serializeWindowState(ResendWindowState state) {
        try {
            return mapper.writeValueAsString(state);
        } catch (Exception e) {
            log.error("Failed to serialize ResendWindowState", e);
            return "{\"initAtMs\":" + state.initAtMs() + ",\"resends\":[]}";
        }
    }

    /**
     * Removes the most recent timestamp from the user's sliding window if Kafka dispatch fails.
     */
    private Mono<Void> rollbackSlidingWindowEntry(String cleanUserId, boolean deleteIfInitialOnly) {
        if (cleanUserId.isEmpty()) {
            return Mono.empty();
        }
        final String userResendKey = "OTP_RESENDS:USR:" + cleanUserId;
        final LoginParam params = loginParamCacheService.getCachedLoginParam();
        final Duration resendWindowDuration = Duration.ofMinutes(params.getSafeOtpResendWindowMin());
        final long windowMs = resendWindowDuration.toMillis();

        return redis.opsForValue().get(userResendKey).defaultIfEmpty("")
                .flatMap(raw -> {
                    if (raw.isEmpty()) {
                        return Mono.empty();
                    }
                    long nowMs = System.currentTimeMillis();
                    ResendWindowState state = parseAndPruneWindowState(raw, nowMs, windowMs);
                    List<Long> currentResends = new ArrayList<>(state.resends());

                    if (!currentResends.isEmpty()) {
                        // Pop the most recent resend timestamp that failed to dispatch
                        currentResends.remove(currentResends.size() - 1);
                        ResendWindowState rolledBack = new ResendWindowState(state.initAtMs(), currentResends);
                        return redis.opsForValue().set(userResendKey, serializeWindowState(rolledBack), resendWindowDuration).then();
                    } else if (deleteIfInitialOnly) {
                        // Initial login failed before any resends were made: delete the window key completely
                        return redis.delete(userResendKey).then();
                    }
                    return Mono.empty();
                });
    }

    /**
     * Internal representation of the rolling 10-minute OTP resend window in Redis.
     */
    private record ResendWindowState(long initAtMs, List<Long> resends) {
    }

    /**
     * Value object returned when initiating a user's OTP session on /login.
     */
    public record OtpSessionInitResult(
            int expiresInSeconds,
            int resendCooldownSeconds,
            int resendsRemaining,
            int otpScreenTimeoutMin
    ) {
    }
}
