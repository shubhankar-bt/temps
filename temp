    /**
     * Extracts the User ID (Subject) from the token.
     * Smartly routes between JWE (Frontend) and JWS (M2M Service) tokens.
     *
     * @param token The Bearer token.
     * @return The userId string.
     */
    public String getUserIdFromToken(String token) {
        String cleanToken = removeBearerPrefix(token);
        String[] parts = cleanToken.split("\\.");
        
        if (parts.length == 5) {
            // JWE FLOW: The User ID is conveniently stored in the unencrypted 'kid' header!
            return extractUserIdFromJweHeader(cleanToken);
        } else {
            // JWS FLOW: Fallback for Service/M2M tokens using JJWT
            return extractClaim(cleanToken, Claims::getSubject);
        }
    }
