import java.math.BigDecimal;
import java.math.RoundingMode;

/**
 * Cleans raw data returned from Druid.
 * 1. Strips JSON array formatting from HeadCodes (e.g., "[\"01160\"]" -> "01160")
 * 2. Prevents Scientific Notation on massive billion-dollar balances.
 */
private void sanitizeDruidResponse(List<Map<String, Object>> rawDruidData, String logicalTargetDim, List<String> metrics) {
    for (Map<String, Object> row : rawDruidData) {
        
        // 1. Clean HeadCode String
        if ("HeadCode".equalsIgnoreCase(logicalTargetDim)) {
            Object val = row.get(logicalTargetDim);
            if (val instanceof String) {
                // Removes [, ], and " characters
                String cleaned = ((String) val).replaceAll("[\\[\\]\"]", "").trim();
                // If Druid grouped multiple headcodes like "01160, 02000", we take the first one relevant to the request
                if (cleaned.contains(",")) {
                    cleaned = cleaned.split(",")[0].trim();
                }
                row.put(logicalTargetDim, cleaned);
            }
        }

        // 2. Format massive numbers to prevent Scientific Notation (E10)
        for (String metric : metrics) {
            Object amountObj = row.get(metric);
            if (amountObj != null) {
                try {
                    // Convert to BigDecimal, round to 2 decimals, and return as a raw Double so Jackson doesn't use E notation
                    BigDecimal bd = new BigDecimal(amountObj.toString()).setScale(2, RoundingMode.HALF_UP);
                    row.put(metric, bd.doubleValue()); 
                } catch (NumberFormatException ignored) {
                    row.put(metric, 0.0);
                }
            }
        }
    }
}






