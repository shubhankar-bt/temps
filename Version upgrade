package com.fincore.analyticsservice.engine;

import com.fincore.analyticsservice.dto.DrillDownRequest;
import com.fincore.analyticsservice.dto.FilterDTO;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

import java.util.*;
import java.util.stream.Collectors;

@Slf4j
@Component
public class MockDruidEngine {

    /**
     * Executes the in-memory aggregation simulating Apache Druid's behavior.
     * Utilizes parallel streams and ConcurrentHashMap for high-performance grouping.
     *
     * @param request           The UI Request containing ViewCode, HeadCodes, and drill-down filters
     * @param mockData          The pre-parsed 146MB JSON payload (500k rows)
     * @param physicalDimension The resolved SQL physical column name to group by (e.g., "GEOGRAPHY")
     * @return A sorted List of Maps formatted for the UI grid
     */
    public List<Map<String, Object>> executeAggregation(
            DrillDownRequest request, 
            List<Map<String, Object>> mockData, 
            String physicalDimension) {

        long startTime = System.currentTimeMillis();

        // 1. Resolve global scope variables outside the loop to prevent repeated allocations
        Set<String> validHeadCodes = request.getHeadCodes();
        String physicalHeadCodeField = resolvePhysicalHeadCodeField(request.getViewCode());
        List<FilterDTO> drillDownFilters = request.getFilters() != null ? request.getFilters() : Collections.emptyList();

        // 2. High-Performance Parallel Aggregation
        Map<String, Double> aggregatedResults = mockData.parallelStream()
                .filter(row -> {
                    // --- GLOBAL FILTER: HeadCode Inclusion ---
                    Object rowHeadCodeObj = row.get(physicalHeadCodeField);
                    if (rowHeadCodeObj == null) return false;
                    
                    String rowHeadCode = String.valueOf(rowHeadCodeObj);
                    if (!validHeadCodes.contains(rowHeadCode)) {
                        return false;
                    }

                    // --- DRILL-DOWN FILTERS: Dynamic UI Clicks ---
                    for (FilterDTO filter : drillDownFilters) {
                        // Assuming your service maps logical dimension (e.g. Circle) to physical (CIRCLE_CODE)
                        // If filter.getPhysicalColumn() doesn't exist in your DTO, you should add it to avoid DB lookups here
                        String physicalFilterCol = filter.getPhysicalColumn(); 
                        Object rowValObj = row.get(physicalFilterCol);
                        
                        if (rowValObj == null) return false;
                        
                        String rowVal = String.valueOf(rowValObj);
                        String filterVal = filter.getValue();

                        // Optimization: High-speed zero stripping for Circle/Branch codes without expensive Regex
                        rowVal = fastStripLeadingZeros(rowVal);
                        filterVal = fastStripLeadingZeros(filterVal);

                        if (!rowVal.equalsIgnoreCase(filterVal)) {
                            return false;
                        }
                    }

                    return true; // Row survived all filters
                })
                .collect(Collectors.toConcurrentMap(
                        row -> String.valueOf(row.getOrDefault(physicalDimension, "UNKNOWN")), // Group By Key
                        row -> getNumericValue(row.get("AMOUNT")),                             // Metric Value
                        Double::sum                                                            // Aggregation Function
                ));

        log.debug("In-Memory Aggregation completed in {} ms", (System.currentTimeMillis() - startTime));

        // 3. Apply Domain-Specific Sorting
        return formatAndSortResults(aggregatedResults, physicalDimension);
    }

    /**
     * Resolves the physical headcode column dynamically based on the view scope.
     */
    private String resolvePhysicalHeadCodeField(String viewCode) {
        if (viewCode == null) return "YSA_HEADCODE";
        if (viewCode.startsWith("PNL")) return "PNL_HEADCODE";
        if (viewCode.startsWith("NWSA")) return "NWSA_HEADCODE";
        return "YSA_HEADCODE"; // Default fallback
    }

    /**
     * Replaces expensive Regex `.replaceFirst("^0+(?!$)", "")` with an O(n) char loop.
     * This prevents severe CPU spikes when running against 500k rows in a parallel stream.
     */
    private String fastStripLeadingZeros(String s) {
        if (s == null || s.isEmpty()) return s;
        int i = 0;
        while (i < s.length() - 1 && s.charAt(i) == '0') {
            i++;
        }
        return i > 0 ? s.substring(i) : s;
    }

    /**
     * Safely extracts numeric values (handling Jackson's Integer, Double, or BigDecimal parsing).
     */
    private double getNumericValue(Object obj) {
        if (obj instanceof Number) {
            return ((Number) obj).doubleValue();
        } else if (obj instanceof String) {
            try {
                return Double.parseDouble((String) obj);
            } catch (NumberFormatException e) {
                return 0.0;
            }
        }
        return 0.0;
    }

    /**
     * Formats the map into UI-ready rows and applies the Fincore domain-specific sorting rules.
     */
    private List<Map<String, Object>> formatAndSortResults(Map<String, Double> aggregatedResults, String physicalDimension) {
        
        List<Map<String, Object>> resultList = new ArrayList<>();
        
        for (Map.Entry<String, Double> entry : aggregatedResults.entrySet()) {
            Map<String, Object> row = new HashMap<>();
            row.put("dimensionValue", entry.getKey());
            // Round to 2 decimal places to match UI expectations
            row.put("amount", Math.round(entry.getValue() * 100.0) / 100.0); 
            resultList.add(row);
        }

        // Domain Rule: Branch-Circle dimension uses complex alphabetical sorting
        // Check if the physical dimension represents the Branch-Circle expression
        boolean isBranchCircle = physicalDimension.contains("BRANCH_CODE") && physicalDimension.contains("CIRCLE_NAME");

        if (isBranchCircle) {
            resultList.sort((r1, r2) -> {
                String val1 = (String) r1.get("dimensionValue");
                String val2 = (String) r2.get("dimensionValue");
                
                // Safely split "BRANCH_CODE - CIRCLE_NAME"
                String[] parts1 = val1.split(" - ", 2);
                String[] parts2 = val2.split(" - ", 2);
                
                String circle1 = parts1.length > 1 ? parts1[1] : "";
                String circle2 = parts2.length > 1 ? parts2[1] : "";
                
                int circleCompare = circle1.compareToIgnoreCase(circle2);
                if (circleCompare != 0) {
                    return circleCompare;
                }
                
                // If circles are identical, sort by Branch Code
                String branch1 = parts1[0];
                String branch2 = parts2[0];
                return branch1.compareToIgnoreCase(branch2);
            });
        } else {
            // Default Rule: Sort by Amount Descending
            resultList.sort((r1, r2) -> Double.compare((Double) r2.get("amount"), (Double) r1.get("amount")));
        }

        return resultList;
    }
}
