package com.fincore.analyticsservice.service;

import com.fincore.analyticsservice.dto.DashboardQuery;
import com.fincore.analyticsservice.dto.DashboardRequest;
import com.fincore.analyticsservice.dto.DrillDownRequest;
import com.fincore.analyticsservice.dto.DrillDownResponse;
import com.fincore.analyticsservice.dto.FilterDto;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.util.*;
import java.util.stream.Collectors;

@Slf4j
@Service
public class DashboardService {

    private final SemanticDrillDownService drillDownService;

    public DashboardService(SemanticDrillDownService drillDownService) {
        this.drillDownService = drillDownService;
    }

    public Map<String, BigDecimal> getDashboardBalances(DashboardRequest request, Integer roleId) {
        log.info("Processing Dashboard Request for asOfDate: {}", request.asOfDate());

        // 1. Flatten and collect all unique HeadCodes required across all aliases
        Set<String> allHeadCodes = request.queries().stream()
                .flatMap(q -> q.headCodes().stream())
                .collect(Collectors.toSet());

        // 2. Prepare filters mapping (asOfDate translates to ReportDate in the semantic layer)
        List<FilterDto> filters = new ArrayList<>();
        if (request.asOfDate() != null && !request.asOfDate().isBlank()) {
            filters.add(new FilterDto("ReportDate", "EQUALS", request.asOfDate()));
        }

        // 3. Define the view context (default to YSA_VIEW if not provided)
        String viewCode = (request.viewCode() != null && !request.viewCode().isBlank()) 
                ? request.viewCode() 
                : "YSA_VIEW";

        // 4. Construct an internal DrillDownRequest. 
        // Note: We bypass the @Size(max=5) validation here because we are instantiating 
        // the object programmatically, allowing bulk data fetching for the dashboard.
        DrillDownRequest internalRequest = new DrillDownRequest(
                viewCode,
                allHeadCodes,
                List.of("HeadCode"), // Group by HeadCode
                List.of("AMOUNT"),   // Metric to aggregate
                filters
        );

        // 5. Execute using the robust existing pipeline (Mock/Druid routing, access control, etc.)
        DrillDownResponse response = drillDownService.executeDrillDown(internalRequest, roleId);

        // 6. Map the flattened results by HeadCode for fast O(1) lookup
        Map<String, BigDecimal> headCodeMap = new HashMap<>();
        if (response.data() != null) {
            for (Map<String, Object> row : response.data()) {
                String hc = (String) row.get("name");
                Object amtObj = row.get("AMOUNT");
                
                BigDecimal amt = BigDecimal.ZERO;
                if (amtObj != null) {
                    try {
                        amt = new BigDecimal(String.valueOf(amtObj));
                    } catch (NumberFormatException ignored) {}
                }
                headCodeMap.put(hc, amt);
            }
        }

        // 7. Aggregate sums back into the requested aliases
        Map<String, BigDecimal> result = new LinkedHashMap<>();
        for (DashboardQuery query : request.queries()) {
            BigDecimal totalBalance = BigDecimal.ZERO;
            
            for (String hc : query.headCodes()) {
                totalBalance = totalBalance.add(headCodeMap.getOrDefault(hc, BigDecimal.ZERO));
            }
            
            // Scaling to 4 decimal places as per your JSON example requirements
            result.put(query.alias(), totalBalance.setScale(4, RoundingMode.HALF_UP));
        }

        return result;
    }
}














package com.fincore.analyticsservice.controller;

import com.fincore.analyticsservice.dto.DashboardRequest;
import com.fincore.analyticsservice.service.DashboardService;
import jakarta.validation.Valid;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.math.BigDecimal;
import java.util.Map;

@RestController
@RequestMapping("/api/v1/dashboard")
public class DashboardController {

    private final DashboardService dashboardService;

    public DashboardController(DashboardService dashboardService) {
        this.dashboardService = dashboardService;
    }

    @PostMapping("/balances")
    public ResponseEntity<Map<String, BigDecimal>> getBalances(
            @RequestHeader(value = "X-Role-Id", defaultValue = "10") Integer roleId,
            @Valid @RequestBody DashboardRequest request) {
        
        Map<String, BigDecimal> response = dashboardService.getDashboardBalances(request, roleId);
        
        return ResponseEntity.ok(response);
    }
}








