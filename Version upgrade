package com.tcs.fincore.dashboard.client;

import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;
import java.util.Set;

@Data
@NoArgsConstructor
@AllArgsConstructor
public class BulkAnalyticsRequest {
    /**
     * The unique, flattened set of raw Druid codes.
     * Using a Set prevents querying the same code twice if multiple parents share a dependency.
     */
    private Set<String> rawHeadCodes;
    
    /**
     * The business date for the data being requested.
     */
    private String date;
}














