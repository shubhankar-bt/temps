package com.fincore.gateway.utility;

import jakarta.servlet.http.HttpServletRequest;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.server.reactive.ServerHttpRequest;

@Slf4j
public class LoginUtility {

    public static String getClientIp(ServerHttpRequest request) {
        String ip = request.getHeaders().getFirst("X-Forwarded-For");

        if (ip == null || ip.isEmpty() || "unknown".equalsIgnoreCase(ip)) {
            if (request.getRemoteAddress() != null) {
                ip = String.valueOf(request.getRemoteAddress().getAddress().getHostAddress());
            }
        }
        
        if (ip != null) {
            if (ip.contains(",")) {
                ip = ip.split(",")[0].trim();
            } else if (ip.startsWith("::ffff:")) {
                ip = ip.substring(7);
            } else if (ip.startsWith("::1")) {
                ip = "127.0.0.1";
            }
        }

        return ip;
    }

    /**
     * Fortify Fix: Log Forging & Privacy Violations
     * Use this method to wrap ANY variable before printing it in log.info() or log.warn().
     * Example: log.info("User logged in: {}", LoginUtility.sanitizeLog(userId));
     */
    public static String sanitizeLog(String input) {
        if (input == null) {
            return "null";
        }
        // Strips CRLF characters to prevent Log Forging attacks
        return input.replaceAll("[\n\r\t]", "_");
    }
}









