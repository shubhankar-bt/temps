-- 1. Shift Geography
UPDATE "FINCORE"."DR_VIEW_DIMENSION" 
SET DRILL_LEVEL = 20 
WHERE LOGICAL_NAME = 'Geography' AND DRILL_LEVEL < 90;

-- 2. Shift CGL
UPDATE "FINCORE"."DR_VIEW_DIMENSION" 
SET DRILL_LEVEL = 30 
WHERE LOGICAL_NAME = 'CGL' AND DRILL_LEVEL < 90;

-- 3. Shift Product
UPDATE "FINCORE"."DR_VIEW_DIMENSION" 
SET DRILL_LEVEL = 40 
WHERE LOGICAL_NAME = 'Product' AND DRILL_LEVEL < 90;

-- 4. Shift Branch-Circle
UPDATE "FINCORE"."DR_VIEW_DIMENSION" 
SET DRILL_LEVEL = 50 
WHERE LOGICAL_NAME = 'Branch-Circle' AND DRILL_LEVEL < 90;

-- 5. Promote HeadCode to the new Root Dimension
UPDATE "FINCORE"."DR_VIEW_DIMENSION" 
SET DRILL_LEVEL = 10 
WHERE LOGICAL_NAME = 'HeadCode';

COMMIT;
















