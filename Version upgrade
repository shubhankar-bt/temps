

package com.fincore.analyticsservice.engine;

import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.stream.Collectors;

public class MockDruidEngine {

    public List<Map<String, Object>> executeAggregation(DrillDownRequest request, List<Map<String, Object>> mockData, String physicalDimension) {
        
        Set<String> validHeadCodes = request.getHeadCodes();
        String physicalHeadCodeField = resolvePhysicalHeadCodeField(request.getViewCode()); // e.g., YSA_HEADCODE

        // Enterprise Concurrency: Use parallelStream for the 500k rows
        Map<String, Double> aggregatedResults = mockData.parallelStream()
            .filter(row -> {
                String rowHeadCode = (String) row.get(physicalHeadCodeField);
                
                // 1. GLOBAL FILTER: Drop row if it doesn't match the selected 5 HeadCodes
                if (rowHeadCode == null || !validHeadCodes.contains(rowHeadCode)) {
                    return false;
                }

                // 2. DRILL-DOWN FILTERS: Apply UI-clicked filters (e.g., HeadCode = HC1, Geography = North)
                if (request.getFilters() != null) {
                    for (FilterDTO filter : request.getFilters()) {
                        String filterPhysicalCol = resolvePhysicalColumn(filter.getDimension());
                        String rowVal = (String) row.get(filterPhysicalCol);
                        
                        // Strict equality for drill-down path
                        if (rowVal == null || !rowVal.equals(filter.getValue())) {
                            return false; 
                        }
                    }
                }
                return true; // Row survived all filters
            })
            // Aggregate using ConcurrentHashMap mechanics
            .collect(Collectors.toConcurrentMap(
                row -> (String) row.get(physicalDimension), // Group by the requested dimension
                row -> getNumericValue(row.get("AMOUNT")),
                Double::sum
            ));

        return formatAndSortResults(aggregatedResults, physicalDimension);
    }
}
