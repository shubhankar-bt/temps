Here are the production-grade Oracle DDL scripts for the foundational tables.
This schema includes strict constraints, audit columns, performance-optimized indexing, idempotency keys, and comprehensive table/column comments as required for enterprise financial systems.
1. The Business Translation Layer
This table drives the PySpark classification and ensures the "Strict Reconciliation" approach. Note the UNIQUE constraint on DOMAIN and SOURCE_CODE—this guarantees that PySpark will never accidentally duplicate raw rows during the join.
-- ==============================================================================
-- TABLE: FINANCIAL_CATEGORY_MAPPING
-- PURPOSE: Maps raw source/head codes to dashboard business classifications.
-- ==============================================================================
CREATE TABLE FINANCIAL_CATEGORY_MAPPING (
    ID                  NUMBER GENERATED ALWAYS AS IDENTITY,
    DOMAIN              VARCHAR2(20) NOT NULL,
    SOURCE_CODE         VARCHAR2(50) NOT NULL,
    TYPE                VARCHAR2(100) NOT NULL,
    SUBTYPE             VARCHAR2(100),
    DESCRIPTION         VARCHAR2(100) NOT NULL,
    MULTIPLIER          NUMBER(2) DEFAULT 1 NOT NULL,
    IS_ACTIVE           VARCHAR2(1) DEFAULT 'Y' NOT NULL,
    CREATED_BY          VARCHAR2(50) DEFAULT 'SYSTEM' NOT NULL,
    CREATED_TIMESTAMP   TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_BY          VARCHAR2(50),
    UPDATED_TIMESTAMP   TIMESTAMP,
    
    -- Constraints
    CONSTRAINT PK_FIN_CAT_MAP PRIMARY KEY (ID),
    CONSTRAINT UQ_DOMAIN_SOURCE UNIQUE (DOMAIN, SOURCE_CODE),
    CONSTRAINT CHK_DOMAIN CHECK (DOMAIN IN ('DEPOSIT', 'LOAN')),
    CONSTRAINT CHK_MULTIPLIER CHECK (MULTIPLIER IN (1, -1)),
    CONSTRAINT CHK_IS_ACTIVE CHECK (IS_ACTIVE IN ('Y', 'N'))
);

-- Indexes
CREATE INDEX IDX_FIN_MAP_SEARCH ON FINANCIAL_CATEGORY_MAPPING (SOURCE_CODE, IS_ACTIVE, DOMAIN);

-- Table & Column Comments
COMMENT ON TABLE FINANCIAL_CATEGORY_MAPPING IS 'Central configuration table mapping raw head codes to Dashboard business categories.';
COMMENT ON COLUMN FINANCIAL_CATEGORY_MAPPING.DOMAIN IS 'Business domain: DEPOSIT or LOAN.';
COMMENT ON COLUMN FINANCIAL_CATEGORY_MAPPING.SOURCE_CODE IS 'Raw head code or account code from Druid/Master Source. Use ''UNMAPPED_DEFAULT'' for fallback.';
COMMENT ON COLUMN FINANCIAL_CATEGORY_MAPPING.TYPE IS 'Major business category (e.g., DEMAND DEPOSITS).';
COMMENT ON COLUMN FINANCIAL_CATEGORY_MAPPING.SUBTYPE IS 'Optional sub-category (e.g., CASA).';
COMMENT ON COLUMN FINANCIAL_CATEGORY_MAPPING.DESCRIPTION IS 'Lowest level dashboard category (e.g., Saving Bank A/c).';
COMMENT ON COLUMN FINANCIAL_CATEGORY_MAPPING.MULTIPLIER IS '1 for normal, -1 to reverse sign (Asset vs Liability normalization).';

