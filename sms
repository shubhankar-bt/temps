package com.fincore.CommunicationService.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.client.SimpleClientHttpRequestFactory;
import org.springframework.web.client.RestClient;

import javax.net.ssl.HttpsURLConnection;
import javax.net.ssl.SSLContext;
import javax.net.ssl.TrustManager;
import javax.net.ssl.X509TrustManager;
import java.io.IOException;
import java.net.HttpURLConnection;
import java.security.SecureRandom;
import java.security.cert.X509Certificate;

/**
 * <p>Centralized HTTP Configuration for Vendor APIs.</p>
 *
 * <p><b>Fix Applied:</b> Switched back to {@link SimpleClientHttpRequestFactory}
 * to regain access to the underlying HttpURLConnection. This is mandatory for UAT
 * environments where we must explicitly disable Hostname Verification, a feature
 * that Java 21's native HttpClient strictly enforces.</p>
 *
 * @since 2026-07
 */
@Slf4j
@Configuration
public class RestClientConfig {

    @Value("${app.preIpString:UAT}")
    private String environment;

    @Bean
    public RestClient restClient(RestClient.Builder builder) {
        log.info("Initializing RestClient with legacy HttpURLConnection bindings for UAT compatibility.");

        SimpleClientHttpRequestFactory factory = new SimpleClientHttpRequestFactory() {
            @Override
            protected void prepareConnection(HttpURLConnection connection, String httpMethod) throws IOException {
                // Apply strict timeouts
                connection.setConnectTimeout(3000);
                connection.setReadTimeout(3000);

                // Re-injected exact SSL and Hostname Bypass from old working code
                if (connection instanceof HttpsURLConnection && !"PROD".equalsIgnoreCase(environment)) {
                    HttpsURLConnection httpsConnection = (HttpsURLConnection) connection;
                    try {
                        httpsConnection.setSSLSocketFactory(insecureSslContext().getSocketFactory());
                        // THIS IS THE CRITICAL BYPASS THAT PREVENTS THE I/O ERROR IN UAT
                        httpsConnection.setHostnameVerifier((hostname, session) -> true);
                    } catch (Exception e) {
                        log.error("Failed to inject SSL bypass into connection.", e);
                    }
                }
                super.prepareConnection(connection, httpMethod);
            }
        };

        return builder.requestFactory(factory).build();
    }

    private SSLContext insecureSslContext() throws Exception {
        TrustManager[] trustAllCerts = new TrustManager[]{
                new X509TrustManager() {
                    public X509Certificate[] getAcceptedIssuers() { return null; }
                    public void checkClientTrusted(X509Certificate[] certs, String authType) {}
                    public void checkServerTrusted(X509Certificate[] certs, String authType) {}
                }
        };
        SSLContext sc = SSLContext.getInstance("TLS");
        sc.init(null, trustAllCerts, new SecureRandom());
        return sc;
    }
}















package com.fincore.CommunicationService.client;

import com.fincore.CommunicationService.exception.CommunicationExceptions.VendorDeliveryException;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.json.JSONArray;
import org.json.JSONObject;
import org.springframework.core.io.Resource;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.http.client.MultipartBodyBuilder;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestClient;
import org.springframework.web.client.RestClientException;

import java.util.List;
import java.util.Map;

/**
 * <p>Enterprise Email Vendor Gateway.</p>
 *
 * <p><b>Fix Applied:</b> Implemented Dynamic Content-Type switching.
 * If no attachment exists (e.g., OTP flow), the client behaves exactly like the old code,
 * sending pure application/json. It only switches to multipart for End-of-Day PDF runs.</p>
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class EmailGatewayClient {

    private final RestClient restClient;

    public int sendEmail(Map<String, Object> emailRequest, Resource attachment) {
        try {
            String apiUrl = (String) emailRequest.get("url");
            String apiKey = (String) emailRequest.get("api_key");
            
            // Build the exact same JSON String from your old code
            String jsonPayload = buildEmailJson(emailRequest);

            ResponseEntity<Void> response;

            if (attachment == null) {
                // OTP SCENARIO: Send pure JSON exactly like old code
                log.debug("No attachment. Routing via application/json.");
                response = restClient.post()
                        .uri(apiUrl)
                        .header("api_key", apiKey)
                        .header("Accept", "application/json")
                        .contentType(MediaType.APPLICATION_JSON)
                        .body(jsonPayload)
                        .retrieve()
                        .toBodilessEntity();
            } else {
                // BULK SCENARIO: Stream Multipart File
                log.debug("Attachment present. Routing via multipart/form-data.");
                MultipartBodyBuilder multipartBuilder = new MultipartBodyBuilder();
                multipartBuilder.part("payload", jsonPayload, MediaType.APPLICATION_JSON);
                multipartBuilder.part("attachment", attachment);

                response = restClient.post()
                        .uri(apiUrl)
                        .header("api_key", apiKey)
                        .contentType(MediaType.MULTIPART_FORM_DATA)
                        .body(multipartBuilder.build())
                        .retrieve()
                        .toBodilessEntity(); 
            }

            int responseCode = response.getStatusCode().value();
            log.info("Vendor Email API responded with HTTP {}", responseCode);
            return responseCode;

        } catch (RestClientException e) {
            log.error("Network I/O Exception calling Email Vendor API: {}", e.getMessage());
            throw new VendorDeliveryException("Network communication with Email Vendor failed", e);
        }
    }

    @SuppressWarnings("unchecked")
    private String buildEmailJson(Map<String, Object> emailRequest) {
        JSONObject senderJson = new JSONObject();
        senderJson.put("email", (String) emailRequest.get("senderId"));
        senderJson.put("name", "FINCORE");

        JSONObject emailContentJson = new JSONObject();
        emailContentJson.put("type", "html");
        emailContentJson.put("value", (String) emailRequest.get("emailBody"));

        JSONObject personalizationsJson = new JSONObject();

        if (emailRequest.containsKey("toEmail")) {
            JSONObject recipientJson = new JSONObject();
            recipientJson.put("email", (String) emailRequest.get("toEmail"));
            personalizationsJson.put("to", new JSONArray().put(recipientJson));
        }

        if (emailRequest.containsKey("bccEmails")) {
            List<String> bccEmails = (List<String>) emailRequest.get("bccEmails");
            JSONArray bccArray = new JSONArray();
            for (String email : bccEmails) {
                JSONObject bccObj = new JSONObject();
                bccObj.put("email", email);
                bccArray.put(bccObj);
            }
            personalizationsJson.put("bcc", bccArray);
        }

        // Apply same hardcoded tokens from old code
        personalizationsJson.put("token_to", "8693839845");
        personalizationsJson.put("token_cc", "MSGID657243");
        personalizationsJson.put("token_bcc", "MSGID657244");

        JSONObject trackingSettingsJson = new JSONObject();
        trackingSettingsJson.put("open_track", true);
        trackingSettingsJson.put("click_track", true);
        trackingSettingsJson.put("unsubscribe_track", true);

        JSONObject emailRequestJson = new JSONObject();
        emailRequestJson.put("from", senderJson);
        emailRequestJson.put("subject", (String) emailRequest.get("subject"));
        emailRequestJson.put("content", new JSONArray().put(emailContentJson));
        emailRequestJson.put("personalizations", new JSONArray().put(personalizationsJson));
        emailRequestJson.put("settings", trackingSettingsJson);

        return emailRequestJson.toString();
    }
}









package com.fincore.CommunicationService.client;

import com.fincore.CommunicationService.dto.SmsResponseDTO;
import com.fincore.CommunicationService.model.FincoreSettings;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpHeaders;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestClient;
import org.springframework.web.client.RestClientException;

import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;
import java.util.Base64;

/**
 * <p>Enterprise SMS Vendor Gateway.</p>
 *
 * <p><b>Fix Applied:</b> Reverted the payload body construction to the exact
 * manual URLEncoder string from the old working code. Solace Gateways are incredibly
 * brittle regarding byte-encoding, and Spring's default MultiValueMap was mutating
 * the structure just enough to trigger a 403 Forbidden.</p>
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class SmsGatewayClient {

    private final RestClient restClient;

    public SmsResponseDTO sendSms(FincoreSettings config, String mobileNumber, String message) {
        try {
            String authHeader = null;
            if (config.getUsername() != null && config.getPassword() != null) {
                String auth = config.getUsername() + ":" + config.getPassword();
                authHeader = "Basic " + Base64.getEncoder().encodeToString(auth.getBytes(StandardCharsets.UTF_8));
            }

            // EXACT BYTE-FOR-BYTE PAYLOAD FROM OLD CODE
            String rawPayload = "content_type=text"
                    + "&sender_id=" + config.getSenderId()
                    + "&mobile=0" + mobileNumber
                    + "&message=" + URLEncoder.encode(message, StandardCharsets.UTF_8)
                    + "&intflag=0"
                    + "&charging=0";

            var requestSpec = restClient.post()
                    .uri(config.getUrl())
                    .header("Content-Type", "application/x-www-form-urlencoded")
                    .header("Accept", "application/x-www-form-urlencoded")
                    .body(rawPayload); // Passing raw String instead of Map

            if (authHeader != null) {
                requestSpec.header(HttpHeaders.AUTHORIZATION, authHeader);
            }

            ResponseEntity<String> response = requestSpec.retrieve().toEntity(String.class);

            int responseCode = response.getStatusCode().value();
            String responseBody = response.getBody() != null ? response.getBody() : "";

            boolean success = (responseCode >= 200 && responseCode < 300) && responseBody.contains("MESSAGE_SUBMIT_SUCCESS");

            return SmsResponseDTO.builder()
                    .success(success)
                    .message(success ? "SMS Sent Successfully" : "SMS Sending Failed")
                    .providerResponse(responseBody)
                    .build();

        } catch (RestClientException ex) {
            log.error("Network Exception while sending SMS: {}", ex.getMessage());
            return SmsResponseDTO.builder()
                    .success(false)
                    .message("Network exception: " + ex.getMessage())
                    .build();
        }
    }
}





