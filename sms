package com.fincore.CommunicationService.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.client.SimpleClientHttpRequestFactory;
import org.springframework.web.client.RestClient;

import javax.net.ssl.HttpsURLConnection;
import javax.net.ssl.SSLContext;
import javax.net.ssl.TrustManager;
import javax.net.ssl.X509TrustManager;
import java.io.IOException;
import java.net.HttpURLConnection;
import java.security.SecureRandom;
import java.security.cert.X509Certificate;

/**
 * <p>Centralized HTTP Configuration for Vendor APIs.</p>
 *
 * <p><b>Architectural Mandate:</b> 
 * Forces the modern RestClient to utilize {@link SimpleClientHttpRequestFactory}
 * (which wraps HttpURLConnection). This ensures strict HTTP/1.1 adherence to prevent
 * Solace API 403 errors, automatically inherits corporate proxy settings, and allows
 * us to re-inject the UAT SSL/Hostname bypass.</p>
 */
@Slf4j
@Configuration
public class RestClientConfig {

    @Value("${app.preIpString:UAT}")
    private String environment;

    @Bean
    public RestClient restClient(RestClient.Builder builder) {
        log.info("Initializing RestClient with legacy HttpURLConnection bindings for strict UAT/Solace compatibility.");

        SimpleClientHttpRequestFactory factory = new SimpleClientHttpRequestFactory() {
            @Override
            protected void prepareConnection(HttpURLConnection connection, String httpMethod) throws IOException {
                // Force strict timeouts to prevent thread starvation
                connection.setConnectTimeout(3000);
                connection.setReadTimeout(3000);

                // EXACT SSL and Hostname Bypass from your old working code
                if (connection instanceof HttpsURLConnection && !"PROD".equalsIgnoreCase(environment)) {
                    HttpsURLConnection httpsConnection = (HttpsURLConnection) connection;
                    try {
                        httpsConnection.setSSLSocketFactory(insecureSslContext().getSocketFactory());
                        // THIS IS THE CRITICAL BYPASS THAT PREVENTS THE UAT I/O ERROR
                        httpsConnection.setHostnameVerifier((hostname, session) -> true);
                    } catch (Exception e) {
                        log.error("Failed to inject SSL bypass into connection.", e);
                    }
                }
                super.prepareConnection(connection, httpMethod);
            }
        };

        return builder.requestFactory(factory).build();
    }

    /**
     * Trust manager that blindly accepts all UAT certificates.
     */
    private SSLContext insecureSslContext() throws Exception {
        TrustManager[] trustAllCerts = new TrustManager[]{
                new X509TrustManager() {
                    public X509Certificate[] getAcceptedIssuers() { return null; }
                    public void checkClientTrusted(X509Certificate[] certs, String authType) {}
                    public void checkServerTrusted(X509Certificate[] certs, String authType) {}
                }
        };
        SSLContext sc = SSLContext.getInstance("TLS");
        sc.init(null, trustAllCerts, new SecureRandom());
        return sc;
    }
}
