2. The Time-Series Workhorse
This table holds the pre-calculated daily metrics.
Architectural Highlights:
 * Idempotency: The composite Primary Key ensures that if the PySpark job is accidentally re-run for a specific date, it will MERGE/UPSERT rather than duplicating amounts.
 * Partitioning: List partitioning by DOMAIN and Range sub-partitioning by BUSINESS_DATE ensures that historical trend queries scanning months of data remain lightning-fast.
-- ==============================================================================
-- TABLE: FINANCIAL_DAILY_METRIC
-- PURPOSE: Stores daily aggregated, business-classified metrics for the Dashboard.
-- ==============================================================================
CREATE TABLE FINANCIAL_DAILY_METRIC (
    BUSINESS_DATE       DATE NOT NULL,
    DOMAIN              VARCHAR2(20) NOT NULL,
    TYPE                VARCHAR2(100) NOT NULL,
    SUBTYPE             VARCHAR2(100),
    DESCRIPTION         VARCHAR2(100) NOT NULL,
    CIRCLE_CODE         VARCHAR2(50) NOT NULL,
    CIRCLE_NAME         VARCHAR2(100),
    BRANCH_CODE         VARCHAR2(50) NOT NULL,
    BRANCH_NAME         VARCHAR2(100),
    AMOUNT              NUMBER(24, 4) DEFAULT 0 NOT NULL,
    LOAD_TIMESTAMP      TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    
    -- Idempotency constraint: Prevents duplicate aggregation rows per day
    CONSTRAINT PK_FIN_DAILY_METRIC PRIMARY KEY (BUSINESS_DATE, DOMAIN, DESCRIPTION, CIRCLE_CODE, BRANCH_CODE)
)
PARTITION BY LIST (DOMAIN)
SUBPARTITION BY RANGE (BUSINESS_DATE) (
    PARTITION P_DEPOSIT VALUES ('DEPOSIT') (
        SUBPARTITION P_DEP_2026_Q3 VALUES LESS THAN (TO_DATE('2026-10-01', 'YYYY-MM-DD')),
        SUBPARTITION P_DEP_2026_Q4 VALUES LESS THAN (TO_DATE('2027-01-01', 'YYYY-MM-DD')),
        SUBPARTITION P_DEP_MAX VALUES LESS THAN (MAXVALUE)
    ),
    PARTITION P_LOAN VALUES ('LOAN') (
        SUBPARTITION P_LOAN_2026_Q3 VALUES LESS THAN (TO_DATE('2026-10-01', 'YYYY-MM-DD')),
        SUBPARTITION P_LOAN_2026_Q4 VALUES LESS THAN (TO_DATE('2027-01-01', 'YYYY-MM-DD')),
        SUBPARTITION P_LOAN_MAX VALUES LESS THAN (MAXVALUE)
    )
);

-- Local Partitioned Indexes for high-speed Trend & Scope-based queries
CREATE INDEX IDX_FIN_DAILY_SCOPE ON FINANCIAL_DAILY_METRIC (DOMAIN, CIRCLE_CODE, BRANCH_CODE, BUSINESS_DATE) LOCAL;

-- Table & Column Comments
COMMENT ON TABLE FINANCIAL_DAILY_METRIC IS 'Aggregated daily time-series data for deposits and loans. Consumed by Dashboard Service API.';
COMMENT ON COLUMN FINANCIAL_DAILY_METRIC.AMOUNT IS 'Normalized and aggregated total balance down to 4 decimal places.';
COMMENT ON COLUMN FINANCIAL_DAILY_METRIC.CIRCLE_CODE IS 'Required for scope enforcement and drill-down.';
COMMENT ON COLUMN FINANCIAL_DAILY_METRIC.BRANCH_CODE IS 'Required for branch-level scope enforcement and drill-down.';

3. The Predictive Output Layer
This table decouples the heavy ARIMA ML processing from the API requests.
-- ==============================================================================
-- TABLE: FINANCIAL_FORECAST
-- PURPOSE: Stores pre-calculated predictive time-series generated by batch models.
-- ==============================================================================
CREATE TABLE FINANCIAL_FORECAST (
    FORECAST_DATE       DATE NOT NULL,
    DOMAIN              VARCHAR2(20) NOT NULL,
    DESCRIPTION         VARCHAR2(100) NOT NULL,
    SCOPE_LEVEL         VARCHAR2(20) NOT NULL,  -- 'BANK', 'CIRCLE', or 'BRANCH'
    SCOPE_ID            VARCHAR2(50) NOT NULL,  -- e.g., 'C01' or 'B001'
    PREDICTED_AMOUNT    NUMBER(24, 4) NOT NULL,
    LOWER_BOUND         NUMBER(24, 4),          -- Confidence interval
    UPPER_BOUND         NUMBER(24, 4),
    MODEL_NAME          VARCHAR2(50) NOT NULL,  -- e.g., 'ARIMA'
    MODEL_VERSION       VARCHAR2(20) NOT NULL,  
    RUN_ID              VARCHAR2(100) NOT NULL, -- Traceability back to batch logs
    GENERATED_AT        TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    
    CONSTRAINT PK_FIN_FORECAST PRIMARY KEY (FORECAST_DATE, DOMAIN, DESCRIPTION, SCOPE_LEVEL, SCOPE_ID)
)
PARTITION BY RANGE (FORECAST_DATE) (
    PARTITION P_FCST_2026_Q4 VALUES LESS THAN (TO_DATE('2027-01-01', 'YYYY-MM-DD')),
    PARTITION P_FCST_MAX VALUES LESS THAN (MAXVALUE)
);

-- Indexes
CREATE INDEX IDX_FIN_FCST_SCOPE ON FINANCIAL_FORECAST (DOMAIN, SCOPE_LEVEL, SCOPE_ID, FORECAST_DATE) LOCAL;

-- Table & Column Comments
COMMENT ON TABLE FINANCIAL_FORECAST IS 'Stored predictions generated by offline forecasting models (ARIMA). Read-only for Dashboard API.';
COMMENT ON COLUMN FINANCIAL_FORECAST.SCOPE_LEVEL IS 'The organizational hierarchy level this forecast applies to.';
COMMENT ON COLUMN FINANCIAL_FORECAST.SCOPE_ID IS 'The specific Circle Code, Branch Code, or Bank ID for this forecast.';

