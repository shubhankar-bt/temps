    @Transactional
    @Override
    public UserDto verifyUserCredentials(UserDto userCredentials, String clientIp) {

        final String userId = userCredentials.getUserId().toLowerCase();
        final String encryptedPassword = userCredentials.getPassword();

        UserDto result = new UserDto();
        result.setUserId(userId);
        
        // Anti-Enumeration Generic Message
        String genericAuthError = "Invalid credentials. Please check your User ID and Password.";

        // 1. LOCAL DB EXISTENCE CHECK
        User user = userRepository.findByUserId(userId);
        if (user == null) {
            result.setValidCredentials(false);
            result.setAccountLocked(false);
            result.setMessage(genericAuthError);
            log.warn("Login blocked: User {} not found in local DB.", LoginUtility.sanitizeLog(userId));
            return result;
        }

        LoginParam loginParam = loginParamRepository.getLoginParam();
        char activeMode = loginParam.getActiveLoginMode();

        // Audit prep
        LoginAttempt attempt = new LoginAttempt();
        attempt.setLoginMethod(determineMethodString(activeMode));
        attempt.setSuccess("N");
        attempt.setIpAddress(clientIp);
        attempt.setUserId(userId);

        result.setLoginMethod(activeMode);
        result.setOtpRequired("Y".equalsIgnoreCase(loginParam.getIsOtpEnabled()));
        
        UserRoles userRole = userRepository.getUserRole(userId);
        result.setRoleStatus(userRole.getRoleStatus());
        result.setUserStatus(user.getAccountStatus());
        result.setPasswordLoginStatus(user.getPasswordLogin());

        // 2. GLOBAL ROLE & ACCOUNT CHECKS
        if (!Constants.ACTIVE.equalsIgnoreCase(userRole.getRoleStatus())) {
            attempt.setFailureReason("Role Inactive");
            loginAttemptRepository.save(attempt);
            result.setValidCredentials(false);
            result.setAccountLocked(true); // Triggers 403
            result.setMessage("Your account role is inactive. Please contact support.");
            return result;
        }

        if (!Constants.ACTIVE.equalsIgnoreCase(user.getAccountStatus())) {
            attempt.setFailureReason("User Inactive/Locked in DB");
            loginAttemptRepository.save(attempt);
            result.setValidCredentials(false);
            result.setAccountLocked(true); // Triggers 403
            result.setMessage("Your account is locked or inactive. Please contact support.");
            return result;
        }

        // 3. TIGHTLY SCOPED RSA DECRYPTION
        // Explicitly isolated so it doesn't swallow LDAP security exceptions
        String rawPassword;
        try {
            rawPassword = KeyUtils.decryptRsaPassword(encryptedPassword, rsaPrivatePem);
        } catch (SecurityException e) {
            log.error("Login rejected for user {}: Payload decryption failed", LoginUtility.sanitizeLog(userId));
            result.setValidCredentials(false);
            result.setAccountLocked(false);
            result.setMessage("Security Error: Invalid encrypted payload.");
            attempt.setFailureReason("Payload Decryption Failed");
            loginAttemptRepository.save(attempt);
            return result;
        }

        // 4. BRANCHED AUTHENTICATION
        if (activeMode == Constants.LDAP) {
            // ============================================
            // MODE: LDAP (Delegated Lockouts to AD)
            // ============================================
            log.info("Processing LDAP Login for user: {}", LoginUtility.sanitizeLog(userId));
            try {
                Boolean ldapSuccess = Mono.fromCallable(() -> adAuthenticationService.authenticate(userId, rawPassword))
                        .subscribeOn(ldapScheduler)
                        .block(); 
                        
                if (Boolean.TRUE.equals(ldapSuccess)) {
                    handleSuccess(attempt, result, user, userRole);
                } else {
                    // AD rejected password. Do NOT increment local count.
                    attempt.setFailureReason("LDAP Authentication Failed");
                    result.setValidCredentials(false);
                    result.setAccountLocked(false);
                    result.setMessage(genericAuthError);
                }
            } catch (SecurityException se) {
                // Catches explicit Active Directory errors (e.g. data 775 - Account Locked)
                log.warn("LDAP Security Exception for {}: {}", LoginUtility.sanitizeLog(userId), se.getMessage());
                attempt.setFailureReason(se.getMessage());
                result.setValidCredentials(false);
                result.setAccountLocked(se.getMessage().toLowerCase().contains("locked"));
                result.setMessage(se.getMessage()); 
            } catch (RuntimeException e) {
                log.error("LDAP Server Error for user {}: {}", LoginUtility.sanitizeLog(userId), e.getMessage());
                attempt.setFailureReason("LDAP Server Down");
                result.setValidCredentials(false);
                result.setAccountLocked(false);
                result.setMessage("System Error: Unable to connect to Authentication Server. Please try again later.");
            }
        } 
        else if (activeMode == Constants.PWD_MODE) {
            // ============================================
            // MODE: LOCAL PASSWORD (DB tracked limits)
            // ============================================
            if (Constants.INACTIVE.equalsIgnoreCase(user.getPasswordLogin())) {
                handleAccountLocked(attempt, result, user);
            } else {
                passwordBasedLogin(rawPassword, attempt, result, user, loginParam);
                
                // Expiry Check ONLY for local passwords
                if (result.isValidCredentials()) {
                    Timestamp setAt = user.getTempPasswordSetAt();
                    boolean isPasswordValid = false;
                    if (setAt != null) {
                        LocalDateTime lastUpdate = setAt.toLocalDateTime();
                        isPasswordValid = LocalDateTime.now().isBefore(lastUpdate.plusHours(loginParam.getPasswordValidity()));
                    }
                    if (!isPasswordValid) {
                        result.setUpdatePassword(true); // Triggers 428 Precondition Required
                        result.setMessage("Your password has expired. Please update it.");
                    }
                }
            }
        }

        loginAttemptRepository.save(attempt);
        return result;
    }

