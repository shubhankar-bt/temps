package com.fincore.CommunicationService.client;

import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

import javax.net.ssl.*;
import com.fincore.CommunicationService.dto.SmsResponseDTO;
import com.fincore.CommunicationService.model.FincoreSettings;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStream;
import java.io.InputStreamReader;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;
import java.security.SecureRandom;
import java.security.cert.X509Certificate;
import java.util.Base64;

@Slf4j
@Component
public class SmsGatewayClient {

    // EXACTLY your old working code. 
    // Forces HTTP/1.1 which bypasses the Solace 403 Forbidden error.
    public SmsResponseDTO sendSms(FincoreSettings config, String mobileNumber, String message) {
        HttpURLConnection smsConnection = null;

        try {
            URL url = new URL(config.getUrl());
            smsConnection = (HttpURLConnection) url.openConnection();
            smsConnection.setRequestMethod("POST");
            smsConnection.setDoOutput(true);
            smsConnection.setConnectTimeout(3000);
            smsConnection.setReadTimeout(3000);

            if (smsConnection instanceof HttpsURLConnection) {
                HttpsURLConnection httpsConnection = (HttpsURLConnection) smsConnection;
                try {
                    TrustManager[] trustAllCerts = new TrustManager[] {
                            new X509TrustManager() {
                                public X509Certificate[] getAcceptedIssuers() { return null; }
                                public void checkClientTrusted(X509Certificate[] certs, String authType) {}
                                public void checkServerTrusted(X509Certificate[] certs, String authType) {}
                            }
                    };
                    SSLContext sslContext = SSLContext.getInstance("TLS");
                    sslContext.init(null, trustAllCerts, new SecureRandom());
                    httpsConnection.setSSLSocketFactory(sslContext.getSocketFactory());
                    httpsConnection.setHostnameVerifier((hostname, session) -> true);
                } catch (Exception ex) {
                    log.error("Failed to configure SSL bypass", ex);
                }
            }

            if (config.getUsername() != null && config.getPassword() != null) {
                String auth = config.getUsername() + ":" + config.getPassword();
                String encodedAuth = Base64.getEncoder().encodeToString(auth.getBytes(StandardCharsets.UTF_8));
                smsConnection.setRequestProperty("Authorization", "Basic " + encodedAuth);
            }

            smsConnection.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
            smsConnection.setRequestProperty("Accept", "application/x-www-form-urlencoded");

            String payload = "content_type=text"
                    + "&sender_id=" + config.getSenderId()
                    + "&mobile=0" + mobileNumber
                    + "&message=" + URLEncoder.encode(message, StandardCharsets.UTF_8)
                    + "&intflag=0"
                    + "&charging=0";

            log.info("Sending SMS to ******{}", mobileNumber.substring(Math.max(mobileNumber.length() - 4, 0)));

            try (OutputStream outputStream = smsConnection.getOutputStream()) {
                outputStream.write(payload.getBytes(StandardCharsets.UTF_8));
            }

            int responseCode = smsConnection.getResponseCode();
            InputStream responseStream = (responseCode >= 200 && responseCode < 300)
                            ? smsConnection.getInputStream() : smsConnection.getErrorStream();

            String responseBody = readResponse(responseStream);
            log.info("SMS Response Code : {}", responseCode);
            log.info("SMS Provider Response : {}", responseBody);

            boolean success = responseCode == HttpURLConnection.HTTP_OK && responseBody.contains("MESSAGE_SUBMIT_SUCCESS");

            return SmsResponseDTO.builder()
                    .success(success)
                    .message(success ? "SMS Sent Successfully" : "SMS Sending Failed")
                    .providerResponse(responseBody)
                    .build();

        } catch (Exception ex) {
            log.error("Error while sending SMS", ex);
            return SmsResponseDTO.builder()
                    .success(false)
                    .message(ex.getMessage())
                    .providerResponse(null)
                    .build();
        } finally {
            if (smsConnection != null) {
                smsConnection.disconnect();
            }
        }
    }

    private String readResponse(InputStream responseStream) throws IOException {
        if (responseStream == null) return "";
        StringBuilder response = new StringBuilder();
        try (BufferedReader reader = new BufferedReader(new InputStreamReader(responseStream, StandardCharsets.UTF_8))) {
            String line;
            while ((line = reader.readLine()) != null) response.append(line);
        }
        return response.toString();
    }
}



















package com.fincore.CommunicationService.client;

import java.util.List;
import java.util.Map;

import org.json.JSONArray;
import org.json.JSONObject;
import org.springframework.core.io.Resource;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.http.client.MultipartBodyBuilder;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestClient;

import com.fincore.CommunicationService.exception.CommunicationExceptions.VendorDeliveryException;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Slf4j
@Component
@RequiredArgsConstructor
public class EmailGatewayClient {

    private static final String URL = "url";
    private static final String API_KEY = "api_key";
    private static final String SENDER_ID = "senderId";
    private static final String TO_EMAIL = "toEmail";
    private static final String CC_TO_EMAIL = "ccToEmail";
    private static final String EMAIL_BODY = "emailBody";
    private static final String SUBJECT = "subject";

    private final RestClient restClient;

    public int sendEmail(Map<String, Object> emailRequest, Resource attachment) {
        try {
            String apiUrl = (String) emailRequest.getOrDefault(URL, null);
            String apiKey = (String) emailRequest.getOrDefault(API_KEY, null);
            
            // Build exactly your old JSON String
            String finalRequestBody = buildEmailJson(emailRequest);
            log.info("finalRequestBody   " + finalRequestBody);

            ResponseEntity<String> response;

            if (attachment == null) {
                // OTP SCENARIO: Send EXACTLY like your old code
                response = restClient.post()
                        .uri(apiUrl)
                        .header("Content-Type", "application/json")
                        .header("Accept", "application/json")
                        .header("api_key", apiKey)
                        .body(finalRequestBody)
                        .retrieve()
                        .toEntity(String.class);
            } else {
                // ATTACHMENT SCENARIO: Stream the multipart file
                MultipartBodyBuilder multipartBuilder = new MultipartBodyBuilder();
                multipartBuilder.part("payload", finalRequestBody, MediaType.APPLICATION_JSON);
                multipartBuilder.part("attachment", attachment);

                response = restClient.post()
                        .uri(apiUrl)
                        .header("api_key", apiKey)
                        .contentType(MediaType.MULTIPART_FORM_DATA)
                        .body(multipartBuilder.build())
                        .retrieve()
                        .toEntity(String.class);
            }

            int responseCode = response.getStatusCode().value();
            log.info("responseCode " + responseCode);
            log.info("Server Response : {}", response.getBody());

            return responseCode;

        } catch (Exception e) {
            log.error("Exception while calling Email Vendor API", e);
            throw new VendorDeliveryException("Error occurred while calling Email Vendor API", e);
        }
    }

    @SuppressWarnings("unchecked")
    private String buildEmailJson(Map<String, Object> emailRequest) {
        String senderEmail = (String) emailRequest.getOrDefault(SENDER_ID, null);
        String recipientMail = (String) emailRequest.getOrDefault(TO_EMAIL, null);
        String ccToEmail = (String) emailRequest.getOrDefault(CC_TO_EMAIL, null);
        String emailBody = (String) emailRequest.getOrDefault(EMAIL_BODY, null);
        String subject = (String) emailRequest.getOrDefault(SUBJECT, null);

        JSONObject senderJson = new JSONObject();
        senderJson.put("email", senderEmail);
        senderJson.put("name", "FINCORE");

        JSONObject emailContentJson = new JSONObject();
        emailContentJson.put("type", "html");
        emailContentJson.put("value", emailBody);

        JSONArray contentArray = new JSONArray();
        contentArray.put(emailContentJson);

        JSONObject recipientJson = new JSONObject();
        recipientJson.put("email", recipientMail);

        JSONArray recipientArray = new JSONArray();
        recipientArray.put(recipientJson);

        JSONObject attributesJson = new JSONObject();
        attributesJson.put("LEAD", "Andy Dwyer");
        attributesJson.put("BAND", "Mouse Rat");

        JSONObject personalizationsJson = new JSONObject();
        personalizationsJson.put("to", recipientArray);
        personalizationsJson.put("attributes", attributesJson);

        // Required to support the new Bulk array feature
        if (emailRequest.containsKey("bccEmails")) {
            List<String> bccEmails = (List<String>) emailRequest.get("bccEmails");
            JSONArray bccArray = new JSONArray();
            for (String email : bccEmails) {
                JSONObject bccObj = new JSONObject();
                bccObj.put("email", email);
                bccArray.put(bccObj);
            }
            personalizationsJson.put("bcc", bccArray);
        }

        if (emailRequest.containsKey("ccToEmail")) {
            JSONObject ccRecipientJson = new JSONObject();
            ccRecipientJson.put("email", ccToEmail);
            JSONArray ccArray = new JSONArray();
            ccArray.put(ccRecipientJson);
            personalizationsJson.put("cc", ccArray);
        }

        // Your hardcoded exact tokens
        personalizationsJson.put("token_to", "8693839845");
        personalizationsJson.put("token_cc", "MSGID657243");
        personalizationsJson.put("token_bcc", "MSGID657244");

        JSONArray personalizationsJsonArray = new JSONArray();
        personalizationsJsonArray.put(personalizationsJson);

        JSONObject trackingSettingsJson = new JSONObject();
        trackingSettingsJson.put("open_track", true);
        trackingSettingsJson.put("click_track", true);
        trackingSettingsJson.put("unsubscribe_track", true);

        JSONObject emailRequestJson = new JSONObject();
        emailRequestJson.put("from", senderJson);
        emailRequestJson.put("subject", subject);
        emailRequestJson.put("content", contentArray);
        emailRequestJson.put("personalizations", personalizationsJsonArray);
        emailRequestJson.put("settings", trackingSettingsJson);

        return emailRequestJson.toString();
    }
}
