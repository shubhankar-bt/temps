package com.fincore.CommunicationService.recipient.provider;

import com.fincore.CommunicationService.dto.GenericCommunicationEvent;
import com.fincore.CommunicationService.dto.ResolvedRecipient;
import com.fincore.CommunicationService.model.Role;
import com.fincore.CommunicationService.model.User;
import com.fincore.CommunicationService.model.UserRole;
import com.fincore.CommunicationService.repository.RoleRepository;
import com.fincore.CommunicationService.repository.UserRepository;
import com.fincore.CommunicationService.repository.UserRoleRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

/**
 * Resolves Role-based recipients into Email and Mobile details.
 *
 * <p><b>Fix Applied:</b>
 * Producers send Role IDs as Strings (e.g., ["10", "11"]). 
 * The logic now securely parses these to Longs and searches by ID, rather than Name.</p>
 *
 * @since 2026-07
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class RoleRecipientProvider implements RecipientProvider {

    private static final String ACTIVE = "ACTIVE";

    private final RoleRepository roleRepository;
    private final UserRoleRepository userRoleRepository;
    private final UserRepository userRepository;

    @Override
    @Cacheable(value = "roles", key = "#recipients.roles")
    public List<ResolvedRecipient> resolve(GenericCommunicationEvent.Recipients recipients) {

        if (recipients.getRoles() == null || recipients.getRoles().isEmpty()) {
            return Collections.emptyList();
        }

        log.info("Resolving recipients for Roles: {}", recipients.getRoles());

        List<Long> roleIdsToSearch = new ArrayList<>();

        // 1. Determine if we are fetching ALL roles or specific IDs
        if (recipients.getRoles().contains("ALL")) {
            log.info("Received 'ALL' Roles. Fetching all active role IDs from database.");
            List<Role> activeRoles = roleRepository.findByRoleStatus(ACTIVE);
            roleIdsToSearch = activeRoles.stream().map(Role::getRoleId).toList();
        } else {
            // Parse the Producer's String IDs into Longs safely
            for (String roleStr : recipients.getRoles()) {
                try {
                    roleIdsToSearch.add(Long.parseLong(roleStr.trim()));
                } catch (NumberFormatException e) {
                    log.warn("Producer sent non-numeric Role ID: [{}]. Ignoring.", roleStr);
                }
            }
        }

        if (roleIdsToSearch.isEmpty()) {
            log.warn("No valid numeric Role IDs resolved.");
            return Collections.emptyList();
        }

        // 2. Fetch User-to-Role Mappings directly
        List<UserRole> mappings = userRoleRepository.findByRoleIdIn(roleIdsToSearch);

        if (mappings.isEmpty()) {
            log.warn("No User mappings found for Role IDs: {}", roleIdsToSearch);
            return Collections.emptyList();
        }

        // 3. Extract unique User IDs
        List<String> userIds = mappings.stream()
                .map(UserRole::getUserId)
                .distinct()
                .toList();

        // 4. Fetch actual User Contact Info
        List<User> users = userRepository.findByUserIdIn(userIds);

        log.info("Successfully resolved {} User(s) from {} Role(s).", users.size(), roleIdsToSearch.size());

        return users.stream()
                .map(user -> ResolvedRecipient.builder()
                        .userId(user.getUserId())
                        .email(user.getEmail())
                        .mobile(user.getPhoneNumber())
                        .build())
                .toList();
    }

    @Override
    public String getType() {
        return "ROLE";
    }
}

