package com.fincore.CommunicationService.consumer;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.CommunicationService.dto.KafkaEvent;
import com.fincore.CommunicationService.exception.CommunicationExceptions.DecryptionFailureException;
import com.fincore.CommunicationService.exception.CommunicationExceptions.InvalidPayloadException;
import com.fincore.CommunicationService.exception.CommunicationExceptions.TemplateNotFoundException;
import com.fincore.CommunicationService.exception.CommunicationExceptions.VendorDeliveryException;
import com.fincore.CommunicationService.service.CommunicationAuditService;
import com.fincore.CommunicationService.service.EmailService;
import com.fincore.CommunicationService.service.SmsService;
import com.fincore.commonutilities.util.AesEncryptionUtil;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.data.redis.core.StringRedisTemplate;
import org.springframework.kafka.annotation.DltHandler;
import org.springframework.kafka.annotation.EnableKafka;
import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.kafka.annotation.RetryableTopic;
import org.springframework.kafka.retrytopic.TopicSuffixingStrategy;
import org.springframework.kafka.support.Acknowledgment;
import org.springframework.kafka.support.KafkaHeaders;
import org.springframework.messaging.handler.annotation.Header;
import org.springframework.messaging.handler.annotation.Payload;
import org.springframework.retry.annotation.Backoff;
import org.springframework.stereotype.Component;

import javax.crypto.BadPaddingException;
import javax.crypto.IllegalBlockSizeException;
import java.security.GeneralSecurityException;
import java.time.Duration;
import java.util.Map;

/**
 * <p>A non-blocking, isolated Kafka consumer strictly reserved for Tier-0 (Login OTP) traffic.</p>
 *
 * <p><b>Architectural Context: Bulkhead Pattern</b>
 * This consumer operates on a dedicated topic ({@code fincore.auth.otp.priority}) and a dedicated
 * container factory ({@code priorityOtpContainerFactory}). This guarantees that bulk End-of-Day
 * reporting events can never exhaust the threads required for sub-second OTP delivery.</p>
 *
 * <p><b>Resilience & Retry Architecture:</b>
 * <ul>
 * <li><b>Attempts:</b> 4 total (1 initial + 3 retries) mapped to dynamically generated Kafka topics.</li>
 * <li><b>Backoff Strategy:</b> Exponential delay (2s, 4s, 8s) to allow downstream vendor APIs to recover.</li>
 * <li><b>Non-Retryable:</b> Deterministic faults (Decryption failures, Bad JSON) bypass retries and instantly route to the DLQ.</li>
 * </ul>
 * </p>
 *
 * @author Principal Engineer
 * @since 2026-06-22
 */
@Slf4j
@Component
@RequiredArgsConstructor
@EnableKafka
public class PriorityOtpConsumer {

    private final ObjectMapper mapper;
    private final AesEncryptionUtil aesUtil;
    private final StringRedisTemplate redisTemplate;
    private final CommunicationAuditService auditService;
    private final SmsService smsService;
    private final EmailService emailService;

    /**
     * Symmetrical AES-256-GCM key securely synced with the Login Service via Vault/Config Server.
     * Guarantees Zero-Trust architecture across the Kafka broker.
     */
    @Value("${security.internal.kafka-aes-key}")
    private String internalAesKey;

    /**
     * <p>Main ingress for high-priority OTP events.</p>
     *
     * @param message        The raw, encrypted JSON payload from the Kafka topic.
     * @param acknowledgment The Kafka acknowledgment handle for strict manual offset commits.
     * @throws JsonProcessingException    if the message wrapper cannot be deserialized.
     * @throws VendorDeliveryException    if external HTTP I/O fails (triggers exponential retry).
     * @throws DecryptionFailureException if payload decryption fails (triggers instant DLQ).
     */
    @RetryableTopic(
            attempts = "4",
            backoff = @Backoff(delay = 2000, multiplier = 2.0),
            topicSuffixingStrategy = TopicSuffixingStrategy.SUFFIX_WITH_INDEX_VALUE,
            dltTopicSuffix = "-dlq",
            exclude = {
                    DecryptionFailureException.class,
                    InvalidPayloadException.class,
                    TemplateNotFoundException.class
            }
    )
    @KafkaListener(
            topics = "fincore.auth.otp.priority",
            groupId = "communication-login-otp-group-v7",
            containerFactory = "priorityOtpContainerFactory"
    )
    public void consumeOtpEvent(@Payload String message, Acknowledgment acknowledgment) throws JsonProcessingException {

        log.info("Received Tier-0 OTP Event. Commencing secure processing pipeline.");
        String txId = "UNKNOWN";
        String eventId = "UNKNOWN";

        try {
            // ====================================================================
            // 1. DESERIALIZATION & VALIDATION
            // ====================================================================
            KafkaEvent event;
            try {
                event = mapper.readValue(message, KafkaEvent.class);
                txId = event.getTxId();
                eventId = event.getEventId();
            } catch (Exception e) {
                throw new InvalidPayloadException("Malformed JSON Wrapper: " + e.getMessage());
            }

            if (txId == null || eventId == null || event.getPayload() == null) {
                throw new InvalidPayloadException("Contract Violation: Missing txId, eventId, or encrypted payload.");
            }

            // ====================================================================
            // 2. ZERO-TRUST DECRYPTION (AES-256)
            // ====================================================================
            String decryptedJson;
            try {
                decryptedJson = aesUtil.decrypt(event.getPayload(), internalAesKey);
            } catch (BadPaddingException | IllegalBlockSizeException e) {
                log.error("SECURITY ALERT: Decryption failed for eventId={}. Data tampered or AES key mismatch.", eventId, e);
                throw new DecryptionFailureException("AES Decryption Failed: Invalid Padding", e);
            } catch (GeneralSecurityException e) {
                throw new DecryptionFailureException("AES Decryption Failed: General Security Exception", e);
            }

            // Map the decrypted inner JSON into a Map for FreeMarker binding
            Map<String, Object> templateDataMap = mapper.readValue(decryptedJson, new TypeReference<>() {});
            boolean requiresRetry = false;

            // ====================================================================
            // 3. CHANNEL ROUTING, IDEMPOTENCY & DISPATCH
            // ====================================================================
            for (String channel : event.getChannel()) {
                String recipientData = "EMAIL".equalsIgnoreCase(channel) ? event.getRecipient().getEmail() : event.getRecipient().getMobile();
                String auditId = eventId + "_" + channel.toUpperCase();
                
                // Idempotency Key ensures we don't spam users with multiple OTPs during a Kafka replay/retry
                String idempotencyKey = "COMM_IDEMP:" + eventId + ":" + channel.toUpperCase();

                // 15-minute TTL is optimal for OTP lifecycles
                Boolean isNew = redisTemplate.opsForValue().setIfAbsent(idempotencyKey, "PROCESSED", Duration.ofMinutes(15));
                if (Boolean.FALSE.equals(isNew)) {
                    log.debug("Idempotency hit: Already processed {} for eventId={}. Skipping.", channel, eventId);
                    continue;
                }

                // Log intention to database via non-blocking Virtual Thread
                auditService.logAttempt(auditId, eventId, txId, event.getTemplateId(), channel, recipientData);

                try {
                    // Synchronous Vendor Dispatch
                    if ("SMS".equalsIgnoreCase(channel)) {
                        smsService.sendSms(event.getTemplateId(), event.getRecipient().getMobile(), templateDataMap);
                    } else if ("EMAIL".equalsIgnoreCase(channel)) {
                        emailService.sendEmail(event.getTemplateId(), event.getRecipient().getEmail(), templateDataMap);
                    }

                    // Async success logging
                    auditService.logSuccess(auditId);

                } catch (Exception e) {
                    log.error("Vendor dispatch failed for eventId={} channel={}. Reason: {}", eventId, channel, e.getMessage());
                    
                    // CRITICAL: We must remove the idempotency key so the specific failed channel can be retried
                    redisTemplate.delete(idempotencyKey);
                    requiresRetry = true;
                }
            }

            // ====================================================================
            // 4. RESOLUTION & ACKNOWLEDGEMENT
            // ====================================================================
            if (requiresRetry) {
                // By throwing this runtime exception, Spring Kafka NACKs the message and routes it to the Retry Topic
                throw new VendorDeliveryException("One or more channels failed to deliver. Triggering Retry.", null);
            }

            // Strict Manual Acknowledgment. Ensures zero message loss.
            acknowledgment.acknowledge();
            log.info("Successfully completed Tier-0 OTP Pipeline for eventId={}", eventId);

        } catch (DecryptionFailureException | InvalidPayloadException | TemplateNotFoundException e) {
            log.error("Fatal deterministic error processing eventId={}. Routing to DLQ. Reason: {}", eventId, e.getMessage());
            throw e; // Caught by standard error handler, routes to DLQ instantly
        } catch (Exception e) {
            log.error("Unexpected system error processing Tier-0 OTP eventId={}", eventId, e);
            throw e; 
        }
    }

    /**
     * <p>The Dead Letter Queue (DLQ) Hook for catastrophic or terminal failures.</p>
     *
     * <p>Automatically invoked when:</p>
     * <ol>
     * <li>All exponential retries for a transient failure are exhausted.</li>
     * <li>A deterministic exception (e.g., Invalid JSON, Bad Crypto) is thrown.</li>
     * </ol>
     *
     * @param message          The raw, failing Kafka payload.
     * @param headerTopic      The source topic that failed.
     * @param exceptionMessage The final stack trace or error reason.
     */
    @DltHandler
    public void handleDltOtp(
            String message,
            @Header(KafkaHeaders.ORIGINAL_TOPIC) String headerTopic,
            @Header(KafkaHeaders.EXCEPTION_MESSAGE) String exceptionMessage) {

        log.error("=====================================================");
        log.error("CRITICAL DLQ ALERT: Tier-0 OTP Delivery Permanently Failed!");
        log.error("Original Topic: {}", headerTopic);
        log.error("Failure Reason: {}", exceptionMessage);
        log.error("Failed Message Payload: {}", message);
        log.error("=====================================================");

        String eventId = "UNKNOWN";
        try {
            KafkaEvent failedEvent = mapper.readValue(message, KafkaEvent.class);
            eventId = failedEvent.getEventId();
        } catch (Exception ex) {
            log.error("DLQ Deserialization failed. Cannot extract eventId from poisoned payload.", ex);
        }

        if (!"UNKNOWN".equals(eventId)) {
            // Delegate the terminal failure to the Audit Service for permanent persistence
            auditService.logFailure(eventId, exceptionMessage);
        }
    }
}

