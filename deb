package com.fincore.CommunicationService.config;

import com.fincore.CommunicationService.service.TemplateCacheService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.cache.CacheManager;
import org.springframework.stereotype.Component;

@Slf4j
@Component
@RequiredArgsConstructor
public class CacheSyncSubscriber {

    private final TemplateCacheService templateCacheService;
    private final CacheManager cacheManager;

    /**
     * Triggered by Redis Pub/Sub whenever ANY service publishes to the eviction topic.
     */
    public void onMessage(String message, String channel) {
        log.warn("CLUSTER EVENT RECEIVED: Cache Eviction broadcast detected on topic: {}", channel);
        
        if ("FLUSH_ALL".equals(message)) {
            // Option 1: Clear everything managed by the Caffeine CacheManager
            cacheManager.getCacheNames().forEach(cacheName -> {
                cacheManager.getCache(cacheName).clear();
                log.info("Evicted local L1 cache: {}", cacheName);
            });
        } else if ("FLUSH_TEMPLATES".equals(message)) {
            // Option 2: Clear specific caches using the existing @CacheEvict methods
            templateCacheService.flushCache();
            log.info("Evicted local L1 Template caches.");
        }
    }
}












import org.springframework.data.redis.core.StringRedisTemplate;

// Inside your existing controller or cron job:
@RestController
@RequiredArgsConstructor
public class AdminCacheController {

    private final StringRedisTemplate redisTemplate;

    @PostMapping("/api/admin/syncronizedAllCaches")
    public ResponseEntity<String> syncronizedAllCaches() {
        log.info("Admin triggered global cache eviction.");
        
        // This fires a message into Redis. 
        // Redis instantly duplicates and pushes it to all listening pods.
        redisTemplate.convertAndSend(CacheSyncConfig.CACHE_EVICT_TOPIC, "FLUSH_ALL");
        
        return ResponseEntity.ok("Cache eviction command broadcasted to cluster.");
    }
}

