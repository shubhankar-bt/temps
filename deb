package com.fincore.analyticsservice.dto;

import jakarta.validation.constraints.NotEmpty;
import jakarta.validation.constraints.Size;
import lombok.Data;

import java.util.List;
import java.util.Set;

@Data
public class DrillDownRequest {
    
    // e.g., YSA_BANK, PNL_CIRCLE
    private String viewCode; 
    
    // e.g., HeadCode, Geography, Circle
    private String dimension; 

    // The new Multi-HeadCode global filter
    @NotEmpty(message = "At least one Head Code must be selected.")
    @Size(max = 5, message = "A maximum of 5 Head Codes can be analyzed simultaneously to ensure optimal performance.")
    private Set<String> headCodes; 

    // Dynamic drill-down filters from the UI clicks
    private List<FilterDTO> filters; 
}







