package com.fincore.CommunicationService.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.core.task.AsyncTaskExecutor;
import org.springframework.core.task.support.TaskExecutorAdapter;
import org.springframework.scheduling.annotation.EnableAsync;

import java.util.concurrent.Executors;

/**
 * <p>Enterprise Asynchronous Execution Configuration utilizing Java 21 Virtual Threads.</p>
 *
 * <p><b>Architectural Context:</b>
 * The Communication Service relies heavily on database I/O for auditing every single
 * notification attempt, success, and failure. If we were to use standard platform (OS) threads
 * for this, a massive EOD (End of Day) bulk blast could quickly exhaust the application's
 * thread pool or lead to severe CPU context-switching overhead.</p>
 *
 * <p>By delegating all {@code @Async("virtualThreadAuditExecutor")} tasks to Java 21
 * Virtual Threads, the JVM can "park" the thread during the database network I/O wait time
 * at a cost of mere kilobytes of RAM, allowing the OS carrier thread to serve other requests.
 * This ensures our Kafka consumer threads are never blocked by slow database responses.</p>
 *
 * @author Principal Engineer
 * @since 2026-07
 */
@Slf4j
@Configuration
@EnableAsync
public class AsyncAuditConfig {

    /**
     * <p>Defines the custom executor specifically for Audit logging tasks.</p>
     *
     * <p>Note: We wrap {@code Executors.newVirtualThreadPerTaskExecutor()} in a
     * {@link TaskExecutorAdapter} to ensure Spring's internal routing and
     * context propagation (like SLF4J MDC contexts) behave correctly across
     * asynchronous boundaries.</p>
     *
     * @return AsyncTaskExecutor backed by a Virtual Thread Per Task Executor.
     */
    @Bean(name = "virtualThreadAuditExecutor")
    public AsyncTaskExecutor virtualThreadAuditExecutor() {
        log.info("Initializing Java 21 Virtual Thread Executor for the Audit Engine. " +
                 "I/O blocking overhead neutralized.");
        
        return new TaskExecutorAdapter(Executors.newVirtualThreadPerTaskExecutor());
    }
}

